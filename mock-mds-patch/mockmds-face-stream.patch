+package io.mosip.mock.sbi.devicehelper.face;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Collections;
+import java.util.List;
+
+import javax.imageio.ImageIO;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class FaceStreamProviderTest {
+
+    @TempDir
+    Path dir;
+
+    static byte[] jpeg(int grey) throws IOException {
+        BufferedImage img = new BufferedImage(32, 24, BufferedImage.TYPE_INT_RGB);
+        for (int y = 0; y < 24; y++) for (int x = 0; x < 32; x++) img.setRGB(x, y, (grey << 16) | (grey << 8) | grey);
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        ImageIO.write(img, "jpg", out);
+        return out.toByteArray();
+    }
+
+    /** Exactly what the liveness MjpegRecorder writes (the /stream wire format). */
+    static byte[] recording(byte[]... frames) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        for (byte[] f : frames) {
+            out.write(("--BoundaryString\r\nContent-type: image/jpeg\r\nContent-Length: " + f.length + "\r\n\r\n")
+                    .getBytes(StandardCharsets.US_ASCII));
+            out.write(f);
+            out.write("\r\n\r\n".getBytes(StandardCharsets.US_ASCII));
+        }
+        return out.toByteArray();
+    }
+
+    @Test
+    void defaultIsTheOriginalStaticImage() {
+        FaceStreamProvider p = FaceStreamProvider.fromConfig(null, null, null);
+        assertEquals(FaceStreamProvider.Mode.STATIC, p.mode());
+        assertFalse(p.active());
+        assertNull(p.currentJpeg(0));
+    }
+
+    @Test
+    void videoModeReplaysRecorderFilesFrameByFrameAtTheConfiguredRate() throws IOException {
+        byte[] a = jpeg(10), b = jpeg(120), c = jpeg(240);
+        File f = dir.resolve("clip.mjpeg").toFile();
+        Files.write(f.toPath(), recording(a, b, c));
+        FaceStreamProvider p = new FaceStreamProvider(FaceStreamProvider.Mode.VIDEO,
+                FaceStreamProvider.splitRecording(Files.readAllBytes(f.toPath())), 10.0, null, 1000);
+        assertEquals(3, p.frameCount());
+        assertArrayEquals(a, p.currentJpeg(1000));
+        assertArrayEquals(a, p.currentJpeg(1099));
+        assertArrayEquals(b, p.currentJpeg(1100));
+        assertArrayEquals(c, p.currentJpeg(1250));
+        assertArrayEquals(a, p.currentJpeg(1300), "loops");
+    }
+
+    @Test
+    void videoModeAlsoAcceptsPlainConcatenatedJpegs() throws IOException {
+        byte[] a = jpeg(10), b = jpeg(200);
+        byte[] plain = new byte[a.length + b.length + 7];
+        System.arraycopy(a, 0, plain, 0, a.length);
+        System.arraycopy("garbage".getBytes(StandardCharsets.US_ASCII), 0, plain, a.length, 7);
+        System.arraycopy(b, 0, plain, a.length + 7, b.length);
+        List<byte[]> frames = FaceStreamProvider.splitRecording(plain);
+        assertEquals(2, frames.size());
+        assertArrayEquals(a, frames.get(0));
+        assertArrayEquals(b, frames.get(1));
+    }
+
+    @Test
+    void truncatedLastFrameIsIgnoredAndJunkIsRejected() throws IOException {
+        byte[] full = recording(jpeg(10), jpeg(20));
+        byte[] cut = java.util.Arrays.copyOf(full, full.length - 40);
+        assertEquals(1, FaceStreamProvider.splitRecording(cut).size());
+        assertThrows(IOException.class, () -> FaceStreamProvider.splitRecording("not a video".getBytes(StandardCharsets.US_ASCII)));
+    }
+
+    @Test
+    void imagesModeCyclesAFolderInNameOrderAndConvertsPng() throws IOException {
+        Files.write(dir.resolve("b.jpg"), jpeg(100));
+        ImageIO.write(ImageIO.read(new java.io.ByteArrayInputStream(jpeg(200))), "png", dir.resolve("c.png").toFile());
+        Files.write(dir.resolve("a.jpeg"), jpeg(50));
+        Files.write(dir.resolve("notes.txt"), "ignore me".getBytes(StandardCharsets.US_ASCII));
+        List<byte[]> imgs = FaceStreamProvider.loadImages(dir.toFile());
+        assertEquals(3, imgs.size());
+        assertArrayEquals(Files.readAllBytes(dir.resolve("a.jpeg")), imgs.get(0));
+        assertNotNull(ImageIO.read(new java.io.ByteArrayInputStream(imgs.get(2))), "PNG re-encoded as JPEG");
+
+        FaceStreamProvider p = new FaceStreamProvider(FaceStreamProvider.Mode.IMAGES, imgs, 2.0, null, 0);
+        assertArrayEquals(imgs.get(0), p.currentJpeg(0));
+        assertArrayEquals(imgs.get(1), p.currentJpeg(500));
+    }
+
+    @Test
+    void singleImageIsAStaticPhotoFeed() throws IOException {
+        Files.write(dir.resolve("photo.jpg"), jpeg(77));
+        FaceStreamProvider p = FaceStreamProvider.fromConfig("images", dir.resolve("photo.jpg").toString(), "15");
+        assertTrue(p.active());
+        assertArrayEquals(p.currentJpeg(), p.currentJpeg());
+    }
+
+    @Test
+    void badConfigurationFallsBackToTheStaticImage() {
+        assertEquals(FaceStreamProvider.Mode.STATIC, FaceStreamProvider.fromConfig("video", null, null).mode());
+        assertEquals(FaceStreamProvider.Mode.STATIC,
+                FaceStreamProvider.fromConfig("video", dir.resolve("missing.mjpeg").toString(), null).mode());
+        assertEquals(FaceStreamProvider.Mode.STATIC, FaceStreamProvider.fromConfig("hologram", null, null).mode());
+        assertEquals(FaceStreamProvider.Mode.IMAGES, FaceStreamProvider.parseMode(" Images "));
+        assertTrue(FaceStreamProvider.fromConfig(null, null, "abc").currentJpeg(0) == null);
