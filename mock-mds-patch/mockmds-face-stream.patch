diff --git a/MockMDS/src/main/java/io/mosip/mock/sbi/devicehelper/face/FaceStreamProvider.java b/MockMDS/src/main/java/io/mosip/mock/sbi/devicehelper/face/FaceStreamProvider.java
new file mode 100644
index 0000000..b35f03d
--- /dev/null
+++ b/MockMDS/src/main/java/io/mosip/mock/sbi/devicehelper/face/FaceStreamProvider.java
@@ -0,0 +1,250 @@
+package io.mosip.mock.sbi.devicehelper.face;
+
+import java.awt.image.BufferedImage;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+import javax.imageio.ImageIO;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import io.mosip.mock.sbi.util.ApplicationPropertyHelper;
+
+/**
+ * Real frames for the mock face device's {@code /stream} (face liveness development and automated tests).
+ *
+ * <p>Modes, set with {@value #KEY_MODE} (system property first, then application.properties):
+ * <ul>
+ *   <li>{@code static} (default): the original behaviour, one fixed stream image.</li>
+ *   <li>{@code images}: a folder (or one file) of JPEG/PNG images, shown in name order, each for one frame period
+ *       at {@value #KEY_FPS} frames per second, looping. One image = a printed-photo attack.</li>
+ *   <li>{@code video}: a recording replayed at {@value #KEY_FPS}, looping. Accepts the Content-Length framed files
+ *       written by the liveness MjpegRecorder (the exact /stream wire format) and plain concatenated JPEGs
+ *       ({@code ffmpeg -i in.mp4 -f mjpeg out.mjpeg}).</li>
+ *   <li>{@code webcam}: the default camera of this machine (webcam-capture library), live.</li>
+ * </ul>
+ * {@value #KEY_SOURCE} is the folder/file for {@code images} and {@code video}. Frames advance by elapsed time, so
+ * playback speed does not depend on how often the stream loop asks for a frame.
+ */
+public class FaceStreamProvider {
+
+    public static final String KEY_MODE = "mosip.mock.sbi.face.stream.mode";
+    public static final String KEY_SOURCE = "mosip.mock.sbi.face.stream.source";
+    public static final String KEY_FPS = "mosip.mock.sbi.face.stream.fps";
+
+    public enum Mode { STATIC, IMAGES, VIDEO, WEBCAM }
+
+    private static final Logger logger = LoggerFactory.getLogger(FaceStreamProvider.class);
+    private static final int MAX_FRAME_BYTES = 16 * 1024 * 1024;
+
+    private static volatile FaceStreamProvider configured;
+
+    private final Mode mode;
+    private final List<byte[]> frames;
+    private final long frameIntervalMs;
+    private final long startedAtMs;
+    private final Object webcam; // com.github.sarxos.webcam.Webcam, only in WEBCAM mode
+
+    FaceStreamProvider(Mode mode, List<byte[]> frames, double fps, Object webcam, long nowMs) {
+        this.mode = mode;
+        this.frames = frames;
+        this.frameIntervalMs = Math.max(1L, Math.round(1000.0 / (fps > 0 ? fps : 15.0)));
+        this.webcam = webcam;
+        this.startedAtMs = nowMs;
+    }
+
+    /** The provider configured for this MockMDS process (created on first use). */
+    public static FaceStreamProvider get() {
+        FaceStreamProvider p = configured;
+        if (p == null) {
+            synchronized (FaceStreamProvider.class) {
+                p = configured;
+                if (p == null) {
+                    p = fromConfig(setting(KEY_MODE), setting(KEY_SOURCE), setting(KEY_FPS));
+                    configured = p;
+                }
+            }
+        }
+        return p;
+    }
+
+    /** Builds a provider; any problem falls back to STATIC (the original behaviour) and is logged. */
+    static FaceStreamProvider fromConfig(String modeValue, String source, String fpsValue) {
+        Mode mode = parseMode(modeValue);
+        double fps = 15.0;
+        try {
+            if (fpsValue != null && !fpsValue.trim().isEmpty()) fps = Double.parseDouble(fpsValue.trim());
+        } catch (NumberFormatException e) {
+            logger.warn("Invalid {}={}, using 15", KEY_FPS, fpsValue);
+        }
+        try {
+            switch (mode) {
+            case IMAGES:
+                return new FaceStreamProvider(mode, loadImages(new File(required(source))), fps, null, now());
+            case VIDEO:
+                return new FaceStreamProvider(mode, splitRecording(Files.readAllBytes(new File(required(source)).toPath())),
+                        fps, null, now());
+            case WEBCAM:
+                return new FaceStreamProvider(mode, Collections.<byte[]>emptyList(), fps, openWebcam(), now());
+            default:
+                return new FaceStreamProvider(Mode.STATIC, Collections.<byte[]>emptyList(), fps, null, now());
+            }
+        } catch (Exception | LinkageError e) {
+            logger.error("Face stream mode {} could not start ({}); using the static stream image", mode, e.toString());
+            return new FaceStreamProvider(Mode.STATIC, Collections.<byte[]>emptyList(), fps, null, now());
+        }
+    }
+
+    public Mode mode() {
+        return mode;
+    }
+
+    /** True when frames come from this provider rather than the static stream image. */
+    public boolean active() {
+        return mode != Mode.STATIC;
+    }
+
+    /** The JPEG for the current moment, or null to fall back to the static image. */
+    public byte[] currentJpeg() {
+        return currentJpeg(now());
+    }
+
+    byte[] currentJpeg(long nowMs) {
+        if (mode == Mode.WEBCAM) return grabWebcam();
+        if (frames.isEmpty()) return null;
+        long index = (nowMs - startedAtMs) / frameIntervalMs;
+        return frames.get((int) (index % frames.size()));
+    }
+
+    int frameCount() {
+        return frames.size();
+    }
+
+    // ------------------------------------------------------------------ loading
+
+    static Mode parseMode(String value) {
+        if (value == null || value.trim().isEmpty()) return Mode.STATIC;
+        try {
+            return Mode.valueOf(value.trim().toUpperCase(Locale.ROOT));
+        } catch (IllegalArgumentException e) {
+            logger.warn("Unknown {}={}, using static", KEY_MODE, value);
+            return Mode.STATIC;
+        }
+    }
+
+    /** Images in name order; JPEGs are used as-is, anything else ImageIO reads is re-encoded as JPEG. */
+    static List<byte[]> loadImages(File imageOrFolder) throws IOException {
+        File[] files = imageOrFolder.isDirectory() ? imageOrFolder.listFiles() : new File[] {imageOrFolder};
+        if (files == null) throw new IOException("Cannot list " + imageOrFolder);
+        Arrays.sort(files);
+        List<byte[]> out = new ArrayList<>();
+        for (File f : files) {
+            String name = f.getName().toLowerCase(Locale.ROOT);
+            if (!f.isFile()) continue;
+            if (name.endsWith(".jpg") || name.endsWith(".jpeg")) {
+                out.add(Files.readAllBytes(f.toPath()));
+            } else if (name.endsWith(".png") || name.endsWith(".bmp")) {
+                BufferedImage img = ImageIO.read(f);
+                if (img != null) out.add(toJpeg(img));
+            }
+        }
+        if (out.isEmpty()) throw new IOException("No JPEG/PNG images in " + imageOrFolder);
+        return out;
+    }
+
+    /**
+     * Splits a recording into JPEG frames: Content-Length framed parts (the /stream wire format the liveness
+     * MjpegRecorder writes) or, when there are no such headers, plain concatenated JPEGs (SOI..EOI).
+     */
+    static List<byte[]> splitRecording(byte[] data) throws IOException {
+        List<byte[]> frames = new ArrayList<>();
+        String ascii = new String(data, StandardCharsets.ISO_8859_1);
+        String lower = ascii.toLowerCase(Locale.ROOT);
+        int pos = 0;
+        while (true) {
+            int h = lower.indexOf("content-length:", pos);
+            if (h < 0) break;
+            int lineEnd = lower.indexOf('\n', h);
+            if (lineEnd < 0) break;
+            int length = Integer.parseInt(ascii.substring(h + "content-length:".length(), lineEnd).trim());
+            if (length <= 0 || length > MAX_FRAME_BYTES) throw new IOException("Bad Content-Length " + length);
+            int body = ascii.indexOf("\r\n\r\n", h);
+            if (body < 0) break;
+            body += 4;
+            if (body + length > data.length) break; // truncated last frame: ignore it
+            frames.add(Arrays.copyOfRange(data, body, body + length));
+            pos = body + length;
+        }
+        if (!frames.isEmpty()) return frames;
+        int i = 0;
+        while (i + 1 < data.length) {
+            if ((data[i] & 0xFF) == 0xFF && (data[i + 1] & 0xFF) == 0xD8) {
+                int j = i + 2;
+                while (j + 1 < data.length && !((data[j] & 0xFF) == 0xFF && (data[j + 1] & 0xFF) == 0xD9)) j++;
+                if (j + 1 >= data.length) break;
+                frames.add(Arrays.copyOfRange(data, i, j + 2));
+                i = j + 2;
+            } else {
+                i++;
+            }
+        }
+        if (frames.isEmpty()) throw new IOException("No JPEG frames found in the recording");
+        return frames;
+    }
+
+    static byte[] toJpeg(BufferedImage img) throws IOException {
+        BufferedImage rgb = img;
+        if (img.getType() != BufferedImage.TYPE_INT_RGB && img.getType() != BufferedImage.TYPE_3BYTE_BGR) {
+            rgb = new BufferedImage(img.getWidth(), img.getHeight(), BufferedImage.TYPE_INT_RGB);
+            rgb.getGraphics().drawImage(img, 0, 0, null);
+        }
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        if (!ImageIO.write(rgb, "jpg", out)) throw new IOException("No JPEG writer");
+        return out.toByteArray();
+    }
+
+    // ------------------------------------------------------------------ webcam
+
+    private static Object openWebcam() {
+        com.github.sarxos.webcam.Webcam cam = com.github.sarxos.webcam.Webcam.getDefault();
+        if (cam == null) throw new IllegalStateException("No webcam found");
+        cam.open();
+        logger.info("Face stream: using webcam {}", cam.getName());
+        return cam;
+    }
+
+    private byte[] grabWebcam() {
+        try {
+            BufferedImage img = ((com.github.sarxos.webcam.Webcam) webcam).getImage();
+            return img == null ? null : toJpeg(img);
+        } catch (Exception e) {
+            logger.error("Webcam frame failed: {}", e.toString());
+            return null;
+        }
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    private static String setting(String key) {
+        String v = System.getProperty(key);
+        return v != null ? v : ApplicationPropertyHelper.getPropertyKeyValue(key);
+    }
+
+    private static String required(String source) {
+        if (source == null || source.trim().isEmpty()) throw new IllegalArgumentException(KEY_SOURCE + " is not set");
+        return source.trim();
+    }
+
+    private static long now() {
+        return System.nanoTime() / 1_000_000L;
+    }
+}
