# Hashed or signed text resources must keep their exact bytes on every OS. On Windows, core.autocrlf=true
# would check them out with CRLF; for example, the checksum of
# liveness-analyzer/src/main/resources/liveness/heuristic-analyzer.properties then no longer matches its manifest.
*.properties text eol=lf
*.manifest   text eol=lf
*.jsonl      text eol=lf
# Part 2: the signed model bundle. manifest.sig signs the exact bytes of manifest.json: no conversion at all.
models/manifest.json -text
models/manifest.sig  -text
# Part 5: the Android integration patches are applied byte for byte by git am / git apply.
android-integration/patches/*.patch -text
android-integration/*.diff          -text
# Binary assets: never convert.
*.onnx   binary
*.tflite binary
*.pth    binary
*.jpg    binary
*.jpeg   binary
*.png    binary
*.mjpeg  binary
# Part 4: overlay copies of the Registration Client's message bundles keep the upstream bytes (CRLF, no final
# newline), so the overlay changes only the appended liveness block.
registration-client/src/main/resources/messages_ar.properties -text
registration-client/src/main/resources/messages_fr.properties -text
# Part 4 (F17, offline model install): the same for the labels, the home page layout and its controller.
registration-client/src/main/resources/labels_en.properties -text
registration-client/src/main/resources/labels_ar.properties -text
registration-client/src/main/resources/labels_fr.properties -text
registration-client/src/main/resources/fxml/RegistrationOfficerPacketLayout.fxml -text
registration-client/src/main/java/io/mosip/registration/controller/reg/PacketHandlerController.java -text
