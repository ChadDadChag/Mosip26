<?xml version="1.0" encoding="UTF-8"?>

<?import io.mosip.registration.controller.liveness.LivenessCameraCard?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Face liveness screen (docs/ui-liveness-spec.md §2 and §9), the same for the resident, operator and supervisor
     flows: camera card, status card, progress row, tips (failure only), and the buttons pinned to the bottom.
     Controller: io.mosip.registration.controller.liveness.LivenessView (set by the loader). -->
<BorderPane fx:id="root" styleClass="liveness-root" prefWidth="720" prefHeight="820"
            xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox styleClass="liveness-header" alignment="CENTER_LEFT">
            <Label fx:id="title" styleClass="liveness-title" />
        </HBox>
    </top>
    <center>
        <VBox fx:id="content" alignment="TOP_CENTER" maxWidth="560">
            <BorderPane.margin><Insets top="16" right="24" left="24" /></BorderPane.margin>

            <!-- The mirrored preview with the face-oval guide and the state badge. -->
            <LivenessCameraCard fx:id="camera" />

            <!-- The status: badge and one message, centred. -->
            <StackPane fx:id="statusCard" styleClass="liveness-status-card">
                <VBox.margin><Insets top="12" /></VBox.margin>
                <HBox fx:id="statusRow" alignment="CENTER" spacing="10">
                    <StackPane fx:id="statusBadge" styleClass="liveness-status-badge" minWidth="28" minHeight="28"
                               maxWidth="28" maxHeight="28">
                        <SVGPath fx:id="statusIcon" styleClass="liveness-badge-icon" scaleX="0.75" scaleY="0.75" />
                    </StackPane>
                    <!-- Not wrapping: LivenessView gives it its lines (as wide as the longest). -->
                    <Label fx:id="status" styleClass="liveness-status" />
                </HBox>
            </StackPane>

            <!-- Guidance or feedback, or the recovery text of a final failure. -->
            <HBox fx:id="hintRow" alignment="CENTER" spacing="6">
                <VBox.margin><Insets top="8" /></VBox.margin>
                <SVGPath fx:id="hintIcon" styleClass="liveness-hint-icon" scaleX="0.75" scaleY="0.75" />
                <Label fx:id="hint" styleClass="liveness-hint" wrapText="true" />
            </HBox>

            <!-- Step i of n, the step bar, Attempt a of m; after a failed attempt only the attempts left. -->
            <StackPane fx:id="progressRow" minHeight="24">
                <VBox.margin><Insets top="8" /></VBox.margin>
                <HBox fx:id="stepRow" alignment="CENTER" spacing="12">
                    <Label fx:id="step" styleClass="liveness-meta" />
                    <HBox fx:id="segments" styleClass="liveness-segments" spacing="4" alignment="CENTER" HBox.hgrow="ALWAYS" />
                    <Label fx:id="attempt" styleClass="liveness-meta" />
                </HBox>
                <Label fx:id="progressText" styleClass="liveness-meta" wrapText="true" />
            </StackPane>

            <!-- Failure only (LIVENESS_NOT_VERIFIED): the problem statement's additional guidance. -->
            <VBox fx:id="tips" styleClass="liveness-tips" spacing="4">
                <VBox.margin><Insets top="12" /></VBox.margin>
            </VBox>
        </VBox>
    </center>
    <bottom>
        <HBox fx:id="buttonRow" alignment="CENTER" spacing="12" styleClass="liveness-buttons">
            <padding><Insets top="8" right="24" bottom="16" left="24" /></padding>
            <Button fx:id="retryButton" styleClass="liveness-button-primary" minHeight="48" onAction="#onRetry" />
            <Button fx:id="cancelButton" styleClass="liveness-button" minHeight="48" onAction="#onCancel"
                    cancelButton="true" />
            <Button fx:id="closeButton" styleClass="liveness-button-primary" minHeight="48" onAction="#onClose" />
        </HBox>
    </bottom>
</BorderPane>
