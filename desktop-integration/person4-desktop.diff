+			camera.preview().setImage(image);
+			showPreview(true, "");
+		}
+		image.getPixelWriter().setPixels(0, 0, f.width(), f.height(), PixelFormat.getByteRgbInstance(), f.rgb(), 0,
+				f.width() * 3);
