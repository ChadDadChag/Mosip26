+		byte[] rgb = f.rgb();
+		for (int y = 0, i = 0; y < f.height(); y++) {
+			for (int x = 0; x < f.width(); x++, i += 3) {
+				img.setRGB(x, y, (rgb[i] & 0xff) << 16 | (rgb[i + 1] & 0xff) << 8 | (rgb[i + 2] & 0xff));
