+		synced.put(LivenessPolicy.PREFIX + "supervisor.challengeTypes", "BLINK,TURN_LEFT");
+		DesktopLivenessConfig c = config(new Properties());
+		LivenessPolicy supervisor = LivenessPolicy.load(c, WorkflowType.SUPERVISOR);
