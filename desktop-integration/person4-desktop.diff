+# ----------------------------------------------------------------------------------------------------------------
+# Face liveness / PAD for the Registration Client (Desktop Part 4, Android Part 5).
+# Append to registration-default.properties in mosip-config. The client syncs it into its local GLOBAL_PARAM table,
+# so every value below also applies offline. A change is used from the next liveness session (no restart).
+# Key reference: docs/part4-desktop-integration.md §5. Any key left out falls back to the client's bundled defaults
+# (the same values as here).
+# ----------------------------------------------------------------------------------------------------------------
+
+# --- Policy, all workflows (mosip.registration.liveness.face.default.*) -------------------------------------------
+# Liveness on/off. false = the legacy capture/authentication flow, unchanged.
+mosip.registration.liveness.face.default.enabled=true
+# Passive: median liveness score over the window >= this passes with no challenge.
+mosip.registration.liveness.face.default.passiveThreshold=0.85
+# Passive: median < this is a presentation attack (generic failure, no challenge offered).
+mosip.registration.liveness.face.default.padRejectThreshold=0.30
+mosip.registration.liveness.face.default.passiveWindowFrames=10
+mosip.registration.liveness.face.default.passiveTimeoutMs=8000
+# Active liveness: false = a score between the two thresholds fails instead of starting a challenge.
+mosip.registration.liveness.face.default.activeEnabled=true
+# Challenge pool (BLINK, SMILE, TURN_LEFT, TURN_RIGHT, LOOK_UP, LOOK_DOWN) and how many are asked per attempt.
+mosip.registration.liveness.face.default.challengeTypes=BLINK,SMILE,TURN_LEFT,TURN_RIGHT
+mosip.registration.liveness.face.default.minChallenges=2
+mosip.registration.liveness.face.default.challengeTimeoutMs=6000
+# Retries after the first attempt (attempts = 1 + maxRetries).
+mosip.registration.liveness.face.default.maxRetries=3
+# Behaviour on repeated failure: BLOCK (recovery guidance) or COOLDOWN (also refuse new sessions for cooldownSec).
+mosip.registration.liveness.face.default.onRepeatedFailure=BLOCK
+mosip.registration.liveness.face.default.cooldownSec=60
+# Diagnostic mode: per-attempt score statistics in the audit trail and an event trace in the client log.
+# Never changes the screen.
+mosip.registration.liveness.face.default.diagnosticMode=false
+mosip.registration.liveness.face.default.analyzeFps=8
+
+# --- Workflow policies (override the default.* keys) --------------------------------------------------------------
+# Operators and supervisors authenticate often: one challenge keeps it quick.
+mosip.registration.liveness.face.operator.minChallenges=1
+mosip.registration.liveness.face.supervisor.minChallenges=1
+# Operator authentication: refuse new attempts for cooldownSec after repeated failures.
+mosip.registration.liveness.face.operator.onRepeatedFailure=COOLDOWN
+# Examples (not set by default):
+# mosip.registration.liveness.face.resident.maxRetries=3
+# mosip.registration.liveness.face.supervisor.challengeTypes=BLINK,TURN_LEFT,TURN_RIGHT
+
+# --- Face binding (F1): the captured face must be the person who passed liveness ----------------------------------
+mosip.registration.liveness.face.binding.enabled=true
+mosip.registration.liveness.face.binding.cosineThreshold=0.45
+
+# --- Identity binding (F15): after a password login's liveness check, the live face must be the user's onboarded face
+# The threshold is provisional (docs/part2-pad-architecture.md section 12.1). requireTemplate=true blocks users
+# without a readable onboarded face on the machine; false lets them in on presence alone (audited NOT_BOUND_*).
+mosip.registration.liveness.face.binding.identity.enabled=true
+mosip.registration.liveness.face.binding.identity.threshold=0.40
+mosip.registration.liveness.face.binding.identity.requireTemplate=false
+
+# --- Desktop client ------------------------------------------------------------------------------------------------
+mosip.registration.liveness.face.desktop.sbi.frameTimeoutMs=15000
+mosip.registration.liveness.face.desktop.sbi.frameStride=1
+mosip.registration.liveness.face.desktop.sbi.maxReconnectAttempts=3
+mosip.registration.liveness.face.desktop.sbi.reconnectBackoffMs=500
+mosip.registration.liveness.face.desktop.autoContinueMs=1000
+# Operator liveness right after a successful password login (as on Android). Skipped when a face login step
+# follows (it runs its own check). false = password login as before.
+mosip.registration.liveness.face.desktop.operator.gatePasswordLogin=true
+# The 200 ms status cross-fade on the liveness screen. false = reduced motion.
+mosip.registration.liveness.face.desktop.animations=true
+mosip.registration.liveness.face.desktop.metricsAuditEvery=20
+# Offline model store (signed bundles only). Empty = <client folder>/.liveness-models
+mosip.registration.liveness.face.desktop.modelStoreDir=
+
+# --- Online model update (as on Android) ---------------------------------------------------------------------------
+# true = after each successful config sync, download a newer signed bundle from the index (latest.json, HTTPS) into
+# the model store above. New sessions use it; running sessions keep their models. Off until MOSIP hosts the bundles.
+mosip.registration.liveness.model.update.enabled=false
+mosip.registration.liveness.model.update.url=
+
+# --- Offline model install (F17) -----------------------------------------------------------------------------------
+# true = supervisors and admins see "Install model bundle" and "Roll back model bundle" in the home page's operational
+# tasks: a signed bundle zip from removable media, verified exactly like an online update. false hides both.
+mosip.registration.liveness.model.offlineInstall.enabled=true
