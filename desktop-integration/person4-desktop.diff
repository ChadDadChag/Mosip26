--- /dev/null
+++ b/registration-client/src/main/resources/liveness.css
@@ -0,0 +1,164 @@
+/* Face liveness screen (docs/ui-liveness-spec.md §2, §7 and §9). Colours always come with an icon and a text.
+   The tokens are the Android client's (LivenessStyle): primary #1C43A1, challenge #E8890C, success #2E7D32,
+   failure #D32F2F, neutral #616161; text #212121 and #616161. */
+
+.liveness-root {
+    -fx-background-color: #ffffff;
+    -fx-font-family: "Roboto", "Segoe UI", "Arial";
+}
+
+.liveness-header {
+    -fx-background-color: #2c3e50;
+    -fx-padding: 14 24 14 24;
+}
+
+.liveness-title {
+    -fx-text-fill: #ffffff;
+    -fx-font-size: 20px;
+    -fx-font-weight: bold;
+}
+
+/* Camera card: 4:3, radius 16 (LivenessCameraCard), 40% scrim outside the oval, 4 px oval. */
+.liveness-preview {
+    -fx-background-color: #616161;
+    -fx-background-radius: 16;
+}
+
+.liveness-preview-placeholder {
+    -fx-text-fill: #ffffff;
+    -fx-font-size: 15px;
+    -fx-text-alignment: center;
+}
+
+.liveness-oval {
+    -fx-fill: transparent;
+    -fx-stroke-width: 4;
+}
+
+.liveness-mask {
+    -fx-fill: rgba(0, 0, 0, 0.40);
+}
+
+/* The state badge, on the oval and in the status card: a 28 px circle in the state colour. */
+.liveness-badge, .liveness-status-badge {
+    -fx-background-radius: 14;
+    -fx-border-color: #ffffff;
+    -fx-border-width: 1.5;
+    -fx-border-radius: 14;
+}
+
+.liveness-badge-icon {
+    -fx-fill: #ffffff;
+}
+
+/* Status card: the state colour at 10%, a 1 px border, radius 12; 20 px semibold, centred, at most 2 lines. */
+.liveness-status-card {
+    -fx-background-radius: 12;
+    -fx-border-radius: 12;
+    -fx-border-width: 1;
+    -fx-padding: 12;
+}
+
+/* Weight 600: JavaFX does not derive Segoe UI's semibold face from -fx-font-weight, so it is named. */
+.liveness-status, .liveness-tips-title, .liveness-button, .liveness-button-primary {
+    -fx-font-family: "Segoe UI Semibold";
+}
+
+.liveness-status {
+    -fx-font-size: 20px;
+    -fx-text-fill: #212121;
+    -fx-text-alignment: center;
+    -fx-alignment: center;
+    -fx-line-spacing: 2;
+}
+
+.liveness-hint {
+    -fx-font-size: 15px;
+    -fx-text-fill: #616161;
+    -fx-text-alignment: center;
+    -fx-alignment: center;
+}
+
+.liveness-hint-icon {
+    -fx-fill: #b26a00;
+}
+
+.liveness-meta {
+    -fx-font-size: 13px;
+    -fx-text-fill: #616161;
+    -fx-text-alignment: center;
+    -fx-alignment: center;
+}
+
+/* Step bar: one segment per challenge; done filled, the current one at least half. */
+.liveness-segment {
+    -fx-background-color: #e0e0e0;
+    -fx-background-radius: 3;
+}
+
+.liveness-segment-fill {
+    -fx-background-color: #1c43a1;
+    -fx-background-radius: 3;
+}
+
+.liveness-tips {
+    -fx-background-color: #f5f5f5;
+    -fx-background-radius: 12;
+    -fx-padding: 10 14 10 14;
+}
+
+.liveness-tips .label {
+    -fx-font-size: 14px;
+    -fx-text-fill: #212121;
+}
+
+/* Buttons: one row, equal widths, 48 high, radius 12; filled for Retry and Close, outlined for Cancel. */
+.liveness-button, .liveness-button-primary {
+    -fx-font-size: 15px;
+    -fx-background-radius: 12;
+    -fx-border-radius: 12;
+    -fx-cursor: hand;
+}
+
+.liveness-button {
+    -fx-background-color: #ffffff;
+    -fx-border-color: #1c43a1;
+    -fx-border-width: 1;
+    -fx-text-fill: #1c43a1;
+}
+
+.liveness-button-primary {
+    -fx-background-color: #1c43a1;
+    -fx-text-fill: #ffffff;
+}
+
+.liveness-button:focused, .liveness-button-primary:focused {
+    -fx-border-color: #e8890c;
+    -fx-border-width: 3;
+}
+
+/* Tones: oval stroke, badges and the status card. */
+.tone-neutral .liveness-oval { -fx-stroke: #616161; }
+.tone-neutral .liveness-badge, .tone-neutral .liveness-status-badge { -fx-background-color: #616161; }
+.tone-neutral .liveness-status-card { -fx-background-color: rgba(97, 97, 97, 0.10); -fx-border-color: #616161; }
+
