--- /dev/null
+++ b/registration-services/src/main/resources/liveness-desktop-default.properties
@@ -0,0 +1,46 @@
+# Face liveness: Desktop defaults, used when the synced global config (the server's registration-default.properties)
+# does not set a key. The policy keys (mosip.registration.liveness.face.<default|resident|operator|supervisor>.*)
+# fall back to the engine's own liveness-default.properties; only Desktop-specific keys live here.
+# Full list and meaning: docs/part4-desktop-integration.md §5.
+
+# F1 face binding: the SBI face that is stored or matched must be the person who passed liveness.
+mosip.registration.liveness.face.binding.enabled=true
+
+# F15 identity binding: after a password login's liveness check, the live face must be the user's face onboarded on
+# this machine (SFace cosine at or above the threshold, provisional). A user without a readable onboarded face gets in
+# on presence alone (audited NOT_BOUND_*), unless requireTemplate=true.
+mosip.registration.liveness.face.binding.identity.enabled=true
+mosip.registration.liveness.face.binding.identity.threshold=0.40
+mosip.registration.liveness.face.binding.identity.requireTemplate=false
+
+# SBI /stream frame source (Part 1 SbiStreamFrameSource)
+mosip.registration.liveness.face.desktop.sbi.frameTimeoutMs=15000
+mosip.registration.liveness.face.desktop.sbi.frameStride=1
+mosip.registration.liveness.face.desktop.sbi.maxReconnectAttempts=3
+mosip.registration.liveness.face.desktop.sbi.reconnectBackoffMs=500
+
+# How long the "Good, face captured successfully" state stays before the flow continues.
+mosip.registration.liveness.face.desktop.autoContinueMs=1000
+
+# Operator liveness right after a successful password login, as on Android (skipped when a face login step follows,
+# which runs its own liveness check). false = password login as before.
+mosip.registration.liveness.face.desktop.operator.gatePasswordLogin=true
+
+# The 200 ms status cross-fade on the liveness screen; false for reduced motion.
+mosip.registration.liveness.face.desktop.animations=true
+
+# Audit an anonymised metrics snapshot (LIVENESS_METRICS) every N completed sessions (0 = never).
+mosip.registration.liveness.face.desktop.metricsAuditEvery=20
+
+# Offline model updates: signed bundles installed here are used when newer than the bundled one.
+# Empty = <user.dir>/.liveness-models
+mosip.registration.liveness.face.desktop.modelStoreDir=
+
+# Online model update, as on Android: after each successful config sync, download a newer signed bundle from the
+# index (latest.json, HTTPS) into the model store above. Off until MOSIP hosts the bundles.
+mosip.registration.liveness.model.update.enabled=false
+mosip.registration.liveness.model.update.url=
+
+# Offline model install (F17): supervisors and admins can install a signed bundle zip from removable media, and roll
+# back, from the home page's operational tasks. The signature and anti-rollback checks make it safe; false hides it.
+mosip.registration.liveness.model.offlineInstall.enabled=true
