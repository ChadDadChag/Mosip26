+	// ---- Part 4 (F17): offline face liveness model install and rollback ----
+
+	/** The two tiles only for supervisors and admins, and only while the feature is on (the actions check it again). */
+	private void showModelBundleTasks() {
+		boolean allowed = false;
+		try {
+			allowed = desktopLivenessService.isOfflineModelInstallAllowed();
+		} catch (RuntimeException e) {
+			LOGGER.error(PACKET_HANDLER, APPLICATION_NAME, APPLICATION_ID, "Liveness model tasks hidden: "
+					+ e.getClass().getSimpleName());
+		}
+		for (GridPane pane : new GridPane[] { installModelBundlePane, rollbackModelBundlePane }) {
+			pane.setVisible(allowed);
+			pane.setManaged(allowed);
+		}
+	}
+
+	/** Picks a signed model bundle zip (removable media) and installs it off the UI thread. */
+	@FXML
+	public void installModelBundle() {
+		if (!desktopLivenessService.isOfflineModelInstallAllowed()) {
+			generateAlert(RegistrationConstants.ERROR, modelBundleText(ModelBundleOutcome.NOT_ALLOWED, null, false));
+			return;
+		}
+		FileChooser chooser = new FileChooser();
+		chooser.setTitle(RegistrationUIConstants.getMessageLanguageSpecific("liveness.model.select_file"));
+		chooser.getExtensionFilters().add(new FileChooser.ExtensionFilter("*.zip", "*.zip"));
+		File zip = chooser.showOpenDialog(fXComponents.getStage());
+		if (zip != null) {
+			runModelBundleAction(() -> desktopLivenessService.installOfflineBundle(zip), false);
+		}
+	}
+
+	/** Rolls back to the previous model bundle, after a confirmation (an explicit operator action). */
+	@FXML
+	public void rollbackModelBundle() {
+		if (!desktopLivenessService.isOfflineModelInstallAllowed()) {
+			generateAlert(RegistrationConstants.ERROR, modelBundleText(ModelBundleOutcome.NOT_ALLOWED, null, true));
+			return;
+		}
+		Alert confirm = createAlert(AlertType.CONFIRMATION,
+				RegistrationUIConstants.getMessageLanguageSpecific(RegistrationUIConstants.INFORMATION),
+				RegistrationUIConstants.getMessageLanguageSpecific("liveness.model.rollback"),
+				RegistrationUIConstants.getMessageLanguageSpecific("liveness.model.confirm_rollback"),
+				RegistrationConstants.PAGE_NAVIGATION_CONFIRM, RegistrationConstants.PAGE_NAVIGATION_CANCEL);
+		Optional<ButtonType> answer = confirm.showAndWait();
+		if (answer.isPresent() && answer.get() == ButtonType.OK) {
+			runModelBundleAction(desktopLivenessService::rollbackModelBundle, true);
+		}
+	}
+
+	/** Runs the install or rollback (it verifies and reloads the models, about 1-2 s) and shows the result. */
+	private void runModelBundleAction(Supplier<ModelBundleResult> action, boolean rollback) {
+		installModelBundlePane.setDisable(true);
+		rollbackModelBundlePane.setDisable(true);
+		Thread worker = new Thread(() -> {
+			ModelBundleResult result = null;
+			try {
+				result = action.get();
+			} catch (RuntimeException e) {
+				LOGGER.error(PACKET_HANDLER, APPLICATION_NAME, APPLICATION_ID, "Liveness model action failed: "
+						+ e.getClass().getSimpleName());
+			}
+			final ModelBundleResult r = result;
+			Platform.runLater(() -> {
+				installModelBundlePane.setDisable(false);
+				rollbackModelBundlePane.setDisable(false);
+				ModelBundleOutcome o = r == null ? ModelBundleOutcome.FAILED : r.outcome();
+				boolean done = o == ModelBundleOutcome.INSTALLED || o == ModelBundleOutcome.ROLLED_BACK;
+				generateAlert(done ? RegistrationConstants.ALERT_INFORMATION : RegistrationConstants.ERROR,
+						modelBundleText(o, r == null ? null : r.toVersion(), rollback));
+			});
+		}, "liveness-model-bundle");
+		worker.setDaemon(true);
+		worker.start();
+	}
+
+	/** The generic, localised text for an outcome: never a path or an exception message. */
+	private static String modelBundleText(ModelBundleOutcome outcome, String version, boolean rollback) {
+		return ModelBundleTexts.fill(RegistrationUIConstants.getMessageLanguageSpecific(
+				ModelBundleTexts.messageKey(outcome, rollback)), version);
+	}
+
 
