<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.mosip.registration</groupId>
        <artifactId>registration-client-parent</artifactId>
        <version>1.2.0.2</version>
    </parent>

    <artifactId>liveness-analyzer</artifactId>
    <name>Registration Liveness Analyzer</name>
    <description>Part 2: passive liveness and PAD analyzer (ONNX Runtime)</description>
    <version>1.2.0.2</version>

    <properties>
        <!-- Same test stack as liveness-core; the parent's surefire 2.22.0 predates these JUnit Platform versions. -->
        <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <assertj.version>3.25.3</assertj.version>
        <onnxruntime.version>1.31.0</onnxruntime.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.mosip.registration</groupId>
            <artifactId>liveness-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.mosip.registration</groupId>
            <artifactId>liveness-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Provided: each app ships its own runtime (desktop: this jar; Android: onnxruntime-android, same API). -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>${onnxruntime.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Only for the JUnit 4 tests moved with the heuristic reference analyzer. -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- Hashed resources must keep their exact bytes. -->
                <filtering>false</filtering>
            </resource>
            <!-- The bundled models (repo-root models/), copied byte-for-byte; never filtered. -->
            <resource>
                <directory>${project.basedir}/../models</directory>
                <targetPath>liveness/models</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>*.onnx</include>
                    <include>manifest.json</include>
                    <include>manifest.sig</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Portability gate: code that ships in the apps may only use APIs present in Java 8 and Android API 21. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>animal-sniffer-maven-plugin</artifactId>
                <version>1.23</version>
                <executions>
                    <execution>
                        <id>java8-api</id>
                        <phase>process-classes</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <signature>
                                <groupId>org.codehaus.mojo.signature</groupId>
                                <artifactId>java18</artifactId>
                                <version>1.0</version>
                            </signature>
                        </configuration>
                    </execution>
                    <execution>
                        <id>android-api</id>
                        <phase>process-classes</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <signature>
                                <groupId>net.sf.androidscents.signature</groupId>
                                <artifactId>android-api-level-21</artifactId>
                                <version>5.0.1_r2</version>
                            </signature>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Coverage gate on top of the parent's JaCoCo agent and report. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${maven.jacoco.version}</version>
                <executions>
                    <execution>
                        <id>coverage-gate</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
