+      tone = LivenessStyle.primary;
+      sentence = 'Checking…';
+      message = 'A face check, then the comparison with the test face';
+    } else if (info != null) {
+      sentence = _identityText(info);
+      if (info.outcome == 'MATCH') {
+        icon = Icons.check_circle;
+        tone = LivenessStyle.success;
+        message = 'This face matches the enrolled test face.';
+      } else if (info.outcome == 'NO_MATCH') {
+        icon = Icons.cancel;
+        tone = LivenessStyle.failure;
+        message = 'This face does not match the enrolled test face.';
+      }
+      detail = _similarityText(info);
+    } else if (_identityProblem != null) {
+      sentence = _identityProblem!;
+    } else {
+      icon = Icons.person_search_outlined;
+      sentence = 'No identity check yet';
+      message = 'After 2. Check identity, the verdict shows here.';
+    }
+    return KeyedSubtree(
+      key: _verdictKey,
+      child: Container(
