+package io.mosip.registration.liveness.android;
+
+import io.mosip.registration.clientmanager.repository.GlobalParamRepository;
+import io.mosip.registration.liveness.api.ConfigProvider;
+
+/**
+ * The engine's config from the client's synced global params ({@code mosip.registration.liveness.*}).
+ * A missing or empty value returns null, so the engine falls back to its bundled defaults.
+ */
+public final class AndroidConfigProvider implements ConfigProvider {
+
+    private final GlobalParamRepository globalParams;
+
+    public AndroidConfigProvider(GlobalParamRepository globalParams) {
+        if (globalParams == null) throw new IllegalArgumentException("globalParams is required");
+        this.globalParams = globalParams;
+    }
+
+    @Override
+    public String get(String key) {
+        String value = globalParams.getCachedStringGlobalParam(key);
+        return value == null || value.trim().isEmpty() ? null : value;
+    }
+}
