+import 'package:flutter/material.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+import 'package:registration_client/ui/liveness/liveness_page.dart';
+
+import 'fake_liveness_service.dart';
+
+class _Launcher extends StatelessWidget {
+  const _Launcher(this.service, this.workflow, this.onResult, {this.useFake = false});
+
+  final LivenessService service;
+  final String workflow;
+  final void Function(LivenessOutcome?) onResult;
+  final bool useFake;
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+        body: Center(
+          child: ElevatedButton(
+            onPressed: () async {
+              final outcome = await Navigator.push<LivenessOutcome>(
+                context,
+                MaterialPageRoute(
+                  builder: (_) => LivenessPage(
+                    workflow: workflow,
+                    service: service,
+                    useFake: useFake,
+                    // The fake engine brings its own placeholder.
+                    previewBuilder: useFake ? null : () => const ColoredBox(color: Colors.grey),
+                  ),
+                ),
+              );
+              onResult(outcome);
+            },
+            child: const Text('open'),
+          ),
+        ),
+      );
+}
+
+void main() {
+  late FakeLivenessService service;
+  LivenessOutcome? outcome;
+  var returned = false;
+
+  setUp(() {
+    service = FakeLivenessService();
+    outcome = null;
+    returned = false;
+  });
+
+  Future<void> open(WidgetTester tester, {String workflow = 'RESIDENT', bool useFake = false}) async {
+    await tester.binding.setSurfaceSize(const Size(411, 891)); // a phone in portrait
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    await tester.pumpWidget(MaterialApp(
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      home: _Launcher(service, workflow, (o) {
+        outcome = o;
+        returned = true;
+      }, useFake: useFake),
+    ));
+    await tester.tap(find.text('open'));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 400)); // route transition and the start-up calls
+  }
+
+  Future<void> send(WidgetTester tester, Map<String, Object?> m) async {
+    service.emit(m);
+    // The first pump delivers the event (a microtask) and schedules a frame; the second draws it.
+    await tester.pump();
+    await tester.pump();
+  }
+
+  Future<void> tapText(WidgetTester tester, String text) async {
+    await tester.ensureVisible(find.text(text));
+    await tester.pump();
+    await tester.tap(find.text(text));
+    await tester.pump();
+  }
+
+  testWidgets('PASS_ACTIVE: the banner follows the script, then the page pops passed', (tester) async {
+    await open(tester);
+    expect(service.started, ['RESIDENT/front/false']);
+    expect(find.text('Face liveness check'), findsOneWidget);
+
+    await send(tester, ev('STARTED'));
+    expect(find.text('Starting face liveness check…'), findsOneWidget);
+    expect(find.text('Attempt 1 of 4'), findsOneWidget);
+    await send(tester, ev('CHECKING_PASSIVE'));
+    expect(find.text('Checking face liveness…'), findsOneWidget);
+    await send(tester, ev('CHALLENGE_PROMPT', challenge: 'BLINK', index: 1, count: 2));
+    expect(find.text('Please blink'), findsOneWidget);
+    expect(find.text('Step 1 of 2'), findsOneWidget);
+    await send(tester, ev('CHALLENGE_PROGRESS', challenge: 'BLINK', index: 1, count: 2, progress: 0.35));
+    expect(find.text('Please blink'), findsOneWidget);
+    expect(find.text('Please continue'), findsOneWidget);
+    await send(tester, ev('ACTION_DETECTED'));
+    expect(find.text('Action detected'), findsOneWidget);
+    await send(tester, ev('CHALLENGE_PROMPT', challenge: 'SMILE', index: 2, count: 2));
+    expect(find.text('Please smile'), findsOneWidget);
+    expect(find.text('Step 2 of 2'), findsOneWidget);
+    await send(tester, ev('ACTION_DETECTED'));
+    await send(tester, ev('HOLD_STILL'));
+    expect(find.text('Hold still'), findsOneWidget);
+    await send(tester, ev('PASSED'));
+    expect(find.text('Good, face captured successfully'), findsOneWidget);
+    expect(find.text('Cancel'), findsNothing);
+    await send(tester, complete('PASSED'));
+
+    await tester.pump(const Duration(milliseconds: 900));
+    expect(returned, isFalse, reason: 'the success state stays about 1 s');
+    await tester.pump(const Duration(milliseconds: 200));
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(returned, isTrue);
+    expect(outcome!.passed, isTrue);
+    expect(outcome!.passPath, 'ACTIVE_CHALLENGE');
+    expect(outcome!.sessionId, 's-1');
+    expect(outcome!.durationMs, 4321);
+    expect(find.text('0.62'), findsNothing);
+  });
+
+  testWidgets('PAD attack: generic text without tips, then max attempts with the recovery text and Close',
+      (tester) async {
+    await open(tester);
+    await send(tester, ev('STARTED'));
+    await send(tester, ev('CHECKING_PASSIVE'));
+    await send(tester, ev('ATTEMPT_FAILED',
+        error: 'PAD_FAILURE', userMessage: 'VERIFICATION_NOT_COMPLETED', retriesLeft: 3));
+    expect(find.text('Face verification could not be completed. Please try again.'), findsOneWidget);
+    expect(find.text('Tips:'), findsNothing);
+    expect(find.text('3 attempt(s) left'), findsOneWidget);
+    expect(find.text('Retry'), findsOneWidget);
+
+    await send(tester, ev('FAILED_FINAL',
+        attempt: 4, error: 'MAX_RETRIES_EXCEEDED', userMessage: 'MAX_ATTEMPTS_REACHED', recoverable: false));
+    await send(tester, complete('FAILED', failureCode: 'MAX_RETRIES_EXCEEDED', userMessage: 'MAX_ATTEMPTS_REACHED'));
+    expect(find.text('Face verification could not be completed.'), findsOneWidget);
+    expect(find.text('Please contact the supervisor. The resident can be registered using the biometric exception process.'),
+        findsOneWidget);
+    expect(find.text('Retry'), findsNothing);
+    expect(find.text('Cancel'), findsNothing);
+    await tapText(tester, 'Close');
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(outcome!.passed, isFalse);
+    expect(outcome!.cancelled, isFalse);
+    expect(outcome!.failureCode, 'MAX_RETRIES_EXCEEDED');
+  });
+
+  testWidgets('LIVENESS_NOT_VERIFIED shows the tips; Retry calls retry()', (tester) async {
+    await open(tester);
+    await send(tester, ev('ATTEMPT_FAILED',
+        error: 'CHALLENGE_TIMEOUT', userMessage: 'LIVENESS_NOT_VERIFIED', retriesLeft: 2));
+    expect(find.text('We could not verify face liveness. Please try again.'), findsOneWidget);
+    expect(find.text('Tips:'), findsOneWidget);
+    expect(find.textContaining('Follow the prompted action.'), findsOneWidget);
+    await tapText(tester, 'Retry');
+    expect(service.retries, 1);
+    await send(tester, ev('STARTED', attempt: 2));
+    expect(find.text('Attempt 2 of 4'), findsOneWidget);
+    expect(find.text('Tips:'), findsNothing);
+
+    await tapText(tester, 'Cancel');
+    await tester.pump(const Duration(milliseconds: 400));
+  });
+
+  testWidgets('Cancel calls cancel() and pops cancelled', (tester) async {
+    await open(tester);
+    await send(tester, ev('STARTED'));
+    await send(tester, ev('CHECKING_PASSIVE'));
+    await tapText(tester, 'Cancel');
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(service.cancels, 1);
+    expect(outcome!.cancelled, isTrue);
+    expect(outcome!.passed, isFalse);
+  });
+
+  testWidgets('back mid-session cancels', (tester) async {
+    await open(tester);
+    await send(tester, ev('CHALLENGE_PROMPT', challenge: 'TURN_LEFT', index: 1, count: 2));
+    expect(find.text('Please turn your head to the left'), findsOneWidget);
+    await tester.pageBack(); // the app bar's back button: Navigator.maybePop, as the system back does
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(service.cancels, 1);
+    expect(outcome!.cancelled, isTrue);
+  });
+
+  testWidgets('a CANCELLED result pops cancelled', (tester) async {
+    await open(tester);
+    await send(tester, ev('STARTED'));
+    await send(tester, complete('CANCELLED', failureCode: 'CANCELLED'));
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(outcome!.cancelled, isTrue);
+    expect(service.cancels, 0);
+  });
+
+  testWidgets('a disabled workflow pops disabled without starting a session', (tester) async {
+    service.enabled = false;
+    await open(tester);
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(returned, isTrue);
+    expect(outcome!.disabled, isTrue);
+    expect(service.started, isEmpty);
+  });
+
+  testWidgets('camera permission refused: device text, recovery text and Close', (tester) async {
+    service.permission = CameraPermission.denied;
+    await open(tester, workflow: 'OPERATOR');
+    expect(service.started, isEmpty);
+    expect(find.text('Operator face verification'), findsOneWidget);
+    expect(find.text('Camera/device not available. Check the connection and try again.'), findsOneWidget);
+    expect(find.text('Please contact your administrator or try again later.'), findsOneWidget);
+    expect(find.text('Open settings'), findsNothing);
+    await tapText(tester, 'Close');
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(outcome!.failureCode, 'CAMERA_UNAVAILABLE');
+    expect(outcome!.userMessage, 'DEVICE_PROBLEM');
+  });
+
+  testWidgets('camera permission permanently refused: Open settings as well', (tester) async {
+    service.permission = CameraPermission.permanentlyDenied;
+    await open(tester);
+    expect(find.text('Camera/device not available. Check the connection and try again.'), findsOneWidget);
+    await tapText(tester, 'Open settings');
+    expect(service.settingsOpened, 1);
+    await tapText(tester, 'Close');
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(outcome!.failureCode, 'CAMERA_UNAVAILABLE');
+  });
+
+  testWidgets('fake engine: no camera permission asked, placeholder preview', (tester) async {
+    service.permission = CameraPermission.denied; // would fail if it were asked
+    await open(tester, useFake: true);
+    expect(service.permissionRequests, 0);
+    expect(service.started, ['RESIDENT/front/true']);
+    expect(find.byType(LivenessPlaceholderPreview), findsOneWidget);
+    await send(tester, ev('PASSED'));
+    await send(tester, complete('PASSED'));
+    await tester.pump(const Duration(milliseconds: 1100));
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(outcome!.passed, isTrue);
+    expect(outcome!.bestFrameJpeg, isNull);
+  });
+
+  testWidgets('guidance shows in the hint line; a result of another session is ignored', (tester) async {
+    await open(tester);
+    await send(tester, ev('CHECKING_PASSIVE'));
+    await send(tester, ev('GUIDANCE', guidance: 'IMPROVE_LIGHTING'));
+    expect(find.text('Please improve the lighting.'), findsOneWidget);
+    expect(find.byIcon(Icons.warning_amber_rounded), findsOneWidget);
+    await send(tester, complete('CANCELLED', sessionId: 'old-session'));
+    expect(returned, isFalse);
+    await tapText(tester, 'Cancel');
+    await tester.pump(const Duration(milliseconds: 600));
+  });
+}
