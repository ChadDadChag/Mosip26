+  Future<void> _identityCheck() async {
+    setState(() {
+      _busy = true;
+      _identityChecking = true;
+      _identityNote = null;
+      _identityInfo = null;
+      _identityProblem = null;
+    });
+    final gate = await LivenessGate.run(context,
+        workflow: LivenessGate.operator, service: _service, previewBuilder: widget.previewBuilder);
+    IdentityCheckInfo? info;
+    String? problem;
+    if (gate.disabled) {
+      problem = 'Liveness is off for operators – nothing compared';
+    } else if (!gate.proceed || gate.sessionId == null) {
+      problem = 'Face check not passed – nothing compared';
+    } else {
+      try {
+        await _api.setIdentityDiagnosticOverride(true);
+        info = await _service.verifyIdentity(gate.sessionId!, _identityTestUser, 'diagnostics', 1);
+      } on PlatformException catch (e) {
+        problem = 'Identity check failed: ${e.message}';
+      } finally {
+        await _api.setIdentityDiagnosticOverride(false);
+      }
+    }
+    await _identityDone(info: info, problem: problem);
+    // The verdict is the answer, not the face check's "captured" screen before it: bring it into view.
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      final panel = _verdictKey.currentContext;
+      if (panel == null) return;
+      Scrollable.ensureVisible(panel,
+          duration: const Duration(milliseconds: 300),
+          curve: Curves.easeOut,
+          alignmentPolicy: ScrollPositionAlignmentPolicy.keepVisibleAtEnd);
+    });
+  }
+
+  Future<void> _identityDelete() async {
+    setState(() {
+      _busy = true;
+      _identityInfo = null;
+      _identityProblem = null;
+    });
+    String note;
+    try {
+      note = await _api.deleteIdentityTestTemplate() ? 'Test face deleted' : 'No test face enrolled';
+    } on PlatformException catch (e) {
+      note = 'Delete failed: ${e.message}';
+    }
+    await _identityDone(note: note);
+  }
+
+  Future<void> _identityDone({String? note, IdentityCheckInfo? info, String? problem}) async {
+    int? enrolledAt = _identityEnrolledAt;
+    try {
+      enrolledAt = await _api.identityTestTemplateTime();
+    } on PlatformException catch (e) {
+      debugPrint('liveness demo: test face status failed: ${e.message}');
+    }
+    if (!mounted) return;
+    setState(() {
+      _busy = false;
+      _identityChecking = false;
+      _identityEnrolledAt = enrolledAt;
+      _identityNote = note;
+      _identityInfo = info;
+      _identityProblem = problem;
+    });
+  }
+
+  /// "Test face enrolled · today 13:16" (or its date), or "No test face enrolled".
+  String _enrolledText() {
+    final at = _identityEnrolledAt;
+    if (at == null) return 'No test face enrolled';
+    // File.lastModified is 0 when the time cannot be read.
+    if (at <= 0) return 'Test face enrolled';
+    final t = DateTime.fromMillisecondsSinceEpoch(at);
+    final now = DateTime.now();
+    String two(int v) => v.toString().padLeft(2, '0');
+    final day = t.year == now.year && t.month == now.month && t.day == now.day
+        ? 'today'
+        : '${t.day} ${_months[t.month - 1]}${t.year == now.year ? '' : ' ${t.year}'}';
+    return 'Test face enrolled · $day ${two(t.hour)}:${two(t.minute)}';
+  }
+
+  /// "Similarity 0.82 · needed 0.40" when faces were compared (the number reaches Dart in diagnostics builds only).
+  static String? _similarityText(IdentityCheckInfo info) {
+    if (info.similarity.isNaN) return null;
+    final similarity = 'Similarity ${info.similarity.toStringAsFixed(2)}';
+    return info.threshold.isNaN ? similarity : '$similarity · needed ${info.threshold.toStringAsFixed(2)}';
+  }
+
+  static String _identityText(IdentityCheckInfo info) {
+    switch (info.outcome) {
+      case 'MATCH':
+        return 'Same person';
+      case 'NO_MATCH':
+        return 'Different person – refused';
+      case 'NOT_BOUND_NO_TEMPLATE':
+        return 'No test face enrolled';
+      case 'NOT_BOUND_UNREADABLE':
+        return 'The test face cannot be read – enroll again';
+      case 'NO_LIVE_FACE':
+        return 'No face found in the check – try again';
+      case 'NO_LIVE_FRAME':
+        return 'No face kept from the check – try again';
+      case 'SKIPPED':
+        return 'The identity check is turned off';
+      default:
+        return 'The comparison failed – try again';
+    }
+  }
