+    @Test
+    public void theFrameIsDroppedAfterTheTtlOnANewSessionAndOnPause() {
+        FaceBinding b = binding();
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        now[0] += FaceBinding.TTL_MS - 1;
+        assertTrue(b.holding());
+        now[0] += 1;
+        assertFalse(b.holding());
+        assertEquals(FaceBinding.Arm.REJECTED, b.arm("s1"));
