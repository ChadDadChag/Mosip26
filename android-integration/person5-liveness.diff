diff --git a/android/liveness/src/test/java/io/mosip/registration/liveness/device/android/CameraXFrameSourceConversionTest.java b/android/liveness/src/test/java/io/mosip/registration/liveness/device/android/CameraXFrameSourceConversionTest.java
new file mode 100644
index 0000000..12f9157
--- /dev/null
+++ b/android/liveness/src/test/java/io/mosip/registration/liveness/device/android/CameraXFrameSourceConversionTest.java
@@ -0,0 +1,194 @@
+package io.mosip.registration.liveness.device.android;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotSame;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import android.content.Context;
+import android.util.Size;
+
+import androidx.camera.core.CameraSelector;
+import androidx.camera.core.ImageProxy;
+import androidx.lifecycle.LifecycleOwner;
+
+import org.junit.Test;
+
+import java.nio.ByteBuffer;
+import java.util.Random;
+
+/**
+ * The fixed-point, bulk-copy YUV_420_888 conversion against the straightforward double-precision
+ * BT.601 conversion with per-pixel rotation (the previous implementation), on synthetic planes with
+ * row padding, for planar (pixel stride 1) and interleaved (pixel stride 2) chroma.
+ */
+public class CameraXFrameSourceConversionTest {
+
+    private static final int WIDTH = 6;
+    private static final int HEIGHT = 4;
+
+    @Test
+    public void planarChromaWithRowPaddingMatchesTheReference() {
+        Planes p = planar(new Random(1), WIDTH, HEIGHT, 8, 5);
+        for (int rotation : new int[]{0, 90, 180, 270}) {
+            assertClose(rotation, reference(p, rotation), source().yuv420ToRgb888(p.image(), rotation));
+        }
+    }
+
+    @Test
+    public void interleavedChromaMatchesTheReference() {
+        Planes p = interleaved(new Random(2), WIDTH, HEIGHT, 8, 8);
+        for (int rotation : new int[]{0, 90, 180, 270}) {
+            assertClose(rotation, reference(p, rotation), source().yuv420ToRgb888(p.image(), rotation));
+        }
+    }
+
+    @Test
+    public void saturatedColoursAreClamped() {
+        Planes p = planar(new Random(3), WIDTH, HEIGHT, WIDTH, WIDTH / 2);
+        java.util.Arrays.fill(p.y, (byte) 255);
+        java.util.Arrays.fill(p.v, (byte) 255);
+        byte[] rgb = source().yuv420ToRgb888(p.image(), 0);
+        for (int i = 0; i < rgb.length; i += 3) assertEquals(255, rgb[i] & 0xFF);
+    }
+
+    @Test
+    public void eachFrameGetsItsOwnOutputArray() {
+        Planes p = planar(new Random(4), WIDTH, HEIGHT, WIDTH, WIDTH / 2);
+        CameraXFrameSource source = source();
+        byte[] first = source.yuv420ToRgb888(p.image(), 90);
+        byte[] second = source.yuv420ToRgb888(p.image(), 90);
+        assertNotSame(first, second);
+        assertEquals(WIDTH * HEIGHT * 3, first.length);
+    }
+
+    private static CameraXFrameSource source() {
+        Context context = mock(Context.class);
+        when(context.getApplicationContext()).thenReturn(context);
+        return new CameraXFrameSource(context, mock(LifecycleOwner.class), CameraSelector.DEFAULT_FRONT_CAMERA,
+                new Size(640, 480));
+    }
+
+    private static void assertClose(int rotation, byte[] expected, byte[] actual) {
+        assertEquals(expected.length, actual.length);
+        for (int i = 0; i < expected.length; i++) {
+            int diff = Math.abs((expected[i] & 0xFF) - (actual[i] & 0xFF));
+            assertTrue("rotation " + rotation + " byte " + i + " differs by " + diff, diff <= 1);
+        }
+    }
+
+    /** Double-precision BT.601 with rounding and the per-pixel rotation mapping. */
+    private static byte[] reference(Planes p, int rotation) {
+        int w = p.width;
+        int h = p.height;
+        int outWidth = (rotation == 90 || rotation == 270) ? h : w;
+        byte[] rgb = new byte[w * h * 3];
+        for (int row = 0; row < h; row++) {
+            for (int col = 0; col < w; col++) {
+                int y = p.y[row * p.yRowStride + col] & 0xFF;
+                int u = (p.uAt(row / 2, col / 2) & 0xFF) - 128;
+                int v = (p.vAt(row / 2, col / 2) & 0xFF) - 128;
+                int r = clamp(Math.round(y + 1.402 * v));
+                int g = clamp(Math.round(y - 0.344136 * u - 0.714136 * v));
+                int b = clamp(Math.round(y + 1.772 * u));
+                int outX;
+                int outY;
+                switch (rotation) {
+                    case 90:  outX = h - 1 - row; outY = col; break;
+                    case 180: outX = w - 1 - col; outY = h - 1 - row; break;
+                    case 270: outX = row;         outY = w - 1 - col; break;
+                    default:  outX = col;         outY = row; break;
+                }
+                int i = (outY * outWidth + outX) * 3;
+                rgb[i] = (byte) r;
+                rgb[i + 1] = (byte) g;
+                rgb[i + 2] = (byte) b;
+            }
+        }
+        return rgb;
+    }
+
+    private static int clamp(long v) {
+        return (int) Math.max(0, Math.min(255, v));
+    }
+
+    private static Planes planar(Random random, int w, int h, int yRowStride, int uvRowStride) {
+        Planes p = new Planes(w, h, yRowStride, uvRowStride, 1);
+        p.y = randomBytes(random, yRowStride * h);
+        p.u = randomBytes(random, uvRowStride * (h / 2));
+        p.v = randomBytes(random, uvRowStride * (h / 2));
+        p.uBuffer = ByteBuffer.wrap(p.u);
+        p.vBuffer = ByteBuffer.wrap(p.v);
+        return p;
+    }
+
+    /** NV21-style: one VU-interleaved block; the U plane starts one byte after the V plane, as on most phones. */
+    private static Planes interleaved(Random random, int w, int h, int yRowStride, int uvRowStride) {
+        Planes p = new Planes(w, h, yRowStride, uvRowStride, 2);
+        p.y = randomBytes(random, yRowStride * h);
+        byte[] vu = randomBytes(random, uvRowStride * (h / 2));
+        p.v = vu;
+        p.u = vu;
+        p.uOffset = 1;
+        p.vBuffer = ByteBuffer.wrap(vu, 0, vu.length - 1).slice();
+        p.uBuffer = ByteBuffer.wrap(vu, 1, vu.length - 1).slice();
+        return p;
+    }
+
+    private static byte[] randomBytes(Random random, int n) {
+        byte[] b = new byte[n];
+        random.nextBytes(b);
+        return b;
+    }
+
+    private static final class Planes {
+        final int width;
+        final int height;
+        final int yRowStride;
+        final int uvRowStride;
+        final int uvPixelStride;
+        byte[] y;
+        byte[] u;
+        byte[] v;
+        int uOffset;
+        ByteBuffer uBuffer;
+        ByteBuffer vBuffer;
+
+        Planes(int width, int height, int yRowStride, int uvRowStride, int uvPixelStride) {
+            this.width = width;
+            this.height = height;
+            this.yRowStride = yRowStride;
+            this.uvRowStride = uvRowStride;
+            this.uvPixelStride = uvPixelStride;
+        }
+
+        byte uAt(int row, int col) {
+            return u[uOffset + row * uvRowStride + col * uvPixelStride];
+        }
+
+        byte vAt(int row, int col) {
+            return v[row * uvRowStride + col * uvPixelStride];
+        }
+
+        ImageProxy image() {
+            ImageProxy image = mock(ImageProxy.class);
+            when(image.getWidth()).thenReturn(width);
+            when(image.getHeight()).thenReturn(height);
+            ImageProxy.PlaneProxy[] planes = {
+                    plane(ByteBuffer.wrap(y), yRowStride, 1),
+                    plane(uBuffer, uvRowStride, uvPixelStride),
+                    plane(vBuffer, uvRowStride, uvPixelStride)};
+            when(image.getPlanes()).thenReturn(planes);
+            return image;
+        }
+
+        private static ImageProxy.PlaneProxy plane(ByteBuffer buffer, int rowStride, int pixelStride) {
+            ImageProxy.PlaneProxy plane = mock(ImageProxy.PlaneProxy.class);
+            when(plane.getBuffer()).thenReturn(buffer);
+            when(plane.getRowStride()).thenReturn(rowStride);
+            when(plane.getPixelStride()).thenReturn(pixelStride);
+            return plane;
+        }
+    }
+}
diff --git a/android/liveness/src/test/java/io/mosip/registration/liveness/device/android/CameraXFrameSourcePacingTest.java b/android/liveness/src/test/java/io/mosip/registration/liveness/device/android/CameraXFrameSourcePacingTest.java
