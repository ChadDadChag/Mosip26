+    'FAIL_CHALLENGE_THEN_PASS_ON_RETRY',
+    'PAD_ATTACK',
+    'CHALLENGE_TIMEOUT',
+    'NO_FACE_THEN_PASS',
+    'MULTIPLE_FACES',
+    'POOR_LIGHTING_HINTS',
