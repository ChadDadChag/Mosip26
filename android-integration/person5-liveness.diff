+    @Before
+    public void setUp() {
+        when(context.getApplicationContext()).thenReturn(context);
+        when(context.getAssets()).thenReturn(mock(AssetManager.class));
+        when(context.getFilesDir()).thenReturn(files.getRoot());
+        when(globalParams.getCachedStringGlobalParam(anyString())).thenAnswer(i -> synced.get(i.<String>getArgument(0)));
+        holder = new LivenessServiceHolder(context, globalParams, auditManager);
+    }
+
+    private final AuditManagerService auditManager = mock(AuditManagerService.class);
+
+    @Test
+    public void aModelUpdateCheckNeedsUpdatesEnabledWithAValidUrl() {
+        assertUpdateRefused("disabled");
+        holder.setOverride(ModelUpdates.ENABLED_KEY, "true");
+        assertUpdateRefused("no " + ModelUpdates.URL_KEY);
+        holder.setOverride(ModelUpdates.URL_KEY, "not a url");
+        assertUpdateRefused("not a valid URL");
+        // Not a diagnostics build: plain HTTP is refused before any connection, and the outcome is audited.
+        holder.setOverride(ModelUpdates.URL_KEY, "http://127.0.0.1:9/latest.json");
+        ModelUpdater.UpdateResult r = holder.checkModelUpdate("manual");
+        assertEquals(ModelUpdater.Status.FAILED, r.status());
+        assertEquals(ModelUpdater.Reason.INSECURE_TRANSPORT, r.reason());
+        verify(auditManager, timeout(2000)).audit(eq(AuditEvent.LIVENESS_MODEL_UPDATE), eq(Components.HOME),
+                startsWith("outcome=FAILED;reason=INSECURE_TRANSPORT;durationMs="));
+    }
+
+    private void assertUpdateRefused(String message) {
+        try {
+            holder.checkModelUpdate("manual");
+            fail("expected a refusal: " + message);
+        } catch (IllegalStateException e) {
+            assertTrue(e.getMessage(), e.getMessage().contains(message));
+        }
+    }
+
+    @Test
+    public void anOverrideChangesThePolicy() {
+        assertEquals(3, holder.policy(WorkflowType.RESIDENT).maxRetries);
+        holder.setOverride(FACE + "default.maxRetries", "1");
+        assertEquals(1, holder.policy(WorkflowType.RESIDENT).maxRetries);
+        holder.setOverride(FACE + "default.maxRetries", "");
+        assertEquals(3, holder.policy(WorkflowType.RESIDENT).maxRetries);
+    }
+
+    @Test
+    public void aSyncedValueAppliesAfterTheRefreshListenerRuns() {
+        ArgumentCaptor<Runnable> listener = ArgumentCaptor.forClass(Runnable.class);
+        verify(globalParams).addRefreshListener(listener.capture());
+        assertEquals(2, holder.policy(WorkflowType.RESIDENT).minChallenges);
