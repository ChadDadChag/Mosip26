+++ b/android/liveness/src/test/java/io/mosip/registration/liveness/android/LivenessMetricsStoreTest.java
@@ -0,0 +1,174 @@
+package io.mosip.registration.liveness.android;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+
+import android.content.SharedPreferences;
+
+import org.junit.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Set;
+
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.LivenessResult;
+import io.mosip.registration.liveness.core.metrics.LivenessMetrics;
+
+public class LivenessMetricsStoreTest {
+
+    private final MapPrefs prefs = new MapPrefs();
+    private final LivenessMetricsStore store = new LivenessMetricsStore(prefs);
+
+    @Test
+    public void eachCountIsAddedOnce() {
+        LivenessMetrics m = new LivenessMetrics();
+        m.sessionStarted();
+        m.frameAnalyzed(30);
+        m.passed(LivenessResult.PassPath.PASSIVE_ONLY);
+        store.merge(m);
+        store.merge(m); // nothing new
+        m.sessionStarted();
+        m.attemptFailed(ErrorCode.CHALLENGE_TIMEOUT);
+        m.retryStarted();
+        m.failedFinal(ErrorCode.MAX_RETRIES_EXCEEDED);
+        m.frameAnalyzed(50);
+        store.merge(m);
+
+        assertEquals(2, store.count("sessions"));
+        assertEquals(1, store.count("passedPassive"));
+        assertEquals(1, store.count("failedFinal"));
+        assertEquals(1, store.count("retries"));
+        assertEquals(80, store.count("processingMsTotal"));
+        Map<String, String> d = store.derived();
+        assertEquals("40.000", d.get("avgProcessingMs"));
+        assertEquals("0.500", d.get("failureRate"));
+        assertEquals("0.500", d.get("retryRate"));
+        assertEquals("1.000", d.get("passiveShare"));
+        assertEquals("1", d.get("finalFailure.MAX_RETRIES_EXCEEDED"));
+        assertEquals("1", d.get("attemptFailure.CHALLENGE_TIMEOUT"));
+    }
+
+    @Test
+    public void mergesAcrossTwoServices() {
+        LivenessMetrics a = new LivenessMetrics(), b = new LivenessMetrics();
+        a.sessionStarted();
+        a.passed(LivenessResult.PassPath.PASSIVE_ONLY);
+        store.merge(a);
+        b.sessionStarted();
+        b.passed(LivenessResult.PassPath.ACTIVE_CHALLENGE);
+        b.challengeDetected(1200);
+        store.merge(b);
+        a.sessionStarted();
+        a.failedFinal(ErrorCode.PAD_FAILURE);
+        store.merge(a);
+        b.sessionStarted();
+        b.failedFinal(ErrorCode.PAD_FAILURE);
+        store.merge(b);
+
+        assertEquals(4, store.count("sessions"));
+        assertEquals(1, store.count("passedPassive"));
+        assertEquals(1, store.count("passedActive"));
+        assertEquals(2, store.count("failedFinal"));
+        Map<String, String> d = store.derived();
+        assertEquals("2", d.get("finalFailure.PAD_FAILURE"));
+        assertEquals("0.500", d.get("passiveShare"));
+        assertEquals("1200.000", d.get("avgChallengeCompletionMs"));
+    }
+
+    @Test
+    public void totalsSurviveANewStoreAndANewService() {
+        LivenessMetrics first = new LivenessMetrics();
+        first.sessionStarted();
+        first.cancelled();
+        store.merge(first);
+
+        // App restart: new store object on the same preferences, new service counting from zero.
+        LivenessMetricsStore again = new LivenessMetricsStore(prefs);
+        assertEquals(1, again.count("sessions"));
+        LivenessMetrics second = new LivenessMetrics();
+        second.sessionStarted();
+        again.merge(second);
+        assertEquals(2, again.count("sessions"));
+        assertEquals(1, again.count("cancelled"));
+    }
+
+    @Test
+    public void resetClearsAndDoesNotAddOldCountsAgain() {
+        LivenessMetrics m = new LivenessMetrics();
+        m.sessionStarted();
+        m.failedFinal(ErrorCode.CHALLENGE_FAILED);
+        store.merge(m);
+        store.reset();
+        assertEquals(0, store.count("sessions"));
+        assertFalse(store.derived().containsKey("finalFailure.CHALLENGE_FAILED"));
+        assertEquals("NaN", store.derived().get("failureRate"));
+
+        store.merge(m); // unchanged since the last merge
+        assertEquals(0, store.count("sessions"));
+        m.sessionStarted();
+        store.merge(m);
+        assertEquals(1, store.count("sessions"));
+        assertEquals(0, store.count("failedFinal"));
+    }
+
+    @Test
+    public void storesNoIdentifiersOrTimes() {
+        LivenessMetrics m = new LivenessMetrics();
+        m.sessionStarted();
+        m.passed(LivenessResult.PassPath.PASSIVE_ONLY);
+        m.attemptFailed(ErrorCode.FACE_NOT_DETECTED);
+        store.merge(m);
+        for (Map.Entry<String, ?> e : prefs.getAll().entrySet()) {
+            boolean known = e.getKey().startsWith("count.") || e.getKey().startsWith("finalFailure.")
+                    || e.getKey().startsWith("attemptFailure.");
+            assertEquals(e.getKey(), true, known);
+            assertEquals(e.getKey(), Long.class, e.getValue().getClass());
+        }
+    }
+
+    /** In-memory SharedPreferences: edits apply on commit()/apply(), like the real one. */
+    static final class MapPrefs implements SharedPreferences {
+        final Map<String, Object> values = new HashMap<>();
+
+        @Override public Map<String, ?> getAll() { return new HashMap<>(values); }
+        @Override public String getString(String k, String d) { return values.containsKey(k) ? (String) values.get(k) : d; }
+        @SuppressWarnings("unchecked")
+        @Override public Set<String> getStringSet(String k, Set<String> d) { return values.containsKey(k) ? (Set<String>) values.get(k) : d; }
+        @Override public int getInt(String k, int d) { return values.containsKey(k) ? (Integer) values.get(k) : d; }
+        @Override public long getLong(String k, long d) { return values.containsKey(k) ? (Long) values.get(k) : d; }
+        @Override public float getFloat(String k, float d) { return values.containsKey(k) ? (Float) values.get(k) : d; }
+        @Override public boolean getBoolean(String k, boolean d) { return values.containsKey(k) ? (Boolean) values.get(k) : d; }
+        @Override public boolean contains(String k) { return values.containsKey(k); }
+        @Override public void registerOnSharedPreferenceChangeListener(OnSharedPreferenceChangeListener l) { }
+        @Override public void unregisterOnSharedPreferenceChangeListener(OnSharedPreferenceChangeListener l) { }
+
+        @Override
+        public Editor edit() {
+            return new Editor() {
+                final Map<String, Object> puts = new HashMap<>();
+                boolean clear;
+
+                @Override public Editor putString(String k, String v) { puts.put(k, v); return this; }
+                @Override public Editor putStringSet(String k, Set<String> v) { puts.put(k, v); return this; }
+                @Override public Editor putInt(String k, int v) { puts.put(k, v); return this; }
+                @Override public Editor putLong(String k, long v) { puts.put(k, v); return this; }
+                @Override public Editor putFloat(String k, float v) { puts.put(k, v); return this; }
+                @Override public Editor putBoolean(String k, boolean v) { puts.put(k, v); return this; }
+                @Override public Editor remove(String k) { puts.put(k, null); return this; }
+                @Override public Editor clear() { clear = true; return this; }
+
+                @Override
+                public boolean commit() {
+                    if (clear) values.clear();
+                    for (Map.Entry<String, Object> e : puts.entrySet()) {
+                        if (e.getValue() == null) values.remove(e.getKey()); else values.put(e.getKey(), e.getValue());
+                    }
+                    return true;
+                }
+
+                @Override public void apply() { commit(); }
+            };
+        }
+    }
+}
diff --git a/android/liveness/src/test/java/io/mosip/registration/liveness/android/LivenessOfflineModelInstallTest.java b/android/liveness/src/test/java/io/mosip/registration/liveness/android/LivenessOfflineModelInstallTest.java
new file mode 100644
index 0000000..b55f54d
--- /dev/null
+++ b/android/liveness/src/test/java/io/mosip/registration/liveness/android/LivenessOfflineModelInstallTest.java
@@ -0,0 +1,315 @@
+package io.mosip.registration.liveness.android;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.ArgumentMatchers.argThat;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.timeout;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import android.content.Context;
+import android.content.res.AssetManager;
+
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.security.MessageDigest;
+import java.security.Signature;
+import java.security.spec.ECGenParameterSpec;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+import io.mosip.registration.clientmanager.constant.AuditEvent;
+import io.mosip.registration.clientmanager.constant.Components;
+import io.mosip.registration.clientmanager.repository.GlobalParamRepository;
+import io.mosip.registration.clientmanager.spi.AuditManagerService;
+import io.mosip.registration.liveness.analyzer.integrity.DirectoryBundleSource;
+import io.mosip.registration.liveness.analyzer.integrity.TrustedKeys;
+import io.mosip.registration.liveness.analyzer.runtime.ModelRole;
+import io.mosip.registration.liveness.android.LivenessServiceHolder.ModelBundleOutcome;
+import io.mosip.registration.liveness.android.LivenessServiceHolder.ModelBundleResult;
+
+/**
+ * F17: the production offline model install and rollback, end to end with the real models re-signed with a throwaway
+ * key (no development key in tests): install and reload, refusals that leave the store unchanged (a tampered zip is
+ * invalid whatever version it claims), rollback, the role gate, the debug builds' role override (ignored by release
+ * builds) and the config switch, and the REG-EVT-019 audit (codes, versions and the user id only).
+ */
+public class LivenessOfflineModelInstallTest {
+
+    private static final String KEY_ID = "android-test-key";
+    private static final String BUNDLED = "pad-2026.10.5";
+    private static final String NEWER = "pad-2026.10.6";
+    private static final File ASSET_MODELS = new File("src/main/assets/liveness/models");
+
+    @Rule
+    public TemporaryFolder files = new TemporaryFolder();
+
+    private final Map<String, String> synced = new HashMap<>();
+    private final GlobalParamRepository globalParams = mock(GlobalParamRepository.class);
+    private final AuditManagerService auditManager = mock(AuditManagerService.class);
+    private KeyPair kp;
+    private Context context;
+    private File bundled;
+    private LivenessServiceHolder holder;
+    private boolean supervisor = true;
+
+    @Before
+    public void setUp() throws Exception {
+        context = mock(Context.class);
+        when(context.getApplicationContext()).thenReturn(context);
+        when(context.getAssets()).thenReturn(mock(AssetManager.class));
+        when(context.getFilesDir()).thenReturn(files.newFolder("files"));
+        when(globalParams.getCachedStringGlobalParam(anyString())).thenAnswer(i -> synced.get(i.<String>getArgument(0)));
+        KeyPairGenerator g = KeyPairGenerator.getInstance("EC");
+        g.initialize(new ECGenParameterSpec("secp256r1"));
+        kp = g.generateKeyPair();
+        bundled = files.newFolder("bundled");
+        for (Map.Entry<String, byte[]> e : bundle(BUNDLED).entrySet()) {
+            Files.write(new File(bundled, e.getKey()).toPath(), e.getValue());
+        }
+        holder = holder(false); // a release build
+    }
+
+    /** A holder as a release ({@code diagnostics} false) or a debug/profile build makes it, with the test user. */
+    private LivenessServiceHolder holder(boolean diagnostics) {
+        LivenessServiceHolder h = new LivenessServiceHolder(context, globalParams, auditManager, diagnostics,
+                new DirectoryBundleSource(bundled), new TrustedKeys(Collections.singletonMap(KEY_ID, kp.getPublic())));
+        h.setModelBundleUser(new LivenessServiceHolder.ModelBundleUser() {
+            @Override public boolean maySupervise() {
+                return supervisor;
+            }
+
+            @Override public String id() {
+                return "sup-17";
+            }
+        });
+        return h;
+    }
+
+    /** manifest.json, manifest.sig and the real models, as bundle {@code version} signed with the throwaway key. */
+    private Map<String, byte[]> bundle(String version) throws Exception {
+        StringBuilder list = new StringBuilder();
+        Map<String, byte[]> models = new LinkedHashMap<>();
+        for (ModelRole role : ModelRole.values()) {
+            byte[] b = Files.readAllBytes(new File(ASSET_MODELS, role.fileName()).toPath());
+            models.put(role.fileName(), b);
+            list.append(list.length() == 0 ? "" : ",\n").append("    {\"role\": \"").append(role.name())
+                    .append("\", \"name\": \"").append(role.fileName()).append("\", \"size\": ").append(b.length)
+                    .append(", \"sha256\": \"").append(hex(MessageDigest.getInstance("SHA-256").digest(b))).append("\"}");
+        }
+        byte[] manifest = ("{\n  \"schema\": 1,\n  \"bundleVersion\": \"" + version + "\",\n  \"keyId\": \"" + KEY_ID
+                + "\",\n  \"createdUtc\": \"2026-10-27T00:00:00Z\",\n  \"params\": { \"pitchBiasDeg\": -9.5 },\n"
+                + "  \"files\": [\n" + list + "\n  ]\n}\n").getBytes(StandardCharsets.UTF_8);
+        Signature s = Signature.getInstance("SHA256withECDSA");
+        s.initSign(kp.getPrivate());
+        s.update(manifest);
+        Map<String, byte[]> out = new LinkedHashMap<>();
+        out.put("manifest.json", manifest);
+        out.put("manifest.sig", (KEY_ID + ":" + hex(s.sign()) + "\n").getBytes(StandardCharsets.US_ASCII));
+        out.putAll(models);
+        return out;
+    }
+
+    /** A zip of these entries, in order (manifest.json first, as ModelBundleTool pack writes it). */
+    private File zip(String name, Map<String, byte[]> entries) throws IOException {
+        File f = files.newFile(name);
+        try (ZipOutputStream z = new ZipOutputStream(new FileOutputStream(f))) {
+            for (Map.Entry<String, byte[]> e : entries.entrySet()) {
+                z.putNextEntry(new ZipEntry(e.getKey()));
+                z.write(e.getValue());
+                z.closeEntry();
+            }
+        }
+        return f;
+    }
+
+    private static String hex(byte[] b) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : b) sb.append(String.format("%02x", x & 0xff));
+        return sb.toString();
+    }
+
+    private void verifyAudit(String... parts) {
+        verifyAudits(1, parts);
+    }
+
+    /** Exactly {@code count} REG-EVT-019 records contain every part, and none of them a path. */
+    private void verifyAudits(int count, String... parts) {
+        verify(auditManager, timeout(5000).times(count)).audit(eq(AuditEvent.LIVENESS_MODEL_UPDATE), eq(Components.HOME),
+                argThat(text -> {
+                    for (String p : parts) if (!text.contains(p)) return false;
