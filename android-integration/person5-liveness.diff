+package io.mosip.registration.liveness.android;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+
+import io.mosip.registration.liveness.api.ChallengeType;
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.LivenessEvent;
+import io.mosip.registration.liveness.api.LivenessResult;
+
+public class LivenessMapsTest {
+
+    private static final List<String> EVENT_KEYS = Arrays.asList("kind", "type", "guidance", "challenge",
+            "challengeIndex", "challengeCount", "timeoutMs", "progress", "error", "userMessage", "attemptNumber",
+            "retriesLeft", "recoverable");
+    private static final List<String> RESULT_KEYS = Arrays.asList("kind", "decision", "passPath", "failureCode",
+            "userMessage", "passiveScore", "challengesIssued", "attempts", "durationMs", "sessionId", "modelVersion",
+            "bestFrameJpeg");
+
+    @Test
+    public void eventHasEveryKeyAndNamesForEnums() {
+        Map<String, Object> m = LivenessMaps.event(LivenessEvent.of(LivenessEvent.Type.STARTED, 1));
+        assertEquals(new HashSet<>(EVENT_KEYS), m.keySet());
+        assertEquals("event", m.get("kind"));
+        assertEquals("STARTED", m.get("type"));
+        assertNull(m.get("guidance"));
+        assertNull(m.get("challenge"));
+        assertNull(m.get("error"));
+        assertNull(m.get("userMessage"));
+        assertEquals(1, m.get("attemptNumber"));
+        assertEquals(Boolean.TRUE, m.get("recoverable"));
+    }
+
+    @Test
+    public void guidanceEvent() {
+        Map<String, Object> m = LivenessMaps.event(LivenessEvent.guidance(LivenessEvent.Guidance.MOVE_CLOSER, 2));
+        assertEquals("GUIDANCE", m.get("type"));
+        assertEquals("MOVE_CLOSER", m.get("guidance"));
+        assertEquals(2, m.get("attemptNumber"));
+    }
+
+    @Test
+    public void challengePromptAndProgress() {
+        Map<String, Object> prompt = LivenessMaps.event(LivenessEvent.prompt(ChallengeType.TURN_LEFT, 1, 2, 6000L, 1));
+        assertEquals("CHALLENGE_PROMPT", prompt.get("type"));
+        assertEquals("TURN_LEFT", prompt.get("challenge"));
+        assertEquals(1, prompt.get("challengeIndex"));
+        assertEquals(2, prompt.get("challengeCount"));
+        assertEquals(6000L, prompt.get("timeoutMs"));
+
+        Map<String, Object> progress = LivenessMaps.event(LivenessEvent.progress(ChallengeType.BLINK, 0, 2, 0.5f, 1));
+        assertEquals("CHALLENGE_PROGRESS", progress.get("type"));
+        assertEquals(0.5, (Double) progress.get("progress"), 1e-9);
+    }
+
+    @Test
+    public void failureEventCarriesTheUserMessage() {
+        Map<String, Object> m = LivenessMaps.event(
+                LivenessEvent.failure(LivenessEvent.Type.ATTEMPT_FAILED, ErrorCode.PAD_FAILURE, 1, 2, true));
+        assertEquals("ATTEMPT_FAILED", m.get("type"));
+        assertEquals("PAD_FAILURE", m.get("error"));
+        assertEquals("VERIFICATION_NOT_COMPLETED", m.get("userMessage"));
+        assertEquals(2, m.get("retriesLeft"));
+
+        Map<String, Object> device = LivenessMaps.event(
+                LivenessEvent.failure(LivenessEvent.Type.DEVICE_ERROR, ErrorCode.CAMERA_UNAVAILABLE, 1, 0, false));
+        assertEquals("DEVICE_PROBLEM", device.get("userMessage"));
+        assertEquals(Boolean.FALSE, device.get("recoverable"));
+    }
+
+    @Test
+    public void passedResultKeepsTheBestFrame() {
+        byte[] jpeg = {(byte) 0xFF, (byte) 0xD8, 1, 2};
+        LivenessResult r = new LivenessResult(LivenessResult.Decision.PASSED, LivenessResult.PassPath.ACTIVE_CHALLENGE,
+                null, null, 0.62f, Arrays.asList(ChallengeType.BLINK, ChallengeType.TURN_RIGHT), 1, 4200L, "s-1", "pad-2026.10.1");
+        Map<String, Object> m = LivenessMaps.result(r, jpeg);
+        assertEquals(new HashSet<>(RESULT_KEYS), m.keySet());
+        assertEquals("complete", m.get("kind"));
+        assertEquals("PASSED", m.get("decision"));
+        assertEquals("ACTIVE_CHALLENGE", m.get("passPath"));
+        assertNull(m.get("failureCode"));
+        assertEquals("NONE", m.get("userMessage"));
+        assertEquals(0.62, (Double) m.get("passiveScore"), 1e-6);
+        assertEquals(Arrays.asList("BLINK", "TURN_RIGHT"), m.get("challengesIssued"));
+        assertEquals(1, m.get("attempts"));
+        assertEquals(4200L, m.get("durationMs"));
+        assertEquals("s-1", m.get("sessionId"));
+        assertEquals("pad-2026.10.1", m.get("modelVersion"));
+        assertArrayEquals(jpeg, (byte[]) m.get("bestFrameJpeg"));
+    }
+
+    @Test
+    public void bestFrameOnlyOnPassed() {
+        LivenessResult r = new LivenessResult(LivenessResult.Decision.FAILED, LivenessResult.PassPath.NONE,
+                ErrorCode.MAX_RETRIES_EXCEEDED, null, 0.2f, Collections.<ChallengeType>emptyList(), 4, 30000L, "s-2", "v");
+        Map<String, Object> m = LivenessMaps.result(r, new byte[]{1});
+        assertNull(m.get("bestFrameJpeg"));
+        assertEquals("MAX_RETRIES_EXCEEDED", m.get("failureCode"));
+        assertEquals("MAX_ATTEMPTS_REACHED", m.get("userMessage"));
+    }
+
+    @Test
+    public void nullChallengeListBecomesEmpty() {
+        LivenessResult r = new LivenessResult(LivenessResult.Decision.CANCELLED, LivenessResult.PassPath.NONE,
+                ErrorCode.CANCELLED, null, Float.NaN, null, 1, 10L, "s-3", "v");
+        Map<String, Object> m = LivenessMaps.result(r, null);
+        assertEquals(Collections.emptyList(), m.get("challengesIssued"));
+        assertEquals("NONE", m.get("userMessage"));
+        assertTrue(Double.isNaN((Double) m.get("passiveScore")));
+    }
+
+    @Test
+    public void syntheticFailure() {
+        Map<String, Object> m = LivenessMaps.failed(ErrorCode.CAMERA_UNAVAILABLE, "s-4", "");
+        assertEquals("FAILED", m.get("decision"));
+        assertEquals("NONE", m.get("passPath"));
+        assertEquals("CAMERA_UNAVAILABLE", m.get("failureCode"));
+        assertEquals("DEVICE_PROBLEM", m.get("userMessage"));
+        assertEquals("s-4", m.get("sessionId"));
+        assertNull(m.get("bestFrameJpeg"));
+    }
+
+    @Test
+    public void describeNeverContainsTheImage() {
+        LivenessResult r = new LivenessResult(LivenessResult.Decision.PASSED, LivenessResult.PassPath.PASSIVE_ONLY,
+                null, null, 0.99f, Collections.<ChallengeType>emptyList(), 1, 2100L, "s-5", "v");
+        String s = LivenessMaps.describe(r);
+        assertTrue(s.contains("decision=PASSED"));
+        assertTrue(s.contains("session=s-5"));
+        assertFalse(s.toLowerCase().contains("frame"));
+    }
+}
