+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:registration_client/ui/liveness/liveness_style.dart';
+import 'package:registration_client/utils/app_fonts.dart';
+
+/// Loads the app's bundled fonts (Noto Sans and its Arabic, Devanagari, Kannada and Tamil families, pubspec.yaml)
+/// and the Material icons, so layout tests and screenshots measure the real text instead of the 1-em-per-glyph test
+/// font. Widgets get them through [livenessTestTheme]. Returns false when a font asset is missing.
+Future<bool> loadLivenessTestFonts() async {
+  final icons = FontLoader('MaterialIcons')..addFont(rootBundle.load('fonts/MaterialIcons-Regular.otf'));
+  await icons.load();
+  const families = {
+    AppFonts.family: ['NotoSans-Regular', 'NotoSans-Medium', 'NotoSans-SemiBold', 'NotoSans-Bold'],
+    'NotoSansArabic': ['NotoSansArabic-Regular', 'NotoSansArabic-SemiBold'],
+    'NotoSansDevanagari': ['NotoSansDevanagari-Regular', 'NotoSansDevanagari-SemiBold'],
+    'NotoSansKannada': ['NotoSansKannada-Regular', 'NotoSansKannada-SemiBold'],
+    'NotoSansTamil': ['NotoSansTamil-Regular', 'NotoSansTamil-SemiBold'],
+  };
+  try {
+    for (final family in families.entries) {
+      final loader = FontLoader(family.key);
+      for (final file in family.value) {
+        loader.addFont(rootBundle.load('assets/fonts/$file.ttf'));
+      }
+      await loader.load();
+    }
+  } on FlutterError {
+    return false;
+  }
+  return true;
+}
+
+/// The app's theme as far as the liveness screens see it: the app bar's blue, the app's font and type scale.
+ThemeData livenessTestTheme() => ThemeData(
+      colorScheme: const ColorScheme.light(primary: LivenessStyle.primary),
+      fontFamily: AppFonts.family,
+      fontFamilyFallback: AppFonts.fallback,
+      extensions: const [AppTypeScale.standard],
+    );
