+package io.mosip.registration.liveness.android;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+
+import org.junit.Test;
+
+import java.util.EnumSet;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+
+import io.mosip.registration.clientmanager.constant.AuditEvent;
+import io.mosip.registration.clientmanager.constant.Components;
+import io.mosip.registration.clientmanager.spi.AuditManagerService;
+import io.mosip.registration.liveness.api.AuditSink;
+import io.mosip.registration.liveness.api.WorkflowType;
+
+public class AndroidAuditSinkTest {
+
+    private final AuditManagerService audit = mock(AuditManagerService.class);
+    private final AndroidAuditSink sink = new AndroidAuditSink(audit, Runnable::run);
+
+    @Test
+    public void everyEngineEventHasItsOwnAuditEventInTheFreeBlock() {
+        Set<AuditEvent> mapped = new HashSet<>();
+        Set<String> ids = new HashSet<>();
+        for (AuditSink.Event e : AuditSink.Event.values()) {
+            AuditEvent a = AndroidAuditSink.auditEvent(e);
+            mapped.add(a);
+            ids.add(a.getId());
+            assertTrue(a.getName(), a.getName().startsWith("LIVENESS_"));
+            assertTrue(a.getName(), a.getName().endsWith(e.name().replace("LIVENESS_", "")));
+        }
+        assertEquals(AuditSink.Event.values().length, mapped.size());
+        Set<String> expected = new HashSet<>();
+        for (int i = 9; i <= 17; i++) expected.add(String.format("REG-EVT-%03d", i));
+        assertEquals(expected, ids);
+    }
+
+    @Test
+    public void auditIdsAreNotUsedByOtherEvents() {
+        Set<AuditEvent> liveness = EnumSet.noneOf(AuditEvent.class);
+        for (AuditSink.Event e : AuditSink.Event.values()) liveness.add(AndroidAuditSink.auditEvent(e));
+        for (AuditEvent a : AuditEvent.values()) {
+            if (liveness.contains(a)) continue;
+            for (AuditEvent l : liveness) assertTrue(a.name() + " reuses " + l.getId(), !a.getId().equals(l.getId()));
+        }
+    }
+
+    @Test
+    public void workflowPicksTheModule() {
+        assertEquals(Components.REGISTRATION, AndroidAuditSink.component(WorkflowType.RESIDENT));
+        assertEquals(Components.LOGIN, AndroidAuditSink.component(WorkflowType.OPERATOR));
+        assertEquals(Components.REG_PACKET_LIST, AndroidAuditSink.component(WorkflowType.SUPERVISOR));
+        assertEquals(Components.HOME, AndroidAuditSink.component(null));
+    }
+
+    @Test
+    public void detailsAreKeyValuePairsAfterTheSessionId() {
+        Map<String, String> d = new LinkedHashMap<>();
+        d.put("errorCode", "PAD_FAILURE");
+        d.put("passiveScore", "0.21");
+        sink.record(AuditSink.Event.LIVENESS_ATTEMPT_FAILED, WorkflowType.RESIDENT, "s-1", d);
+        verify(audit).audit(AuditEvent.LIVENESS_ATTEMPT_FAILED, Components.REGISTRATION,
+                "sessionId=s-1;errorCode=PAD_FAILURE;passiveScore=0.21");
+    }
+
+    @Test
+    public void separatorsInsideValuesAreReplaced() {
+        Map<String, String> d = new LinkedHashMap<>();
+        d.put("challenges", "BLINK;SMILE");
+        d.put("note", "a=b\nc");
+        assertEquals("challenges=BLINK,SMILE;note=a:b c",
+                AndroidAuditSink.details(AuditEvent.LIVENESS_PASSED, null, d));
+    }
+
+    @Test
+    public void longDetailsAreCutToTheColumn() {
+        Map<String, String> d = new LinkedHashMap<>();
+        StringBuilder big = new StringBuilder();
+        for (int i = 0; i < 3000; i++) big.append('x');
+        d.put("big", big.toString());
+        String text = AndroidAuditSink.details(AuditEvent.LIVENESS_STARTED, "s-1", d);
+        String stored = AuditEvent.LIVENESS_STARTED.getDescription() + ": " + text;
+        assertEquals(AndroidAuditSink.MAX_DESCRIPTION, stored.length());
+        assertTrue(text.endsWith(AndroidAuditSink.ELLIPSIS));
+        assertTrue(text.startsWith("sessionId=s-1;big=xxx"));
+    }
+
+    @Test
+    public void shortDetailsAreNotCut() {
+        Map<String, String> d = new LinkedHashMap<>();
+        d.put("modelVersion", "pad-2026.10.1");
+        assertEquals("modelVersion=pad-2026.10.1", AndroidAuditSink.details(AuditEvent.LIVENESS_MODEL_LOADED, null, d));
+        assertEquals("", AndroidAuditSink.details(AuditEvent.LIVENESS_MODEL_LOADED, null, null));
+    }
+
+    @Test
+    public void appStartRecordsGoToHome() {
+        sink.record(AuditSink.Event.MODEL_INTEGRITY_FAILED, null, null, null);
+        verify(audit).audit(AuditEvent.LIVENESS_MODEL_INTEGRITY_FAILED, Components.HOME, "");
+    }
+
+    @Test
+    public void auditFailuresNeverReachTheEngine() {
+        doThrow(new IllegalStateException("db closed")).when(audit).audit(any(AuditEvent.class), any(Components.class), anyString());
+        sink.record(AuditSink.Event.LIVENESS_PASSED, WorkflowType.OPERATOR, "s-1", null);
+        verify(audit).audit(AuditEvent.LIVENESS_PASSED, Components.LOGIN, "sessionId=s-1");
+    }
+
+    @Test
+    public void executorFailuresNeverReachTheEngine() {
+        AndroidAuditSink rejecting = new AndroidAuditSink(audit, r -> {
+            throw new java.util.concurrent.RejectedExecutionException("shut down");
+        });
+        rejecting.record(AuditSink.Event.CONFIG_LOADED, WorkflowType.RESIDENT, null, null);
+    }
+}
