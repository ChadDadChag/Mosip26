@@ -0,0 +1,41 @@
+package io.mosip.registration.liveness.android;
+
+import android.content.Context;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.work.Worker;
+import androidx.work.WorkerParameters;
+
+/**
+ * The periodic online model update ({@link ModelUpdates}): checks the index and installs a newer verified bundle.
+ * A failed check leaves the store unchanged and waits for the next period, so the job always ends as success.
+ */
+public final class ModelUpdateWorker extends Worker {
+
+    private static final String TAG = "LivenessModelUpdate";
+
+    public ModelUpdateWorker(@NonNull Context context, @NonNull WorkerParameters params) {
+        super(context, params);
+    }
+
+    @NonNull
+    @Override
+    public Result doWork() {
+        LivenessServiceHolder holder = LivenessServiceHolder.current();
+        try {
+            if (holder != null) {
+                holder.checkModelUpdate("scheduled");
+            } else {
+                String url = getInputData().getString(ModelUpdates.INPUT_URL);
+                if (url != null) {
+                    ModelUpdates.checkWithoutEngine(getApplicationContext(), url,
+                            getInputData().getBoolean(ModelUpdates.INPUT_INSECURE_LOCALHOST, false));
+                }
+            }
+        } catch (IllegalStateException e) {
+            Log.i(TAG, "model update skipped: " + e.getMessage()); // disabled meanwhile
+        }
+        return Result.success();
+    }
+}
diff --git a/android/liveness/src/main/java/io/mosip/registration/liveness/android/ModelUpdates.java b/android/liveness/src/main/java/io/mosip/registration/liveness/android/ModelUpdates.java
new file mode 100644
index 0000000..17dd9e8
--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/ModelUpdates.java
@@ -0,0 +1,205 @@
+package io.mosip.registration.liveness.android;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.SystemClock;
+import android.util.Log;
+
+import androidx.work.Constraints;
+import androidx.work.Data;
+import androidx.work.ExistingPeriodicWorkPolicy;
+import androidx.work.NetworkType;
+import androidx.work.PeriodicWorkRequest;
+import androidx.work.WorkManager;
+
+import java.net.MalformedURLException;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+import io.mosip.registration.liveness.analyzer.integrity.ModelUpdater;
+import io.mosip.registration.liveness.analyzer.integrity.TrustedKeys;
+import io.mosip.registration.liveness.api.ConfigProvider;
+
+/**
+ * Online model updates on Android, with the engine's {@link ModelUpdater}.
+ *
+ * <ul>
+ *   <li>Config: {@value #ENABLED_KEY} (default false: no update server exists yet), {@value #URL_KEY} (the index,
+ *       {@code latest.json}, over HTTPS) and {@value #INTERVAL_KEY} (default 24, at least 1).</li>
+ *   <li>{@link #schedule}: one unique periodic WorkManager job, {@value #WORK_NAME}, which needs a network
+ *       connection. It exists while updates are enabled with a URL, and is cancelled otherwise. It is replaced only
+ *       when the URL or the interval change.</li>
+ *   <li>{@link ModelUpdateWorker} checks through the running engine ({@link LivenessServiceHolder#checkModelUpdate}),
+ *       which reloads the analyzer after an install and writes REG-EVT-019.</li>
+ *   <li>When WorkManager started the process and the engine is not running, the worker checks with the same store,
+ *       assets and keys. It keeps the outcome for the engine to audit when it starts; the next preload uses an
+ *       installed bundle.</li>
+ * </ul>
+ * Plain HTTP to 127.0.0.1 and localhost is allowed only in diagnostics builds (debug and profile), as their network
+ * security config allows; release builds use HTTPS only.
+ */
+public final class ModelUpdates {
+
+    private static final String TAG = "LivenessModelUpdate";
+    public static final String KEY_PREFIX = "mosip.registration.liveness.model.update.";
+    public static final String ENABLED_KEY = KEY_PREFIX + "enabled";
+    public static final String URL_KEY = KEY_PREFIX + "url";
+    public static final String INTERVAL_KEY = KEY_PREFIX + "intervalHours";
+    static final int DEFAULT_INTERVAL_HOURS = 24;
+    static final String WORK_NAME = "liveness-model-update";
+    static final String INPUT_URL = "url";
+    static final String INPUT_INSECURE_LOCALHOST = "allowInsecureLocalhost";
+    static final String PREFS = "liveness-model-update";
+    private static final String SCHEDULED = "scheduled";
+    private static final String PENDING = "pending";
+    private static final int MAX_PENDING = 20;
+
+    private ModelUpdates() { }
+
+    /** The update settings in the config. */
+    static final class Settings {
+        final boolean enabled;
+        final String url;
+        final int intervalHours;
+
+        Settings(boolean enabled, String url, int intervalHours) {
+            this.enabled = enabled;
+            this.url = url;
+            this.intervalHours = intervalHours;
+        }
+
+        static Settings from(ConfigProvider config) {
+            String enabled = trim(config.get(ENABLED_KEY));
+            String url = trim(config.get(URL_KEY));
+            int hours = DEFAULT_INTERVAL_HOURS;
+            String h = trim(config.get(INTERVAL_KEY));
+            if (h != null) {
+                try {
+                    hours = Math.max(1, Integer.parseInt(h));
+                } catch (NumberFormatException e) {
+                    Log.w(TAG, INTERVAL_KEY + " is not a number; using " + DEFAULT_INTERVAL_HOURS);
+                }
+            }
+            return new Settings("true".equalsIgnoreCase(enabled), url, hours);
+        }
+
+        /** Enabled, with a URL. */
+        boolean active() {
+            return enabled && url != null;
+        }
+
+        private static String trim(String s) {
+            if (s == null) return null;
+            s = s.trim();
+            return s.isEmpty() ? null : s;
+        }
+    }
+
+    static ModelUpdater updater(boolean allowInsecureLocalhost) {
+        return ModelUpdater.builder().allowInsecureLocalhost(allowInsecureLocalhost).build();
+    }
+
+    /** Schedules, replaces or cancels the periodic job for these settings. */
+    static void schedule(Context context, Settings s, boolean allowInsecureLocalhost) {
+        SharedPreferences prefs = prefs(context);
+        if (prefs == null) return; // no app storage (unit tests)
+        try {
+            WorkManager work = WorkManager.getInstance(context);
+            if (!s.active()) {
+                work.cancelUniqueWork(WORK_NAME);
+                prefs.edit().remove(SCHEDULED).apply();
+                return;
+            }
+            String fingerprint = s.url + "|" + s.intervalHours + "|" + allowInsecureLocalhost;
+            boolean same = fingerprint.equals(prefs.getString(SCHEDULED, null));
+            PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(ModelUpdateWorker.class,
+                    s.intervalHours, TimeUnit.HOURS)
+                    .setConstraints(new Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build())
+                    .setInputData(new Data.Builder()
+                            .putString(INPUT_URL, s.url)
+                            .putBoolean(INPUT_INSECURE_LOCALHOST, allowInsecureLocalhost)
+                            .build())
+                    .build();
+            work.enqueueUniquePeriodicWork(WORK_NAME,
+                    same ? ExistingPeriodicWorkPolicy.KEEP : ExistingPeriodicWorkPolicy.REPLACE, request);
+            prefs.edit().putString(SCHEDULED, fingerprint).apply();
+            if (!same) Log.i(TAG, "model update scheduled every " + s.intervalHours + " h");
+        } catch (RuntimeException e) {
+            Log.w(TAG, "model update not scheduled: " + e); // e.g. WorkManager not initialised
+        }
+    }
+
+    /**
+     * The worker's check while the engine is not running. The outcome goes to the engine if it started meanwhile,
+     * else it is kept for its audit at the next start.
+     */
+    static void checkWithoutEngine(Context context, String url, boolean allowInsecureLocalhost) {
+        URL index;
+        try {
+            index = new URL(url);
+        } catch (MalformedURLException e) {
+            Log.w(TAG, "model update: the index URL is invalid");
+            return;
+        }
+        long start = SystemClock.elapsedRealtime();
+        ModelUpdater.UpdateResult r = updater(allowInsecureLocalhost).check(index,
+                LivenessServiceHolder.sharedStore(context), new AssetBundleSource(context), TrustedKeys.builtIn());
+        long ms = SystemClock.elapsedRealtime() - start;
+        LivenessServiceHolder holder = LivenessServiceHolder.current();
+        if (holder != null) {
+            holder.onModelUpdate(r, ms, "scheduled");
+        } else {
+            Log.i(TAG, "model update (engine not running): " + r + " in " + ms + " ms");
+            keep(context, r, ms);
+        }
+    }
+
+    /** Keeps an outcome for the engine's audit (at most {@value #MAX_PENDING}, the newest). */
+    static synchronized void keep(Context context, ModelUpdater.UpdateResult r, long ms) {
+        SharedPreferences prefs = prefs(context);
+        if (prefs == null) return;
+        List<String> lines = split(prefs.getString(PENDING, ""));
+        lines.add(r.status() + "|" + nullable(r.version()) + "|" + nullable(r.reason() == null ? null : r.reason().name())
+                + "|" + ms);
+        while (lines.size() > MAX_PENDING) lines.remove(0);
+        prefs.edit().putString(PENDING, String.join("\n", lines)).apply();
+    }
+
+    /** Audits the kept outcomes once (trigger "scheduled-offline") and forgets them. */
+    static synchronized void auditKept(Context context, AndroidAuditSink audit) {
+        SharedPreferences prefs = prefs(context);
+        if (prefs == null) return;
+        List<String> lines = split(prefs.getString(PENDING, ""));
+        if (lines.isEmpty()) return;
+        prefs.edit().remove(PENDING).apply();
+        for (String line : lines) {
+            String[] f = line.split("\\|", -1);
+            if (f.length != 4) continue;
+            long ms;
+            try {
+                ms = Long.parseLong(f[3]);
+            } catch (NumberFormatException e) {
+                continue;
+            }
+            audit.modelUpdate(f[0], f[1].isEmpty() ? null : f[1], f[2].isEmpty() ? null : f[2], ms, "scheduled-offline");
+        }
+    }
+
+    private static List<String> split(String s) {
+        List<String> out = new ArrayList<>();
+        for (String line : s.split("\n")) {
+            if (!line.isEmpty()) out.add(line);
+        }
+        return out;
+    }
+
+    private static String nullable(String s) {
+        return s == null ? "" : s;
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+}
diff --git a/android/liveness/src/main/java/io/mosip/registration/liveness/android/SwappableAnalyzerFactory.java b/android/liveness/src/main/java/io/mosip/registration/liveness/android/SwappableAnalyzerFactory.java
new file mode 100644
index 0000000..a38ba68
--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/SwappableAnalyzerFactory.java
@@ -0,0 +1,116 @@
+package io.mosip.registration.liveness.android;
+
+import io.mosip.registration.liveness.analyzer.OnnxFaceAnalyzerFactory;
+import io.mosip.registration.liveness.api.FaceAnalyzer;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.FrameAnalysis;
+import io.mosip.registration.liveness.api.LivenessEngineException;
+import io.mosip.registration.liveness.core.session.FaceAnalyzerFactory;
+
+/**
+ * The analyzer factory the engine uses, replaceable when the analyzer config changes (after a config sync).
+ * New sessions get analyzers from the current factory; a replaced factory is closed (releasing its ONNX sessions)
+ * once the analyzers created from it, i.e. those of a running session, are closed. So a running session keeps
+ * its analyzer, as the contract keeps its policy.
+ */
+final class SwappableAnalyzerFactory implements FaceAnalyzerFactory {
+
+    static final class Entry {
+        final OnnxFaceAnalyzerFactory factory;
+        int users;
+        boolean retired;
+
+        Entry(OnnxFaceAnalyzerFactory factory) {
+            this.factory = factory;
+        }
+    }
+
+    private Entry current;
+
+    SwappableAnalyzerFactory(OnnxFaceAnalyzerFactory initial) {
+        if (initial == null) throw new IllegalArgumentException("initial factory is required");
+        this.current = new Entry(initial);
+    }
+
+    synchronized OnnxFaceAnalyzerFactory current() {
+        return current.factory;
+    }
+
+    /** Makes {@code next} current; the previous factory closes when its last analyzer does (at once if unused). */
+    void swap(OnnxFaceAnalyzerFactory next) {
+        if (next == null) throw new IllegalArgumentException("next factory is required");
+        Entry old;
+        synchronized (this) {
+            old = current;
+            current = new Entry(next);
+            old.retired = true;
+            if (old.users > 0) return;
+        }
+        old.factory.close();
+    }
+
+    @Override
+    public FaceAnalyzer create() throws LivenessEngineException {
+        Entry entry;
+        synchronized (this) {
+            entry = current;
+            entry.users++;
+        }
+        try {
+            return new Counted(this, entry.factory.create(), entry);
+        } catch (LivenessEngineException | RuntimeException e) {
+            release(entry);
+            throw e;
+        }
+    }
+
+    private void release(Entry entry) {
+        synchronized (this) {
+            entry.users--;
+            if (!entry.retired || entry.users > 0) return;
+        }
+        entry.factory.close();
+    }
+
+    /** An analyzer that releases its factory when closed. */
+    static final class Counted implements FaceAnalyzer {
+        private final SwappableAnalyzerFactory owner;
+        private final FaceAnalyzer analyzer;
+        private final Entry entry;
+        private boolean closed;
+
+        Counted(SwappableAnalyzerFactory owner, FaceAnalyzer analyzer, Entry entry) {
+            this.owner = owner;
+            this.analyzer = analyzer;
+            this.entry = entry;
+        }
+
+        /** The engine's analyzer, for its per-stage statistics. */
+        FaceAnalyzer inner() {
+            return analyzer;
+        }
+
+        @Override
+        public FrameAnalysis analyze(Frame frame) throws LivenessEngineException {
+            return analyzer.analyze(frame);
+        }
+
+        @Override
+        public String modelVersion() {
+            return analyzer.modelVersion();
+        }
+
+        @Override
+        public void close() {
+            synchronized (this) {
+                if (closed) return;
+                closed = true;
+            }
+            try {
+                analyzer.close();
+            } finally {
+                owner.release(entry);
+            }
+        }
+    }
+}
diff --git a/android/liveness/src/main/java/io/mosip/registration/liveness/android/TimedAnalyzerFactory.java b/android/liveness/src/main/java/io/mosip/registration/liveness/android/TimedAnalyzerFactory.java
new file mode 100644
index 0000000..80f6531
--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/TimedAnalyzerFactory.java
@@ -0,0 +1,127 @@
+package io.mosip.registration.liveness.android;
+
+import java.util.Arrays;
+import java.util.Locale;
+
+import io.mosip.registration.liveness.analyzer.AnalyzerStats;
+import io.mosip.registration.liveness.analyzer.OnnxFaceAnalyzer;
+import io.mosip.registration.liveness.api.FaceAnalyzer;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.FrameAnalysis;
+import io.mosip.registration.liveness.api.LivenessEngineException;
+import io.mosip.registration.liveness.core.session.FaceAnalyzerFactory;
+
+/**
+ * Wraps the analyzer factory to collect per-stage analysis times for the session in progress (one at a time):
+ * {@link #reset()} when a session starts, {@link #summary()} when it ends. Timings only; frames are not kept.
+ */
+public final class TimedAnalyzerFactory implements FaceAnalyzerFactory {
+
+    static final String[] STAGES = {"total", "detect", "mesh", "pose", "quality", "pad", "cues"};
+
+    private final FaceAnalyzerFactory delegate;
+    private final long[][] samples = new long[STAGES.length][];
+    private final int[] counts = new int[STAGES.length];
+    private long firstNs;
+    private long lastNs;
+    private AnalyzerStats lastStats;
+
+    public TimedAnalyzerFactory(FaceAnalyzerFactory delegate) {
+        if (delegate == null) throw new IllegalArgumentException("delegate is required");
+        this.delegate = delegate;
+        reset();
+    }
+
+    @Override
+    public FaceAnalyzer create() throws LivenessEngineException {
+        return new Timed(delegate.create());
+    }
+
+    public synchronized void reset() {
+        for (int i = 0; i < STAGES.length; i++) {
+            samples[i] = new long[64];
+            counts[i] = 0;
+        }
+        firstNs = 0L;
+        lastNs = 0L;
+        lastStats = null;
+    }
+
+    /** Frames analysed since {@link #reset()}, their rate, and p50/p95 per stage in ms (stages that ran). */
+    public synchronized String summary() {
+        int frames = counts[0];
+        double seconds = frames > 1 ? (lastNs - firstNs) / 1e9 : 0.0;
+        StringBuilder sb = new StringBuilder(String.format(Locale.ROOT, "analysed %d frames in %.1f s (%.1f fps)",
+                frames, seconds, seconds > 0 ? (frames - 1) / seconds : 0.0));
+        for (int i = 0; i < STAGES.length; i++) {
+            if (counts[i] == 0) continue;
+            long[] sorted = Arrays.copyOf(samples[i], counts[i]);
+            Arrays.sort(sorted);
+            sb.append(String.format(Locale.ROOT, "; %s p50 %.1f p95 %.1f ms (n=%d)",
+                    STAGES[i], percentile(sorted, 0.50) / 1e6, percentile(sorted, 0.95) / 1e6, counts[i]));
+        }
+        AnalyzerStats s = lastStats;
+        if (s != null) {
+            sb.append(String.format(Locale.ROOT, "; faces none %d one %d multi %d, pose-gated %d",
+                    s.framesNoFace(), s.framesOneFace(), s.framesMultiFace(), s.framesPoseGated()));
+        }
+        return sb.toString();
+    }
+
+    /** Nearest-rank percentile of a sorted, non-empty array. */
+    static long percentile(long[] sorted, double p) {
+        int rank = (int) Math.ceil(p * sorted.length);
+        return sorted[Math.max(0, Math.min(sorted.length - 1, rank - 1))];
+    }
+
+    private synchronized void record(long totalNs, AnalyzerStats stats) {
+        long now = System.nanoTime();
+        if (counts[0] == 0) firstNs = now;
+        lastNs = now;
+        add(0, totalNs);
+        if (stats != null) {
+            add(1, stats.lastDetectNs());
+            add(2, stats.lastMeshNs());
+            add(3, stats.lastPoseNs());
+            add(4, stats.lastQualityNs());
+            add(5, stats.lastPadNs());
+            add(6, stats.lastCuesNs());
+            lastStats = stats;
+        }
+    }
+
+    private void add(int stage, long ns) {
+        if (ns <= 0) return; // the stage did not run on this frame
+        if (counts[stage] == samples[stage].length) samples[stage] = Arrays.copyOf(samples[stage], counts[stage] * 2);
+        samples[stage][counts[stage]++] = ns;
+    }
+
+    private final class Timed implements FaceAnalyzer {
+        private final FaceAnalyzer analyzer;
+
+        Timed(FaceAnalyzer analyzer) {
+            this.analyzer = analyzer;
+        }
+
+        @Override
+        public FrameAnalysis analyze(Frame frame) throws LivenessEngineException {
+            long start = System.nanoTime();
+            FrameAnalysis result = analyzer.analyze(frame);
+            long total = System.nanoTime() - start;
+            FaceAnalyzer engine = analyzer instanceof SwappableAnalyzerFactory.Counted
+                    ? ((SwappableAnalyzerFactory.Counted) analyzer).inner() : analyzer;
+            record(total, engine instanceof OnnxFaceAnalyzer ? ((OnnxFaceAnalyzer) engine).stats() : null);
+            return result;
+        }
+
+        @Override
+        public String modelVersion() {
+            return analyzer.modelVersion();
+        }
+
+        @Override
+        public void close() {
+            analyzer.close();
+        }
+    }
+}
diff --git a/android/liveness/src/test/java/io/mosip/registration/liveness/android/AnalyzerBenchmarkTest.java b/android/liveness/src/test/java/io/mosip/registration/liveness/android/AnalyzerBenchmarkTest.java
new file mode 100644
