+            @Override
+            public int read() throws IOException {
+                throw new IOException("truncated asset");
+            }
+
+            @Override
+            public int read(byte[] b) throws IOException {
+                throw new IOException("truncated asset");
+            }
+        };
+        when(assets.open(anyString(), anyInt())).thenReturn(broken);
+        try {
+            new AssetBundleSource(assets, "p/").read("x");
+            fail("expected IOException");
+        } catch (IOException e) {
+            assertEquals("truncated asset", e.getMessage());
+        }
+    }
+
+    @Test
+    public void describeNamesThePrefix() {
+        assertEquals("assets:liveness/models/", new AssetBundleSource(assets, AssetBundleSource.DEFAULT_PREFIX).describe());
+    }
+
+    @Test(expected = IllegalArgumentException.class)
+    public void requiresAssets() {
+        new AssetBundleSource(null, "p/");
+    }
+}
