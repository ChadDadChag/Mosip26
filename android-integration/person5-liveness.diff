new file mode 100644
index 0000000..6425bf0
--- /dev/null
+++ b/lib/platform_spi/liveness_service.dart
@@ -0,0 +1,97 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'dart:typed_data';
+
+import 'package:registration_client/pigeon/liveness_pigeon.dart';
+import 'package:registration_client/platform_android/liveness_service_impl.dart';
+
+/// One message of a liveness session: an engine event (kind "event") or the
+/// session's result (kind "complete"). Enum values arrive as their names.
+/// The UI renders [userMessage] and [guidance] only, never [passiveScore].
+class LivenessMessage {
+  LivenessMessage(this.data);
+
+  final Map<String, Object?> data;
+
+  bool get isComplete => data['kind'] == 'complete';
+
+  // Events
+  String? get type => data['type'] as String?;
+  String? get guidance => data['guidance'] as String?;
+  String? get challenge => data['challenge'] as String?;
+  int get challengeIndex => (data['challengeIndex'] as int?) ?? 0;
+  int get challengeCount => (data['challengeCount'] as int?) ?? 0;
+  int get timeoutMs => (data['timeoutMs'] as int?) ?? 0;
+  double get progress => (data['progress'] as num?)?.toDouble() ?? 0;
+  String? get error => data['error'] as String?;
+  int get attemptNumber => (data['attemptNumber'] as int?) ?? 0;
+  int get retriesLeft => (data['retriesLeft'] as int?) ?? 0;
+  bool get recoverable => (data['recoverable'] as bool?) ?? false;
+
+  // Both: the ErrorCode.UserMessage name (NONE, LIVENESS_NOT_VERIFIED, ...).
+  String? get userMessage => data['userMessage'] as String?;
+
+  // Result
+  String? get decision => data['decision'] as String?;
+  String? get passPath => data['passPath'] as String?;
+  String? get failureCode => data['failureCode'] as String?;
+  double get passiveScore => (data['passiveScore'] as num?)?.toDouble() ?? double.nan;
+  List<String> get challengesIssued =>
+      ((data['challengesIssued'] as List?) ?? const []).cast<String>();
+  int get attempts => (data['attempts'] as int?) ?? 0;
+  int get durationMs => (data['durationMs'] as int?) ?? 0;
+  String? get sessionId => data['sessionId'] as String?;
+  String? get modelVersion => data['modelVersion'] as String?;
+
+  /// JPEG of the best frame; only on PASSED. Keep it in memory only.
+  Uint8List? get bestFrameJpeg => data['bestFrameJpeg'] as Uint8List?;
+}
+
+/// The camera permission after asking. [permanentlyDenied]: Android no longer
+/// shows the dialog; only the app settings can grant it.
+enum CameraPermission { granted, denied, permanentlyDenied }
+
+/// Face liveness. Workflows: RESIDENT, OPERATOR, SUPERVISOR. Cameras: front, back.
+abstract class LivenessService {
+  /// Events and results of every session, in order. Listen before starting a session.
+  Stream<LivenessMessage> get messages;
+
+  Future<bool> isEnabled(String workflow);
+
+  Future<LivenessPolicyInfo> policy(String workflow);
+
+  /// Asks for the camera permission if needed.
+  Future<CameraPermission> ensureCameraPermission();
+
+  /// Opens this app's system settings (to grant a permanently refused camera permission).
+  Future<void> openCameraSettings();
+
+  /// front or back for the workflow (mosip.registration.liveness.face.android.<workflow>.camera).
+  Future<String> cameraFor(String workflow);
+
+  /// Re-reads the liveness config for new sessions.
+  Future<void> reloadConfig();
+
+  /// Asks for the camera permission, then starts a session (cancelling any
+  /// running one). Returns the session id, or "" when liveness is disabled for
+  /// the workflow. A refused permission completes the session with FAILED /
+  /// CAMERA_UNAVAILABLE on [messages].
+  Future<String> startSession(String workflow,
+      {String camera = 'front', bool useFake = false});
+
+  Future<void> retry();
+
+  Future<void> cancel();
+
+  Future<String> modelVersion();
+
+  /// Debug builds only: overrides a config key; an empty value removes it.
+  Future<void> setConfigOverride(String key, String value);
+
+  factory LivenessService() => getLivenessServiceImpl();
+}
