@@ -0,0 +1,34 @@
+package io.mosip.registration.liveness.android;
+
+import android.graphics.Bitmap;
+
+import java.io.ByteArrayOutputStream;
+
+import io.mosip.registration.liveness.api.Frame;
+
+/** Encodes the engine's best frame as a JPEG for the UI. In memory only; never written to disk or logged. */
+public final class BestFrameEncoder {
+
+    public static final int QUALITY = 90;
+
+    private BestFrameEncoder() { }
+
+    public static byte[] jpeg(Frame frame, int quality) {
+        if (frame == null) return null;
+        int width = frame.width();
+        int height = frame.height();
+        byte[] rgb = frame.rgb();
+        int[] argb = new int[width * height];
+        for (int i = 0, p = 0; i < argb.length; i++, p += 3) {
+            argb[i] = 0xFF000000 | ((rgb[p] & 0xFF) << 16) | ((rgb[p + 1] & 0xFF) << 8) | (rgb[p + 2] & 0xFF);
+        }
+        Bitmap bitmap = Bitmap.createBitmap(argb, width, height, Bitmap.Config.ARGB_8888);
+        try {
+            ByteArrayOutputStream out = new ByteArrayOutputStream(64 * 1024);
+            bitmap.compress(Bitmap.CompressFormat.JPEG, quality, out);
+            return out.toByteArray();
+        } finally {
+            bitmap.recycle();
+        }
+    }
+}
diff --git a/android/liveness/src/main/java/io/mosip/registration/liveness/android/BindingImages.java b/android/liveness/src/main/java/io/mosip/registration/liveness/android/BindingImages.java
new file mode 100644
index 0000000..667637d
--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/BindingImages.java
@@ -0,0 +1,81 @@
+package io.mosip.registration.liveness.android;
+
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+
+import com.gemalto.jp2.JP2Decoder;
+import com.gemalto.jp2.JP2Encoder;
+
+import java.io.IOException;
+
+import io.mosip.registration.liveness.api.Frame;
+
+/**
+ * Images for face binding (F1), in memory only: decoding a captured face to RGB888, and (debug page only) encoding a
+ * camera still. JPEG 2000 (an SBI face inside ISO 19794-5 is usually JP2) is decoded with JP2ForAndroid, the
+ * decoder the client already uses for captures; anything else with {@link BitmapFactory} (JPEG, PNG).
+ */
+public final class BindingImages {
+
+    // A JP2 file starts with the 12-byte signature box; a raw codestream with SOC + SIZ.
+    private static final byte[] JP2_SIGNATURE = {0, 0, 0, 0x0C, 0x6A, 0x50, 0x20, 0x20, 0x0D, 0x0A, (byte) 0x87, 0x0A};
+    private static final byte[] J2K_CODESTREAM = {(byte) 0xFF, 0x4F, (byte) 0xFF, 0x51};
+
+    private BindingImages() { }
+
+    /** JPEG 2000, by its signature (checked here, so that PNG and JPEG never load the native JP2 library). */
+    static boolean isJpeg2000(byte[] b) {
+        return startsWith(b, JP2_SIGNATURE) || startsWith(b, J2K_CODESTREAM);
+    }
+
+    /** @throws IOException for empty or undecodable bytes */
+    public static FaceBinding.Rgb decode(byte[] bytes) throws IOException {
+        if (bytes == null || bytes.length == 0) throw new IOException("no image");
+        Bitmap bmp = isJpeg2000(bytes) ? new JP2Decoder(bytes).decode()
+                : BitmapFactory.decodeByteArray(bytes, 0, bytes.length);
+        if (bmp == null) throw new IOException("not a decodable image");
+        try {
+            return rgb(bmp);
+        } finally {
+            bmp.recycle();
+        }
+    }
+
+    public static FaceBinding.Rgb rgb(Bitmap bmp) {
+        int w = bmp.getWidth(), h = bmp.getHeight();
+        int[] argb = new int[w * h];
+        bmp.getPixels(argb, 0, w, 0, 0, w, h);
+        byte[] rgb = new byte[w * h * 3];
+        for (int i = 0, p = 0; i < argb.length; i++, p += 3) {
+            int c = argb[i];
+            rgb[p] = (byte) (c >> 16);
+            rgb[p + 1] = (byte) (c >> 8);
+            rgb[p + 2] = (byte) c;
+        }
+        return new FaceBinding.Rgb(rgb, w, h);
+    }
+
+    /** Debug page only: a camera still as JPEG 2000 (JP2), to exercise the decoder the SBI path uses. */
+    public static byte[] jp2(Frame frame) {
+        int w = frame.width(), h = frame.height();
+        byte[] rgb = frame.rgb();
+        int[] argb = new int[w * h];
+        for (int i = 0, p = 0; i < argb.length; i++, p += 3) {
+            argb[i] = 0xFF000000 | ((rgb[p] & 0xFF) << 16) | ((rgb[p + 1] & 0xFF) << 8) | (rgb[p + 2] & 0xFF);
+        }
+        Bitmap bmp = Bitmap.createBitmap(argb, w, h, Bitmap.Config.ARGB_8888);
+        try {
+            return new JP2Encoder(bmp).setOutputFormat(JP2Encoder.FORMAT_JP2).encode();
+        } finally {
+            bmp.recycle();
+        }
+    }
+
+    private static boolean startsWith(byte[] b, byte[] prefix) {
+        if (b == null || b.length < prefix.length) return false;
+        for (int i = 0; i < prefix.length; i++) {
+            if (b[i] != prefix[i]) return false;
+        }
+        return true;
+    }
+}
diff --git a/android/liveness/src/main/java/io/mosip/registration/liveness/android/FaceBinding.java b/android/liveness/src/main/java/io/mosip/registration/liveness/android/FaceBinding.java
new file mode 100644
index 0000000..eab4a06
--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/FaceBinding.java
@@ -0,0 +1,356 @@
+package io.mosip.registration.liveness.android;
+
+import java.util.Locale;
+import java.util.concurrent.Executor;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.BooleanSupplier;
+import java.util.function.Consumer;
+import java.util.function.DoubleSupplier;
+import java.util.function.LongSupplier;
+
+import io.mosip.registration.liveness.analyzer.match.FaceMatcher;
+import io.mosip.registration.liveness.analyzer.match.MatchResult;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.LivenessEngineException;
+import io.mosip.registration.liveness.api.WorkflowType;
+
+/**
+ * Face binding (F1) on Android: is the face the SBI captured the person who just passed liveness?
+ *
+ * <p><b>The best frame.</b> At most one is held: the one of the most recent PASSED real session, in memory only,
+ * never logged or written. It is dropped after a binding, when the next session starts ({@link #clear}), when the
+ * Activity pauses ({@link #onPause}, unless an armed SBI face capture is in flight: the SBI app itself pauses the
+ * Activity), and {@value #TTL_MS} ms after the session ({@link #sweep}).
+ *
+ * <p><b>Arming</b> (the hooks, before the SBI face capture): {@link #arm} with the gate's session id. It is valid only
+ * for the held session. The next FACE capture result consumes it ({@link #onFaceCapture}), whatever happens:
+ * <ul>
+ *   <li>armed: the capture is compared with the best frame ({@link #bindCapture}) and stored only on MATCH. Anything
+ *       else (another person, no face, several faces, a decode error, an exception, a timeout) is not stored. If the
+ *       best frame was dropped meanwhile (pause, TTL), the capture fails closed too: arming is cleared only by a
+ *       capture result or a new session;</li>
+ *   <li>not armed (no hook, the exception photo, other modalities): stored exactly as before;</li>
+ *   <li>binding disabled ({@value #ENABLED_KEY} = false): {@link #arm} returns DISABLED, and the next FACE capture is
+ *       stored as before and audited SKIPPED.</li>
+ * </ul>
+ * Every binding is audited: outcome, similarity, threshold and session id; never an image or a feature.
+ */
+public final class FaceBinding {
+
+    public static final String ENABLED_KEY = "mosip.registration.liveness.face.binding.enabled";
+    public static final long TTL_MS = 5 * 60 * 1000L;
+    /** A binding of a capture that has not finished by then fails closed. */
+    public static final long TIMEOUT_MS = 20_000L;
+    public static final String ERROR = "ERROR";
+    public static final String SKIPPED = "SKIPPED";
+
+    public enum Arm { ARMED, DISABLED, REJECTED }
+
+    /** A matcher on the current verified models (one per binding; creating one is cheap). */
+    public interface MatcherSource {
+        FaceMatcher open() throws LivenessEngineException;
+    }
+
+    public interface Audit {
+        void binding(WorkflowType workflow, String sessionId, Result result);
+    }
+
+    /** Decodes the captured image; runs on the binding thread. */
+    public interface Decoder {
+        Rgb decode() throws Exception;
+    }
+
+    public interface Scheduler {
+        void schedule(Runnable task, long delayMs);
+    }
+
+    /** An image as packed RGB888, row by row. */
+    public static final class Rgb {
+        public final byte[] rgb;
+        public final int width;
+        public final int height;
+
+        public Rgb(byte[] rgb, int width, int height) {
+            this.rgb = rgb;
+            this.width = width;
+            this.height = height;
+        }
+    }
+
+    /** What a binding found. similarity is NaN unless both images held exactly one face. */
+    public static final class Result {
+        public final String outcome;
+        public final double similarity;
+        public final double threshold;
+
+        public Result(String outcome, double similarity, double threshold) {
+            this.outcome = outcome;
+            this.similarity = similarity;
+            this.threshold = threshold;
+        }
+
+        public boolean matched() {
+            return MatchResult.Outcome.MATCH.name().equals(outcome);
+        }
+
+        @Override
+        public String toString() {
+            return String.format(Locale.ROOT, "%s (similarity %.2f, threshold %.2f)", outcome, similarity, threshold);
+        }
+    }
+
+    /** What the capture handler does with one FACE capture result. */
+    public static final class Capture {
+        enum Kind { UNBOUND, SKIPPED, BIND }
+
+        static final Capture UNBOUND = new Capture(Kind.UNBOUND, null, null, null);
+
+        final Kind kind;
+        final String sessionId;
+        final WorkflowType workflow;
+        final Frame bestFrame; // null for BIND when the frame was dropped: the binding then fails closed
+
+        Capture(Kind kind, String sessionId, WorkflowType workflow, Frame bestFrame) {
+            this.kind = kind;
+            this.sessionId = sessionId;
+            this.workflow = workflow;
+            this.bestFrame = bestFrame;
+        }
+
+        /** True: compare first ({@link #bindCapture}); false: store as before. */
+        public boolean bind() {
+            return kind == Kind.BIND;
+        }
+    }
+
+    private final MatcherSource matchers;
+    private final BooleanSupplier enabled;
+    private final DoubleSupplier threshold;
+    private final Audit audit;
+    private final LongSupplier clock;
+
+    // Guarded by this.
+    private String sessionId;
+    private WorkflowType workflow;
+    private Frame bestFrame;
+    private long heldAt;
+    private String armedSession;    // the session the next FACE capture must match; null when not armed
+    private WorkflowType armedWorkflow;
+    private boolean inFlight;       // an armed SBI face capture was started
+    private String skippedSession;  // binding disabled: the next FACE capture is audited SKIPPED
+    private WorkflowType skippedWorkflow;
+    private boolean skipPending;
+
+    public FaceBinding(MatcherSource matchers, BooleanSupplier enabled, DoubleSupplier threshold, Audit audit,
+                       LongSupplier clock) {
+        if (matchers == null || enabled == null || threshold == null || audit == null || clock == null) {
+            throw new IllegalArgumentException("null argument");
+        }
+        this.matchers = matchers;
+        this.enabled = enabled;
+        this.threshold = threshold;
+        this.audit = audit;
+        this.clock = clock;
+    }
+
+    /** {@value #ENABLED_KEY}: anything but "false" (or no value) keeps binding on. */
+    public static boolean enabled(String value) {
+        return value == null || !"false".equalsIgnoreCase(value.trim());
+    }
+
+    /** A real session PASSED: hold its best frame (replacing any other) until it is bound or dropped. */
+    public synchronized void hold(String sessionId, WorkflowType workflow, Frame bestFrame) {
+        resetAll();
+        if (sessionId == null || bestFrame == null) return;
+        this.sessionId = sessionId;
+        this.workflow = workflow;
+        this.bestFrame = bestFrame;
+        this.heldAt = clock.getAsLong();
+    }
+
+    /** A new session starts: everything is dropped, including an arming (the new gate arms again). */
+    public synchronized void clear() {
+        resetAll();
+    }
+
+    /**
+     * The Activity paused. During an armed SBI face capture (the SBI app's own activity) nothing changes. Otherwise
+     * the best frame is dropped; an arming stays, so a capture that still arrives fails closed.
+     */
+    public synchronized void onPause() {
+        if (!inFlight) dropFrame();
+    }
+
+    /** Drops the best frame once it is {@value #TTL_MS} ms old (an arming stays, as for a pause). */
+    public synchronized void sweep() {
+        if (bestFrame != null && clock.getAsLong() - heldAt >= TTL_MS) dropFrame();
+    }
+
+    /** A held best frame handed to identity binding (F15), with its session's workflow. */
+    public static final class Held {
+        public final WorkflowType workflow;
+        public final Frame bestFrame;
+
+        Held(WorkflowType workflow, Frame bestFrame) {
+            this.workflow = workflow;
+            this.bestFrame = bestFrame;
+        }
+    }
+
+    /**
+     * F15: the held best frame of {@code sessionId} for identity binding ({@link IdentityBinding}), which has no SBI
+     * capture. Consumes it: everything is dropped. Null when nothing is held for that session (another session, a
+     * pause, the TTL).
+     */
+    public synchronized Held take(String sessionId) {
+        sweep();
+        if (sessionId == null || bestFrame == null || !sessionId.equals(this.sessionId)) return null;
+        Held h = new Held(workflow, bestFrame);
+        resetAll();
+        return h;
+    }
+
+    /** Whether a best frame is held (tests and diagnostics). */
+    public synchronized boolean holding() {
+        sweep();
+        return bestFrame != null;
+    }
+
+    /** Whether the next FACE capture will be compared (tests and diagnostics). */
+    public synchronized boolean armed() {
+        return armedSession != null;
+    }
+
+    /**
+     * The hook, before the SBI face capture: ARMED for the held session; DISABLED when binding is off (the capture is
+     * then stored as before and audited SKIPPED); REJECTED for an unknown or expired session (the hook blocks).
+     */
+    public synchronized Arm arm(String sessionId) {
+        if (!enabled.getAsBoolean()) {
+            skipPending = true;
+            skippedSession = sessionId;
+            skippedWorkflow = sessionId != null && sessionId.equals(this.sessionId) ? workflow : null;
+            return Arm.DISABLED;
+        }
+        sweep();
+        if (sessionId == null || bestFrame == null || !sessionId.equals(this.sessionId)) return Arm.REJECTED;
+        armedSession = sessionId;
+        armedWorkflow = workflow;
+        return Arm.ARMED;
+    }
+
+    /** The SBI face capture was started (the SBI app will pause the Activity). */
+    public synchronized void captureStarted() {
+        if (armedSession != null) inFlight = true;
+    }
+
+    /** A FACE capture result arrived (main thread): consumes the arming, if any. */
+    public Capture onFaceCapture() {
+        Capture c;
+        synchronized (this) {
+            if (armedSession != null) {
+                boolean same = bestFrame != null && armedSession.equals(sessionId)
+                        && clock.getAsLong() - heldAt < TTL_MS;
+                c = new Capture(Capture.Kind.BIND, armedSession, armedWorkflow, same ? bestFrame : null);
+                resetAll(); // the frame is used once
+            } else if (skipPending) {
+                c = new Capture(Capture.Kind.SKIPPED, skippedSession, skippedWorkflow, null);
+                resetAll(); // the held frame is not needed: binding is off
+            } else {
+                c = Capture.UNBOUND;
+            }
+        }
+        if (c.kind == Capture.Kind.SKIPPED) audit.binding(c.workflow, c.sessionId, skipped());
+        return c;
+    }
+
+    /**
+     * Compares the armed capture on {@code worker} and calls {@code done} EXACTLY ONCE on {@code callback}: true to
+     * store the capture (MATCH only), false otherwise, including when nothing finished within {@code timeoutMs}.
+     * The outcome that completes is audited; a binding that finishes after the timeout is dropped.
+     */
+    public void bindCapture(Capture c, Decoder decoder, Executor worker, Executor callback, Scheduler timer,
+                            long timeoutMs, Consumer<Boolean> done) {
+        AtomicBoolean once = new AtomicBoolean();
+        Consumer<Result> finish = r -> {
+            if (!once.compareAndSet(false, true)) return;
+            audit.binding(c.workflow, c.sessionId, r);
+            callback.execute(() -> done.accept(r.matched()));
+        };
+        try {
+            timer.schedule(() -> finish.accept(error()), timeoutMs);
+            worker.execute(() -> finish.accept(compare(c.bestFrame, decoder)));
+        } catch (RuntimeException e) { // e.g. a rejected execution
+            finish.accept(error());
+        }
+    }
+
+    /**
+     * The debug page's binding test (Pigeon bindCapturedFace): compares the image with the held best frame of
+     * {@code sessionId} on the calling thread, drops that frame and audits the outcome. SKIPPED when binding is off;
+     * ERROR for an unknown or expired session.
+     */
+    public Result bindNow(String sessionId, Decoder decoder) {
+        if (!enabled.getAsBoolean()) {
+            Result r = skipped();
+            audit.binding(null, sessionId, r);
+            return r;
+        }
+        Frame best = null;
+        WorkflowType wf = null;
+        synchronized (this) {
+            sweep();
+            if (sessionId != null && bestFrame != null && sessionId.equals(this.sessionId)) {
+                best = bestFrame;
+                wf = workflow;
+                resetAll();
+            }
+        }
+        Result r = compare(best, decoder);
+        audit.binding(wf, sessionId, r);
+        return r;
+    }
+
+    /** Never throws: anything but a completed comparison is ERROR. */
+    Result compare(Frame best, Decoder decoder) {
+        if (best == null) return error();
+        Rgb image;
+        try {
+            image = decoder.decode();
+        } catch (Exception | LinkageError e) {
+            return error();
+        }
+        if (image == null || image.rgb == null) return error();
+        try (FaceMatcher m = matchers.open()) {
+            MatchResult r = m.compare(best.rgb(), best.width(), best.height(), image.rgb, image.width, image.height);
+            return new Result(r.outcome.name(), r.similarity, r.threshold);
+        } catch (Exception | LinkageError e) {
+            return error();
+        }
+    }
+
+    private Result error() {
+        return new Result(ERROR, Double.NaN, threshold.getAsDouble());
+    }
+
+    private Result skipped() {
+        return new Result(SKIPPED, Double.NaN, threshold.getAsDouble());
+    }
+
+    private void dropFrame() {
+        sessionId = null;
+        workflow = null;
+        bestFrame = null;
+        heldAt = 0;
+    }
+
+    private void resetAll() {
+        dropFrame();
+        armedSession = null;
+        armedWorkflow = null;
+        inFlight = false;
+        skipPending = false;
+        skippedSession = null;
+        skippedWorkflow = null;
+    }
+}
