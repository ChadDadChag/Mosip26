+import io.mosip.registration.liveness.core.metrics.LivenessMetrics;
+import io.mosip.registration.liveness.fake.FakeLivenessService;
+
+/**
+ * The app's single liveness engine (one instance, provided by Dagger).
+ *
+ * <ul>
+ *   <li>Real engine: the ONNX analyzer with the signed bundle from the assets, or a newer verified bundle installed
+ *       in {@code files/liveness-models}, behind {@link DefaultLivenessService}.</li>
+ *   <li>Fake engine: {@link FakeLivenessService}, scripted by {@code mosip.registration.liveness.fake.scenario}.</li>
+ *   <li>Config: the synced global params, under a map of overrides (debug screen only). Re-read after every global
+ *       param refresh (a sync): policies for new sessions, and the analyzer when its settings changed.</li>
+ *   <li>{@link #preload()} verifies the bundle and builds the ONNX sessions in the background at app start.</li>
+ *   <li>The camera per workflow: {@code mosip.registration.liveness.face.android.<workflow>.camera}, front or back;
+ *       the dim-face exposure assist: {@code mosip.registration.liveness.face.android.exposureAssist} (default true).</li>
+ *   <li>Analyzer settings: the {@code mosip.registration.liveness.face.analyzer.*} keys, else the Android defaults
+ *       ({@link #ANDROID_ANALYZER_DEFAULTS}, from the on-device benchmark), else the analyzer's own defaults.</li>
+ *   <li>The real engine's anonymised metrics are added to {@link LivenessMetricsStore} after each session.</li>
+ *   <li>Face binding (F1, {@link #binding()}): {@value FaceBinding#ENABLED_KEY} (default true) and
+ *       {@code mosip.registration.liveness.face.binding.cosineThreshold} (default 0.45).</li>
+ *   <li>Identity binding (F15, {@link #verifyIdentity}): after a password-only gate, the live face against the user's
+ *       onboarded face ({@link #setIdentityTemplates}); {@value IdentityBinding#ENABLED_KEY} (default true),
+ *       {@value IdentityBinding#THRESHOLD_KEY} (default 0.40) and {@value IdentityBinding#REQUIRE_TEMPLATE_KEY}
+ *       (default false).</li>
+ *   <li>Online model update ({@link #checkModelUpdate}, {@link ModelUpdates}): {@code
+ *       mosip.registration.liveness.model.update.enabled} (default false), {@code .url} and {@code .intervalHours}
+ *       (default 24); scheduled again after every config reload.</li>
+ * </ul>
+ */
+public final class LivenessServiceHolder {
+
+    private static final String TAG = "LivenessService";
+    public static final String MODEL_STORE_DIR = "liveness-models";
+    public static final String CAMERA_KEY_PREFIX = "mosip.registration.liveness.face.android.";
+    public static final String EXPOSURE_ASSIST_KEY = CAMERA_KEY_PREFIX + "exposureAssist";
+
+    /**
+     * Analyzer settings used on Android when the config does not set them: the fastest setting of the on-device
+     * benchmark (Samsung S23 FE) whose scores and landmarks match the CPU 1-thread reference
+     * (Mosip26 docs/part5-android-benchmark.md). Any analyzer key in the synced config or an override wins.
+     */
+    static final Map<String, String> ANDROID_ANALYZER_DEFAULTS;
+
+    static {
+        Map<String, String> m = new HashMap<>();
+        m.put(AnalyzerConfig.KEY_PREFIX + "intraOpThreads", "2");
+        m.put(AnalyzerConfig.KEY_PREFIX + "accelerator", "CPU");
+        ANDROID_ANALYZER_DEFAULTS = Collections.unmodifiableMap(m);
+    }
+
+    private static volatile LivenessServiceHolder current;
+    private static ModelStore sharedStore; // guarded by the class
+
+    private final Context context;
+    private final boolean diagnostics;
+    private final AndroidAuditSink audit;
+    private final ConfigProvider baseConfig;
+    private final Map<String, String> overrides = new ConcurrentHashMap<>();
+    private final ConfigProvider config = this::configValue;
+    private final ExecutorService background = Executors.newSingleThreadExecutor(r -> {
+        Thread t = new Thread(r, "liveness-background");
+        t.setDaemon(true);
+        return t;
+    });
+
+    // Face binding (F1) compares one capture at a time; its own thread, so a benchmark on background() cannot delay it.
+    private final ExecutorService bindingWorker = Executors.newSingleThreadExecutor(r -> {
+        Thread t = new Thread(r, "liveness-binding");
+        t.setDaemon(true);
+        return t;
+    });
+
+    private final SwappableAnalyzerFactory analyzers;
+    private final TimedAnalyzerFactory timedAnalyzers;
+    private final DefaultLivenessService real;
+    // The app's signed bundle and the keys it trusts (tests: a bundle signed with a throwaway key).
+    private final BundleSource bundledModels;
+    private final TrustedKeys trustedKeys;
+    private final FaceBinding binding;
+    private static final IdentityBinding.TemplateSource NO_TEMPLATES = userId -> Collections.emptyList();
+    private final IdentityBinding identity;
+    private volatile IdentityBinding.TemplateSource identityTemplates = NO_TEMPLATES;
+    // Debug and profile builds only: the debug page's F15 check (its own test template).
+    private volatile IdentityBinding.TemplateSource diagnosticIdentityTemplates;
+    private volatile FakeLivenessService fake;
+    private String analyzerFingerprint; // guarded by this
+    private volatile int analyzerSwaps;
+
+    private volatile String modelVersion = "";
+    private LivenessMetricsStore metricsStore; // created on first use
+    // Main thread only: the live preview views, newest last (a screen opened over another one has its own).
+    private final List<PreviewView> previews = new ArrayList<>();
+
+    public LivenessServiceHolder(Context context, GlobalParamRepository globalParams, AuditManagerService auditManager) {
+        this(context, globalParams, auditManager, false);
+    }
+
+    /**
+     * @param diagnostics debug and profile builds ({@code BuildConfig.LIVENESS_DIAGNOSTICS}): the online model update
+     *                    may then use plain HTTP to 127.0.0.1 and localhost (the debug page's test server)
+     */
+    public LivenessServiceHolder(Context context, GlobalParamRepository globalParams, AuditManagerService auditManager,
+                                 boolean diagnostics) {
+        this(context, globalParams, auditManager, diagnostics, new AssetBundleSource(context.getApplicationContext()),
+                TrustedKeys.builtIn());
+    }
+
+    /** Tests: another bundled model source and its trusted keys. */
+    LivenessServiceHolder(Context context, GlobalParamRepository globalParams, AuditManagerService auditManager,
+                          boolean diagnostics, BundleSource bundledModels, TrustedKeys trustedKeys) {
+        this.context = context.getApplicationContext();
+        this.diagnostics = diagnostics;
+        this.bundledModels = bundledModels;
+        this.trustedKeys = trustedKeys;
+        this.audit = new AndroidAuditSink(auditManager);
+        this.baseConfig = new AndroidConfigProvider(globalParams);
+        AnalyzerConfig analyzerConfig = analyzerConfig(config);
+        this.analyzerFingerprint = fingerprint(analyzerConfig);
+        this.analyzers = new SwappableAnalyzerFactory(analyzerFactory(analyzerConfig));
+        this.timedAnalyzers = new TimedAnalyzerFactory(analyzers);
+        this.real = DefaultLivenessService.builder().config(config).analyzerFactory(timedAnalyzers).auditSink(audit).build();
+        this.binding = new FaceBinding(() -> analyzers.current().createMatcher(),
+                () -> FaceBinding.enabled(config.get(FaceBinding.ENABLED_KEY)),
+                () -> analyzerConfig(config).bindingCosineThreshold, audit::binding, SystemClock::elapsedRealtime);
+        this.identity = new IdentityBinding(binding, () -> analyzers.current().createMatcher(), config::get,
+                () -> analyzerConfig(config).identityCosineThreshold, audit::identity);
+        this.fake = fakeService(1.0);
+        // After a global-param sync (or any cache refresh), new sessions use the new config.
+        globalParams.addRefreshListener(this::reloadConfig);
+        ModelUpdates.auditKept(this.context, audit); // checks the update job made while the engine was not running
+        scheduleModelUpdates();
+        current = this;
+    }
+
+    private OnnxFaceAnalyzerFactory analyzerFactory(AnalyzerConfig analyzerConfig) {
+        return new OnnxFaceAnalyzerFactory(bundledModels, modelStore(), trustedKeys,
+                analyzerConfig);
+    }
+
+    private ModelStore modelStore() {
+        return sharedStore(context);
+    }
+
+    /**
+     * The process's one model store ({@code files/liveness-models}): the analyzer, the debug page's install and
+     * rollback, and the online update (also when WorkManager runs it without the engine) all go through its lock.
+     */
+    static synchronized ModelStore sharedStore(Context context) {
+        File root = new File(context.getApplicationContext().getFilesDir(), MODEL_STORE_DIR);
+        if (sharedStore == null || !sharedStore.root().equals(root)) sharedStore = new ModelStore(root); // tests
+        return sharedStore;
+    }
+
+    /** The engine, once the app has created it in this process; else null (the update worker then runs alone). */
+    static LivenessServiceHolder current() {
+        return current;
+    }
+
+    private FakeLivenessService fakeService(double timeScale) {
+        return FakeLivenessService.builder(config).timeScale(timeScale).auditSink(audit).build();
+    }
+
+    /**
+     * On a background thread: verifies the model bundle (all five files) and builds the per-frame ONNX sessions, then
+     * builds the face-binding (MATCHER) session, so that neither the first session nor the first binding waits.
+     * Logs both times.
+     */
+    public void preload() {
+        background.execute(() -> {
+            long start = SystemClock.elapsedRealtime();
+            OnnxFaceAnalyzerFactory factory = analyzers.current();
+            try {
+                factory.preload();
+                long ms = SystemClock.elapsedRealtime() - start;
+                modelVersion = factory.modelVersion();
+                String accelerator = String.valueOf(factory.activeAccelerator());
+                Log.i(TAG, "preload: bundle " + modelVersion + " verified and loaded in " + ms + " ms (" + accelerator + ")");
+                Map<String, String> d = new HashMap<>();
+                d.put("modelVersion", modelVersion);
+                d.put("loadMs", Long.toString(ms));
+                d.put("accelerator", accelerator);
+                audit.record(AuditSink.Event.MODEL_LOADED, null, null, d);
+            } catch (LivenessEngineException e) {
+                preloadFailed(e.code(), e, start);
+                return;
+            } catch (RuntimeException | LinkageError e) {
+                preloadFailed(ErrorCode.ENGINE_ERROR, e, start);
+                return;
+            }
+            long warm = SystemClock.elapsedRealtime();
