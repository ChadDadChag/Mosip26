+    if (!mounted) return;
+    Future<void>.delayed(const Duration(milliseconds: 500), _refreshDiagnostics);
+    setState(() {
+      _pageOpen = false;
+      _outcome = outcome;
+      _addLog('LivenessPage returned $outcome');
+    });
+  }
+
+  Future<void> _start() async {
+    setState(() {
+      _log.clear();
+      _result = null;
+      _status = 'starting';
+      _banner = 'Starting face liveness check…';
+      _bannerProgress = null;
+      _running = true;
+    });
+    _clock
+      ..reset()
+      ..start();
+    try {
+      final id = await _service.startSession(_workflow,
+          camera: _camera, useFake: _fake);
