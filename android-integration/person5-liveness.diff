new file mode 100644
index 0000000..dd1ea35
--- /dev/null
+++ b/pigeon/liveness.dart
@@ -0,0 +1,80 @@
+import 'package:pigeon/pigeon.dart';
+
+/// The parts of a workflow's liveness policy the UI needs (from the synced
+/// mosip.registration.liveness.face.* config, or the engine defaults).
+class LivenessPolicyInfo {
+  final bool enabled;
+  final int maxRetries;
+  final int minChallenges;
+  final int challengeTimeoutMs;
+
+  LivenessPolicyInfo({
+    required this.enabled,
+    required this.maxRetries,
+    required this.minChallenges,
+    required this.challengeTimeoutMs,
+  });
+}
+
+/// Face liveness. Workflows: RESIDENT, OPERATOR, SUPERVISOR. Cameras: front, back.
+/// Session events and the result arrive on the event channel
+/// io.mosip.registration_client/liveness/events.
+@HostApi()
+abstract class LivenessApi {
+  bool isEnabled(String workflow);
+
+  LivenessPolicyInfo policy(String workflow);
+
+  /// Starts a session (cancelling any running one) and returns its id,
+  /// or "" when liveness is disabled for the workflow.
+  @async
+  String startSession(String workflow, String camera, bool useFake);
+
+  void retry();
+
+  void cancel();
+
+  /// The loaded model bundle version, or "" before the models are loaded.
+  String modelVersion();
+
+  /// front or back, from mosip.registration.liveness.face.android.<workflow>.camera
+  /// (default front).
+  String cameraFor(String workflow);
+
+  /// Re-reads the liveness config for new sessions (the native side also does
+  /// this after every global-param sync).
+  void reloadConfig();
+
+  /// Diagnostics builds (debug, profile) only, ignored otherwise: sets a config
+  /// override, or removes it when value is empty.
+  void setConfigOverride(String key, String value);
+
+  /// The persisted anonymised metrics of the real engine (counts since install
+  /// or the last reset, and the rates derived from them), one key=value per line.
+  String metrics();
+
+  /// Diagnostics builds only: clears the persisted metrics.
+  void resetMetrics();
+
+  /// Diagnostics builds only: captures 60 camera frames into memory (the person
+  /// faces the camera for about 5 s), benchmarks the analyzer (1, 2 and 4
+  /// threads x CPU, XNNPACK, NNAPI) with the bundled models and each signed
+  /// test bundle under files/bench-bundles/, discards the frames and returns
+  /// the report as text. Takes a few minutes.
+  @async
+  String runBenchmark(String camera);
+
+  /// Diagnostics builds only: installs the signed bundle staged (adb push) in
+  /// files/bundle-staging/ into the model store; new sessions use it. Returns
+  /// the installed version.
+  @async
+  String installModelBundle();
+
+  /// Diagnostics builds only: the model store's previous bundle becomes current
+  /// again. Returns that version.
+  @async
+  String rollbackModelBundle();
+
+  /// The model store's installed versions and its current one.
+  String modelStoreStatus();
+}
