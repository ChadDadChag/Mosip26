+        holder = new LivenessServiceHolder(context, globalParams, auditManager);
+    }
+
+    private final AuditManagerService auditManager = mock(AuditManagerService.class);
+
+    @Test
+    public void aModelUpdateCheckNeedsUpdatesEnabledWithAValidUrl() {
+        assertUpdateRefused("disabled");
+        holder.setOverride(ModelUpdates.ENABLED_KEY, "true");
+        assertUpdateRefused("no " + ModelUpdates.URL_KEY);
+        holder.setOverride(ModelUpdates.URL_KEY, "not a url");
+        assertUpdateRefused("not a valid URL");
+        // Not a diagnostics build: plain HTTP is refused before any connection, and the outcome is audited.
+        holder.setOverride(ModelUpdates.URL_KEY, "http://127.0.0.1:9/latest.json");
+        ModelUpdater.UpdateResult r = holder.checkModelUpdate("manual");
+        assertEquals(ModelUpdater.Status.FAILED, r.status());
+        assertEquals(ModelUpdater.Reason.INSECURE_TRANSPORT, r.reason());
+        verify(auditManager, timeout(2000)).audit(eq(AuditEvent.LIVENESS_MODEL_UPDATE), eq(Components.HOME),
