+ *   <li>The real engine's anonymised metrics are added to {@link LivenessMetricsStore} after each session.</li>
+ * </ul>
+ */
+public final class LivenessServiceHolder {
+
+    private static final String TAG = "LivenessService";
+    public static final String MODEL_STORE_DIR = "liveness-models";
+    public static final String CAMERA_KEY_PREFIX = "mosip.registration.liveness.face.android.";
+    public static final String EXPOSURE_ASSIST_KEY = CAMERA_KEY_PREFIX + "exposureAssist";
+
+    /**
+     * Analyzer settings used on Android when the config does not set them: the fastest setting of the on-device
+     * benchmark (Samsung S23 FE) whose scores and landmarks match the CPU 1-thread reference
+     * (Mosip26 docs/part5-android-benchmark.md). Any analyzer key in the synced config or an override wins.
+     */
+    static final Map<String, String> ANDROID_ANALYZER_DEFAULTS;
+
+    static {
+        Map<String, String> m = new HashMap<>();
+        m.put(AnalyzerConfig.KEY_PREFIX + "intraOpThreads", "2");
+        m.put(AnalyzerConfig.KEY_PREFIX + "accelerator", "CPU");
+        ANDROID_ANALYZER_DEFAULTS = Collections.unmodifiableMap(m);
+    }
+
+    private final Context context;
+    private final AndroidAuditSink audit;
+    private final ConfigProvider baseConfig;
+    private final Map<String, String> overrides = new ConcurrentHashMap<>();
+    private final ConfigProvider config = this::configValue;
+    private final ExecutorService background = Executors.newSingleThreadExecutor(r -> {
+        Thread t = new Thread(r, "liveness-background");
+        t.setDaemon(true);
+        return t;
+    });
+
+    private final SwappableAnalyzerFactory analyzers;
+    private final TimedAnalyzerFactory timedAnalyzers;
+    private final DefaultLivenessService real;
+    private volatile FakeLivenessService fake;
+    private String analyzerFingerprint; // guarded by this
+    private volatile int analyzerSwaps;
+
+    private volatile String modelVersion = "";
+    private LivenessMetricsStore metricsStore; // created on first use
+    // Main thread only: the live preview views, newest last (a screen opened over another one has its own).
+    private final List<PreviewView> previews = new ArrayList<>();
+
+    public LivenessServiceHolder(Context context, GlobalParamRepository globalParams, AuditManagerService auditManager) {
+        this.context = context.getApplicationContext();
+        this.audit = new AndroidAuditSink(auditManager);
+        this.baseConfig = new AndroidConfigProvider(globalParams);
+        AnalyzerConfig analyzerConfig = analyzerConfig(config);
+        this.analyzerFingerprint = fingerprint(analyzerConfig);
+        this.analyzers = new SwappableAnalyzerFactory(analyzerFactory(analyzerConfig));
+        this.timedAnalyzers = new TimedAnalyzerFactory(analyzers);
+        this.real = DefaultLivenessService.builder().config(config).analyzerFactory(timedAnalyzers).auditSink(audit).build();
+        this.fake = fakeService(1.0);
+        // After a global-param sync (or any cache refresh), new sessions use the new config.
+        globalParams.addRefreshListener(this::reloadConfig);
+    }
+
+    private OnnxFaceAnalyzerFactory analyzerFactory(AnalyzerConfig analyzerConfig) {
+        return new OnnxFaceAnalyzerFactory(new AssetBundleSource(context), modelStore(), TrustedKeys.builtIn(),
+                analyzerConfig);
+    }
+
+    private ModelStore modelStore() {
+        return new ModelStore(new File(context.getFilesDir(), MODEL_STORE_DIR));
+    }
+
+    private FakeLivenessService fakeService(double timeScale) {
+        return FakeLivenessService.builder(config).timeScale(timeScale).auditSink(audit).build();
+    }
+
+    /** Verifies the model bundle and builds the ONNX sessions on a background thread; logs the time taken. */
+    public void preload() {
+        background.execute(() -> {
+            long start = SystemClock.elapsedRealtime();
+            OnnxFaceAnalyzerFactory factory = analyzers.current();
+            try {
+                factory.preload();
+                long ms = SystemClock.elapsedRealtime() - start;
+                modelVersion = factory.modelVersion();
+                String accelerator = String.valueOf(factory.activeAccelerator());
+                Log.i(TAG, "preload: bundle " + modelVersion + " verified and loaded in " + ms + " ms (" + accelerator + ")");
+                Map<String, String> d = new HashMap<>();
+                d.put("modelVersion", modelVersion);
+                d.put("loadMs", Long.toString(ms));
+                d.put("accelerator", accelerator);
+                audit.record(AuditSink.Event.MODEL_LOADED, null, null, d);
+            } catch (LivenessEngineException e) {
+                preloadFailed(e.code(), e, start);
+            } catch (RuntimeException | LinkageError e) {
+                preloadFailed(ErrorCode.ENGINE_ERROR, e, start);
+            }
+        });
+    }
+
+    private void preloadFailed(ErrorCode code, Throwable e, long start) {
+        Log.e(TAG, "preload failed after " + (SystemClock.elapsedRealtime() - start) + " ms: " + code, e);
+        Map<String, String> d = new HashMap<>();
+        d.put("errorCode", code.name());
+        d.put("phase", "preload");
+        audit.record(AuditSink.Event.MODEL_INTEGRITY_FAILED, null, null, d);
+    }
+
+    public LivenessService service(boolean useFake) {
+        return useFake ? fake : real;
+    }
+
+    public LivenessPolicy policy(WorkflowType workflow) {
+        return real.policy(workflow);
+    }
+
+    /**
+     * The engine's anonymised operational metrics since app start (counts, rates and averages; no session ids,
+     * individual scores or images). The fake engine keeps its own, reset when its speed is changed.
+     */
+    public LivenessMetrics.Snapshot metrics(boolean useFake) {
+        return (useFake ? fake.metrics() : real.metrics()).snapshot();
+    }
+
+    /**
+     * Adds the real engine's metrics since the last call to the persisted totals (after each real session). The fake
+     * engine's are not persisted: they are test runs.
+     */
+    public void recordMetrics() {
+        metricsStore().merge(real.metrics());
+    }
+
+    /** The persisted totals (since install or the last reset) and the rates derived from them. */
+    public Map<String, String> persistedMetrics() {
+        return metricsStore().derived();
+    }
+
+    public void resetMetrics() {
+        metricsStore().reset();
+    }
+
+    private synchronized LivenessMetricsStore metricsStore() {
+        if (metricsStore == null) {
+            metricsStore = new LivenessMetricsStore(
+                    context.getSharedPreferences(LivenessMetricsStore.PREFS, Context.MODE_PRIVATE));
+        }
+        return metricsStore;
+    }
+
+    /** {@value #EXPOSURE_ASSIST_KEY}: anything but "false" (or no value) keeps the dim-face exposure assist on. */
+    public boolean exposureAssist() {
+        String v = config.get(EXPOSURE_ASSIST_KEY);
+        return v == null || !"false".equalsIgnoreCase(v.trim());
+    }
+
+    /**
+     * Installs the signed bundle staged in {@code dir} into the model store ({@link ModelStore#install}: verified,
+     * strictly newer than the store's current one, atomic switch) and reloads the analyzer, so the next session uses
+     * it; a running session keeps its models. The first install also installs the bundled models (verified) as the
+     * store's base, so that {@link #rollbackModelBundle()} can return to them.
+     *
+     * @return the installed version
+     * @throws LivenessEngineException  MODEL_INTEGRITY_FAILED for a bundle that does not verify (the store is unchanged)
+     * @throws IllegalArgumentException for a bundle that is not newer than the current one
+     */
+    public synchronized String installModelBundle(File dir) throws LivenessEngineException, IOException {
+        DirectoryBundleSource staged = new DirectoryBundleSource(dir);
+        VerifiedBundle.load(staged, TrustedKeys.builtIn()); // a bad bundle fails here, before the store is touched
+        ModelStore store = modelStore();
+        if (store.installedVersions().isEmpty()) {
+            String base = store.install(new AssetBundleSource(context), TrustedKeys.builtIn());
+            Log.i(TAG, "model store: bundled " + base + " installed as the base for rollback");
+        }
+        String v = store.install(staged, TrustedKeys.builtIn());
+        Log.i(TAG, "model store: installed " + v + " from " + dir);
+        reloadModels();
+        return v;
+    }
+
+    /** Operator action: the store's previous bundle becomes current again ({@link ModelStore#rollback}), then a reload. */
+    public synchronized String rollbackModelBundle() throws LivenessEngineException, IOException {
+        String v = modelStore().rollback(TrustedKeys.builtIn());
+        Log.i(TAG, "model store: rolled back to " + v);
+        reloadModels();
+        return v;
+    }
+
+    /** The store's installed versions (oldest first) and its current one. */
+    public synchronized String modelStoreStatus() {
+        ModelStore store = modelStore();
+        String current;
+        try {
+            current = store.currentVersion();
+        } catch (LivenessEngineException e) {
+            current = "unreadable (" + e.code() + ")";
+        }
+        return "installed " + store.installedVersions() + ", current " + (current == null ? "none (bundled)" : current);
+    }
+
+    /** New sessions use the newest verified bundle (store or assets); running sessions keep theirs. */
+    private void reloadModels() {
+        modelVersion = "";
+        analyzers.swap(analyzerFactory(analyzerConfig(config)));
+        analyzerSwaps++;
+        preload();
+    }
+
+    /** The bundled models plus each signed test bundle directory under {@code dir} (benchmark only). */
+    public List<AnalyzerBenchmark.Bundle> benchmarkBundles(File dir) {
+        List<AnalyzerBenchmark.Bundle> out = new ArrayList<>();
+        out.add(new AnalyzerBenchmark.Bundle("bundled", new AssetBundleSource(context)));
+        File[] dirs = dir == null ? null : dir.listFiles(File::isDirectory);
+        if (dirs != null) {
+            Arrays.sort(dirs);
+            for (File d : dirs) out.add(new AnalyzerBenchmark.Bundle(d.getName(), new DirectoryBundleSource(d)));
+        }
+        return out;
+    }
+
+    /** "back" when {@code mosip.registration.liveness.face.android.<workflow>.camera} says so, else "front". */
+    public String cameraFor(WorkflowType workflow) {
+        String v = config.get(CAMERA_KEY_PREFIX + workflow.name().toLowerCase(Locale.ROOT) + ".camera");
+        return v != null && "back".equalsIgnoreCase(v.trim()) ? "back" : "front";
+    }
+
+    /** The loaded bundle version, or "" before the models are loaded. */
+    public String modelVersion() {
+        return modelVersion;
+    }
+
+    /** Per-stage analysis times of the session in progress. */
+    public TimedAnalyzerFactory analyzerTimes() {
+        return timedAnalyzers;
+    }
+
+    /** For short background work of the bridge (session start, best-frame encoding). */
+    public ExecutorService background() {
+        return background;
+    }
+
+    /**
+     * Sets (or, with a null or empty value, removes) a config override and reloads both engines' policies.
+     * {@value FakeLivenessService#TIME_SCALE_PROPERTY} rebuilds the fake engine with that speed (1 = real time).
+     */
+    public void setOverride(String key, String value) {
+        if (key == null || key.trim().isEmpty()) return;
+        if (value == null || value.trim().isEmpty()) {
+            overrides.remove(key.trim());
+        } else {
+            overrides.put(key.trim(), value.trim());
+        }
+        if (FakeLivenessService.TIME_SCALE_PROPERTY.equals(key.trim())) {
+            double scale = 1.0;
+            try {
+                if (value != null && !value.trim().isEmpty()) scale = Math.max(0.0, Double.parseDouble(value.trim()));
+            } catch (NumberFormatException e) {
+                Log.w(TAG, "ignored fake time scale '" + value + "'");
+            }
+            fake = fakeService(scale);
+        }
+        reloadConfig();
+    }
+
+    public void clearOverrides() {
+        overrides.clear();
+        reloadConfig();
+    }
+
+    public Map<String, String> overrides() {
+        return Collections.unmodifiableMap(new TreeMap<>(overrides));
+    }
+
+    /**
+     * Re-reads the config (after a sync or an override change): the policies of new sessions, and, when the analyzer
+     * settings changed, a new analyzer for new sessions (loaded in the background). Running sessions keep theirs.
+     */
+    public synchronized void reloadConfig() {
+        real.reloadConfig(config);
+        fake.reloadConfig(config);
+        AnalyzerConfig next = analyzerConfig(config);
+        String print = fingerprint(next);
+        if (!print.equals(analyzerFingerprint)) {
+            analyzerFingerprint = print;
+            analyzers.swap(analyzerFactory(next));
+            analyzerSwaps++;
+            Log.i(TAG, "analyzer settings changed: new sessions use them");
+            preload();
+        }
+    }
+
+    /** How often the analyzer was replaced after a config change (tests). */
+    int analyzerSwaps() {
+        return analyzerSwaps;
+    }
+
+    /** A preview view was created (main thread); the next session binds its preview to the newest one. */
+    public void setPreview(PreviewView view) {
+        previews.remove(view);
+        previews.add(view);
+    }
+
+    /** The view was disposed: the one below it, if any, is current again. */
+    public void clearPreview(PreviewView view) {
+        previews.remove(view);
+    }
+
+    public PreviewView preview() {
+        return previews.isEmpty() ? null : previews.get(previews.size() - 1);
+    }
+
+    public Context context() {
+        return context;
+    }
+
+    private String configValue(String key) {
+        String v = overrides.get(key);
+        return v != null ? v : baseConfig.get(key);
+    }
+
+    /** The analyzer settings: configured keys first, then {@link #ANDROID_ANALYZER_DEFAULTS}. */
+    static AnalyzerConfig analyzerConfig(ConfigProvider config) {
+        ConfigProvider withDefaults = key -> {
+            String v = config.get(key);
+            return v != null && !v.trim().isEmpty() ? v : ANDROID_ANALYZER_DEFAULTS.get(key);
+        };
+        try {
+            return AnalyzerConfig.fromConfig(withDefaults);
+        } catch (IllegalArgumentException e) {
+            Log.e(TAG, "invalid analyzer config, using the Android defaults: " + e.getMessage());
+            return AnalyzerConfig.fromConfig(ANDROID_ANALYZER_DEFAULTS::get);
+        }
+    }
+
+    /** The analyzer settings new sessions get (tests and the debug log). */
+    AnalyzerConfig analyzerSettings() {
+        return analyzerConfig(config);
+    }
+
+    /** The analyzer settings as text (its public fields, and those of nested settings), to see if they changed. */
+    static String fingerprint(Object settings) {
+        StringBuilder sb = new StringBuilder();
+        appendFields(sb, settings, true);
+        return sb.toString();
+    }
+
+    private static void appendFields(StringBuilder sb, Object o, boolean nested) {
+        Field[] fields = o.getClass().getFields();
+        Arrays.sort(fields, (a, b) -> a.getName().compareTo(b.getName()));
+        for (Field f : fields) {
+            if (Modifier.isStatic(f.getModifiers())) continue;
+            Object v;
+            try {
+                v = f.get(o);
+            } catch (IllegalAccessException e) {
+                v = "?";
+            }
+            sb.append(f.getName()).append('=');
+            if (nested && v != null && !(v instanceof Enum) && v.getClass().getName().startsWith("io.mosip.")) {
+                sb.append('{');
+                appendFields(sb, v, false);
+                sb.append('}');
+            } else {
+                sb.append(v);
+            }
+            sb.append(';');
+        }
+    }
+}
diff --git a/android/liveness/src/main/java/io/mosip/registration/liveness/android/SwappableAnalyzerFactory.java b/android/liveness/src/main/java/io/mosip/registration/liveness/android/SwappableAnalyzerFactory.java
new file mode 100644
index 0000000..a38ba68
--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/SwappableAnalyzerFactory.java
@@ -0,0 +1,116 @@
+package io.mosip.registration.liveness.android;
+
+import io.mosip.registration.liveness.analyzer.OnnxFaceAnalyzerFactory;
+import io.mosip.registration.liveness.api.FaceAnalyzer;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.FrameAnalysis;
+import io.mosip.registration.liveness.api.LivenessEngineException;
+import io.mosip.registration.liveness.core.session.FaceAnalyzerFactory;
+
+/**
+ * The analyzer factory the engine uses, replaceable when the analyzer config changes (after a config sync).
+ * New sessions get analyzers from the current factory; a replaced factory is closed (releasing its ONNX sessions)
+ * once the analyzers created from it, i.e. those of a running session, are closed. So a running session keeps
+ * its analyzer, as the contract keeps its policy.
+ */
+final class SwappableAnalyzerFactory implements FaceAnalyzerFactory {
+
+    static final class Entry {
+        final OnnxFaceAnalyzerFactory factory;
+        int users;
+        boolean retired;
+
+        Entry(OnnxFaceAnalyzerFactory factory) {
+            this.factory = factory;
+        }
+    }
+
+    private Entry current;
+
+    SwappableAnalyzerFactory(OnnxFaceAnalyzerFactory initial) {
+        if (initial == null) throw new IllegalArgumentException("initial factory is required");
+        this.current = new Entry(initial);
+    }
+
+    synchronized OnnxFaceAnalyzerFactory current() {
+        return current.factory;
+    }
+
+    /** Makes {@code next} current; the previous factory closes when its last analyzer does (at once if unused). */
+    void swap(OnnxFaceAnalyzerFactory next) {
+        if (next == null) throw new IllegalArgumentException("next factory is required");
+        Entry old;
+        synchronized (this) {
+            old = current;
+            current = new Entry(next);
+            old.retired = true;
+            if (old.users > 0) return;
+        }
+        old.factory.close();
+    }
+
+    @Override
+    public FaceAnalyzer create() throws LivenessEngineException {
+        Entry entry;
+        synchronized (this) {
+            entry = current;
+            entry.users++;
+        }
+        try {
+            return new Counted(this, entry.factory.create(), entry);
+        } catch (LivenessEngineException | RuntimeException e) {
+            release(entry);
+            throw e;
+        }
+    }
+
+    private void release(Entry entry) {
+        synchronized (this) {
+            entry.users--;
+            if (!entry.retired || entry.users > 0) return;
+        }
+        entry.factory.close();
+    }
+
+    /** An analyzer that releases its factory when closed. */
+    static final class Counted implements FaceAnalyzer {
+        private final SwappableAnalyzerFactory owner;
+        private final FaceAnalyzer analyzer;
+        private final Entry entry;
+        private boolean closed;
+
+        Counted(SwappableAnalyzerFactory owner, FaceAnalyzer analyzer, Entry entry) {
+            this.owner = owner;
+            this.analyzer = analyzer;
+            this.entry = entry;
+        }
+
+        /** The engine's analyzer, for its per-stage statistics. */
+        FaceAnalyzer inner() {
+            return analyzer;
+        }
+
+        @Override
+        public FrameAnalysis analyze(Frame frame) throws LivenessEngineException {
+            return analyzer.analyze(frame);
+        }
+
+        @Override
+        public String modelVersion() {
+            return analyzer.modelVersion();
+        }
+
+        @Override
+        public void close() {
+            synchronized (this) {
+                if (closed) return;
+                closed = true;
+            }
+            try {
+                analyzer.close();
+            } finally {
+                owner.release(entry);
+            }
+        }
+    }
+}
diff --git a/android/liveness/src/main/java/io/mosip/registration/liveness/android/TimedAnalyzerFactory.java b/android/liveness/src/main/java/io/mosip/registration/liveness/android/TimedAnalyzerFactory.java
new file mode 100644
index 0000000..80f6531
--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/TimedAnalyzerFactory.java
@@ -0,0 +1,127 @@
+package io.mosip.registration.liveness.android;
+
+import java.util.Arrays;
+import java.util.Locale;
+
+import io.mosip.registration.liveness.analyzer.AnalyzerStats;
+import io.mosip.registration.liveness.analyzer.OnnxFaceAnalyzer;
+import io.mosip.registration.liveness.api.FaceAnalyzer;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.FrameAnalysis;
+import io.mosip.registration.liveness.api.LivenessEngineException;
+import io.mosip.registration.liveness.core.session.FaceAnalyzerFactory;
+
+/**
+ * Wraps the analyzer factory to collect per-stage analysis times for the session in progress (one at a time):
+ * {@link #reset()} when a session starts, {@link #summary()} when it ends. Timings only; frames are not kept.
+ */
+public final class TimedAnalyzerFactory implements FaceAnalyzerFactory {
+
+    static final String[] STAGES = {"total", "detect", "mesh", "pose", "quality", "pad", "cues"};
+
+    private final FaceAnalyzerFactory delegate;
+    private final long[][] samples = new long[STAGES.length][];
+    private final int[] counts = new int[STAGES.length];
+    private long firstNs;
+    private long lastNs;
+    private AnalyzerStats lastStats;
+
+    public TimedAnalyzerFactory(FaceAnalyzerFactory delegate) {
+        if (delegate == null) throw new IllegalArgumentException("delegate is required");
+        this.delegate = delegate;
+        reset();
+    }
+
+    @Override
+    public FaceAnalyzer create() throws LivenessEngineException {
+        return new Timed(delegate.create());
+    }
+
+    public synchronized void reset() {
+        for (int i = 0; i < STAGES.length; i++) {
+            samples[i] = new long[64];
+            counts[i] = 0;
+        }
+        firstNs = 0L;
+        lastNs = 0L;
+        lastStats = null;
+    }
+
+    /** Frames analysed since {@link #reset()}, their rate, and p50/p95 per stage in ms (stages that ran). */
+    public synchronized String summary() {
+        int frames = counts[0];
+        double seconds = frames > 1 ? (lastNs - firstNs) / 1e9 : 0.0;
+        StringBuilder sb = new StringBuilder(String.format(Locale.ROOT, "analysed %d frames in %.1f s (%.1f fps)",
+                frames, seconds, seconds > 0 ? (frames - 1) / seconds : 0.0));
+        for (int i = 0; i < STAGES.length; i++) {
+            if (counts[i] == 0) continue;
+            long[] sorted = Arrays.copyOf(samples[i], counts[i]);
+            Arrays.sort(sorted);
+            sb.append(String.format(Locale.ROOT, "; %s p50 %.1f p95 %.1f ms (n=%d)",
+                    STAGES[i], percentile(sorted, 0.50) / 1e6, percentile(sorted, 0.95) / 1e6, counts[i]));
+        }
+        AnalyzerStats s = lastStats;
+        if (s != null) {
+            sb.append(String.format(Locale.ROOT, "; faces none %d one %d multi %d, pose-gated %d",
+                    s.framesNoFace(), s.framesOneFace(), s.framesMultiFace(), s.framesPoseGated()));
+        }
+        return sb.toString();
+    }
+
+    /** Nearest-rank percentile of a sorted, non-empty array. */
+    static long percentile(long[] sorted, double p) {
+        int rank = (int) Math.ceil(p * sorted.length);
+        return sorted[Math.max(0, Math.min(sorted.length - 1, rank - 1))];
+    }
+
+    private synchronized void record(long totalNs, AnalyzerStats stats) {
+        long now = System.nanoTime();
+        if (counts[0] == 0) firstNs = now;
+        lastNs = now;
+        add(0, totalNs);
+        if (stats != null) {
+            add(1, stats.lastDetectNs());
+            add(2, stats.lastMeshNs());
+            add(3, stats.lastPoseNs());
+            add(4, stats.lastQualityNs());
+            add(5, stats.lastPadNs());
+            add(6, stats.lastCuesNs());
+            lastStats = stats;
+        }
+    }
+
+    private void add(int stage, long ns) {
+        if (ns <= 0) return; // the stage did not run on this frame
+        if (counts[stage] == samples[stage].length) samples[stage] = Arrays.copyOf(samples[stage], counts[stage] * 2);
+        samples[stage][counts[stage]++] = ns;
+    }
+
+    private final class Timed implements FaceAnalyzer {
+        private final FaceAnalyzer analyzer;
+
+        Timed(FaceAnalyzer analyzer) {
+            this.analyzer = analyzer;
+        }
+
+        @Override
+        public FrameAnalysis analyze(Frame frame) throws LivenessEngineException {
+            long start = System.nanoTime();
+            FrameAnalysis result = analyzer.analyze(frame);
+            long total = System.nanoTime() - start;
+            FaceAnalyzer engine = analyzer instanceof SwappableAnalyzerFactory.Counted
+                    ? ((SwappableAnalyzerFactory.Counted) analyzer).inner() : analyzer;
+            record(total, engine instanceof OnnxFaceAnalyzer ? ((OnnxFaceAnalyzer) engine).stats() : null);
+            return result;
+        }
+
+        @Override
+        public String modelVersion() {
+            return analyzer.modelVersion();
+        }
+
+        @Override
+        public void close() {
+            analyzer.close();
+        }
+    }
+}
