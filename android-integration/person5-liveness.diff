+++ b/test/liveness/liveness_gate_test.dart
@@ -0,0 +1,193 @@
+import 'dart:typed_data';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:registration_client/ui/liveness/liveness_gate.dart';
+import 'package:registration_client/ui/liveness/liveness_page.dart';
+
+import 'fake_liveness_service.dart';
+
+/// Calls LivenessGate.run like a screen does, from the page itself or from inside a dialog.
+class _GateHost extends StatelessWidget {
+  const _GateHost(this.service, this.workflow, this.onResult);
+
+  final FakeLivenessService service;
+  final String workflow;
+  final void Function(GateResult) onResult;
+
+  Future<void> _run(BuildContext context) async {
+    onResult(await LivenessGate.run(context,
+        workflow: workflow,
+        service: service,
+        previewBuilder: () => const ColoredBox(color: Colors.grey)));
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+        body: Column(
+          children: [
+            ElevatedButton(onPressed: () => _run(context), child: const Text('run')),
+            ElevatedButton(
+              onPressed: () => showDialog<void>(
+                context: context,
+                builder: (dialogContext) => AlertDialog(
+                  content: const Text('approve dialog'),
+                  actions: [
+                    TextButton(onPressed: () => _run(dialogContext), child: const Text('run in dialog')),
+                  ],
+                ),
+              ),
+              child: const Text('dialog'),
+            ),
+          ],
+        ),
+      );
+}
+
+void main() {
+  late FakeLivenessService service;
+  GateResult? result;
+
+  setUp(() {
+    service = FakeLivenessService();
+    result = null;
+  });
+
+  Future<void> host(WidgetTester tester, {String workflow = LivenessGate.resident}) async {
+    await tester.binding.setSurfaceSize(const Size(411, 891));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    await tester.pumpWidget(MaterialApp(
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      home: _GateHost(service, workflow, (r) => result = r),
+    ));
+  }
+
+  Future<void> tap(WidgetTester tester, String text) async {
+    await tester.ensureVisible(find.text(text));
+    await tester.pump();
+    await tester.tap(find.text(text));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 400));
+  }
+
+  Future<void> send(WidgetTester tester, Map<String, Object?> m) async {
+    service.emit(m);
+    await tester.pump();
+    await tester.pump();
+  }
+
+  Future<void> passSession(WidgetTester tester, {Uint8List? jpeg}) async {
+    await send(tester, ev('STARTED'));
+    await send(tester, ev('PASSED'));
+    final done = complete('PASSED');
+    done['bestFrameJpeg'] = jpeg;
+    await send(tester, done);
+    await tester.pump(const Duration(milliseconds: 1100));
+    await tester.pump(const Duration(milliseconds: 400));
+  }
+
+  group('outcome mapping', () {
+    test('fromOutcome', () {
+      expect(GateResult.fromOutcome(null).cancelled, isTrue);
+      expect(GateResult.fromOutcome(LivenessOutcome.cancelledOutcome).cancelled, isTrue);
+      final disabled = GateResult.fromOutcome(LivenessOutcome.disabledOutcome);
+      expect(disabled.proceed && disabled.disabled, isTrue);
+      final passed = GateResult.fromOutcome(const LivenessOutcome(passed: true, sessionId: 's-9'));
+      expect(passed.proceed && !passed.disabled, isTrue);
+      expect(passed.sessionId, 's-9');
+      const failed = LivenessOutcome(failureCode: 'MAX_RETRIES_EXCEEDED', userMessage: 'MAX_ATTEMPTS_REACHED');
+      expect(GateResult.fromOutcome(failed).blocked, isTrue);
+      expect(GateResult.fromOutcome(failed).failureMessageKey, 'liveness.error.max_attempts_reached');
+      const camera = LivenessOutcome(failureCode: 'CAMERA_UNAVAILABLE', userMessage: 'DEVICE_PROBLEM');
+      expect(GateResult.fromOutcome(camera).failureMessageKey, 'liveness.error.device_problem');
+    });
+  });
+
+  testWidgets('passed: proceed with the outcome and the best frame', (tester) async {
+    await host(tester);
+    await tap(tester, 'run');
+    expect(find.byType(LivenessPage), findsOneWidget);
+    await passSession(tester, jpeg: Uint8List.fromList([0xFF, 0xD8, 1]));
+    expect(result!.proceed, isTrue);
+    expect(result!.disabled, isFalse);
+    expect(result!.sessionId, 's-1');
+    expect(result!.bestFrameJpeg, [0xFF, 0xD8, 1]);
+    expect(find.byType(LivenessPage), findsNothing);
+  });
+
+  testWidgets('Cancel: cancelled', (tester) async {
+    await host(tester);
+    await tap(tester, 'run');
+    await send(tester, ev('CHECKING_PASSIVE'));
+    await tap(tester, 'Cancel');
+    expect(result!.cancelled, isTrue);
+    expect(service.cancels, 1);
+  });
+
+  testWidgets('failed: blocked with the outcome', (tester) async {
+    await host(tester);
+    await tap(tester, 'run');
+    await send(tester, ev('FAILED_FINAL',
+        attempt: 4, error: 'MAX_RETRIES_EXCEEDED', userMessage: 'MAX_ATTEMPTS_REACHED', recoverable: false));
+    await send(tester, complete('FAILED', failureCode: 'MAX_RETRIES_EXCEEDED', userMessage: 'MAX_ATTEMPTS_REACHED'));
+    await tap(tester, 'Close');
+    expect(result!.blocked, isTrue);
+    expect(result!.outcome!.failureCode, 'MAX_RETRIES_EXCEEDED');
+    expect(result!.failureMessageKey, 'liveness.error.max_attempts_reached');
+  });
+
+  testWidgets('disabled workflow: proceed(disabled) without opening the page', (tester) async {
+    service.enabled = false;
+    await host(tester, workflow: LivenessGate.operator);
+    await tester.tap(find.text('run'));
+    await tester.pump();
+    expect(find.byType(LivenessPage), findsNothing);
+    expect(result!.proceed, isTrue);
+    expect(result!.disabled, isTrue);
+    expect(service.started, isEmpty);
+  });
+
+  testWidgets('the workflow\'s configured camera is used', (tester) async {
+    service.cameras = {LivenessGate.operator: 'back'};
+    await host(tester, workflow: LivenessGate.operator);
+    await tap(tester, 'run');
+    expect(service.started, ['OPERATOR/back/false']);
+    await tap(tester, 'Cancel');
+  });
+
+  testWidgets('from inside a dialog: the page opens on the root navigator, the dialog stays', (tester) async {
+    await host(tester, workflow: LivenessGate.supervisor);
+    await tap(tester, 'dialog');
+    expect(find.text('approve dialog'), findsOneWidget);
+    await tap(tester, 'run in dialog');
+    expect(find.byType(LivenessPage), findsOneWidget);
+    expect(find.text('Supervisor face verification'), findsOneWidget);
+    await passSession(tester);
+    expect(result!.proceed, isTrue);
+    expect(find.byType(LivenessPage), findsNothing);
+    expect(find.text('approve dialog'), findsOneWidget);
+  });
+
+  testWidgets('a page popped some other way counts as cancelled and releases the session', (tester) async {
+    await host(tester);
+    await tap(tester, 'run');
+    await send(tester, ev('CHECKING_PASSIVE'));
+    Navigator.of(tester.element(find.byType(LivenessPage))).pop();
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 400));
+    expect(result!.cancelled, isTrue);
+    expect(service.cancels, 1);
+  });
+
+  testWidgets('an error fails closed as blocked', (tester) async {
+    service.throwOnIsEnabled = StateError('bridge down');
+    await host(tester);
+    await tester.tap(find.text('run'));
+    await tester.pump();
+    expect(result!.blocked, isTrue);
+    expect(result!.outcome!.failureCode, 'ENGINE_ERROR');
+    expect(find.byType(LivenessPage), findsNothing);
+  });
+}
