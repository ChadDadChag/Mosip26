+<?xml version="1.0" encoding="utf-8"?>
+<!-- Debug and profile builds only, never release. It replaces clientmanager's network_security_config.xml (used in
+     all builds) and keeps what that file sets: no plain HTTP. The one difference: plain HTTP to this phone itself
+     (127.0.0.1, localhost), for testing the liveness model update against a laptop server through
+     `adb reverse tcp:8000 tcp:8000`. -->
+<network-security-config>
+    <base-config cleartextTrafficPermitted="false" />
+    <!-- As in clientmanager's network_security_config.xml. -->
+    <domain-config cleartextTrafficPermitted="false">
+        <domain includeSubdomains="true">jsonplaceholder.typicode.com</domain>
+        <domain includeSubdomains="true">dev.mosip.net</domain>
+    </domain-config>
+    <domain-config cleartextTrafficPermitted="true">
+        <domain includeSubdomains="false">127.0.0.1</domain>
+        <domain includeSubdomains="false">localhost</domain>
+    </domain-config>
+</network-security-config>
