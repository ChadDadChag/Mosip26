+import 'dart:async';
+
+import 'package:registration_client/pigeon/liveness_pigeon.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+
+/// A scripted LivenessService: the test emits the engine's maps.
+class FakeLivenessService implements LivenessService {
+  final StreamController<LivenessMessage> _messages = StreamController<LivenessMessage>.broadcast();
+  bool enabled = true;
+  CameraPermission permission = CameraPermission.granted;
+  Map<String, String> cameras = {};
+  int maxRetries = 3;
+  String sessionId = 's-1';
+  int retries = 0;
+  int cancels = 0;
+  int permissionRequests = 0;
+  int settingsOpened = 0;
+  Object? throwOnIsEnabled;
+  final List<String> started = [];
+
+  void emit(Map<String, Object?> m) => _messages.add(LivenessMessage(m));
+
+  @override
+  Stream<LivenessMessage> get messages => _messages.stream;
+
+  @override
+  Future<bool> isEnabled(String workflow) async {
+    if (throwOnIsEnabled != null) throw throwOnIsEnabled!;
+    return enabled;
+  }
+
+  @override
+  Future<LivenessPolicyInfo> policy(String workflow) async => LivenessPolicyInfo(
+      enabled: enabled, maxRetries: maxRetries, minChallenges: 2, challengeTimeoutMs: 6000);
+
+  @override
+  Future<CameraPermission> ensureCameraPermission() async {
+    permissionRequests++;
+    return permission;
+  }
+
+  @override
+  Future<void> openCameraSettings() async => settingsOpened++;
+
+  @override
+  Future<String> cameraFor(String workflow) async => cameras[workflow] ?? 'front';
+
+  @override
+  Future<void> reloadConfig() async {}
+
+  @override
+  Future<String> startSession(String workflow, {String camera = 'front', bool useFake = false}) async {
+    started.add('$workflow/$camera/$useFake');
+    return enabled ? sessionId : '';
+  }
+
+  @override
+  Future<void> retry() async => retries++;
+
+  @override
+  Future<void> cancel() async => cancels++;
+
+  String version = 'test-model';
+
+  @override
+  Future<String> modelVersion() async => version;
+
+  /// The config overrides set, by key; an empty value removes one.
+  final Map<String, String> overrides = {};
+
+  @override
+  Future<void> setConfigOverride(String key, String value) async {
+    if (value.isEmpty) {
+      overrides.remove(key);
+    } else {
+      overrides[key] = value;
+    }
+  }
+
+  /// What armBinding returns (ARMED, DISABLED, REJECTED), or throws when [throwOnArm] is set.
+  String armResult = 'ARMED';
+  Object? throwOnArm;
+  final List<String> armed = [];
+
+  @override
+  Future<String> armBinding(String sessionId) async {
+    armed.add(sessionId);
+    if (throwOnArm != null) throw throwOnArm!;
+    return armResult;
+  }
+
+  /// What verifyIdentity returns, one per call (the last one repeats), or throws when [throwOnIdentity] is set.
+  List<IdentityCheckInfo> identityResults = [identity('MATCH')];
+  Object? throwOnIdentity;
+  final List<String> identityCalls = [];
+
+  @override
+  Future<IdentityCheckInfo> verifyIdentity(String sessionId, String userId, String gate, int attempt) async {
+    identityCalls.add('$sessionId/$userId/$gate/$attempt');
+    if (throwOnIdentity != null) throw throwOnIdentity!;
+    return identityResults[(identityCalls.length - 1).clamp(0, identityResults.length - 1)];
+  }
+}
+
+/// An identity check result as the native side returns it (similarity NaN, as in release builds).
+IdentityCheckInfo identity(String outcome, {bool? accepted, bool? retryable}) => IdentityCheckInfo(
+      outcome: outcome,
+      accepted: accepted ?? (outcome == 'MATCH' || outcome.startsWith('NOT_BOUND') || outcome == 'SKIPPED'),
+      retryable: retryable ?? !(outcome == 'MATCH' || outcome.startsWith('NOT_BOUND') || outcome == 'SKIPPED'),
+      similarity: double.nan,
+      threshold: 0.40,
+    );
+
+Map<String, Object?> ev(String type,
+        {int attempt = 1,
+        String? guidance,
+        String? challenge,
+        int index = 0,
+        int count = 0,
+        double progress = 0,
+        String? error,
+        String? userMessage,
+        int retriesLeft = 0,
+        bool recoverable = true}) =>
+    <String, Object?>{
+      'kind': 'event',
+      'type': type,
+      'guidance': guidance,
+      'challenge': challenge,
+      'challengeIndex': index,
+      'challengeCount': count,
+      'timeoutMs': 6000,
+      'progress': progress,
+      'error': error,
+      'userMessage': userMessage,
+      'attemptNumber': attempt,
+      'retriesLeft': retriesLeft,
+      'recoverable': recoverable,
+    };
+
+Map<String, Object?> complete(String decision,
+        {String? failureCode, String userMessage = 'NONE', String sessionId = 's-1'}) =>
+    <String, Object?>{
+      'kind': 'complete',
+      'decision': decision,
+      'passPath': decision == 'PASSED' ? 'ACTIVE_CHALLENGE' : 'NONE',
+      'failureCode': failureCode,
+      'userMessage': userMessage,
+      'passiveScore': 0.62,
+      'challengesIssued': const <String>['BLINK', 'SMILE'],
+      'attempts': 1,
+      'durationMs': 4321,
+      'sessionId': sessionId,
+      'modelVersion': 'test-model',
+      'bestFrameJpeg': null,
+    };
