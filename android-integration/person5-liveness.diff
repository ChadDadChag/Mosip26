+++ b/lib/ui/liveness/liveness_page.dart
@@ -0,0 +1,571 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'dart:async';
+import 'dart:math' as math;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+import 'package:registration_client/ui/liveness/liveness_controller.dart';
+import 'package:registration_client/ui/liveness/liveness_strings.dart';
+
+/// What [LivenessPage] returns with `Navigator.pop`.
+@immutable
+class LivenessOutcome {
+  const LivenessOutcome({
+    this.passed = false,
+    this.cancelled = false,
+    this.disabled = false,
+    this.passPath,
+    this.failureCode,
+    this.userMessage,
+    this.bestFrameJpeg,
+    this.sessionId,
+    this.attempts = 0,
+    this.durationMs = 0,
+    this.modelVersion,
+  });
+
+  factory LivenessOutcome.fromResult(LivenessMessage r) => LivenessOutcome(
+        passed: r.decision == 'PASSED',
+        cancelled: r.decision == 'CANCELLED',
+        passPath: r.passPath,
+        failureCode: r.failureCode,
+        userMessage: r.userMessage,
+        bestFrameJpeg: r.bestFrameJpeg,
+        sessionId: r.sessionId,
+        attempts: r.attempts,
+        durationMs: r.durationMs,
+        modelVersion: r.modelVersion,
+      );
+
+  /// Liveness is disabled for the workflow: the caller keeps its legacy flow.
+  static const LivenessOutcome disabledOutcome = LivenessOutcome(disabled: true);
+  static const LivenessOutcome cancelledOutcome = LivenessOutcome(cancelled: true);
+
+  final bool passed;
+  final bool cancelled;
+  final bool disabled;
+  final String? passPath;
+  final String? failureCode;
+  final String? userMessage;
+
+  /// JPEG of the best frame, on passed only. Keep it in memory.
+  final Uint8List? bestFrameJpeg;
+  final String? sessionId;
+  final int attempts;
+  final int durationMs;
+  final String? modelVersion;
+
+  @override
+  String toString() => 'LivenessOutcome(passed=$passed cancelled=$cancelled disabled=$disabled '
+      'passPath=$passPath failure=$failureCode message=$userMessage attempts=$attempts '
+      '${durationMs}ms bestFrame=${bestFrameJpeg == null ? '-' : '${bestFrameJpeg!.length} bytes'})';
+}
+
+/// The face liveness step (docs/ui-liveness-spec.md): checks that liveness is
+/// enabled for [workflow], asks for the camera, starts a session and renders its
+/// events. Pops a [LivenessOutcome]: passed (about 1 s after the success state),
+/// failed (after Close), cancelled (Cancel or back) or disabled.
+class LivenessPage extends StatefulWidget {
+  const LivenessPage({
+    super.key,
+    required this.workflow,
+    this.camera = 'front',
+    this.useFake = false,
+    this.previewBuilder,
+    this.service,
+    this.showDebugInfo = true,
+  });
+
+  static const String previewViewType = 'io.mosip.registration_client/liveness_preview';
+  static const Duration passedDelay = Duration(seconds: 1);
+
+  /// RESIDENT, OPERATOR or SUPERVISOR.
+  final String workflow;
+
+  /// front or back.
+  final String camera;
+
+  /// The scripted fake engine (debug and tests).
+  final bool useFake;
+
+  /// Replaces the camera preview (tests, privacy-safe screenshots).
+  final Widget Function()? previewBuilder;
+
+  /// Defaults to the platform's [LivenessService].
+  final LivenessService? service;
+
+  /// Debug builds only: a small chip with the model version (off for documentation screenshots).
+  final bool showDebugInfo;
+
+  @override
+  State<LivenessPage> createState() => _LivenessPageState();
+}
+
+class _LivenessPageState extends State<LivenessPage> {
+  late final LivenessService _service = widget.service ?? LivenessService();
+  late final LivenessController _controller = LivenessController(workflow: widget.workflow);
+  final Completer<void> _previewReady = Completer<void>();
+  StreamSubscription<LivenessMessage>? _subscription;
+  Timer? _passedTimer;
+  String? _sessionId;
+  bool _sessionRunning = false;
+  bool _popped = false;
+  String _debugModel = '';
+
+  @override
+  void initState() {
+    super.initState();
+    _controller.addListener(_onStateChanged);
+    _subscription = _service.messages.listen(_onMessage);
+    if (widget.previewBuilder != null || widget.useFake) _previewReady.complete();
+    _begin();
+  }
+
+  @override
+  void dispose() {
+    _passedTimer?.cancel();
+    _subscription?.cancel();
+    if (_sessionRunning) _service.cancel(); // leaving the screen releases the camera
+    _controller.removeListener(_onStateChanged);
+    _controller.dispose();
+    super.dispose();
+  }
+
+  Future<void> _begin() async {
+    try {
+      if (!await _service.isEnabled(widget.workflow)) {
+        _pop(LivenessOutcome.disabledOutcome);
+        return;
+      }
+      // The fake engine uses no camera, so it needs no permission.
+      if (!widget.useFake) {
+        final permission = await _service.ensureCameraPermission();
+        if (permission != CameraPermission.granted) {
+          _controller.permissionDenied(permanently: permission == CameraPermission.permanentlyDenied);
+          return;
+        }
+      }
+      final policy = await _service.policy(widget.workflow);
+      _controller.maxRetries = policy.maxRetries;
+      if (kDebugMode && widget.showDebugInfo) _debugModel = await _service.modelVersion();
+      // Let the platform view exist first, so the session binds its preview.
+      await _previewReady.future.timeout(const Duration(seconds: 2), onTimeout: () {});
+      if (!mounted || _popped) return;
+      _sessionRunning = true;
+      final id = await _service.startSession(widget.workflow,
+          camera: widget.camera, useFake: widget.useFake);
+      if (id.isEmpty) {
+        _sessionRunning = false;
+        _pop(LivenessOutcome.disabledOutcome);
+        return;
+      }
+      _sessionId = id;
+    } on PlatformException catch (e) {
+      debugPrint('Liveness could not start: ${e.code}');
+      _sessionRunning = false;
+      _controller.startFailed();
+    }
+  }
+
+  void _onMessage(LivenessMessage m) {
+    if (_popped) return;
+    if (m.isComplete && _sessionId != null && m.sessionId != _sessionId) return; // an older session
+    _controller.handle(m);
+    if (!m.isComplete) return;
+    _sessionRunning = false;
+    switch (m.decision) {
+      case 'CANCELLED':
+        _pop(LivenessOutcome.fromResult(m));
+        break;
+      case 'PASSED':
+        _passedTimer = Timer(LivenessPage.passedDelay, () => _pop(LivenessOutcome.fromResult(m)));
+        break;
+      default:
+        break; // the final screen waits for Close
+    }
+  }
+
+  void _onStateChanged() {
+    if (mounted) setState(() {});
+  }
+
+  void _retry() => _service.retry();
+
+  void _cancel() {
+    if (_sessionRunning) _service.cancel();
+    _sessionRunning = false;
+    _pop(LivenessOutcome.cancelledOutcome);
+  }
+
+  void _close() {
+    final result = _controller.result;
+    if (result != null) {
+      _pop(LivenessOutcome.fromResult(result));
+    } else {
+      // Refused before a session existed: the camera permission, or the bridge failed.
+      final camera = _controller.state.messageKey == 'liveness.error.device_problem';
+      _pop(LivenessOutcome(
+        failureCode: camera ? 'CAMERA_UNAVAILABLE' : 'ENGINE_ERROR',
+        userMessage: camera ? 'DEVICE_PROBLEM' : 'VERIFICATION_NOT_COMPLETED',
+      ));
+    }
+  }
+
+  void _onBack() {
+    final state = _controller.state;
+    final result = _controller.result;
+    if (state.phase == LivenessPhase.passed && result != null) {
+      _passedTimer?.cancel();
+      _pop(LivenessOutcome.fromResult(result));
+    } else if (state.phase == LivenessPhase.failedFinal) {
+      _close();
+    } else {
+      _cancel();
+    }
+  }
+
+  void _pop(LivenessOutcome outcome) {
+    if (_popped || !mounted) return;
+    _popped = true;
+    Navigator.of(context).pop(outcome);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = AppLocalizations.of(context)!;
+    final s = _controller.state;
+    final tone = _toneColor(s.ovalTone);
+    return WillPopScope(
+      onWillPop: () async {
+        _onBack();
+        return false;
+      },
+      child: Scaffold(
+        appBar: AppBar(
+          title: Text(livenessText(l, _controller.titleKey)),
+          actions: [
+            if (kDebugMode && _debugModel.isNotEmpty)
+              Padding(
