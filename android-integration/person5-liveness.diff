diff --git a/android/liveness/src/test/java/io/mosip/registration/liveness/android/BindingImagesTest.java b/android/liveness/src/test/java/io/mosip/registration/liveness/android/BindingImagesTest.java
new file mode 100644
index 0000000..36ebbc5
--- /dev/null
+++ b/android/liveness/src/test/java/io/mosip/registration/liveness/android/BindingImagesTest.java
@@ -0,0 +1,82 @@
+package io.mosip.registration.liveness.android;
+
+import android.graphics.Bitmap;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import org.robolectric.annotation.GraphicsMode;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+/** The Android decoder of captured faces (BitmapFactory with Robolectric's native graphics; JP2 is device-only). */
+@RunWith(RobolectricTestRunner.class)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+@Config(sdk = 34)
+public class BindingImagesTest {
+
+    private static byte[] resource(String name) throws IOException {
+        try (InputStream in = BindingImagesTest.class.getResourceAsStream(name)) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[64 * 1024];
+            for (int n; (n = in.read(buf)) > 0; ) out.write(buf, 0, n);
+            return out.toByteArray();
+        }
+    }
+
+    @Test
+    public void aPngDecodesToTheSamePixelsAsTheDesktopDecoder() throws Exception {
+        byte[] png = resource("/golden/portrait_frontal.png");
+        FaceBinding.Rgb android = BindingImages.decode(png);
+        FaceBinding.Rgb desktop = FaceBindingTest.png("/golden/portrait_frontal.png");
+        assertEquals(desktop.width, android.width);
+        assertEquals(desktop.height, android.height);
+        assertArrayEquals("lossless PNG, packed RGB888", desktop.rgb, android.rgb);
+    }
+
+    @Test
+    public void aJpegDecodes() throws Exception {
+        FaceBinding.Rgb src = BindingImages.decode(resource("/golden/portrait_frontal.png"));
+        int[] argb = new int[src.width * src.height];
+        for (int i = 0, p = 0; i < argb.length; i++, p += 3) {
+            argb[i] = 0xFF000000 | ((src.rgb[p] & 0xFF) << 16) | ((src.rgb[p + 1] & 0xFF) << 8) | (src.rgb[p + 2] & 0xFF);
+        }
+        Bitmap bmp = Bitmap.createBitmap(argb, src.width, src.height, Bitmap.Config.ARGB_8888);
+        ByteArrayOutputStream jpeg = new ByteArrayOutputStream();
+        assertTrue(bmp.compress(Bitmap.CompressFormat.JPEG, 90, jpeg));
+        FaceBinding.Rgb back = BindingImages.decode(jpeg.toByteArray());
+        assertEquals(src.width, back.width);
+        assertEquals(src.height, back.height);
+        long diff = 0;
+        for (int i = 0; i < src.rgb.length; i++) diff += Math.abs((src.rgb[i] & 0xFF) - (back.rgb[i] & 0xFF));
+        assertTrue("JPEG at quality 90 stays close: mean " + (double) diff / src.rgb.length,
+                (double) diff / src.rgb.length < 4);
+    }
+
+    @Test
+    public void badOrEmptyBytesFail() {
+        assertThrows(IOException.class, () -> BindingImages.decode(new byte[] {1, 2, 3, 4, 5}));
+        assertThrows(IOException.class, () -> BindingImages.decode(new byte[0]));
+        assertThrows(IOException.class, () -> BindingImages.decode(null));
+    }
+
+    @Test
+    public void jpeg2000IsRecognisedBySignature() throws Exception {
+        byte[] jp2 = {0, 0, 0, 0x0C, 0x6A, 0x50, 0x20, 0x20, 0x0D, 0x0A, (byte) 0x87, 0x0A, 0, 0};
+        byte[] j2k = {(byte) 0xFF, 0x4F, (byte) 0xFF, 0x51, 0};
+        assertTrue(BindingImages.isJpeg2000(jp2));
+        assertTrue(BindingImages.isJpeg2000(j2k));
+        assertFalse(BindingImages.isJpeg2000(resource("/golden/portrait_frontal.png")));
+        assertFalse(BindingImages.isJpeg2000(new byte[] {(byte) 0xFF, (byte) 0xD8, (byte) 0xFF}));
+        assertFalse(BindingImages.isJpeg2000(null));
+    }
+}
diff --git a/android/liveness/src/test/java/io/mosip/registration/liveness/android/FaceBindingTest.java b/android/liveness/src/test/java/io/mosip/registration/liveness/android/FaceBindingTest.java
new file mode 100644
index 0000000..e9bff1b
--- /dev/null
+++ b/android/liveness/src/test/java/io/mosip/registration/liveness/android/FaceBindingTest.java
@@ -0,0 +1,328 @@
+package io.mosip.registration.liveness.android;
+
+import org.junit.AfterClass;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.Executor;
+import java.util.concurrent.RejectedExecutionException;
+
+import io.mosip.registration.liveness.analyzer.OnnxFaceAnalyzerFactory;
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.LivenessEngineException;
+import io.mosip.registration.liveness.api.WorkflowType;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * Face binding on the real matcher (the bundled signed models, desktop ONNX Runtime) with the public-domain golden
+ * images, plus the hold, arming, TTL and exactly-once rules. Images are decoded with ImageIO here; the Android
+ * decoder has its own test (BindingImagesTest).
+ */
+public class FaceBindingTest {
+
+    private static OnnxFaceAnalyzerFactory factory;
+    private static FaceBinding.Rgb portrait, mirrored, crewFace, blank;
+
+    private final long[] now = {1_000};
+    private final List<String> audits = new ArrayList<>();
+    private boolean enabled = true;
+    private FaceBinding.MatcherSource matchers = () -> factory.createMatcher();
+
+    @BeforeClass
+    public static void load() throws Exception {
+        factory = new OnnxFaceAnalyzerFactory();
+        factory.preload();
+        portrait = png("/golden/portrait_frontal.png");
+        mirrored = mirror(portrait);
+        // One crew member alone (as the engine's FaceMatcherTest): a crop around crew3.
+        crewFace = crop(png("/golden/crew_multi.png"), 160, 90, 150, 200);
+        byte[] grey = new byte[portrait.rgb.length];
+        java.util.Arrays.fill(grey, (byte) 128);
+        blank = new FaceBinding.Rgb(grey, portrait.width, portrait.height);
+    }
+
+    @AfterClass
+    public static void close() {
+        factory.close();
+    }
+
+    private FaceBinding binding() {
+        return new FaceBinding(() -> matchers.open(), () -> enabled, () -> 0.45,
+                (wf, id, r) -> audits.add(wf + "/" + id + "/" + r.outcome), () -> now[0]);
+    }
+
+    private static Frame frame(FaceBinding.Rgb img) {
+        return new Frame(img.rgb, img.width, img.height, 0, 0, "test");
+    }
+
+    @Test
+    public void theMirroredPortraitMatches() {
+        FaceBinding b = binding();
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        FaceBinding.Result r = b.bindNow("s1", () -> mirrored);
+        assertEquals("MATCH", r.outcome);
+        assertTrue(r.matched());
+        assertTrue("similarity " + r.similarity, r.similarity > 0.9);
+        assertEquals(0.45, r.threshold, 0);
+        assertFalse("the best frame is dropped after binding", b.holding());
+        assertEquals(List.of("RESIDENT/s1/MATCH"), audits);
+    }
+
+    @Test
+    public void aCrewFaceDoesNotMatchAndABlankImageHasNoFace() {
+        FaceBinding b = binding();
+        b.hold("s1", WorkflowType.OPERATOR, frame(portrait));
+        FaceBinding.Result r = b.bindNow("s1", () -> crewFace);
+        assertEquals("NO_MATCH", r.outcome);
+        assertTrue(r.similarity < 0.363);
+        b.hold("s2", WorkflowType.OPERATOR, frame(portrait));
+        FaceBinding.Result none = b.bindNow("s2", () -> blank);
+        assertEquals("NO_FACE_B", none.outcome);
+        assertTrue(Double.isNaN(none.similarity));
+        assertEquals(List.of("OPERATOR/s1/NO_MATCH", "OPERATOR/s2/NO_FACE_B"), audits);
+    }
+
+    @Test
+    public void badBytesAnUnknownSessionAndAMatcherFailureAreErrors() {
+        FaceBinding b = binding();
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        assertEquals("ERROR", b.bindNow("s1", () -> BindingImagesFixture.decode(new byte[] {1, 2, 3})).outcome);
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        assertEquals("ERROR", b.bindNow("s1", () -> null).outcome);
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        assertEquals("unknown session", "ERROR", b.bindNow("other", () -> mirrored).outcome);
+        assertTrue("an unknown session does not drop the held frame", b.holding());
+        matchers = () -> {
+            throw new LivenessEngineException(ErrorCode.MODEL_INTEGRITY_FAILED, "test");
+        };
+        assertEquals("ERROR", b.bindNow("s1", () -> mirrored).outcome);
+        assertEquals("ERROR", binding().bindNow("s1", () -> mirrored).outcome); // nothing held
+    }
+
+    @Test
+    public void disabledBindingIsSkippedAndAuditedOncePerCapture() {
+        enabled = false;
+        FaceBinding b = binding();
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        assertEquals("SKIPPED", b.bindNow("s1", () -> mirrored).outcome);
+        assertEquals(FaceBinding.Arm.DISABLED, b.arm("s1"));
+        FaceBinding.Capture c = b.onFaceCapture();
+        assertFalse("stored as before", c.bind());
+        assertFalse(b.onFaceCapture().bind());
+        assertEquals(List.of("null/s1/SKIPPED", "RESIDENT/s1/SKIPPED"), audits);
+    }
+
+    @Test
+    public void armingIsOneShotAndOnlyForTheHeldSession() {
+        FaceBinding b = binding();
+        assertEquals(FaceBinding.Arm.REJECTED, b.arm("s1"));
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        assertEquals(FaceBinding.Arm.REJECTED, b.arm("other"));
+        assertEquals(FaceBinding.Arm.REJECTED, b.arm(null));
+        assertFalse(b.onFaceCapture().bind());
+        assertEquals("a capture that was not armed does not consume the frame", true, b.holding());
+        assertEquals(FaceBinding.Arm.ARMED, b.arm("s1"));
+        assertTrue(b.armed());
+        FaceBinding.Capture c = b.onFaceCapture();
+        assertTrue(c.bind());
+        assertSame(WorkflowType.RESIDENT, c.workflow);
+        assertTrue(c.bestFrame != null);
+        assertFalse("consumed", b.armed());
+        assertFalse(b.holding());
+        assertFalse(b.onFaceCapture().bind());
+    }
+
+    @Test
+    public void theFrameIsDroppedAfterTheTtlOnANewSessionAndOnPause() {
+        FaceBinding b = binding();
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        now[0] += FaceBinding.TTL_MS - 1;
+        assertTrue(b.holding());
+        now[0] += 1;
+        assertFalse(b.holding());
+        assertEquals(FaceBinding.Arm.REJECTED, b.arm("s1"));
+
+        b.hold("s2", WorkflowType.RESIDENT, frame(portrait));
+        b.clear();
+        assertFalse(b.holding());
+
+        b.hold("s3", WorkflowType.RESIDENT, frame(portrait));
+        b.onPause();
+        assertFalse(b.holding());
+
+        // The SBI app pausing the Activity during an armed face capture keeps the frame.
+        b.hold("s4", WorkflowType.RESIDENT, frame(portrait));
+        assertEquals(FaceBinding.Arm.ARMED, b.arm("s4"));
+        b.captureStarted();
+        b.onPause();
+        assertTrue(b.holding());
+        FaceBinding.Capture c = b.onFaceCapture();
+        assertTrue(c.bind());
+        assertTrue(c.bestFrame != null);
+
+        // A new session drops an arming too.
+        b.hold("s5", WorkflowType.RESIDENT, frame(portrait));
+        b.arm("s5");
+        b.clear();
+        assertFalse(b.armed());
+        assertFalse(b.onFaceCapture().bind());
+    }
+
+    @Test
+    public void anArmedCaptureWhoseFrameWasDroppedFailsClosed() {
+        FaceBinding b = binding();
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        b.arm("s1");
+        b.onPause(); // not in flight: the frame goes, the arming stays
+        assertFalse(b.holding());
+        FaceBinding.Capture paused = b.onFaceCapture();
+        assertTrue(paused.bind());
+        assertNull(paused.bestFrame);
+        List<Boolean> done = new ArrayList<>();
+        b.bindCapture(paused, () -> mirrored, Runnable::run, Runnable::run, (t, ms) -> { }, 1000, done::add);
+        assertEquals(List.of(false), done);
+
+        b.hold("s2", WorkflowType.RESIDENT, frame(portrait));
+        b.arm("s2");
+        b.captureStarted();
+        now[0] += FaceBinding.TTL_MS; // the SBI app took too long
+        FaceBinding.Capture late = b.onFaceCapture();
+        assertTrue(late.bind());
+        assertNull(late.bestFrame);
+        assertEquals(List.of("RESIDENT/s1/ERROR"), audits);
+    }
+
+    /** Runs nothing until told to. */
+    private static final class Manual implements Executor, FaceBinding.Scheduler {
+        final List<Runnable> tasks = new ArrayList<>();
+
+        @Override public void execute(Runnable r) {
+            tasks.add(r);
+        }
+
+        @Override public void schedule(Runnable task, long delayMs) {
+            tasks.add(task);
+        }
+
+        void runAll() {
+            for (Runnable r : new ArrayList<>(tasks)) r.run();
+            tasks.clear();
+        }
+    }
+
+    private List<Boolean> bindArmed(FaceBinding.Decoder decoder, Executor worker, Manual timer) {
+        FaceBinding b = binding();
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        b.arm("s1");
+        List<Boolean> done = new ArrayList<>();
+        Manual callback = new Manual();
+        b.bindCapture(b.onFaceCapture(), decoder, worker, callback, timer, FaceBinding.TIMEOUT_MS, done::add);
+        assertTrue("done runs on the callback executor only", done.isEmpty());
+        callback.runAll();
+        timer.runAll(); // the timeout fires after the result: ignored
+        callback.runAll();
+        return done;
+    }
+
+    @Test
+    public void aCaptureIsCompletedExactlyOnceOnEveryPath() {
+        assertEquals("MATCH stores", List.of(true), bindArmed(() -> mirrored, Runnable::run, new Manual()));
+        assertEquals("NO_MATCH", List.of(false), bindArmed(() -> crewFace, Runnable::run, new Manual()));
+        assertEquals("NO_FACE_B", List.of(false), bindArmed(() -> blank, Runnable::run, new Manual()));
+        assertEquals("decode error", List.of(false), bindArmed(() -> {
+            throw new IOException("bad JP2");
+        }, Runnable::run, new Manual()));
+        assertEquals("rejected worker", List.of(false), bindArmed(() -> mirrored, r -> {
+            throw new RejectedExecutionException("shut down");
+        }, new Manual()));
+        assertEquals(List.of("RESIDENT/s1/MATCH", "RESIDENT/s1/NO_MATCH", "RESIDENT/s1/NO_FACE_B", "RESIDENT/s1/ERROR",
+                "RESIDENT/s1/ERROR"), audits);
+    }
+
+    @Test
+    public void aTimeoutCompletesOnceAndTheLateResultIsDropped() {
+        audits.clear();
+        FaceBinding b = binding();
+        b.hold("s1", WorkflowType.RESIDENT, frame(portrait));
+        b.arm("s1");
+        Manual worker = new Manual(), timer = new Manual(), callback = new Manual();
+        List<Boolean> done = new ArrayList<>();
+        b.bindCapture(b.onFaceCapture(), () -> mirrored, worker, callback, timer, 5, done::add);
+        timer.runAll();   // the binding has not run: timeout
+        callback.runAll();
+        worker.runAll();  // it finishes late (would be MATCH)
+        callback.runAll();
+        assertEquals(List.of(false), done);
+        assertEquals(List.of("RESIDENT/s1/ERROR"), audits);
+    }
+
+    @Test
+    public void theEnabledKeyDefaultsToTrue() {
+        assertTrue(FaceBinding.enabled(null));
+        assertTrue(FaceBinding.enabled(" TRUE "));
+        assertTrue(FaceBinding.enabled("yes"));
+        assertFalse(FaceBinding.enabled(" false "));
+    }
+
+    static FaceBinding.Rgb png(String resource) throws IOException {
+        try (InputStream in = FaceBindingTest.class.getResourceAsStream(resource)) {
+            return BindingImagesFixture.decode(in);
+        }
+    }
+
+    static FaceBinding.Rgb mirror(FaceBinding.Rgb img) {
+        byte[] out = new byte[img.rgb.length];
+        for (int y = 0; y < img.height; y++) {
+            for (int x = 0; x < img.width; x++) {
+                System.arraycopy(img.rgb, (y * img.width + x) * 3, out, (y * img.width + img.width - 1 - x) * 3, 3);
+            }
+        }
+        return new FaceBinding.Rgb(out, img.width, img.height);
+    }
+
+    static FaceBinding.Rgb crop(FaceBinding.Rgb img, int x, int y, int w, int h) {
+        byte[] out = new byte[w * h * 3];
+        for (int r = 0; r < h; r++) System.arraycopy(img.rgb, ((y + r) * img.width + x) * 3, out, r * w * 3, w * 3);
+        return new FaceBinding.Rgb(out, w, h);
+    }
+
+    /**
+     * Desktop decoding for these JVM tests: the unit tests compile against android.jar (no javax.imageio) but run on
+     * the desktop JDK, so ImageIO is reached by reflection.
+     */
+    static final class BindingImagesFixture {
+        static FaceBinding.Rgb decode(byte[] bytes) throws IOException {
+            return decode(new java.io.ByteArrayInputStream(bytes));
+        }
+
+        static FaceBinding.Rgb decode(InputStream in) throws IOException {
+            try {
+                Object img = Class.forName("javax.imageio.ImageIO").getMethod("read", InputStream.class).invoke(null, in);
+                if (img == null) throw new IOException("not an image");
+                int w = (Integer) img.getClass().getMethod("getWidth").invoke(img);
+                int h = (Integer) img.getClass().getMethod("getHeight").invoke(img);
+                int[] px = (int[]) img.getClass().getMethod("getRGB", int.class, int.class, int.class, int.class,
+                        int[].class, int.class, int.class).invoke(img, 0, 0, w, h, null, 0, w);
+                byte[] rgb = new byte[w * h * 3];
+                for (int i = 0; i < px.length; i++) {
+                    rgb[3 * i] = (byte) (px[i] >> 16);
+                    rgb[3 * i + 1] = (byte) (px[i] >> 8);
+                    rgb[3 * i + 2] = (byte) px[i];
+                }
+                return new FaceBinding.Rgb(rgb, w, h);
+            } catch (ReflectiveOperationException e) {
+                throw new IOException("desktop image decoding unavailable", e);
+            }
+        }
+    }
+}
diff --git a/android/liveness/src/test/java/io/mosip/registration/liveness/android/IdentityBindingTest.java b/android/liveness/src/test/java/io/mosip/registration/liveness/android/IdentityBindingTest.java
new file mode 100644
index 0000000..3004080
--- /dev/null
+++ b/android/liveness/src/test/java/io/mosip/registration/liveness/android/IdentityBindingTest.java
@@ -0,0 +1,183 @@
+package io.mosip.registration.liveness.android;
+
+import org.junit.AfterClass;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import io.mosip.registration.liveness.analyzer.OnnxFaceAnalyzerFactory;
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.LivenessEngineException;
+import io.mosip.registration.liveness.api.WorkflowType;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * Identity binding (F15) on the real matcher (the bundled signed models, desktop ONNX Runtime) with the public-domain
+ * golden images: the held best frame against onboarded faces, the outcomes, retryability, the audit, and that the
+ * frame is used once.
+ */
+public class IdentityBindingTest {
+
+    private static OnnxFaceAnalyzerFactory factory;
+    private static FaceBinding.Rgb portrait, mirrored, crewFace, crew, blank;
+
+    private final long[] now = {1_000};
+    private final List<String> audits = new ArrayList<>();
+    private final Map<String, String> config = new HashMap<>();
+    private FaceBinding.MatcherSource matchers = () -> factory.createMatcher();
+    private final FaceBinding binding = new FaceBinding(() -> factory.createMatcher(), () -> true, () -> 0.45,
+            (wf, id, r) -> { }, () -> now[0]);
+    private final IdentityBinding identity = new IdentityBinding(binding, () -> matchers.open(), config::get,
+            () -> 0.40, (wf, id, d) -> audits.add(wf + "/" + id + "/" + d));
+
+    @BeforeClass
+    public static void load() throws Exception {
+        factory = new OnnxFaceAnalyzerFactory();
+        factory.preload();
+        portrait = FaceBindingTest.png("/golden/portrait_frontal.png");
+        mirrored = FaceBindingTest.mirror(portrait);
+        crew = FaceBindingTest.png("/golden/crew_multi.png");
+        crewFace = FaceBindingTest.crop(crew, 160, 90, 150, 200);
+        byte[] grey = new byte[portrait.rgb.length];
+        java.util.Arrays.fill(grey, (byte) 128);
+        blank = new FaceBinding.Rgb(grey, portrait.width, portrait.height);
+    }
+
+    @AfterClass
+    public static void close() {
+        factory.close();
+    }
+
+    /** Onboarded faces; a null entry does not decode. */
+    private static IdentityBinding.TemplateSource onboarded(FaceBinding.Rgb... faces) {
+        return userId -> {
+            List<FaceBinding.Decoder> out = new ArrayList<>();
+            for (FaceBinding.Rgb f : faces) {
+                out.add(() -> {
+                    if (f == null) throw new IOException("not an ISO 19794-5 record");
+                    return f;
+                });
+            }
+            return out;
+        };
+    }
+
+    private void hold(String session, FaceBinding.Rgb face) {
+        binding.hold(session, WorkflowType.OPERATOR, new Frame(face.rgb, face.width, face.height, 0, 0, "test"));
+    }
+
+    @Test
+    public void theOnboardedFaceMatchesAndTheFrameIsUsedOnce() {
+        hold("s1", portrait);
+        IdentityBinding.Result r = identity.verify("s1", "op1", "password_login", 1, onboarded(mirrored), null);
+        assertEquals("MATCH", r.outcome);
+        assertTrue(r.accepted);
+        assertFalse(r.retryable);
+        assertTrue("similarity " + r.similarity, r.similarity > 0.9);
+        assertEquals(0.40, r.threshold, 0);
+        assertFalse("the best frame is dropped", binding.holding());
+        String audit = audits.get(0);
+        assertTrue(audit, audit.startsWith("OPERATOR/s1/{outcome=MATCH, similarity=0.9"));
+        assertTrue(audit, audit.contains("threshold=0.40, gate=password_login, attempt=1, userId=op1, templates=1, "
+                + "unreadable=0, accepted=true}"));
+
+        IdentityBinding.Result again = identity.verify("s1", "op1", "password_login", 2, onboarded(mirrored), null);
+        assertEquals("NO_LIVE_FRAME", again.outcome);
+        assertFalse(again.accepted);
+        assertTrue(again.retryable);
+    }
+
+    @Test
+    public void anotherPersonIsRejectedAndMayRetry() {
+        hold("s1", portrait);
+        IdentityBinding.Result r = identity.verify("s1", "op1", "packet_auth", 1, onboarded(crewFace), null);
+        assertEquals("NO_MATCH", r.outcome);
+        assertFalse(r.accepted);
+        assertTrue(r.retryable);
+        assertTrue("similarity " + r.similarity, r.similarity < 0.363);
+    }
+
+    @Test
+    public void theBestOfSeveralTemplatesDecidesAndUnreadableOnesAreCounted() {
+        hold("s1", portrait);
+        IdentityBinding.Result r = identity.verify("s1", "sup1", "supervisor_approval", 1,
+                onboarded(crewFace, null, blank, crew, mirrored), null);
+        assertEquals("MATCH", r.outcome);
+        assertTrue(audits.get(0), audits.get(0).contains("templates=5, unreadable=3"));
+    }
+
+    @Test
+    public void withoutAReadableTemplateTheUserGetsInOnPresenceUnlessTemplatesAreRequired() {
+        hold("s1", portrait);
+        IdentityBinding.Result none = identity.verify("s1", "op1", "password_login", 1, onboarded(), null);
+        assertEquals("NOT_BOUND_NO_TEMPLATE", none.outcome);
+        assertTrue(none.accepted);
+        assertFalse(none.retryable);
+        assertTrue(audits.get(0), audits.get(0).contains("requireTemplate=false"));
+
+        hold("s2", portrait);
+        IdentityBinding.Result unreadable = identity.verify("s2", "op1", "password_login", 1, onboarded(blank, crew, null),
+                null);
+        assertEquals("NOT_BOUND_UNREADABLE", unreadable.outcome);
+        assertTrue(unreadable.accepted);
+
+        config.put(IdentityBinding.REQUIRE_TEMPLATE_KEY, "true");
+        hold("s3", portrait);
+        IdentityBinding.Result required = identity.verify("s3", "op1", "password_login", 1, onboarded(), null);
+        assertFalse(required.accepted);
+        assertFalse("a new session cannot help", required.retryable);
+        assertTrue(audits.get(2), audits.get(2).contains("requireTemplate=true"));
+    }
+
+    @Test
+    public void everyOtherFailureFailsClosed() {
+        hold("s1", portrait);
+        assertEquals("another session", "NO_LIVE_FRAME",
+                identity.verify("s2", "op1", "password_login", 1, onboarded(mirrored), null).outcome);
+
+        hold("s1", portrait);
+        now[0] += FaceBinding.TTL_MS;
+        assertEquals("expired", "NO_LIVE_FRAME",
+                identity.verify("s1", "op1", "password_login", 1, onboarded(mirrored), null).outcome);
+
+        hold("s1", portrait);
+        IdentityBinding.Result broken = identity.verify("s1", "op1", "password_login", 1,
+                userId -> { throw new IllegalStateException("database closed"); }, null);
+        assertEquals("ERROR", broken.outcome);
+        assertTrue(broken.retryable);
+
+        matchers = () -> { throw new LivenessEngineException(ErrorCode.ENGINE_ERROR, "closed"); };
+        hold("s1", portrait);
+        assertEquals("ERROR", identity.verify("s1", "op1", "password_login", 1, onboarded(mirrored), null).outcome);
+        matchers = () -> factory.createMatcher();
+
+        hold("s1", blank);
+        IdentityBinding.Result noFace = identity.verify("s1", "op1", "password_login", 1, onboarded(mirrored), null);
+        assertEquals("NO_LIVE_FACE", noFace.outcome);
+        assertFalse(noFace.accepted);
+        assertTrue(noFace.retryable);
+    }
+
+    @Test
+    public void switchedOffIsAuditedAsSkipped() {
+        config.put(IdentityBinding.ENABLED_KEY, "false");
+        hold("s1", portrait);
+        IdentityBinding.Result r = identity.verify("s1", "op1", "password_login", 1, onboarded(crewFace),
+                java.util.Collections.singletonMap("templateSource", "diagnostics-test"));
+        assertEquals("SKIPPED", r.outcome);
+        assertTrue(r.accepted);
+        assertTrue(audits.get(0), audits.get(0).contains("templateSource=diagnostics-test"));
+        assertTrue(IdentityBinding.enabled(null));
+        assertTrue(IdentityBinding.enabled("true"));
+        assertFalse(IdentityBinding.enabled(" FALSE "));
+    }
+}
