+++ b/android/liveness/src/test/java/io/mosip/registration/liveness/device/android/CameraXFrameSourcePacingTest.java
@@ -0,0 +1,133 @@
+package io.mosip.registration.liveness.device.android;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import android.content.Context;
+import android.util.Size;
+
+import androidx.camera.core.CameraSelector;
+import androidx.camera.core.ImageInfo;
+import androidx.camera.core.ImageProxy;
+import androidx.lifecycle.LifecycleOwner;
+
+import org.junit.Test;
+
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.List;
+
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.FrameSource;
+
+/** maxDeliverFps on a synthetic 30 fps stream: the delivered rate, no conversion of skipped frames, raw sequence. */
+public class CameraXFrameSourcePacingTest {
+
+    private static final long FRAME_NS = 33_333_333L; // 30 fps
+
+    @Test
+    public void thirtyFpsIsPacedToAboutFifteen() {
+        Run run = run(15, 1, 60, true); // 2 s of camera frames, with timestamp jitter
+        assertTrue("delivered " + run.frames.size(), run.frames.size() >= 29 && run.frames.size() <= 31);
+        for (ImageProxy skipped : run.skipped) verify(skipped, never()).getPlanes();
+        for (ImageProxy image : run.images) verify(image).close();
+        // The sequence stays the raw camera index: every other frame, so the gaps show.
+        for (int i = 1; i < run.frames.size(); i++) {
+            assertEquals(2, run.frames.get(i).sequence() - run.frames.get(i - 1).sequence());
+        }
+    }
+
+    @Test
+    public void zeroMeansUnlimited() {
+        Run run = run(0, 1, 30, false);
+        assertEquals(30, run.frames.size());
+        assertTrue(run.skipped.isEmpty());
+    }
+
+    @Test
+    public void strideStillApplies() {
+        Run run = run(0, 3, 30, false);
+        assertEquals(10, run.frames.size());
+        assertEquals(3, run.frames.get(1).sequence());
+    }
+
+    @Test
+    public void strideThenPacing() {
+        // stride 2 offers 15 fps; a 10 fps cap can only keep whole frames, so every other one: 7.5 fps.
+        Run run = run(10, 2, 60, false);
+        assertEquals(15, run.frames.size());
+        assertEquals(4, run.frames.get(1).sequence());
+    }
+
+    @Test(expected = IllegalArgumentException.class)
+    public void negativeRateIsRejected() {
+        new CameraXFrameSource(context(), mock(LifecycleOwner.class), CameraSelector.DEFAULT_FRONT_CAMERA,
+                new Size(640, 480), 1, null, -1);
+    }
+
+    private static Run run(int maxDeliverFps, int stride, int count, boolean jitter) {
+        CameraXFrameSource source = new CameraXFrameSource(context(), mock(LifecycleOwner.class),
+                CameraSelector.DEFAULT_FRONT_CAMERA, new Size(640, 480), stride, null, maxDeliverFps);
+        Run run = new Run();
+        source.attachForTest(new FrameSource.Listener() {
+            @Override
+            public void onFrame(Frame frame) {
+                run.frames.add(frame);
+            }
+
+            @Override
+            public void onError(ErrorCode code, String detailForAuditOnly, boolean recoverable) {
+                throw new AssertionError(code + ": " + detailForAuditOnly);
+            }
+        });
+        long t = 1_000_000_000L;
+        for (int i = 0; i < count; i++) {
+            long jitterNs = jitter ? ((i * 7919L) % 5 - 2) * 1_500_000L : 0L; // -3..+3 ms
+            ImageProxy image = image(t + jitterNs);
+            run.images.add(image);
+            int before = run.frames.size();
+            source.onImageAvailable(image);
+            if (run.frames.size() == before) run.skipped.add(image);
+            t += FRAME_NS;
+        }
+        return run;
+    }
+
+    private static Context context() {
+        Context context = mock(Context.class);
+        when(context.getApplicationContext()).thenReturn(context);
+        return context;
+    }
+
+    private static ImageProxy image(long timestampNs) {
+        ImageProxy image = mock(ImageProxy.class);
+        ImageInfo info = mock(ImageInfo.class);
+        when(info.getTimestamp()).thenReturn(timestampNs);
+        when(info.getRotationDegrees()).thenReturn(0);
+        when(image.getImageInfo()).thenReturn(info);
+        when(image.getWidth()).thenReturn(4);
+        when(image.getHeight()).thenReturn(2);
+        ImageProxy.PlaneProxy[] planes = {plane(8, 4, 1), plane(2, 2, 1), plane(2, 2, 1)};
+        when(image.getPlanes()).thenReturn(planes);
+        return image;
+    }
+
+    private static ImageProxy.PlaneProxy plane(int size, int rowStride, int pixelStride) {
+        ImageProxy.PlaneProxy plane = mock(ImageProxy.PlaneProxy.class);
+        when(plane.getBuffer()).thenReturn(ByteBuffer.wrap(new byte[size]));
+        when(plane.getRowStride()).thenReturn(rowStride);
+        when(plane.getPixelStride()).thenReturn(pixelStride);
+        return plane;
+    }
+
+    private static final class Run {
+        final List<Frame> frames = new ArrayList<>();
+        final List<ImageProxy> images = new ArrayList<>();
+        final List<ImageProxy> skipped = new ArrayList<>();
+    }
+}
diff --git a/android/liveness/src/test/java/io/mosip/registration/liveness/device/android/ExposureAssistTest.java b/android/liveness/src/test/java/io/mosip/registration/liveness/device/android/ExposureAssistTest.java
new file mode 100644
index 0000000..9c778eb
--- /dev/null
+++ b/android/liveness/src/test/java/io/mosip/registration/liveness/device/android/ExposureAssistTest.java
@@ -0,0 +1,150 @@
+package io.mosip.registration.liveness.device.android;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/** The dim-face exposure assist of CameraXFrameSource, with a fake camera control. */
+public class ExposureAssistTest {
+
+    private static final long MS = 1_000_000L;
+    private static final double DARK = 40;
+    private static final double MID = 110;
+    private static final double BRIGHT = 180;
+
+    /** Records every index the assist sets. */
+    static final class FakeControl implements CameraXFrameSource.ExposureAssist.Control {
+        final List<Integer> set = new ArrayList<>();
+        boolean supported = true;
+        int max = 4;
+
+        @Override
+        public boolean supported() {
+            return supported;
+        }
+
+        @Override
+        public int min() {
+            return -max;
+        }
+
+        @Override
+        public int max() {
+            return max;
+        }
+
+        @Override
+        public void setIndex(int index) {
+            set.add(index);
+        }
+    }
+
+    private final FakeControl camera = new FakeControl();
+    private final CameraXFrameSource.ExposureAssist assist = new CameraXFrameSource.ExposureAssist();
+
+    /** Frames every 66 ms (15 fps) from {@code fromMs} to {@code toMs} with the given luma. */
+    private long feed(double luma, long fromMs, long toMs) {
+        long t = fromMs;
+        for (; t <= toMs; t += 66) assist.onLuma(luma, t * MS);
+        return t;
+    }
+
+    @Test
+    public void briefDarknessChangesNothing() {
+        assist.attach(camera);
+        feed(DARK, 0, 900);
+        feed(MID, 966, 3000);
+        assertTrue(camera.set.isEmpty());
+        assertEquals(0, assist.index());
+    }
+
+    @Test
+    public void darkForASecondStepsUpAtMostEvery500msToTheMaximum() {
+        assist.attach(camera);
+        feed(DARK, 0, 999);
+        assertTrue("nothing before 1 s", camera.set.isEmpty());
+        feed(DARK, 1056, 1056);
+        assertEquals(Arrays.asList(1), camera.set);
+        feed(DARK, 1122, 1500);
+        assertEquals("not again within 500 ms", Arrays.asList(1), camera.set);
+        feed(DARK, 1566, 4000);
+        assertEquals(Arrays.asList(1, 2, 3, 4), camera.set);
+        assertEquals(4, assist.index());
+    }
+
+    @Test
+    public void brightStepsBackTowardZeroOnlyAndNeverBelow() {
+        assist.attach(camera);
+        feed(DARK, 0, 2200); // steps at 1056, 1584 and 2112 ms: up to 3
+        assertEquals(3, assist.index());
+        camera.set.clear();
+        feed(MID, 2244, 4000);
+        assertTrue("between the thresholds nothing changes", camera.set.isEmpty());
+        feed(BRIGHT, 4066, 7000);
+        assertEquals(Arrays.asList(2, 1, 0), camera.set);
+        assertEquals(0, assist.index());
+    }
+
+    @Test
+    public void resetGoesBackToZeroAndForgetsTheCamera() {
+        assist.attach(camera);
+        feed(DARK, 0, 1600);
+        assertEquals(2, assist.index());
+        assist.reset();
+        assertEquals(0, assist.index());
+        assertEquals(Integer.valueOf(0), camera.set.get(camera.set.size() - 1));
+        int calls = camera.set.size();
+        feed(DARK, 2000, 5000);
+        assertEquals("no camera after reset", calls, camera.set.size());
+    }
+
+    @Test
+    public void unsupportedOrFixedExposureIsLeftAlone() {
+        camera.supported = false;
+        assist.attach(camera);
+        feed(DARK, 0, 5000);
+        assertTrue(camera.set.isEmpty());
+
+        FakeControl fixed = new FakeControl();
+        fixed.max = 0;
+        assist.attach(fixed);
+        feed(DARK, 6000, 9000);
+        assertTrue(fixed.set.isEmpty());
+    }
+
+    @Test
+    public void disablingResetsAndStopsTheAssist() {
+        assist.attach(camera);
+        feed(DARK, 0, 1100);
+        assertEquals(1, assist.index());
+        assist.setEnabled(false);
+        assertFalse(assist.enabled());
+        assertEquals(0, assist.index());
+        int calls = camera.set.size();
+        feed(DARK, 2000, 5000);
+        assertEquals(calls, camera.set.size());
+    }
+
+    @Test
+    public void faceRegionLumaIgnoresTheBorderAndFollowsRotation() {
+        int w = 40;
+        int h = 20;
+        byte[] y = new byte[w * h];
+        // Bright border, dark centre (the centre 50% x 40% of the sensor plane, i.e. 40% x 50% upright at 90/270).
+        for (int r = 0; r < h; r++) {
+            for (int c = 0; c < w; c++) {
+                boolean centre = c >= 10 && c < 30 && r >= 6 && r < 14;
+                y[r * w + c] = (byte) (centre ? 30 : 250);
+            }
+        }
+        assertEquals(30.0, CameraXFrameSource.centreMeanLuma(y, w, h, w, 1, 90), 0.01);
+        assertEquals(30.0, CameraXFrameSource.centreMeanLuma(y, w, h, w, 1, 270), 0.01);
+        assertTrue(Double.isNaN(CameraXFrameSource.centreMeanLuma(new byte[0], 0, 0, 0, 1, 0)));
+    }
+}
