+        decoration: BoxDecoration(color: tone.withOpacity(0.08), borderRadius: BorderRadius.circular(12)),
+        child: _ResultRow(
+          sentenceKey: const Key('demo.identity.verdict.sentence'),
+          icon: icon,
+          tone: tone,
+          sentence: sentence,
+          message: message,
