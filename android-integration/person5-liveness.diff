index 0000000..7413816
--- /dev/null
+++ b/lib/ui/liveness/liveness_page.dart
@@ -0,0 +1,784 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'dart:async';
+import 'dart:math' as math;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+import 'package:registration_client/ui/liveness/liveness_controller.dart';
+import 'package:registration_client/ui/liveness/liveness_strings.dart';
+import 'package:registration_client/ui/liveness/liveness_style.dart';
+
+/// What [LivenessPage] returns with `Navigator.pop`.
+@immutable
+class LivenessOutcome {
+  const LivenessOutcome({
+    this.passed = false,
+    this.cancelled = false,
+    this.disabled = false,
+    this.passPath,
+    this.failureCode,
+    this.userMessage,
+    this.bestFrameJpeg,
+    this.sessionId,
+    this.attempts = 0,
+    this.durationMs = 0,
+    this.modelVersion,
+  });
+
+  factory LivenessOutcome.fromResult(LivenessMessage r) => LivenessOutcome(
+        passed: r.decision == 'PASSED',
+        cancelled: r.decision == 'CANCELLED',
+        passPath: r.passPath,
+        failureCode: r.failureCode,
+        userMessage: r.userMessage,
+        bestFrameJpeg: r.bestFrameJpeg,
+        sessionId: r.sessionId,
+        attempts: r.attempts,
+        durationMs: r.durationMs,
+        modelVersion: r.modelVersion,
+      );
+
+  /// Liveness is disabled for the workflow: the caller keeps its legacy flow.
+  static const LivenessOutcome disabledOutcome = LivenessOutcome(disabled: true);
+  static const LivenessOutcome cancelledOutcome = LivenessOutcome(cancelled: true);
+
+  final bool passed;
+  final bool cancelled;
+  final bool disabled;
+  final String? passPath;
+  final String? failureCode;
+  final String? userMessage;
+
+  /// JPEG of the best frame, on passed only. Keep it in memory.
+  final Uint8List? bestFrameJpeg;
+  final String? sessionId;
+  final int attempts;
+  final int durationMs;
+  final String? modelVersion;
+
+  @override
+  String toString() => 'LivenessOutcome(passed=$passed cancelled=$cancelled disabled=$disabled '
+      'passPath=$passPath failure=$failureCode message=$userMessage attempts=$attempts '
+      '${durationMs}ms bestFrame=${bestFrameJpeg == null ? '-' : '${bestFrameJpeg!.length} bytes'})';
+}
+
+/// The face liveness step (docs/ui-liveness-spec.md): checks that liveness is
+/// enabled for [workflow], asks for the camera, starts a session and renders its
+/// events. Pops a [LivenessOutcome]: passed (about 1 s after the success state),
+/// failed (after Close), cancelled (Cancel or back) or disabled.
+class LivenessPage extends StatefulWidget {
+  const LivenessPage({
+    super.key,
+    required this.workflow,
+    this.camera = 'front',
+    this.useFake = false,
+    this.previewBuilder,
+    this.service,
+    this.showDebugInfo = true,
+  });
+
+  static const String previewViewType = 'io.mosip.registration_client/liveness_preview';
+  static const Duration passedDelay = Duration(seconds: 1);
+
+  /// RESIDENT, OPERATOR or SUPERVISOR.
+  final String workflow;
+
+  /// front or back.
+  final String camera;
+
+  /// The scripted fake engine (debug and tests).
+  final bool useFake;
+
+  /// Replaces the camera preview (tests, privacy-safe screenshots).
+  final Widget Function()? previewBuilder;
+
+  /// Defaults to the platform's [LivenessService].
+  final LivenessService? service;
+
+  /// Debug builds only: a small chip with the model version (off for documentation screenshots).
+  final bool showDebugInfo;
+
+  @override
+  State<LivenessPage> createState() => _LivenessPageState();
+}
+
+class _LivenessPageState extends State<LivenessPage> {
+  late final LivenessService _service = widget.service ?? LivenessService();
+  late final LivenessController _controller = LivenessController(workflow: widget.workflow);
+  final Completer<void> _previewReady = Completer<void>();
+  StreamSubscription<LivenessMessage>? _subscription;
+  Timer? _passedTimer;
+  String? _sessionId;
+  bool _sessionRunning = false;
+  bool _popped = false;
+  String _debugModel = '';
+
+  @override
+  void initState() {
+    super.initState();
+    _controller.addListener(_onStateChanged);
+    _subscription = _service.messages.listen(_onMessage);
+    if (widget.previewBuilder != null || widget.useFake) _previewReady.complete();
+    _begin();
+  }
+
+  @override
+  void dispose() {
+    _passedTimer?.cancel();
+    _subscription?.cancel();
+    if (_sessionRunning) _service.cancel(); // leaving the screen releases the camera
+    _controller.removeListener(_onStateChanged);
+    _controller.dispose();
+    super.dispose();
+  }
+
+  Future<void> _begin() async {
+    try {
+      if (!await _service.isEnabled(widget.workflow)) {
+        _pop(LivenessOutcome.disabledOutcome);
+        return;
+      }
+      // The fake engine uses no camera, so it needs no permission.
+      if (!widget.useFake) {
+        final permission = await _service.ensureCameraPermission();
+        if (permission != CameraPermission.granted) {
+          _controller.permissionDenied(permanently: permission == CameraPermission.permanentlyDenied);
+          return;
+        }
+      }
+      final policy = await _service.policy(widget.workflow);
+      _controller.maxRetries = policy.maxRetries;
+      if (kDebugMode && widget.showDebugInfo) _debugModel = await _service.modelVersion();
+      // Let the platform view exist first, so the session binds its preview.
+      await _previewReady.future.timeout(const Duration(seconds: 2), onTimeout: () {});
+      if (!mounted || _popped) return;
+      _sessionRunning = true;
+      final id = await _service.startSession(widget.workflow,
+          camera: widget.camera, useFake: widget.useFake);
+      if (id.isEmpty) {
+        _sessionRunning = false;
+        _pop(LivenessOutcome.disabledOutcome);
+        return;
+      }
+      _sessionId = id;
+    } on PlatformException catch (e) {
+      debugPrint('Liveness could not start: ${e.code}');
+      _sessionRunning = false;
+      _controller.startFailed();
+    }
+  }
+
+  void _onMessage(LivenessMessage m) {
+    if (_popped) return;
+    if (m.isComplete && _sessionId != null && m.sessionId != _sessionId) return; // an older session
+    _controller.handle(m);
+    if (!m.isComplete) return;
+    _sessionRunning = false;
+    switch (m.decision) {
+      case 'CANCELLED':
+        _pop(LivenessOutcome.fromResult(m));
+        break;
+      case 'PASSED':
+        _passedTimer = Timer(LivenessPage.passedDelay, () => _pop(LivenessOutcome.fromResult(m)));
+        break;
+      default:
+        break; // the final screen waits for Close
+    }
+  }
+
+  void _onStateChanged() {
+    if (mounted) setState(() {});
+  }
+
+  void _retry() => _service.retry();
+
+  void _cancel() {
+    if (_sessionRunning) _service.cancel();
+    _sessionRunning = false;
+    _pop(LivenessOutcome.cancelledOutcome);
+  }
+
+  void _close() {
+    final result = _controller.result;
+    if (result != null) {
+      _pop(LivenessOutcome.fromResult(result));
+    } else {
+      // Refused before a session existed: the camera permission, or the bridge failed.
+      final camera = _controller.state.messageKey == 'liveness.error.device_problem';
+      _pop(LivenessOutcome(
+        failureCode: camera ? 'CAMERA_UNAVAILABLE' : 'ENGINE_ERROR',
+        userMessage: camera ? 'DEVICE_PROBLEM' : 'VERIFICATION_NOT_COMPLETED',
+      ));
+    }
+  }
+
+  void _onBack() {
+    final state = _controller.state;
+    final result = _controller.result;
+    if (state.phase == LivenessPhase.passed && result != null) {
+      _passedTimer?.cancel();
+      _pop(LivenessOutcome.fromResult(result));
+    } else if (state.phase == LivenessPhase.failedFinal) {
+      _close();
+    } else {
+      _cancel();
+    }
+  }
+
+  void _pop(LivenessOutcome outcome) {
+    if (_popped || !mounted) return;
+    _popped = true;
+    Navigator.of(context).pop(outcome);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = AppLocalizations.of(context)!;
+    final s = _controller.state;
+    final tone = _toneColor(s.ovalTone);
+    return WillPopScope(
+      onWillPop: () async {
+        _onBack();
+        return false;
+      },
+      child: Scaffold(
+        appBar: AppBar(
+          title: Text(livenessText(l, _controller.titleKey)),
+          actions: [
+            if (kDebugMode && _debugModel.isNotEmpty)
+              Padding(
+                padding: const EdgeInsetsDirectional.only(end: 8),
+                child: Center(
+                  child: Chip(
+                    visualDensity: VisualDensity.compact,
+                    label: Text('debug $_debugModel', style: const TextStyle(fontSize: 11)),
+                  ),
+                ),
+              ),
+          ],
+        ),
+        backgroundColor: LivenessStyle.background,
+        // docs/ui-liveness-spec.md §9: camera card, status card, progress row, tips (failure
+        // only), and the buttons pinned to the bottom. Only the tips ever scroll.
+        body: SafeArea(
+          child: Align(
+            alignment: Alignment.topCenter,
+            child: ConstrainedBox(
+              constraints: const BoxConstraints(maxWidth: LivenessStyle.maxContentWidth),
+              child: Column(
+                children: [
+                  Expanded(
+                    child: Padding(
+                      padding: const EdgeInsets.fromLTRB(LivenessStyle.gutter, 12, LivenessStyle.gutter, 0),
+                      child: _content(l, s, tone),
+                    ),
+                  ),
+                  Padding(
+                    padding: const EdgeInsets.fromLTRB(LivenessStyle.gutter, 8, LivenessStyle.gutter, 16),
+                    child: _buttons(l, s),
+                  ),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _content(AppLocalizations l, LivenessViewState s, Color tone) {
+    return LayoutBuilder(builder: (context, c) {
+      // A landscape phone or a text scale above 1.3: the page scrolls, with a camera card of a fixed size, so nothing
+      // overflows and the preview never collapses. The fixed layout below is for portrait up to 1.3 (spec §9).
+      if (c.maxHeight < LivenessStyle.compactHeight ||
+          MediaQuery.textScaleFactorOf(context) > LivenessStyle.maxFixedTextScale) {
+        return SingleChildScrollView(
+          child: Column(
+            children: [
+              SizedBox(
+                height: LivenessStyle.compactCameraHeight,
+                child: Center(child: AspectRatio(aspectRatio: 3 / 4, child: _preview(s, tone))),
+              ),
+              const SizedBox(height: 12),
+              _statusCard(l, s, tone),
+              _secondaryLine(l, s),
+              _progressRow(l, s),
+              if (s.tips) ...[const SizedBox(height: 12), _tips(l)],
+            ],
+          ),
+        );
+      }
+      return Column(
+        children: [
+          // The camera card takes what is left, up to its share of the screen: less with the tips.
+          Flexible(
+            child: ConstrainedBox(
+              constraints: BoxConstraints(maxHeight: MediaQuery.of(context).size.height * LivenessStyle.cameraShare),
+              child: AspectRatio(aspectRatio: 3 / 4, child: _preview(s, tone)),
+            ),
+          ),
+          const SizedBox(height: 12),
+          _statusCard(l, s, tone),
+          _secondaryLine(l, s),
+          _progressRow(l, s),
+          if (s.tips) ...[
+            const SizedBox(height: 12),
+            ConstrainedBox(
+              constraints: BoxConstraints(maxHeight: c.maxHeight * LivenessStyle.tipsMaxShare),
+              child: _tips(l),
+            ),
+          ],
+        ],
+      );
+    });
+  }
+
+  Widget _preview(LivenessViewState s, Color tone) {
+    // The fake engine has no camera: a placeholder instead of a black view.
+    final preview = widget.previewBuilder?.call() ??
+        (widget.useFake ? const LivenessPlaceholderPreview() : null) ??
+        AndroidView(
+          viewType: LivenessPage.previewViewType,
+          creationParamsCodec: const StandardMessageCodec(),
+          onPlatformViewCreated: (_) {
+            if (!_previewReady.isCompleted) _previewReady.complete();
+          },
+        );
+    return ClipRRect(
+      key: const Key('liveness.camera'),
+      borderRadius: BorderRadius.circular(LivenessStyle.cameraRadius),
+      child: LayoutBuilder(builder: (context, c) {
+        final oval = _OvalPainter.ovalRect(Size(c.maxWidth, c.maxHeight));
+        const badge = LivenessStyle.badge;
+        return Stack(
+          fit: StackFit.expand,
+          children: [
+            ExcludeSemantics(child: preview),
+            IgnorePointer(child: CustomPaint(painter: _OvalPainter(tone))),
+            // The state badge sits on the top centre of the oval.
+            Positioned(
+              key: const Key('liveness.badge'),
+              left: oval.center.dx - badge / 2,
+              top: math.max(0, oval.top - badge / 2),
+              width: badge,
+              height: badge,
+              child: ExcludeSemantics(child: _badge(s.icon, tone)),
+            ),
+          ],
+        );
+      }),
+    );
+  }
+
+  Widget _statusCard(AppLocalizations l, LivenessViewState s, Color tone) {
+    final key = s.statusKey;
+    // The live region carries the current status only: during the cross-fade the outgoing text is still painted,
+    // and it must not be announced again together with the new one.
+    return Semantics(
+      liveRegion: true,
+      container: true,
+      label: key == null ? '' : livenessText(l, key),
+      child: ExcludeSemantics(
+        child: Container(
+        key: const Key('liveness.status'),
+        width: double.infinity,
+        constraints: const BoxConstraints(minHeight: LivenessStyle.statusMinHeight),
+        alignment: Alignment.center,
+        padding: const EdgeInsets.all(12),
+        decoration: BoxDecoration(
+          color: tone.withOpacity(0.10),
+          borderRadius: BorderRadius.circular(LivenessStyle.statusRadius),
+          border: Border.all(color: tone, width: 1),
+        ),
+        child: AnimatedSwitcher(
+          duration: MediaQuery.of(context).disableAnimations ? Duration.zero : LivenessStyle.statusFade,
+          // Without the default builder's key, a status that comes back mid-fade gets its own entry.
+          transitionBuilder: (child, animation) => FadeTransition(opacity: animation, child: child),
+          child: LayoutBuilder(
+            key: ValueKey<String>('$key ${s.icon} ${s.ovalTone}'),
+            builder: (context, c) {
+              final text = key == null ? '' : livenessText(l, key);
+              const icon = LivenessStyle.badge + 10;
+              return Row(
+                mainAxisAlignment: MainAxisAlignment.center,
+                children: [
+                  ExcludeSemantics(child: _badge(s.icon, tone)),
+                  const SizedBox(width: 10),
+                  Flexible(
+                    child: Text(
+                      text,
+                      textAlign: TextAlign.center,
+                      // As wide as the longest line, so the badge stays next to a wrapped status.
+                      textWidthBasis: TextWidthBasis.longestLine,
+                      style: _fitStatus(context, text, c.maxWidth - icon),
+                    ),
+                  ),
+                ],
+              );
+            },
+          ),
+        ),
+      ),
+      ),
+    );
+  }
+
+  /// The status at 20 sp; a long one steps down towards 16 sp where 20 would need a
+  /// third line. Never truncated: at a large text scale it may take more lines.
+  static TextStyle _fitStatus(BuildContext context, String text, double width) {
+    final base = DefaultTextStyle.of(context).style.merge(LivenessStyle.status);
+    for (var size = LivenessStyle.status.fontSize!; size > LivenessStyle.statusMinSize; size--) {
+      final painter = TextPainter(
+        text: TextSpan(text: text, style: base.copyWith(fontSize: size)),
+        textAlign: TextAlign.center,
+        textDirection: Directionality.of(context),
+        textScaleFactor: MediaQuery.textScaleFactorOf(context),
+        locale: Localizations.maybeLocaleOf(context),
+        maxLines: 2,
+      )..layout(maxWidth: math.max(0, width));
+      if (!painter.didExceedMaxLines) return LivenessStyle.status.copyWith(fontSize: size);
+    }
+    return LivenessStyle.status.copyWith(fontSize: LivenessStyle.statusMinSize);
+  }
+
+  /// The hint (guidance or feedback), or the recovery text of a final failure.
+  /// The attempts left go to the progress row instead.
+  Widget _secondaryLine(AppLocalizations l, LivenessViewState s) {
+    final hint = s.hintKey == _attemptsLeftKey ? null : s.hintKey;
+    final key = hint ?? s.recoveryKey;
+    // While guidance can still arrive, the line keeps its place, so nothing below it jumps.
+    final reserve = !s.isFinal && s.phase != LivenessPhase.attemptFailed && s.phase != LivenessPhase.deviceError;
+    if (key == null && !reserve) return const SizedBox(width: double.infinity);
+    return Padding(
+      padding: const EdgeInsets.only(top: 8),
+      child: ConstrainedBox(
+        constraints: const BoxConstraints(minHeight: 20, minWidth: double.infinity),
+        child: key == null
+            ? null
+            : Semantics(
+                liveRegion: true,
+                child: Row(
+                  mainAxisAlignment: MainAxisAlignment.center,
+                  children: [
+                    if (hint != null && s.hintIsGuidance)
+                      const Padding(
+                        padding: EdgeInsetsDirectional.only(end: 6),
+                        child: Icon(Icons.warning_amber_rounded, color: LivenessStyle.warningIcon, size: 18),
+                      ),
+                    Flexible(
+                      child: Text(livenessText(l, key, n: s.retriesLeft),
+                          textAlign: TextAlign.center, style: LivenessStyle.body),
+                    ),
+                  ],
+                ),
+              ),
+      ),
+    );
+  }
+
+  /// "Step i of n", the step bar and "Attempt a of m"; after a failed attempt only
+  /// the attempts left.
+  Widget _progressRow(AppLocalizations l, LivenessViewState s) {
+    Widget? row;
+    final attempt = s.attempt > 0 && s.maxAttempts > 0 && !s.isFinal
+        ? Text(livenessText(l, 'liveness.progress.attempt', a: s.attempt, m: s.maxAttempts),
+            style: LivenessStyle.caption)
+        : null;
+    if (s.hintKey == _attemptsLeftKey) {
+      row = Semantics(
+        liveRegion: true,
+        child: Text(livenessText(l, _attemptsLeftKey, n: s.retriesLeft),
+            textAlign: TextAlign.center, style: LivenessStyle.body),
+      );
+    } else if (s.progressVisible && s.stepCount > 0) {
+      // Each label takes at most 35 % of the row and wraps beyond that (long translations).
+      row = LayoutBuilder(builder: (context, c) {
+        final label = BoxConstraints(maxWidth: c.maxWidth * 0.35);
+        return Row(
+          children: [
+            ConstrainedBox(
+              constraints: label,
+              child: Text(livenessText(l, 'liveness.progress.step', i: s.stepIndex, n: s.stepCount),
+                  style: LivenessStyle.caption),
+            ),
+            const SizedBox(width: 12),
+            Expanded(
+              child: ExcludeSemantics(
+                child: LivenessStepBar(count: s.stepCount, current: s.stepIndex, progress: s.progress ?? 0),
+              ),
+            ),
+            if (attempt != null) ...[
+              const SizedBox(width: 12),
+              ConstrainedBox(constraints: label, child: attempt),
+            ],
+          ],
+        );
+      });
+    } else {
+      row = attempt;
+    }
+    return Padding(
+      padding: const EdgeInsets.only(top: 8),
+      child: ConstrainedBox(
+        constraints: const BoxConstraints(minHeight: 24, minWidth: double.infinity),
+        child: row == null ? null : Center(child: row),
+      ),
+    );
+  }
+
+  Widget _tips(AppLocalizations l) {
+    return Container(
+      key: const Key('liveness.tips'),
+      width: double.infinity,
+      decoration: BoxDecoration(
+        color: LivenessStyle.tipsBackground,
+        borderRadius: BorderRadius.circular(LivenessStyle.statusRadius),
+      ),
+      child: SingleChildScrollView(
+        padding: const EdgeInsets.fromLTRB(14, 10, 14, 10),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(livenessText(l, 'liveness.tips.title'),
+                style: LivenessStyle.tips.copyWith(fontWeight: FontWeight.w600)),
+            // The bullet apart from the text, so a wrapped tip continues under its text.
+            for (final key in livenessTipKeys)
+              Padding(
+                padding: const EdgeInsets.only(top: 4),
+                child: Row(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    const ExcludeSemantics(child: Text('•', style: LivenessStyle.tips)),
+                    const SizedBox(width: LivenessStyle.bulletGap),
+                    Expanded(child: Text(livenessText(l, key), style: LivenessStyle.tips)),
+                  ],
+                ),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  /// One row of equal-width buttons: filled for Retry and Close, outlined for
+  /// Cancel and Open settings. A single button is as wide as one of two.
+  Widget _buttons(AppLocalizations l, LivenessViewState s) {
+    final text = Theme.of(context).textTheme.labelLarge!.merge(LivenessStyle.button);
+    final buttons = <Widget>[
+      if (s.showRetry) _button(livenessText(l, 'liveness.button.retry'), text, _retry, primary: true),
+      if (s.showCancel) _button(livenessText(l, 'liveness.button.cancel'), text, _cancel),
+      if (s.showOpenSettings)
+        _button(livenessText(l, 'liveness.button.open_settings'), text, () => _service.openCameraSettings()),
+      if (s.showClose) _button(livenessText(l, 'liveness.button.close'), text, _close, primary: true),
+    ];
+    return LayoutBuilder(builder: (context, c) {
+      final slots = math.max(buttons.length, 2);
+      final width = (c.maxWidth - LivenessStyle.buttonGap * (slots - 1)) / slots;
+      return ConstrainedBox(
+        constraints: const BoxConstraints(minHeight: LivenessStyle.buttonHeight),
+        child: Row(
+          mainAxisAlignment: MainAxisAlignment.center,
+          children: [
+            for (var i = 0; i < buttons.length; i++) ...[
+              if (i > 0) const SizedBox(width: LivenessStyle.buttonGap),
+              SizedBox(width: width, child: buttons[i]),
+            ],
+          ],
+        ),
+      );
+    });
+  }
+
+  static Widget _button(String text, TextStyle textStyle, VoidCallback onPressed, {bool primary = false}) {
+    const size = Size(0, LivenessStyle.buttonHeight);
+    final shape = RoundedRectangleBorder(borderRadius: BorderRadius.circular(LivenessStyle.buttonRadius));
+    final label = Text(text, textAlign: TextAlign.center);
+    return primary
+        ? ElevatedButton(
+            style: ElevatedButton.styleFrom(
+              backgroundColor: LivenessStyle.primary,
+              foregroundColor: Colors.white,
+              minimumSize: size,
+              shape: shape,
+              textStyle: textStyle,
+              elevation: 0,
+            ),
+            onPressed: onPressed,
+            child: label,
+          )
+        : OutlinedButton(
+            style: OutlinedButton.styleFrom(
+              foregroundColor: LivenessStyle.primary,
+              minimumSize: size,
+              shape: shape,
+              textStyle: textStyle,
+              side: const BorderSide(color: LivenessStyle.primary),
+            ),
+            onPressed: onPressed,
+            child: label,
+          );
+  }
+
+  static const String _attemptsLeftKey = 'liveness.retry.attempts_left';
+
+  static Color _toneColor(LivenessOvalTone tone) {
+    switch (tone) {
+      case LivenessOvalTone.neutral:
+        return LivenessStyle.neutral;
+      case LivenessOvalTone.checking:
+        return LivenessStyle.primary;
+      case LivenessOvalTone.challenge:
+        return LivenessStyle.challenge;
+      case LivenessOvalTone.success:
+        return LivenessStyle.success;
+      case LivenessOvalTone.error:
+        return LivenessStyle.failure;
+    }
+  }
+
+  /// The state badge: a circle in the state colour with the state icon.
+  static Widget _badge(LivenessIcon icon, Color tone) => Container(
+        width: LivenessStyle.badge,
+        height: LivenessStyle.badge,
+        alignment: Alignment.center,
+        decoration: BoxDecoration(
+          color: tone,
+          shape: BoxShape.circle,
+          border: Border.all(color: Colors.white, width: 1.5),
+        ),
+        child: _stateIcon(icon,
+            color: tone == LivenessStyle.challenge ? LivenessStyle.onChallenge : Colors.white,
+            size: LivenessStyle.badgeIcon),
+      );
+
+  /// The state icon, never mirrored in a right-to-left language: the turn arrows show
+  /// the user's physical left and right, the same in every language.
+  static Widget _stateIcon(LivenessIcon icon, {required Color color, required double size}) =>
+      Directionality(
+        textDirection: TextDirection.ltr,
+        child: Icon(_iconData(icon), color: color, size: size),
+      );
+
+  static IconData _iconData(LivenessIcon icon) {
+    switch (icon) {
+      case LivenessIcon.camera:
+        return Icons.photo_camera_outlined;
+      case LivenessIcon.scanning:
+        return Icons.center_focus_weak;
+      case LivenessIcon.blink:
+        return Icons.visibility_outlined;
+      case LivenessIcon.smile:
+        return Icons.sentiment_satisfied_alt;
+      case LivenessIcon.turnLeft:
+        return Icons.arrow_back; // the preview is mirrored: the user's left is on screen left
+      case LivenessIcon.turnRight:
+        return Icons.arrow_forward;
+      case LivenessIcon.lookUp:
+        return Icons.arrow_upward;
+      case LivenessIcon.lookDown:
+        return Icons.arrow_downward;
+      case LivenessIcon.check:
+        return Icons.check_circle;
+      case LivenessIcon.cross:
+        return Icons.cancel;
+      case LivenessIcon.cameraOff:
+        return Icons.no_photography_outlined;
+    }
+  }
+}
+
+/// A neutral grey silhouette in place of the camera picture: the fake engine,
+/// tests and privacy-safe screenshots.
+class LivenessPlaceholderPreview extends StatelessWidget {
+  const LivenessPlaceholderPreview({super.key});
+
+  @override
+  Widget build(BuildContext context) => const ColoredBox(
+        color: Color(0xFFBDBDBD),
+        child: Center(child: Icon(Icons.person, size: 180, color: Color(0xFF8A8A8A))),
+      );
+}
+
+/// The step bar: one segment per challenge. Done steps are filled; the current
+/// one is half filled and fills further with the challenge's progress.
+class LivenessStepBar extends StatelessWidget {
+  const LivenessStepBar({super.key, required this.count, required this.current, required this.progress});
+
+  final int count;
+
+  /// 1-based.
+  final int current;
+  final double progress;
+
+  @override
+  Widget build(BuildContext context) => Row(
+        children: [
+          for (var i = 1; i <= count; i++) ...[
+            if (i > 1) const SizedBox(width: LivenessStyle.segmentGap),
+            Expanded(
+              child: _segment(i < current ? 1.0 : (i == current ? math.max(0.5, progress.clamp(0.0, 1.0)).toDouble() : 0.0)),
+            ),
+          ],
+        ],
+      );
+
+  static Widget _segment(double fill) => ClipRRect(
+        borderRadius: BorderRadius.circular(LivenessStyle.segmentHeight / 2),
+        child: SizedBox(
+          height: LivenessStyle.segmentHeight,
+          child: Stack(
+            fit: StackFit.expand,
+            children: [
+              const ColoredBox(color: LivenessStyle.track),
+              FractionallySizedBox(
+                alignment: AlignmentDirectional.centerStart,
+                widthFactor: fill,
+                child: const ColoredBox(color: LivenessStyle.primary),
+              ),
+            ],
+          ),
+        ),
+      );
+}
+
+/// The face-oval guide: a 40 % scrim outside the oval, the outline in the state colour.
+class _OvalPainter extends CustomPainter {
+  _OvalPainter(this.color);
+
+  final Color color;
+
+  static Rect ovalRect(Size size) => Rect.fromCenter(
+        center: Offset(size.width / 2, size.height * 0.47),
+        width: size.width * 0.66,
+        height: size.height * 0.66,
+      );
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final oval = ovalRect(size);
+    final dim = Path()
+      ..fillType = PathFillType.evenOdd
+      ..addRect(Offset.zero & size)
+      ..addOval(oval);
+    canvas.drawPath(dim, Paint()..color = LivenessStyle.scrim);
+    canvas.drawOval(
+      oval,
+      Paint()
+        ..style = PaintingStyle.stroke
+        ..strokeWidth = LivenessStyle.ovalStroke
+        ..color = color,
+    );
+  }
+
+  @override
+  bool shouldRepaint(_OvalPainter old) => old.color != color;
+}
