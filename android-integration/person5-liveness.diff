@@ -0,0 +1,63 @@
+package io.mosip.registration.clientmanager.repository;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import org.junit.Test;
+
+import java.util.Collections;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import io.mosip.registration.clientmanager.dao.GlobalParamDao;
+import io.mosip.registration.clientmanager.dao.LocalConfigDAO;
+import io.mosip.registration.clientmanager.entity.GlobalParam;
+
+/** Refresh listeners run after every successful cache refresh (e.g. a global-param sync), never after a failed one. */
+public class GlobalParamRepositoryRefreshListenerTest {
+
+    private final GlobalParamDao globalParamDao = mock(GlobalParamDao.class);
+    private final LocalConfigDAO localConfigDAO = mock(LocalConfigDAO.class);
+
+    @Test
+    public void listenersRunAfterASync() {
+        when(globalParamDao.getGlobalParams()).thenReturn(Collections.emptyList());
+        when(localConfigDAO.getLocalConfigurations()).thenReturn(Collections.emptyMap());
+        GlobalParamRepository repository = new GlobalParamRepository(globalParamDao, localConfigDAO);
+        AtomicInteger runs = new AtomicInteger();
+        repository.addRefreshListener(runs::incrementAndGet);
+
+        repository.saveGlobalParams(Collections.singletonList(
+                new GlobalParam("mosip.registration.liveness.face.default.maxRetries", "x", "2", true)));
+        assertEquals(1, runs.get());
+        repository.refreshConfigurationCache();
+        assertEquals(2, runs.get());
+    }
+
+    @Test
+    public void aFailingListenerDoesNotStopTheOthers() {
+        when(globalParamDao.getGlobalParams()).thenReturn(Collections.emptyList());
+        when(localConfigDAO.getLocalConfigurations()).thenReturn(Collections.emptyMap());
+        GlobalParamRepository repository = new GlobalParamRepository(globalParamDao, localConfigDAO);
+        AtomicInteger runs = new AtomicInteger();
+        repository.addRefreshListener(() -> {
+            throw new IllegalStateException("broken listener");
+        });
+        repository.addRefreshListener(runs::incrementAndGet);
+        repository.refreshConfigurationCache();
+        assertEquals(1, runs.get());
+    }
+
+    @Test
+    public void noListenerAfterAFailedRefresh() {
+        when(globalParamDao.getGlobalParams()).thenReturn(Collections.emptyList());
+        when(localConfigDAO.getLocalConfigurations()).thenReturn(Collections.emptyMap());
+        GlobalParamRepository repository = new GlobalParamRepository(globalParamDao, localConfigDAO);
+        AtomicInteger runs = new AtomicInteger();
+        repository.addRefreshListener(runs::incrementAndGet);
+        when(globalParamDao.getGlobalParams()).thenThrow(new IllegalStateException("database closed"));
+        repository.refreshConfigurationCache();
+        assertEquals(0, runs.get());
+        repository.removeRefreshListener(null); // tolerated
+    }
+}
