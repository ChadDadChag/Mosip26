+import io.mosip.registration.liveness.api.WorkflowType;
+import io.mosip.registration.liveness.core.DefaultLivenessService;
+import io.mosip.registration.liveness.core.metrics.LivenessMetrics;
+import io.mosip.registration.liveness.fake.FakeLivenessService;
+
+/**
+ * The app's single liveness engine (one instance, provided by Dagger).
+ *
+ * <ul>
+ *   <li>Real engine: the ONNX analyzer with the signed bundle from the assets, or a newer verified bundle installed
+ *       in {@code files/liveness-models}, behind {@link DefaultLivenessService}.</li>
+ *   <li>Fake engine: {@link FakeLivenessService}, scripted by {@code mosip.registration.liveness.fake.scenario}.</li>
+ *   <li>Config: the synced global params, under a map of overrides (debug screen only). Re-read after every global
+ *       param refresh (a sync): policies for new sessions, and the analyzer when its settings changed.</li>
+ *   <li>{@link #preload()} verifies the bundle and builds the ONNX sessions in the background at app start.</li>
+ *   <li>The camera per workflow: {@code mosip.registration.liveness.face.android.<workflow>.camera}, front or back;
