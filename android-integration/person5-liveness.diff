+/// A neutral grey silhouette in place of the camera picture: the fake engine,
+/// tests and privacy-safe screenshots.
+class LivenessPlaceholderPreview extends StatelessWidget {
+  const LivenessPlaceholderPreview({super.key});
+
+  @override
+  Widget build(BuildContext context) => const ColoredBox(
+        color: Color(0xFFBDBDBD),
+        child: Center(child: Icon(Icons.person, size: 180, color: Color(0xFF8A8A8A))),
+      );
+}
+
+/// The face-oval guide: the outside dimmed lightly, the outline in the state colour.
+class _OvalPainter extends CustomPainter {
+  _OvalPainter(this.color);
+
+  final Color color;
+
+  static Rect ovalRect(Size size) => Rect.fromCenter(
+        center: Offset(size.width / 2, size.height * 0.47),
+        width: size.width * 0.66,
+        height: size.height * 0.66,
+      );
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final oval = ovalRect(size);
+    final dim = Path()
+      ..fillType = PathFillType.evenOdd
+      ..addRect(Offset.zero & size)
+      ..addOval(oval);
+    canvas.drawPath(dim, Paint()..color = Colors.black.withOpacity(0.30));
+    canvas.drawOval(
+      oval,
+      Paint()
+        ..style = PaintingStyle.stroke
+        ..strokeWidth = 4
+        ..color = color,
+    );
+  }
+
+  @override
+  bool shouldRepaint(_OvalPainter old) => old.color != color;
+}
