+
+package io.mosip.registration_client.api_services;
+
+import android.Manifest;
+import android.content.pm.PackageManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+import android.util.Size;
+
+import androidx.annotation.NonNull;
+import androidx.camera.core.CameraSelector;
+import androidx.camera.view.PreviewView;
+import androidx.core.content.ContextCompat;
+
+import java.io.File;
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+
+import javax.inject.Inject;
+import javax.inject.Singleton;
+
+import io.flutter.embedding.engine.FlutterEngine;
+import io.flutter.plugin.common.BinaryMessenger;
+import io.flutter.plugin.common.EventChannel;
+import io.mosip.registration.liveness.android.AnalyzerBenchmark;
+import io.mosip.registration.liveness.android.BestFrameEncoder;
+import io.mosip.registration.liveness.android.LivenessMaps;
+import io.mosip.registration.liveness.android.LivenessServiceHolder;
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.FrameSource;
+import io.mosip.registration.liveness.api.LivenessEvent;
+import io.mosip.registration.liveness.api.LivenessListener;
+import io.mosip.registration.liveness.api.LivenessPolicy;
+import io.mosip.registration.liveness.api.LivenessResult;
+import io.mosip.registration.liveness.api.LivenessSession;
+import io.mosip.registration.liveness.api.WorkflowType;
+import io.mosip.registration.liveness.device.android.CameraXFrameSource;
+import io.mosip.registration_client.BuildConfig;
+import io.mosip.registration_client.MainActivity;
+import io.mosip.registration_client.model.LivenessPigeon;
+
+/**
+ * Face liveness for Dart: the Pigeon {@code LivenessApi} plus the event channel
+ * {@value #EVENT_CHANNEL}, which carries each session's events and its result (see {@link LivenessMaps}).
+ *
+ * <p>One session at a time: starting a session cancels the running one (whose remaining callbacks are dropped),
+ * and the Activity pausing cancels it. Session state is touched on the main thread only. The best frame is
+ * sent to Dart as a JPEG on PASSED and is never logged.</p>
+ *
+ * <p>Diagnostics ({@code BuildConfig.LIVENESS_DIAGNOSTICS}: debug and profile builds, never release): config
+ * overrides, detailed logs, the analyzer benchmark (frames in memory only) and model bundle install/rollback from
+ * {@value #BUNDLE_STAGING}.</p>
+ */
+@Singleton
+public class LivenessApi implements LivenessPigeon.LivenessApi {
+
+    private static final String TAG = "LivenessApi";
+    public static final String EVENT_CHANNEL = "io.mosip.registration_client/liveness/events";
+    public static final String PREVIEW_VIEW_TYPE = "io.mosip.registration_client/liveness_preview";
+    private static final Size ANALYSIS_RESOLUTION = new Size(640, 480);
+    /** Under the app's external files dir (adb push target): a signed bundle to install. */
+    static final String BUNDLE_STAGING = "bundle-staging";
+    /** Under the app's external files dir: signed test bundles the benchmark also runs. */
+    static final String BENCH_BUNDLES = "bench-bundles";
+    private static final int BENCHMARK_FRAMES = 60;
+    private static final long BENCHMARK_CAPTURE_TIMEOUT_MS = 20_000;
+
+    private final LivenessServiceHolder holder;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private WeakReference<MainActivity> activityRef = new WeakReference<>(null);
+
+    // Main thread only.
+    private EventChannel.EventSink events;
+    private LivenessSession session;
+    private CameraXFrameSource source;
+    private int generation;
+    private boolean benchmarking;
+
+    @Inject
+    public LivenessApi(LivenessServiceHolder holder) {
+        this.holder = holder;
+    }
+
+    public void setCallbackActivity(MainActivity activity) {
+        this.activityRef = new WeakReference<>(activity);
+    }
+
+    /** Registers the Pigeon API, the event channel and the camera preview view factory. */
+    public void setup(@NonNull FlutterEngine flutterEngine) {
+        BinaryMessenger messenger = flutterEngine.getDartExecutor().getBinaryMessenger();
+        LivenessPigeon.LivenessApi.setup(messenger, this);
+        new EventChannel(messenger, EVENT_CHANNEL).setStreamHandler(new EventChannel.StreamHandler() {
+            @Override
+            public void onListen(Object arguments, EventChannel.EventSink sink) {
+                events = sink;
+            }
+
+            @Override
+            public void onCancel(Object arguments) {
+                events = null;
+            }
+        });
+        flutterEngine.getPlatformViewsController().getRegistry()
+                .registerViewFactory(PREVIEW_VIEW_TYPE, new LivenessPreviewFactory(holder));
+    }
+
+    /** Loads the models in the background so the first session does not wait for them. */
+    public void preload() {
+        holder.preload();
+    }
+
+    public void onActivityPause() {
+        if (session != null) {
+            Log.i(TAG, "activity paused: cancelling the liveness session");
+            session.cancel();
+        }
+    }
+
+    @NonNull
+    @Override
+    public Boolean isEnabled(@NonNull String workflow) {
+        return holder.policy(workflow(workflow)).enabled;
+    }
+
+    @NonNull
+    @Override
+    public LivenessPigeon.LivenessPolicyInfo policy(@NonNull String workflow) {
+        LivenessPolicy p = holder.policy(workflow(workflow));
+        return new LivenessPigeon.LivenessPolicyInfo.Builder()
+                .setEnabled(p.enabled)
+                .setMaxRetries((long) p.maxRetries)
+                .setMinChallenges((long) p.minChallenges)
+                .setChallengeTimeoutMs(p.challengeTimeoutMs)
+                .build();
+    }
+
+    @Override
+    public void startSession(@NonNull String workflow, @NonNull String camera, @NonNull Boolean useFake,
+                             @NonNull LivenessPigeon.Result<String> result) {
+        int gen = ++generation; // callbacks of the session being replaced are dropped from here on
+        stopCurrent();
+        MainActivity activity = activityRef.get();
+        if (activity == null) {
+            result.error(new IllegalStateException("Activity not set"));
+            return;
+        }
+        WorkflowType wf;
+        try {
+            wf = workflow(workflow);
+        } catch (IllegalArgumentException e) {
+            result.error(e);
+            return;
+        }
+        if (!useFake
+                && ContextCompat.checkSelfPermission(activity, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+            // Dart asks for the permission first; this covers a refusal or a revoked permission.
+            String id = UUID.randomUUID().toString();
+            Log.w(TAG, "camera permission not granted: session " + id + " failed");
+            result.success(id);
+            send(gen, LivenessMaps.failed(ErrorCode.CAMERA_UNAVAILABLE, id, holder.modelVersion()));
+            return;
+        }
+        LivenessSession s;
+        try {
+            s = holder.service(useFake).newSession(wf);
+        } catch (RuntimeException e) {
+            result.error(e);
+            return;
+        }
+        if (s == null) {
+            result.success(""); // liveness disabled for this workflow: the caller keeps its legacy flow
+            return;
+        }
+        // The fake engine runs without a camera: nothing is captured, shown or returned from it.
+        PreviewView preview = useFake ? null : holder.preview();
+        CameraXFrameSource src = null;
+        if (!useFake) {
+            CameraSelector selector = "back".equalsIgnoreCase(camera)
+                    ? CameraSelector.DEFAULT_BACK_CAMERA : CameraSelector.DEFAULT_FRONT_CAMERA;
+            src = new CameraXFrameSource(activity, activity, selector, ANALYSIS_RESOLUTION, 1,
+                    preview == null ? null : preview.getSurfaceProvider());
+            src.setDebugTiming(BuildConfig.LIVENESS_DIAGNOSTICS);
+            src.setExposureAssist(holder.exposureAssist());
+        }
+        final CameraXFrameSource sessionSource = src;
+        session = s;
+        source = src;
+        holder.analyzerTimes().reset();
+        Log.i(TAG, "session " + s.sessionId() + " started: " + wf + ", " + (useFake ? "fake engine, no camera"
+                : "real engine, " + ("back".equalsIgnoreCase(camera) ? "back" : "front") + " camera, preview "
+                + (preview != null) + ", exposure assist " + (src.exposureAssist() ? "on" : "off")));
+        s.start(src, new LivenessListener() {
+            @Override
+            public void onEvent(LivenessEvent event) {
+                Map<String, Object> m = LivenessMaps.event(event);
+                if (BuildConfig.LIVENESS_DIAGNOSTICS) Log.d(TAG, "event " + event.type + describe(event));
+                send(gen, m);
+            }
+
+            @Override
+            public void onComplete(LivenessResult r) {
+                complete(gen, r, sessionSource);
+            }
+        });
+        result.success(s.sessionId());
+    }
+
+    @NonNull
+    @Override
+    public String cameraFor(@NonNull String workflow) {
+        return holder.cameraFor(workflow(workflow));
+    }
+
+    @Override
+    public void reloadConfig() {
+        holder.reloadConfig();
+    }
+
+    @Override
+    public void retry() {
+        if (session != null) session.retry();
+    }
+
+    @Override
+    public void cancel() {
+        if (session != null) session.cancel();
+    }
+
+    @NonNull
+    @Override
+    public String modelVersion() {
+        return holder.modelVersion();
+    }
+
+    @Override
+    public void setConfigOverride(@NonNull String key, @NonNull String value) {
+        if (!BuildConfig.LIVENESS_DIAGNOSTICS) {
+            Log.w(TAG, "config overrides are for diagnostics builds only; ignored " + key);
+            return;
+        }
+        holder.setOverride(key, value);
+        Log.i(TAG, "config overrides now " + holder.overrides());
+    }
+
+    @NonNull
+    @Override
+    public String metrics() {
+        StringBuilder sb = new StringBuilder();
+        for (Map.Entry<String, String> e : holder.persistedMetrics().entrySet()) {
+            sb.append(e.getKey()).append('=').append(e.getValue()).append('\n');
+        }
+        return sb.toString();
+    }
+
+    @Override
+    public void resetMetrics() {
+        if (!BuildConfig.LIVENESS_DIAGNOSTICS) {
+            Log.w(TAG, "metrics reset is for diagnostics builds only; ignored");
+            return;
+        }
+        holder.resetMetrics();
+        Log.i(TAG, "persisted metrics reset");
+    }
+
+    @NonNull
+    @Override
+    public String modelStoreStatus() {
+        return holder.modelStoreStatus();
+    }
+
+    @Override
+    public void installModelBundle(@NonNull LivenessPigeon.Result<String> result) {
+        if (!diagnostics(result)) return;
+        File dir = holder.context().getExternalFilesDir(BUNDLE_STAGING);
+        holder.background().execute(() -> {
+            try {
+                String v = holder.installModelBundle(dir);
+                main.post(() -> result.success(v));
+            } catch (Exception e) {
+                Log.w(TAG, "model bundle not installed: " + e);
+                main.post(() -> result.error(e));
+            }
+        });
+    }
+
+    @Override
+    public void rollbackModelBundle(@NonNull LivenessPigeon.Result<String> result) {
+        if (!diagnostics(result)) return;
+        holder.background().execute(() -> {
+            try {
+                String v = holder.rollbackModelBundle();
+                main.post(() -> result.success(v));
+            } catch (Exception e) {
+                Log.w(TAG, "model bundle not rolled back: " + e);
+                main.post(() -> result.error(e));
+            }
+        });
+    }
+
+    /**
+     * Captures {@value #BENCHMARK_FRAMES} frames into memory (never written anywhere), stops the camera, then runs
+     * {@link AnalyzerBenchmark} on its own thread and drops the frames. The report holds timings and parity only.
+     */
+    @Override
+    public void runBenchmark(@NonNull String camera, @NonNull LivenessPigeon.Result<String> result) {
+        if (!diagnostics(result)) return;
+        MainActivity activity = activityRef.get();
+        if (activity == null) {
+            result.error(new IllegalStateException("Activity not set"));
+            return;
+        }
+        if (session != null || benchmarking) {
+            result.error(new IllegalStateException("a session or a benchmark is running"));
+            return;
+        }
+        if (ContextCompat.checkSelfPermission(activity, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+            result.error(new IllegalStateException("camera permission not granted"));
+            return;
+        }
+        benchmarking = true;
+        CameraSelector selector = "back".equalsIgnoreCase(camera)
+                ? CameraSelector.DEFAULT_BACK_CAMERA : CameraSelector.DEFAULT_FRONT_CAMERA;
+        PreviewView preview = holder.preview();
+        CameraXFrameSource src = new CameraXFrameSource(activity, activity, selector, ANALYSIS_RESOLUTION, 1,
+                preview == null ? null : preview.getSurfaceProvider());
+        src.setExposureAssist(holder.exposureAssist());
+        List<Frame> frames = new ArrayList<>();
+        boolean[] done = {false};
+        Runnable finishCapture = () -> { // main thread
+            if (done[0]) return;
+            done[0] = true;
+            src.stop();
+            if (frames.size() < BENCHMARK_FRAMES) {
+                int captured = frames.size();
+                frames.clear();
+                benchmarking = false;
+                result.error(new IllegalStateException("captured only " + captured + " frames"));
+                return;
+            }
+            File benchDir = activity.getExternalFilesDir(BENCH_BUNDLES);
+            String device = android.os.Build.MANUFACTURER + " " + android.os.Build.MODEL + ", Android "
+                    + android.os.Build.VERSION.RELEASE + " (API " + android.os.Build.VERSION.SDK_INT + "), "
+                    + BuildConfig.BUILD_TYPE + " build, " + frames.get(0).width() + "x" + frames.get(0).height();
+            List<AnalyzerBenchmark.Bundle> bundles = holder.benchmarkBundles(benchDir);
+            Thread t = new Thread(() -> {
+                String report;
+                try {
+                    List<AnalyzerBenchmark.Result> r = AnalyzerBenchmark.run(frames, bundles,
+                            AnalyzerBenchmark.defaultSettings(), step -> Log.i(TAG, "benchmark: " + step));
+                    report = AnalyzerBenchmark.report(r, frames.size(), device);
+                } catch (RuntimeException | LinkageError e) {
+                    report = "benchmark failed: " + e;
+                } finally {
+                    frames.clear(); // the frames are dropped here, whatever happened
+                }
+                for (String line : report.split("\n")) Log.i(TAG, "benchmark| " + line);
+                String text = report;
+                main.post(() -> {
+                    benchmarking = false;
+                    result.success(text);
+                });
+            }, "liveness-benchmark");
+            t.start();
+        };
+        src.start(new FrameSource.Listener() {
+            @Override
+            public void onFrame(Frame frame) {
+                main.post(() -> {
+                    if (done[0]) return;
+                    frames.add(frame);
+                    if (frames.size() >= BENCHMARK_FRAMES) finishCapture.run();
+                });
+            }
+
+            @Override
+            public void onError(ErrorCode code, String detail, boolean recoverable) {
+                Log.w(TAG, "benchmark capture: " + code + " " + detail);
+                if (!recoverable) main.post(finishCapture);
+            }
+        });
+        main.postDelayed(finishCapture, BENCHMARK_CAPTURE_TIMEOUT_MS);
+        Log.i(TAG, "benchmark: capturing " + BENCHMARK_FRAMES + " frames into memory");
+    }
+
+    private static boolean diagnostics(LivenessPigeon.Result<String> result) {
+        if (BuildConfig.LIVENESS_DIAGNOSTICS) return true;
+        result.error(new IllegalStateException("diagnostics builds only"));
+        return false;
+    }
+
+    /** {@code src} is null for the fake engine, which then has no best frame to send either. */
+    private void complete(int gen, LivenessResult r, CameraXFrameSource src) {
+        if (src != null) src.stop(); // the session stops it too; stop() is idempotent
+        if (BuildConfig.LIVENESS_DIAGNOSTICS) {
+            Log.i(TAG, "complete " + LivenessMaps.describe(r));
+            Log.i(TAG, "analyzer " + holder.analyzerTimes().summary());
+            Log.i(TAG, "metrics " + holder.metrics(src == null).toMap());
+        } else {
+            Log.i(TAG, "complete " + r.decision + " " + r.failureCode + " in " + r.durationMs + " ms");
+        }
+        holder.background().execute(() -> {
+            if (src != null) holder.recordMetrics(); // the real engine's counts, persisted (anonymised)
+            byte[] jpeg = null;
+            // Without a camera the fake engine makes up a grey frame: not worth sending.
+            if (src != null && r.passed() && r.bestFrame != null) {
+                try {
+                    jpeg = BestFrameEncoder.jpeg(r.bestFrame, BestFrameEncoder.QUALITY);
+                } catch (RuntimeException e) {
+                    Log.e(TAG, "best frame could not be encoded", e);
+                }
+            }
+            Map<String, Object> m = LivenessMaps.result(r, jpeg);
+            main.post(() -> {
+                if (gen != generation) return;
+                session = null;
+                source = null;
+                deliver(m);
+            });
+        });
+    }
+
+    private void send(int gen, Map<String, Object> m) {
+        main.post(() -> {
+            if (gen == generation) deliver(m);
+        });
+    }
+
+    private void deliver(Map<String, Object> m) {
+        if (events != null) events.success(m);
+    }
+
+    private void stopCurrent() {
+        LivenessSession s = session;
+        CameraXFrameSource src = source;
+        session = null;
+        source = null;
+        if (s != null) s.cancel();
+        if (src != null) src.stop();
+    }
+
+    private static WorkflowType workflow(String workflow) {
+        return WorkflowType.valueOf(workflow.trim().toUpperCase(Locale.ROOT));
+    }
+
+    private static String describe(LivenessEvent e) {
+        StringBuilder sb = new StringBuilder();
+        if (e.guidance != null) sb.append(' ').append(e.guidance);
+        if (e.challenge != null) sb.append(' ').append(e.challenge).append(' ').append(e.challengeIndex).append('/').append(e.challengeCount);
+        if (e.type == LivenessEvent.Type.CHALLENGE_PROGRESS) sb.append(String.format(Locale.ROOT, " %.2f", e.progress));
+        if (e.error != null) sb.append(' ').append(e.error).append(" retriesLeft=").append(e.retriesLeft);
+        return sb.toString();
+    }
+}
