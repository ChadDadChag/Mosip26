+    if (mounted) setState(() => _busy = false);
+  }
+
+  /// F15, enroll: a real Operator gate; its best frame becomes the test face (app-private). It is never shown. Only
+  /// the operator enrolls, once: replacing the test face asks first.
+  Future<void> _identityEnroll() async {
+    if (_identityTemplate &&
+        !await _confirm('Replace the enrolled test face?',
+            'Only the operator enrolls. Everyone else uses 2. Check identity.', 'Replace',
+            const Key('demo.identity.replaceConfirm'))) {
+      return;
+    }
+    if (!mounted) return;
+    setState(() {
+      _busy = true;
+      _identityNote = null;
+      // A verdict against the old test face no longer holds.
+      _identityInfo = null;
+      _identityProblem = null;
+    });
+    final gate = await LivenessGate.run(context,
+        workflow: LivenessGate.operator, service: _service, previewBuilder: widget.previewBuilder);
+    String note;
+    if (gate.disabled) {
+      note = 'Liveness is off for operators – nothing enrolled';
+    } else if (!gate.proceed || gate.sessionId == null) {
+      note = 'Face check not passed – nothing enrolled';
+    } else {
+      try {
+        final outcome = await _api.enrollIdentityTestTemplate(gate.sessionId!);
+        note = outcome == 'ENROLLED'
+            ? 'Enrolled – now anyone can use 2. Check identity'
+            : outcome == 'NO_LIVE_FRAME'
+                ? 'No face kept from the check – nothing enrolled'
+                : 'Enrolment failed – try again';
+      } on PlatformException catch (e) {
+        note = 'Enrolment failed: ${e.message}';
+      }
+    }
+    await _identityDone(note: note);
+  }
+
