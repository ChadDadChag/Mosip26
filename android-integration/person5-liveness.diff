@@ -0,0 +1,34 @@
+package io.mosip.registration.liveness.android;
+
+import android.graphics.Bitmap;
+
+import java.io.ByteArrayOutputStream;
+
+import io.mosip.registration.liveness.api.Frame;
+
+/** Encodes the engine's best frame as a JPEG for the UI. In memory only; never written to disk or logged. */
+public final class BestFrameEncoder {
+
+    public static final int QUALITY = 90;
+
+    private BestFrameEncoder() { }
+
+    public static byte[] jpeg(Frame frame, int quality) {
+        if (frame == null) return null;
+        int width = frame.width();
+        int height = frame.height();
+        byte[] rgb = frame.rgb();
+        int[] argb = new int[width * height];
+        for (int i = 0, p = 0; i < argb.length; i++, p += 3) {
+            argb[i] = 0xFF000000 | ((rgb[p] & 0xFF) << 16) | ((rgb[p + 1] & 0xFF) << 8) | (rgb[p + 2] & 0xFF);
+        }
+        Bitmap bitmap = Bitmap.createBitmap(argb, width, height, Bitmap.Config.ARGB_8888);
+        try {
+            ByteArrayOutputStream out = new ByteArrayOutputStream(64 * 1024);
+            bitmap.compress(Bitmap.CompressFormat.JPEG, quality, out);
+            return out.toByteArray();
+        } finally {
+            bitmap.recycle();
+        }
+    }
+}
diff --git a/android/liveness/src/main/java/io/mosip/registration/liveness/android/LivenessMaps.java b/android/liveness/src/main/java/io/mosip/registration/liveness/android/LivenessMaps.java
new file mode 100644
index 0000000..07131e6
--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/LivenessMaps.java
@@ -0,0 +1,93 @@
+package io.mosip.registration.liveness.android;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+import io.mosip.registration.liveness.api.ChallengeType;
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.LivenessEvent;
+import io.mosip.registration.liveness.api.LivenessResult;
+
+/**
+ * The maps sent to Dart on the liveness event channel. Enums travel as their names, absent values as null.
+ *
+ * <pre>
+ * event:    {kind:"event", type, guidance, challenge, challengeIndex, challengeCount, timeoutMs, progress,
+ *            error, userMessage, attemptNumber, retriesLeft, recoverable}
+ * complete: {kind:"complete", decision, passPath, failureCode, userMessage, passiveScore, challengesIssued:[...],
+ *            attempts, durationMs, sessionId, modelVersion, bestFrameJpeg}
+ * </pre>
+ *
+ * <p>{@code bestFrameJpeg} is set only on PASSED. {@link #describe(LivenessResult)} is the log form of a result:
+ * it never contains the image.</p>
+ */
+public final class LivenessMaps {
+
+    public static final String KIND = "kind";
+    public static final String KIND_EVENT = "event";
+    public static final String KIND_COMPLETE = "complete";
+    public static final String BEST_FRAME_JPEG = "bestFrameJpeg";
+
+    private LivenessMaps() { }
+
+    public static Map<String, Object> event(LivenessEvent e) {
+        Map<String, Object> m = new HashMap<>();
+        m.put(KIND, KIND_EVENT);
+        m.put("type", name(e.type));
+        m.put("guidance", name(e.guidance));
+        m.put("challenge", name(e.challenge));
+        m.put("challengeIndex", e.challengeIndex);
+        m.put("challengeCount", e.challengeCount);
+        m.put("timeoutMs", e.timeoutMs);
+        m.put("progress", (double) e.progress);
+        m.put("error", name(e.error));
+        m.put("userMessage", e.error == null ? null : e.error.userMessage().name());
+        m.put("attemptNumber", e.attemptNumber);
+        m.put("retriesLeft", e.retriesLeft);
+        m.put("recoverable", e.recoverable);
+        return m;
+    }
+
+    /** @param bestFrameJpeg the encoded best frame; ignored unless the result PASSED */
+    public static Map<String, Object> result(LivenessResult r, byte[] bestFrameJpeg) {
+        Map<String, Object> m = new HashMap<>();
+        m.put(KIND, KIND_COMPLETE);
+        m.put("decision", name(r.decision));
+        m.put("passPath", name(r.passPath));
+        m.put("failureCode", name(r.failureCode));
+        m.put("userMessage", r.failureCode == null ? ErrorCode.UserMessage.NONE.name() : r.failureCode.userMessage().name());
+        m.put("passiveScore", (double) r.passiveScore);
+        List<String> challenges = new ArrayList<>();
+        for (ChallengeType c : r.challengesIssued == null ? Collections.<ChallengeType>emptyList() : r.challengesIssued) {
+            challenges.add(c.name());
+        }
+        m.put("challengesIssued", challenges);
+        m.put("attempts", r.attempts);
+        m.put("durationMs", r.durationMs);
+        m.put("sessionId", r.sessionId);
+        m.put("modelVersion", r.modelVersion);
+        m.put(BEST_FRAME_JPEG, r.decision == LivenessResult.Decision.PASSED ? bestFrameJpeg : null);
+        return m;
+    }
+
+    /** A completed session that never reached the engine, e.g. the camera permission was refused. */
+    public static Map<String, Object> failed(ErrorCode code, String sessionId, String modelVersion) {
+        return result(new LivenessResult(LivenessResult.Decision.FAILED, LivenessResult.PassPath.NONE, code, null,
+                Float.NaN, Collections.<ChallengeType>emptyList(), 0, 0L, sessionId, modelVersion), null);
+    }
+
+    /** One log line for a result, without the best frame. */
+    public static String describe(LivenessResult r) {
+        return String.format(Locale.ROOT, "decision=%s path=%s failure=%s score=%.4f challenges=%s attempts=%d durationMs=%d model=%s session=%s",
+                r.decision, r.passPath, r.failureCode, r.passiveScore, r.challengesIssued, r.attempts, r.durationMs,
+                r.modelVersion, r.sessionId);
+    }
+
+    private static String name(Enum<?> e) {
+        return e == null ? null : e.name();
+    }
+}
diff --git a/android/liveness/src/main/java/io/mosip/registration/liveness/android/LivenessMetricsStore.java b/android/liveness/src/main/java/io/mosip/registration/liveness/android/LivenessMetricsStore.java
new file mode 100644
index 0000000..085dbae
--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/LivenessMetricsStore.java
@@ -0,0 +1,116 @@
+package io.mosip.registration.liveness.android;
+
+import android.content.SharedPreferences;
+
+import java.util.LinkedHashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.TreeMap;
+import java.util.WeakHashMap;
+
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.core.metrics.LivenessMetrics;
+
+/**
+ * The engine's anonymised metrics over app restarts: counts and totals only, kept in SharedPreferences. No session
+ * ids, timestamps, scores of individuals or images are stored.
+ *
+ * <p>A service's {@link LivenessMetrics} counts from zero for its lifetime (one app process). After each session,
+ * {@link #merge} adds what changed since that object's previous merge, so every count is added exactly once, whatever
+ * the number of services (one per process, or a replaced one).
+ */
+public final class LivenessMetricsStore {
+
+    public static final String PREFS = "liveness_metrics";
+    private static final String COUNT = "count.";
+    private static final String FINAL_FAILURE = "finalFailure.";
+    private static final String ATTEMPT_FAILURE = "attemptFailure.";
+
+    private final SharedPreferences prefs;
+    // The last snapshot merged from each live metrics object (weak: a dropped service is forgotten).
+    private final Map<LivenessMetrics, LivenessMetrics.Snapshot> merged = new WeakHashMap<>();
+
+    public LivenessMetricsStore(SharedPreferences prefs) {
+        this.prefs = prefs;
+    }
+
+    /** Adds the counts {@code metrics} gained since its previous merge (all of them the first time). */
+    public synchronized void merge(LivenessMetrics metrics) {
+        LivenessMetrics.Snapshot now = metrics.snapshot();
+        LivenessMetrics.Snapshot before = merged.put(metrics, now);
+        SharedPreferences.Editor e = prefs.edit();
+        long[] a = counts(now), b = before == null ? new long[a.length] : counts(before);
+        for (int i = 0; i < COUNTS.length; i++) add(e, COUNT + COUNTS[i], a[i] - b[i]);
+        for (Map.Entry<ErrorCode, Long> f : now.finalFailuresByCode.entrySet()) {
+            add(e, FINAL_FAILURE + f.getKey().name(), f.getValue() - previous(before == null ? null : before.finalFailuresByCode, f.getKey()));
+        }
+        for (Map.Entry<ErrorCode, Long> f : now.attemptFailuresByCode.entrySet()) {
+            add(e, ATTEMPT_FAILURE + f.getKey().name(), f.getValue() - previous(before == null ? null : before.attemptFailuresByCode, f.getKey()));
+        }
+        e.apply();
+    }
+
+    /** Clears the stored totals. Counts already merged are not added again. */
+    public synchronized void reset() {
+        prefs.edit().clear().apply();
+    }
+
+    /** A stored count (0 if none); {@code name} is a Snapshot field name, e.g. "sessions". */
+    public synchronized long count(String name) {
+        return prefs.getLong(COUNT + name, 0L);
+    }
+
+    /** The stored totals and the rates derived from them, in a fixed order (log- and display-friendly). */
+    public synchronized Map<String, String> derived() {
+        long sessions = count("sessions"), passedPassive = count("passedPassive"), passedActive = count("passedActive");
+        Map<String, String> m = new LinkedHashMap<>();
+        m.put("sessions", Long.toString(sessions));
+        m.put("passedPassive", Long.toString(passedPassive));
+        m.put("passedActive", Long.toString(passedActive));
+        m.put("failedFinal", Long.toString(count("failedFinal")));
+        m.put("cancelled", Long.toString(count("cancelled")));
+        m.put("retries", Long.toString(count("retries")));
+        m.put("deviceErrors", Long.toString(count("deviceErrors")));
+        m.put("avgProcessingMs", fmt(ratio(count("processingMsTotal"), count("framesAnalyzed"))));
+        m.put("avgChallengeCompletionMs", fmt(ratio(count("challengeMsTotal"), count("challengesDetected"))));
+        m.put("retryRate", fmt(ratio(count("retries"), sessions)));
+        m.put("failureRate", fmt(ratio(count("failedFinal"), sessions)));
+        m.put("passiveShare", fmt(ratio(passedPassive, passedPassive + passedActive)));
+        Map<String, String> byCode = new TreeMap<>();
+        for (Map.Entry<String, ?> e : prefs.getAll().entrySet()) {
+            if (e.getKey().startsWith(FINAL_FAILURE) || e.getKey().startsWith(ATTEMPT_FAILURE)) {
+                byCode.put(e.getKey(), String.valueOf(e.getValue()));
+            }
+        }
+        m.putAll(byCode);
+        return m;
+    }
+
+    // The Snapshot's long fields, by name; counts() must list them in the same order.
+    static final String[] COUNTS = {"sessions", "passedPassive", "passedActive", "failedFinal", "cancelled",
+            "cooldownRefusals", "retries", "attemptFailures", "deviceErrors", "framesAnalyzed", "processingMsTotal",
+            "challengesDetected", "challengeMsTotal", "challengesFailed"};
+
+    private static long[] counts(LivenessMetrics.Snapshot s) {
+        return new long[]{s.sessions, s.passedPassive, s.passedActive, s.failedFinal, s.cancelled, s.cooldownRefusals,
+                s.retries, s.attemptFailures, s.deviceErrors, s.framesAnalyzed, s.processingMsTotal,
+                s.challengesDetected, s.challengeMsTotal, s.challengesFailed};
+    }
+
+    private void add(SharedPreferences.Editor e, String key, long delta) {
+        if (delta != 0) e.putLong(key, prefs.getLong(key, 0L) + delta);
+    }
+
+    private static long previous(Map<ErrorCode, Long> m, ErrorCode code) {
+        Long v = m == null ? null : m.get(code);
+        return v == null ? 0L : v;
+    }
+
+    private static double ratio(long a, long b) {
+        return b == 0 ? Double.NaN : (double) a / b;
+    }
+
+    private static String fmt(double d) {
+        return Double.isNaN(d) ? "NaN" : String.format(Locale.ROOT, "%.3f", d);
+    }
+}
