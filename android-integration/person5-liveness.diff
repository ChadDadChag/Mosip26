+  static Color _toneColor(LivenessOvalTone tone) {
+    switch (tone) {
+      case LivenessOvalTone.neutral:
+        return Colors.grey.shade600;
+      case LivenessOvalTone.checking:
+        return Colors.blue.shade600;
+      case LivenessOvalTone.challenge:
+        return Colors.amber.shade800;
+      case LivenessOvalTone.success:
+        return Colors.green.shade600;
+      case LivenessOvalTone.error:
+        return Colors.red.shade600;
+    }
+  }
+
+  static IconData _iconData(LivenessIcon icon) {
+    switch (icon) {
+      case LivenessIcon.camera:
+        return Icons.photo_camera_outlined;
+      case LivenessIcon.scanning:
+        return Icons.center_focus_weak;
+      case LivenessIcon.blink:
+        return Icons.visibility_outlined;
+      case LivenessIcon.smile:
+        return Icons.sentiment_satisfied_alt;
+      case LivenessIcon.turnLeft:
+        return Icons.arrow_back; // the preview is mirrored: the user's left is on screen left
+      case LivenessIcon.turnRight:
+        return Icons.arrow_forward;
+      case LivenessIcon.lookUp:
+        return Icons.arrow_upward;
+      case LivenessIcon.lookDown:
+        return Icons.arrow_downward;
+      case LivenessIcon.check:
+        return Icons.check_circle;
+      case LivenessIcon.cross:
+        return Icons.cancel;
+      case LivenessIcon.cameraOff:
+        return Icons.no_photography_outlined;
