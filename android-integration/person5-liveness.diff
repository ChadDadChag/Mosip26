+                Log.i(TAG, "model store: installed " + r.version() + " from removable media");
+                reloadModels();
+                return bundleAudit("offline", from, r.version(), "INSTALLED", null, null, start, ModelBundleOutcome.INSTALLED);
+            case UP_TO_DATE:
+                return bundleAudit("offline", from, from, "UP_TO_DATE", "NOT_NEWER", null, start, ModelBundleOutcome.NOT_NEWER);
+            default:
+                boolean storage = r.reason() == ModelUpdater.Reason.STORAGE;
+                return bundleAudit("offline", from, from, "FAILED", r.reason().name(),
+                        storage ? null : ErrorCode.MODEL_INTEGRITY_FAILED.name(), start,
+                        storage ? ModelBundleOutcome.FAILED : ModelBundleOutcome.INVALID);
+        }
+    }
+
+    /**
+     * Operator action from the production page: the store's previous bundle becomes current again
+     * ({@link ModelStore#rollback}, verified again), then a reload. Writes REG-EVT-019 with trigger=rollback.
+     */
+    public synchronized ModelBundleResult rollbackOfflineBundle() {
+        long start = SystemClock.elapsedRealtime();
+        String from = activeModelVersion();
+        if (!modelBundleActionsAllowed()) {
+            return bundleAudit("rollback", from, null, "REFUSED", "NOT_ALLOWED", null, start, ModelBundleOutcome.NOT_ALLOWED);
+        }
+        try {
+            String v = modelStore().rollback(trustedKeys);
+            Log.i(TAG, "model store: rolled back to " + v);
+            reloadModels();
+            return bundleAudit("rollback", from, activeModelVersion(), "ROLLED_BACK", null, null, start,
+                    ModelBundleOutcome.ROLLED_BACK);
+        } catch (IllegalStateException nothingEarlier) {
+            return bundleAudit("rollback", from, from, "REFUSED", "NOTHING_TO_ROLL_BACK", null, start,
+                    ModelBundleOutcome.NOTHING_TO_ROLL_BACK);
+        } catch (LivenessEngineException e) {
+            return bundleAudit("rollback", from, from, "FAILED", "BUNDLE_INVALID", e.code().name(), start,
+                    ModelBundleOutcome.INVALID);
+        } catch (IOException | RuntimeException e) {
+            Log.w(TAG, "model rollback failed: " + e.getClass().getSimpleName());
+            return bundleAudit("rollback", from, from, "FAILED", "STORAGE", null, start, ModelBundleOutcome.FAILED);
+        }
+    }
+
+    private ModelBundleResult bundleAudit(String trigger, String from, String to, String outcome, String reason,
+                                          String errorCode, long start, ModelBundleOutcome result) {
+        String user;
+        boolean supervises;
+        try {
+            user = modelBundleUser.id();
+            supervises = modelBundleUser.maySupervise();
+        } catch (RuntimeException e) {
+            user = null;
+            supervises = false;
+        }
+        audit.modelBundle(outcome, errorCode, reason, from, to, SystemClock.elapsedRealtime() - start, trigger, user,
+                !supervises && roleOverridden());
+        return new ModelBundleResult(result, from, to);
+    }
+
+    /**
+     * Online model update ({@link ModelUpdates}): checks the configured index and installs a newer verified bundle
+     * into the store, then reloads as {@link #installModelBundle} does. Writes REG-EVT-019 with the outcome; the
+     * reload after an install writes MODEL_LOADED with the new version. The download runs on the calling thread
+     * (WorkManager's, or a background thread), without holding this object's lock.
+     *
+     * @param trigger "scheduled" (the periodic job) or "manual" (the debug page), for the audit record
+     * @throws IllegalStateException when updates are disabled or no index URL is configured
+     */
+    public ModelUpdater.UpdateResult checkModelUpdate(String trigger) {
+        ModelUpdates.Settings s = ModelUpdates.Settings.from(config);
+        if (!s.enabled) throw new IllegalStateException("model update is disabled (" + ModelUpdates.ENABLED_KEY + ")");
+        if (s.url == null) throw new IllegalStateException("no " + ModelUpdates.URL_KEY);
+        URL index;
+        try {
+            index = new URL(s.url);
+        } catch (MalformedURLException e) {
+            throw new IllegalStateException(ModelUpdates.URL_KEY + " is not a valid URL");
+        }
+        long start = SystemClock.elapsedRealtime();
+        ModelUpdater.UpdateResult r = ModelUpdates.updater(diagnostics).check(index, modelStore(),
+                bundledModels, trustedKeys);
+        onModelUpdate(r, SystemClock.elapsedRealtime() - start, trigger);
+        return r;
+    }
+
+    /** Logs and audits an update outcome; after an install, new sessions use the new bundle. */
+    void onModelUpdate(ModelUpdater.UpdateResult r, long ms, String trigger) {
+        Log.i(TAG, "model update (" + trigger + "): " + r + " in " + ms + " ms; store " + modelStoreStatus());
+        audit.modelUpdate(r.status().name(), r.version(), r.reason() == null ? null : r.reason().name(), ms, trigger);
+        if (r.status() == ModelUpdater.Status.INSTALLED) {
+            synchronized (this) {
+                reloadModels();
+            }
+        }
+    }
+
+    private void scheduleModelUpdates() {
+        ModelUpdates.schedule(context, ModelUpdates.Settings.from(config), diagnostics);
+    }
+
+    /** New sessions use the newest verified bundle (store or assets); running sessions keep theirs. */
+    private void reloadModels() {
+        modelVersion = "";
+        analyzers.swap(analyzerFactory(analyzerConfig(config)));
+        analyzerSwaps++;
+        preload();
+    }
+
+    /** The bundled models plus each signed test bundle directory under {@code dir} (benchmark only). */
+    public List<AnalyzerBenchmark.Bundle> benchmarkBundles(File dir) {
+        List<AnalyzerBenchmark.Bundle> out = new ArrayList<>();
+        out.add(new AnalyzerBenchmark.Bundle("bundled", new AssetBundleSource(context)));
+        File[] dirs = dir == null ? null : dir.listFiles(File::isDirectory);
+        if (dirs != null) {
+            Arrays.sort(dirs);
+            for (File d : dirs) out.add(new AnalyzerBenchmark.Bundle(d.getName(), new DirectoryBundleSource(d)));
+        }
+        return out;
+    }
+
+    /** "back" when {@code mosip.registration.liveness.face.android.<workflow>.camera} says so, else "front". */
+    public String cameraFor(WorkflowType workflow) {
+        String v = config.get(CAMERA_KEY_PREFIX + workflow.name().toLowerCase(Locale.ROOT) + ".camera");
+        return v != null && "back".equalsIgnoreCase(v.trim()) ? "back" : "front";
+    }
+
+    /** The loaded bundle version, or "" before the models are loaded. */
+    public String modelVersion() {
+        return modelVersion;
+    }
+
+    /** Per-stage analysis times of the session in progress. */
+    public TimedAnalyzerFactory analyzerTimes() {
+        return timedAnalyzers;
+    }
+
+    /** For short background work of the bridge (session start, best-frame encoding). */
+    public ExecutorService background() {
+        return background;
+    }
+
+    /** Face binding (F1): the held best frame, the hooks' arming and the comparisons. */
+    public FaceBinding binding() {
+        return binding;
+    }
+
+    /** The thread face-binding comparisons (image decoding and the matcher) run on; never the main thread. */
+    public ExecutorService bindingWorker() {
+        return bindingWorker;
+    }
+
+    /** F15: the users' onboarded faces, as the app reads them (Room user_biometric). Until set: none (presence only). */
+    public void setIdentityTemplates(IdentityBinding.TemplateSource templates) {
+        this.identityTemplates = templates == null ? NO_TEMPLATES : templates;
+    }
+
+    /**
+     * Debug and profile builds: the debug page's F15 check uses this test template source (the face it enrolled in
+     * app-private storage) instead of the user's rows, so it works without a backend or an onboarded user. Null ends
+     * it. Ignored unless {@code diagnostics} (never in a release build); a check that used it is audited with
+     * templateSource=diagnostics-test.
+     */
+    public void setDiagnosticIdentityTemplates(IdentityBinding.TemplateSource templates) {
+        this.diagnosticIdentityTemplates = diagnostics ? templates : null;
+    }
+
+    /**
+     * F15 after a PASSED gate: the held best frame of {@code sessionId} against {@code userId}'s onboarded faces
+     * ({@link IdentityBinding#verify}). Blocking: call it on {@link #bindingWorker()}.
+     */
+    public IdentityBinding.Result verifyIdentity(String sessionId, String userId, String gate, int attempt) {
+        IdentityBinding.TemplateSource test = diagnostics ? diagnosticIdentityTemplates : null;
+        return identity.verify(sessionId, userId, gate, attempt, test != null ? test : identityTemplates,
+                test != null ? Collections.singletonMap("templateSource", "diagnostics-test") : null);
+    }
+
+    /** Diagnostics only: {@link MatcherBenchmark} with the current analyzer settings, the bundled models and test bundles. */
+    public String runMatcherBenchmark(List<io.mosip.registration.liveness.api.Frame> frames, File benchDir, String device) {
+        return MatcherBenchmark.run(frames, benchmarkBundles(benchDir), analyzerConfig(config), device);
+    }
+
+    /**
+     * Sets (or, with a null or empty value, removes) a config override and reloads both engines' policies.
+     * {@value FakeLivenessService#TIME_SCALE_PROPERTY} rebuilds the fake engine with that speed (1 = real time).
+     */
+    public void setOverride(String key, String value) {
+        if (key == null || key.trim().isEmpty()) return;
+        if (value == null || value.trim().isEmpty()) {
+            overrides.remove(key.trim());
+        } else {
+            overrides.put(key.trim(), value.trim());
+        }
+        if (FakeLivenessService.TIME_SCALE_PROPERTY.equals(key.trim())) {
+            double scale = 1.0;
+            try {
+                if (value != null && !value.trim().isEmpty()) scale = Math.max(0.0, Double.parseDouble(value.trim()));
+            } catch (NumberFormatException e) {
+                Log.w(TAG, "ignored fake time scale '" + value + "'");
+            }
+            fake = fakeService(scale);
+        }
+        reloadConfig();
+    }
+
+    public void clearOverrides() {
+        overrides.clear();
+        reloadConfig();
+    }
+
+    public Map<String, String> overrides() {
+        return Collections.unmodifiableMap(new TreeMap<>(overrides));
+    }
+
+    /**
+     * Re-reads the config (after a sync or an override change): the policies of new sessions, and, when the analyzer
+     * settings changed, a new analyzer for new sessions (loaded in the background). Running sessions keep theirs.
+     */
+    public synchronized void reloadConfig() {
+        real.reloadConfig(config);
+        fake.reloadConfig(config);
+        scheduleModelUpdates();
+        AnalyzerConfig next = analyzerConfig(config);
+        String print = fingerprint(next);
+        if (!print.equals(analyzerFingerprint)) {
+            analyzerFingerprint = print;
+            analyzers.swap(analyzerFactory(next));
+            analyzerSwaps++;
+            Log.i(TAG, "analyzer settings changed: new sessions use them");
+            preload();
+        }
+    }
+
+    /** How often the analyzer was replaced after a config change (tests). */
+    int analyzerSwaps() {
+        return analyzerSwaps;
+    }
+
+    /** A preview view was created (main thread); the next session binds its preview to the newest one. */
+    public void setPreview(PreviewView view) {
+        previews.remove(view);
+        previews.add(view);
+    }
+
+    /** The view was disposed: the one below it, if any, is current again. */
+    public void clearPreview(PreviewView view) {
+        previews.remove(view);
+    }
+
+    public PreviewView preview() {
+        return previews.isEmpty() ? null : previews.get(previews.size() - 1);
+    }
+
+    public Context context() {
+        return context;
+    }
+
+    private String configValue(String key) {
+        String v = overrides.get(key);
+        return v != null ? v : baseConfig.get(key);
+    }
+
+    /** The analyzer settings: configured keys first, then {@link #ANDROID_ANALYZER_DEFAULTS}. */
+    static AnalyzerConfig analyzerConfig(ConfigProvider config) {
+        ConfigProvider withDefaults = key -> {
+            String v = config.get(key);
+            return v != null && !v.trim().isEmpty() ? v : ANDROID_ANALYZER_DEFAULTS.get(key);
+        };
+        try {
+            return AnalyzerConfig.fromConfig(withDefaults);
+        } catch (IllegalArgumentException e) {
+            Log.e(TAG, "invalid analyzer config, using the Android defaults: " + e.getMessage());
+            return AnalyzerConfig.fromConfig(ANDROID_ANALYZER_DEFAULTS::get);
+        }
+    }
+
+    /** The analyzer settings new sessions get (tests and the debug log). */
+    AnalyzerConfig analyzerSettings() {
+        return analyzerConfig(config);
+    }
+
+    /** The analyzer settings as text (its public fields, and those of nested settings), to see if they changed. */
+    static String fingerprint(Object settings) {
+        StringBuilder sb = new StringBuilder();
+        appendFields(sb, settings, true);
+        return sb.toString();
+    }
+
+    private static void appendFields(StringBuilder sb, Object o, boolean nested) {
+        Field[] fields = o.getClass().getFields();
+        Arrays.sort(fields, (a, b) -> a.getName().compareTo(b.getName()));
+        for (Field f : fields) {
+            if (Modifier.isStatic(f.getModifiers())) continue;
+            Object v;
+            try {
+                v = f.get(o);
+            } catch (IllegalAccessException e) {
+                v = "?";
+            }
+            sb.append(f.getName()).append('=');
+            if (nested && v != null && !(v instanceof Enum) && v.getClass().getName().startsWith("io.mosip.")) {
+                sb.append('{');
+                appendFields(sb, v, false);
+                sb.append('}');
+            } else {
+                sb.append(v);
+            }
+            sb.append(';');
+        }
+    }
+}
