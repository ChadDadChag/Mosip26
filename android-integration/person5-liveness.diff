+                try {
+                    List<AnalyzerBenchmark.Result> r = AnalyzerBenchmark.run(frames, bundles,
+                            AnalyzerBenchmark.defaultSettings(), step -> Log.i(TAG, "benchmark: " + step));
+                    report = AnalyzerBenchmark.report(r, frames.size(), device);
+                } catch (RuntimeException | LinkageError e) {
+                    report = "benchmark failed: " + e;
+                } finally {
+                    frames.clear(); // the frames are dropped here, whatever happened
+                }
+                for (String line : report.split("\n")) Log.i(TAG, "benchmark| " + line);
+                String text = report;
+                main.post(() -> {
+                    benchmarking = false;
+                    result.success(text);
+                });
+            }, "liveness-benchmark");
+            t.start();
+        };
+        src.start(new FrameSource.Listener() {
+            @Override
+            public void onFrame(Frame frame) {
+                main.post(() -> {
+                    if (done[0]) return;
+                    frames.add(frame);
+                    if (frames.size() >= BENCHMARK_FRAMES) finishCapture.run();
+                });
+            }
+
+            @Override
+            public void onError(ErrorCode code, String detail, boolean recoverable) {
+                Log.w(TAG, "benchmark capture: " + code + " " + detail);
+                if (!recoverable) main.post(finishCapture);
+            }
+        });
+        main.postDelayed(finishCapture, BENCHMARK_CAPTURE_TIMEOUT_MS);
+        Log.i(TAG, "benchmark: capturing " + BENCHMARK_FRAMES + " frames into memory");
+    }
+
+    @NonNull
+    @Override
+    public String armBinding(@NonNull String sessionId) {
+        FaceBinding.Arm arm = holder.binding().arm(sessionId);
+        Log.i(TAG, "face binding " + arm + " for session " + sessionId);
+        return arm.name();
+    }
+
+    /** Decoding and the matcher run on the binding thread; neither image is logged or kept. */
+    @Override
+    public void bindCapturedFace(@NonNull String sessionId, @NonNull byte[] capturedImage,
+                                 @NonNull LivenessPigeon.Result<LivenessPigeon.BindingInfo> result) {
+        holder.bindingWorker().execute(() -> {
+            long start = android.os.SystemClock.elapsedRealtime();
+            FaceBinding.Result r = holder.binding().bindNow(sessionId, () -> BindingImages.decode(capturedImage));
+            Log.i(TAG, "face binding " + r + " for session " + sessionId + " in "
+                    + (android.os.SystemClock.elapsedRealtime() - start) + " ms");
+            LivenessPigeon.BindingInfo info = new LivenessPigeon.BindingInfo.Builder()
+                    .setOutcome(r.outcome).setSimilarity(r.similarity).setThreshold(r.threshold).build();
+            main.post(() -> result.success(info));
+        });
+    }
+
+    /**
+     * F15 after a PASSED gate: the held best frame against the user's onboarded faces, on the binding thread. Never
+     * fails: an error is ERROR (rejected). The similarity goes to Dart only in diagnostics builds (the debug page shows
+     * it; production screens never show a score); the audit has it.
+     */
+    @Override
+    public void verifyIdentity(@NonNull String sessionId, @NonNull String userId, @NonNull String gate,
+                               @NonNull Long attempt,
+                               @NonNull LivenessPigeon.Result<LivenessPigeon.IdentityCheckInfo> result) {
+        holder.bindingWorker().execute(() -> {
+            LivenessPigeon.IdentityCheckInfo info;
+            try {
+                IdentityBinding.Result r = holder.verifyIdentity(sessionId, userId, gate, attempt.intValue());
+                // The numbers, like the score sent to Dart, only in diagnostics builds: a live check read from logcat.
+                Log.i(TAG, "identity binding " + r + " for session " + sessionId + " (" + gate + ", attempt " + attempt + ")"
+                        + (BuildConfig.LIVENESS_DIAGNOSTICS ? String.format(Locale.ROOT,
+                                ", similarity %.2f, threshold %.2f", r.similarity, r.threshold) : ""));
+                info = new LivenessPigeon.IdentityCheckInfo.Builder()
+                        .setOutcome(r.outcome).setAccepted(r.accepted).setRetryable(r.retryable)
+                        .setSimilarity(BuildConfig.LIVENESS_DIAGNOSTICS ? r.similarity : Double.NaN)
+                        .setThreshold(r.threshold).build();
+            } catch (Throwable t) {
+                // An Error (out of memory on a bad template) must refuse the gate, not leave it waiting.
+                Log.e(TAG, "identity binding failed: " + t.getClass().getSimpleName());
+                info = new LivenessPigeon.IdentityCheckInfo.Builder()
+                        .setOutcome("ERROR").setAccepted(false).setRetryable(false)
+                        .setSimilarity(Double.NaN).setThreshold(Double.NaN).build();
+            }
+            if (IdentityBinding.countsAsFailedLogin(gate, attempt.intValue(), info.getAccepted())) {
+                try {
+                    loginService.recordFailedLoginAttempt(userId);
+                } catch (RuntimeException e) {
+                    Log.e(TAG, "failed login not recorded: " + e.getClass().getSimpleName());
+                }
+            }
+            final LivenessPigeon.IdentityCheckInfo answer = info;
+            main.post(() -> result.success(answer));
+        });
+    }
+
+    /** F15, diagnostics builds only: the debug page's test template (app-private storage, never sent anywhere). */
+    private File identityTestTemplate() {
+        return new File(holder.context().getFilesDir(), IdentityTemplates.TEST_TEMPLATE);
+    }
+
+    @Override
+    public void enrollIdentityTestTemplate(@NonNull String sessionId, @NonNull LivenessPigeon.Result<String> result) {
+        if (!BuildConfig.LIVENESS_DIAGNOSTICS) {
+            result.success("NOT_ALLOWED");
+            return;
+        }
+        holder.bindingWorker().execute(() -> {
+            String outcome;
+            // The debug page enrols from an Operator gate (liveness_debug_page.dart); a frame of another workflow is refused.
+            FaceBinding.Held held = holder.binding().take(sessionId, WorkflowType.OPERATOR);
+            if (held == null) {
+                outcome = "NO_LIVE_FRAME";
+            } else {
+                try {
+                    IdentityTemplates.writeTestTemplate(identityTestTemplate(), IdentityTemplates.encodeIso(held.bestFrame));
+                    outcome = "ENROLLED";
+                } catch (IOException | RuntimeException | LinkageError e) {
+                    outcome = "FAILED";
+                }
+            }
+            Log.i(TAG, "identity test template: " + outcome);
+            final String done = outcome;
+            main.post(() -> result.success(done));
+        });
+    }
+
+    @NonNull
+    @Override
+    public Boolean deleteIdentityTestTemplate() {
+        if (!BuildConfig.LIVENESS_DIAGNOSTICS) return false;
+        boolean deleted = identityTestTemplate().delete();
+        Log.i(TAG, "identity test template deleted: " + deleted);
+        return deleted;
+    }
+
+    @NonNull
+    @Override
+    public Boolean hasIdentityTestTemplate() {
+        return BuildConfig.LIVENESS_DIAGNOSTICS && identityTestTemplate().isFile();
+    }
+
+    /** F15, diagnostics builds only: the demo page shows when the test template was enrolled. */
+    @Nullable
+    @Override
+    public Long identityTestTemplateTime() {
+        File file = identityTestTemplate();
+        if (!BuildConfig.LIVENESS_DIAGNOSTICS || !file.isFile()) return null;
+        return file.lastModified();
+    }
+
+    /** F15, diagnostics builds: the debug page's check uses the test template; the holder ignores it in release. */
+    @Override
+    public void setIdentityDiagnosticOverride(@NonNull Boolean on) {
+        holder.setDiagnosticIdentityTemplates(BuildConfig.LIVENESS_DIAGNOSTICS && on
+                ? IdentityTemplates.fromTestTemplate(identityTestTemplate()) : null);
+    }
+
+    /**
+     * Diagnostics only: one camera still (the {@value #STILL_FRAME}th frame, once exposure has settled), without
+     * liveness, as JPEG or JPEG 2000. In memory only; never logged.
+     */
+    @Override
+    public void captureStill(@NonNull String camera, @NonNull Boolean jp2, @NonNull LivenessPigeon.Result<byte[]> result) {
+        if (!BuildConfig.LIVENESS_DIAGNOSTICS) {
+            result.error(new IllegalStateException("diagnostics builds only"));
+            return;
+        }
+        captureFrames(camera, STILL_FRAME, frames -> holder.bindingWorker().execute(() -> {
+            Frame still = frames.get(frames.size() - 1);
+            frames.clear();
+            try {
+                byte[] bytes = jp2 ? BindingImages.jp2(still) : BestFrameEncoder.jpeg(still, BestFrameEncoder.QUALITY);
+                Log.i(TAG, "binding test: camera still captured (" + (jp2 ? "JPEG 2000" : "JPEG") + ", "
+                        + still.width() + "x" + still.height() + ")");
+                main.post(() -> result.success(bytes));
+            } catch (RuntimeException | LinkageError e) {
+                main.post(() -> result.error(new IllegalStateException("the still could not be encoded: " + e)));
+            }
+        }), result::error);
+    }
+
+    /** Diagnostics only: {@code MatcherBenchmark} on {@value #MATCHER_BENCH_FRAMES} frames held in memory. */
+    @Override
+    public void runMatcherBenchmark(@NonNull String camera, @NonNull LivenessPigeon.Result<String> result) {
+        if (!diagnostics(result)) return;
+        MainActivity activity = activityRef.get();
+        if (activity == null) {
+            result.error(new IllegalStateException("Activity not set"));
+            return;
+        }
+        captureFrames(camera, MATCHER_BENCH_FRAMES, frames -> {
+            File benchDir = activity.getExternalFilesDir(BENCH_BUNDLES);
+            String device = android.os.Build.MANUFACTURER + " " + android.os.Build.MODEL + ", Android "
+                    + android.os.Build.VERSION.RELEASE + ", " + BuildConfig.BUILD_TYPE + " build";
+            Thread t = new Thread(() -> {
+                String report;
+                try {
+                    report = holder.runMatcherBenchmark(frames, benchDir, device);
+                } catch (RuntimeException | LinkageError e) {
+                    report = "matcher benchmark failed: " + e;
+                } finally {
+                    frames.clear();
+                }
+                for (String line : report.split("\n")) Log.i(TAG, "matcher benchmark| " + line);
+                String text = report;
+                main.post(() -> {
+                    benchmarking = false;
+                    result.success(text);
+                });
+            }, "liveness-matcher-benchmark");
+            benchmarking = true;
+            t.start();
+        }, result::error);
+    }
+
+    /**
+     * Opens the camera (no preview), keeps {@code count} frames in memory, stops it and hands them to
+     * {@code onFrames} on the main thread; any problem goes to {@code onError}. Refused while a session or a benchmark
+     * runs, or without the camera permission.
+     */
+    private void captureFrames(String camera, int count, java.util.function.Consumer<List<Frame>> onFrames,
+                               java.util.function.Consumer<Throwable> onError) {
+        MainActivity activity = activityRef.get();
+        if (activity == null) {
+            onError.accept(new IllegalStateException("Activity not set"));
+            return;
+        }
+        if (session != null || benchmarking) {
+            onError.accept(new IllegalStateException("a session or a benchmark is running"));
+            return;
+        }
+        if (ContextCompat.checkSelfPermission(activity, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+            onError.accept(new IllegalStateException("camera permission not granted"));
+            return;
+        }
+        CameraSelector selector = "back".equalsIgnoreCase(camera)
+                ? CameraSelector.DEFAULT_BACK_CAMERA : CameraSelector.DEFAULT_FRONT_CAMERA;
+        CameraXFrameSource src = new CameraXFrameSource(activity, activity, selector, ANALYSIS_RESOLUTION, 1, null);
+        src.setExposureAssist(holder.exposureAssist());
+        List<Frame> frames = new ArrayList<>();
+        boolean[] done = {false};
+        benchmarking = true;
+        Runnable finish = () -> { // main thread
+            if (done[0]) return;
+            done[0] = true;
+            src.stop();
+            benchmarking = false;
+            if (frames.size() < count) {
+                int captured = frames.size();
+                frames.clear();
+                onError.accept(new IllegalStateException("captured only " + captured + " frames"));
+                return;
+            }
+            onFrames.accept(frames);
+        };
+        src.start(new FrameSource.Listener() {
+            @Override
+            public void onFrame(Frame frame) {
+                main.post(() -> {
+                    if (done[0]) return;
+                    frames.add(frame);
+                    if (frames.size() >= count) finish.run();
+                });
+            }
+
+            @Override
+            public void onError(ErrorCode code, String detail, boolean recoverable) {
+                Log.w(TAG, "still capture: " + code + " " + detail);
+                if (!recoverable) main.post(finish);
+            }
+        });
+        main.postDelayed(finish, BENCHMARK_CAPTURE_TIMEOUT_MS);
+    }
+
+    private static boolean diagnostics(LivenessPigeon.Result<String> result) {
+        if (BuildConfig.LIVENESS_DIAGNOSTICS) return true;
+        result.error(new IllegalStateException("diagnostics builds only"));
+        return false;
+    }
+
+    /**
+     * {@code src} is null for the fake engine, which then has no best frame to send either. A real PASSED session's
+     * best frame is also held for face binding ({@link FaceBinding}) before Dart hears of the result, so that the
+     * hook's arming finds it.
+     */
+    private void complete(int gen, LivenessResult r, CameraXFrameSource src, WorkflowType wf) {
+        if (src != null) src.stop(); // the session stops it too; stop() is idempotent
+        if (BuildConfig.LIVENESS_DIAGNOSTICS) {
+            Log.i(TAG, "complete " + LivenessMaps.describe(r));
+            Log.i(TAG, "analyzer " + holder.analyzerTimes().summary());
+            Log.i(TAG, "metrics " + holder.metrics(src == null).toMap());
+        } else {
+            Log.i(TAG, "complete " + r.decision + " " + r.failureCode + " in " + r.durationMs + " ms");
+        }
+        holder.background().execute(() -> {
+            if (src != null) holder.recordMetrics(); // the real engine's counts, persisted (anonymised)
+            byte[] jpeg = null;
+            // Without a camera the fake engine makes up a grey frame: not worth sending.
+            if (src != null && r.passed() && r.bestFrame != null) {
+                try {
+                    jpeg = BestFrameEncoder.jpeg(r.bestFrame, BestFrameEncoder.QUALITY);
+                } catch (RuntimeException e) {
+                    Log.e(TAG, "best frame could not be encoded", e);
+                }
+            }
+            Map<String, Object> m = LivenessMaps.result(r, jpeg);
+            main.post(() -> {
+                if (gen != generation) return;
+                session = null;
+                source = null;
+                if (src != null && r.passed() && r.bestFrame != null) {
+                    holder.binding().hold(r.sessionId, wf, r.bestFrame);
+                    main.postDelayed(holder.binding()::sweep, FaceBinding.TTL_MS + 1_000);
+                }
+                deliver(m);
+            });
+        });
+    }
+
+    private void send(int gen, Map<String, Object> m) {
+        main.post(() -> {
+            if (gen == generation) deliver(m);
+        });
+    }
+
+    private void deliver(Map<String, Object> m) {
+        if (events != null) events.success(m);
+    }
+
+    private void stopCurrent() {
+        LivenessSession s = session;
+        CameraXFrameSource src = source;
+        session = null;
+        source = null;
+        if (s != null) s.cancel();
+        if (src != null) src.stop();
+    }
+
+    private static WorkflowType workflow(String workflow) {
+        return WorkflowType.valueOf(workflow.trim().toUpperCase(Locale.ROOT));
+    }
+
+    private static String describe(LivenessEvent e) {
+        StringBuilder sb = new StringBuilder();
+        if (e.guidance != null) sb.append(' ').append(e.guidance);
+        if (e.challenge != null) sb.append(' ').append(e.challenge).append(' ').append(e.challengeIndex).append('/').append(e.challengeCount);
+        if (e.type == LivenessEvent.Type.CHALLENGE_PROGRESS) sb.append(String.format(Locale.ROOT, " %.2f", e.progress));
+        if (e.error != null) sb.append(' ').append(e.error).append(" retriesLeft=").append(e.retriesLeft);
+        return sb.toString();
+    }
+}
