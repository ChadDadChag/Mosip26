diff --git a/android/clientmanager/src/test/java/io/mosip/registration/clientmanager/repository/GlobalParamRepositoryRefreshListenerTest.java b/android/clientmanager/src/test/java/io/mosip/registration/clientmanager/repository/GlobalParamRepositoryRefreshListenerTest.java
