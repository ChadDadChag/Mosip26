+    expect(service.started, ['RESIDENT/front/false', 'OPERATOR/front/false', 'SUPERVISOR/front/false']);
+  });
+
+  testWidgets('the result panel never shows an image, the best frame included', (tester) async {
+    await pumpDemo(tester);
+    await tapKey(tester, 'demo.run.RESIDENT');
+    await passSession(tester);
+    final panel = find.byKey(const Key('demo.result'));
