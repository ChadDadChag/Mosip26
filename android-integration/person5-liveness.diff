+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+package io.mosip.registration_client.api_services;
+
+import android.content.Context;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.camera.view.PreviewView;
+
+import io.flutter.plugin.common.StandardMessageCodec;
+import io.flutter.plugin.platform.PlatformView;
+import io.flutter.plugin.platform.PlatformViewFactory;
+import io.mosip.registration.liveness.android.LivenessServiceHolder;
+
+/**
+ * The camera preview for Dart's {@code AndroidView(viewType: "io.mosip.registration_client/liveness_preview")}.
+ * The holder keeps the current view; the next liveness session binds its preview to it.
+ * PreviewView mirrors the front camera on screen; the analysed frames are never mirrored.
+ */
+public final class LivenessPreviewFactory extends PlatformViewFactory {
+
+    private final LivenessServiceHolder holder;
+
+    public LivenessPreviewFactory(LivenessServiceHolder holder) {
+        super(StandardMessageCodec.INSTANCE);
+        this.holder = holder;
+    }
+
+    @NonNull
+    @Override
+    public PlatformView create(@Nullable Context context, int viewId, @Nullable Object args) {
+        PreviewView view = new PreviewView(context);
+        view.setScaleType(PreviewView.ScaleType.FILL_CENTER);
+        // A TextureView, so Flutter can compose the platform view with its own widgets.
+        view.setImplementationMode(PreviewView.ImplementationMode.COMPATIBLE);
+        holder.setPreview(view);
+        return new PlatformView() {
+            @Override
+            public View getView() {
+                return view;
+            }
+
+            @Override
+            public void dispose() {
+                holder.clearPreview(view);
+            }
+        };
+    }
+}
