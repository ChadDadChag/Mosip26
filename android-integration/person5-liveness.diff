diff --git a/test/liveness/face_binding_test.dart b/test/liveness/face_binding_test.dart
new file mode 100644
index 0000000..451323f
--- /dev/null
+++ b/test/liveness/face_binding_test.dart
@@ -0,0 +1,123 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:registration_client/ui/liveness/face_binding.dart';
+import 'package:registration_client/ui/liveness/liveness_gate.dart';
+import 'package:registration_client/ui/liveness/liveness_page.dart';
+
+import 'fake_liveness_service.dart';
+
+/// The face-capture hooks' branching (portrait Scan, landscape Scan and Rescan,
+/// operator onboarding all call FaceBinding.captureFace), with the gate, the
+/// native arming and the SBI capture mocked.
+void main() {
+  late BuildContext ctx;
+  late FakeLivenessService service;
+  late List<String> captures;
+  late List<String> shown;
+
+  setUp(() {
+    service = FakeLivenessService();
+    captures = [];
+    shown = [];
+  });
+
+  Future<void> pumpHost(WidgetTester tester) async {
+    await tester.pumpWidget(MaterialApp(home: Builder(builder: (c) {
+      ctx = c;
+      return const SizedBox();
+    })));
+  }
+
+  Future<FaceCaptureStep> run(GateResult gate, {String captureResult = 'Ok'}) =>
+      FaceBinding.captureFace(
+        ctx,
+        workflow: LivenessGate.resident,
+        gate: () async => gate,
+        service: service,
+        showText: shown.add,
+        capture: () async {
+          captures.add('sbi');
+          return captureResult;
+        },
+      );
+
+  GateResult passed([String id = 's-1']) =>
+      GateResult.fromOutcome(LivenessOutcome(passed: true, sessionId: id));
+
+  testWidgets('a matching capture is stored and the caller continues', (tester) async {
+    await pumpHost(tester);
+    expect(await run(passed()), FaceCaptureStep.captured);
+    expect(service.armed, ['s-1']);
+    expect(captures, ['sbi']);
+    expect(shown, isEmpty);
+  });
+
+  testWidgets('a rejected capture shows the generic text; the caller stops', (tester) async {
+    await pumpHost(tester);
+    expect(await run(passed(), captureResult: FaceBinding.captureRejected),
+        FaceCaptureStep.rejected);
+    expect(captures, ['sbi']);
+    expect(shown, [FaceBinding.messageKey]);
+    expect(FaceBinding.messageKey, 'liveness.error.verification_not_completed');
+  });
+
+  testWidgets('an unknown or expired session blocks before the capture', (tester) async {
+    await pumpHost(tester);
+    service.armResult = 'REJECTED';
+    expect(await run(passed()), FaceCaptureStep.blocked);
+    expect(captures, isEmpty);
+    expect(shown, [FaceBinding.messageKey]);
+  });
+
+  testWidgets('an arming error or a missing session id blocks too', (tester) async {
+    await pumpHost(tester);
+    service.throwOnArm = StateError('channel');
+    expect(await run(passed()), FaceCaptureStep.blocked);
+    service.throwOnArm = null;
+    expect(await run(passed('')), FaceCaptureStep.blocked);
+    expect(captures, isEmpty);
+    expect(shown, [FaceBinding.messageKey, FaceBinding.messageKey]);
+  });
+
+  testWidgets('binding disabled by config: the capture runs as before', (tester) async {
+    await pumpHost(tester);
+    service.armResult = 'DISABLED';
+    expect(await run(passed()), FaceCaptureStep.captured);
+    expect(captures, ['sbi']);
+    expect(shown, isEmpty);
+  });
+
+  testWidgets('liveness disabled for the workflow: no arming, legacy capture', (tester) async {
+    await pumpHost(tester);
+    expect(await run(GateResult.proceed(disabled: true)), FaceCaptureStep.captured);
+    expect(service.armed, isEmpty);
+    expect(captures, ['sbi']);
+  });
+
+  testWidgets('a cancelled or failed gate captures nothing', (tester) async {
+    await pumpHost(tester);
+    expect(await run(GateResult.cancelled()), FaceCaptureStep.cancelled);
+    expect(
+        await run(GateResult.blocked(const LivenessOutcome(failureCode: 'PAD_FAILURE'))),
+        FaceCaptureStep.blocked);
+    expect(service.armed, isEmpty);
+    expect(captures, isEmpty);
+    expect(shown, isEmpty, reason: 'the liveness page already showed its recovery text');
+  });
+
+  testWidgets('the default text is shown in a snack bar', (tester) async {
+    await tester.pumpWidget(MaterialApp(home: Scaffold(body: Builder(builder: (c) {
+      ctx = c;
+      return const SizedBox();
+    }))));
+    final step = await FaceBinding.captureFace(ctx,
+        workflow: LivenessGate.operator,
+        gate: () async => passed(),
+        service: service,
+        capture: () async => FaceBinding.captureRejected);
+    await tester.pump();
+    expect(step, FaceCaptureStep.rejected);
+    // No localizations in this host: the canonical key is shown as it is.
+    expect(find.text(FaceBinding.messageKey), findsOneWidget);
+  });
+}
diff --git a/test/liveness/fake_liveness_service.dart b/test/liveness/fake_liveness_service.dart
new file mode 100644
index 0000000..8076e1e
--- /dev/null
+++ b/test/liveness/fake_liveness_service.dart
@@ -0,0 +1,145 @@
+import 'dart:async';
+
+import 'package:registration_client/pigeon/liveness_pigeon.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+
+/// A scripted LivenessService: the test emits the engine's maps.
+class FakeLivenessService implements LivenessService {
+  final StreamController<LivenessMessage> _messages = StreamController<LivenessMessage>.broadcast();
+  bool enabled = true;
+  CameraPermission permission = CameraPermission.granted;
+  Map<String, String> cameras = {};
+  int maxRetries = 3;
+  String sessionId = 's-1';
+  int retries = 0;
+  int cancels = 0;
+  int permissionRequests = 0;
+  int settingsOpened = 0;
+  Object? throwOnIsEnabled;
+  final List<String> started = [];
+
+  void emit(Map<String, Object?> m) => _messages.add(LivenessMessage(m));
+
+  @override
+  Stream<LivenessMessage> get messages => _messages.stream;
+
+  @override
+  Future<bool> isEnabled(String workflow) async {
+    if (throwOnIsEnabled != null) throw throwOnIsEnabled!;
+    return enabled;
+  }
+
+  @override
+  Future<LivenessPolicyInfo> policy(String workflow) async => LivenessPolicyInfo(
+      enabled: enabled, maxRetries: maxRetries, minChallenges: 2, challengeTimeoutMs: 6000);
+
+  @override
+  Future<CameraPermission> ensureCameraPermission() async {
+    permissionRequests++;
+    return permission;
+  }
+
+  @override
+  Future<void> openCameraSettings() async => settingsOpened++;
+
+  @override
+  Future<String> cameraFor(String workflow) async => cameras[workflow] ?? 'front';
+
+  @override
+  Future<void> reloadConfig() async {}
+
+  @override
+  Future<String> startSession(String workflow, {String camera = 'front', bool useFake = false}) async {
+    started.add('$workflow/$camera/$useFake');
+    return enabled ? sessionId : '';
+  }
+
+  @override
+  Future<void> retry() async => retries++;
+
+  @override
+  Future<void> cancel() async => cancels++;
+
+  @override
+  Future<String> modelVersion() async => 'test-model';
+
+  @override
+  Future<void> setConfigOverride(String key, String value) async {}
+
+  /// What armBinding returns (ARMED, DISABLED, REJECTED), or throws when [throwOnArm] is set.
+  String armResult = 'ARMED';
+  Object? throwOnArm;
+  final List<String> armed = [];
+
+  @override
+  Future<String> armBinding(String sessionId) async {
+    armed.add(sessionId);
+    if (throwOnArm != null) throw throwOnArm!;
+    return armResult;
+  }
+
+  /// What verifyIdentity returns, one per call (the last one repeats), or throws when [throwOnIdentity] is set.
+  List<IdentityCheckInfo> identityResults = [identity('MATCH')];
+  Object? throwOnIdentity;
+  final List<String> identityCalls = [];
+
+  @override
+  Future<IdentityCheckInfo> verifyIdentity(String sessionId, String userId, String gate, int attempt) async {
+    identityCalls.add('$sessionId/$userId/$gate/$attempt');
+    if (throwOnIdentity != null) throw throwOnIdentity!;
+    return identityResults[(identityCalls.length - 1).clamp(0, identityResults.length - 1)];
+  }
+}
+
+/// An identity check result as the native side returns it (similarity NaN, as in release builds).
+IdentityCheckInfo identity(String outcome, {bool? accepted, bool? retryable}) => IdentityCheckInfo(
+      outcome: outcome,
+      accepted: accepted ?? (outcome == 'MATCH' || outcome.startsWith('NOT_BOUND') || outcome == 'SKIPPED'),
+      retryable: retryable ?? !(outcome == 'MATCH' || outcome.startsWith('NOT_BOUND') || outcome == 'SKIPPED'),
+      similarity: double.nan,
+      threshold: 0.40,
+    );
+
+Map<String, Object?> ev(String type,
+        {int attempt = 1,
+        String? guidance,
+        String? challenge,
+        int index = 0,
+        int count = 0,
+        double progress = 0,
+        String? error,
+        String? userMessage,
+        int retriesLeft = 0,
+        bool recoverable = true}) =>
+    <String, Object?>{
+      'kind': 'event',
+      'type': type,
+      'guidance': guidance,
+      'challenge': challenge,
+      'challengeIndex': index,
+      'challengeCount': count,
+      'timeoutMs': 6000,
+      'progress': progress,
+      'error': error,
+      'userMessage': userMessage,
+      'attemptNumber': attempt,
+      'retriesLeft': retriesLeft,
+      'recoverable': recoverable,
+    };
+
+Map<String, Object?> complete(String decision,
+        {String? failureCode, String userMessage = 'NONE', String sessionId = 's-1'}) =>
+    <String, Object?>{
+      'kind': 'complete',
+      'decision': decision,
+      'passPath': decision == 'PASSED' ? 'ACTIVE_CHALLENGE' : 'NONE',
+      'failureCode': failureCode,
+      'userMessage': userMessage,
+      'passiveScore': 0.62,
+      'challengesIssued': const <String>['BLINK', 'SMILE'],
+      'attempts': 1,
+      'durationMs': 4321,
+      'sessionId': sessionId,
+      'modelVersion': 'test-model',
+      'bestFrameJpeg': null,
+    };
diff --git a/test/liveness/identity_binding_test.dart b/test/liveness/identity_binding_test.dart
new file mode 100644
index 0000000..6eb3b53
--- /dev/null
+++ b/test/liveness/identity_binding_test.dart
@@ -0,0 +1,164 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:registration_client/ui/liveness/identity_binding.dart';
+import 'package:registration_client/ui/liveness/liveness_gate.dart';
+import 'package:registration_client/ui/liveness/liveness_page.dart';
+
+import 'fake_liveness_service.dart';
+
+/// Identity binding (F15) in the password-only steps (operator login, packet
+/// authentication, supervisor approval all call IdentityBinding.run), with the
+/// gate, the native check and the retry dialog mocked.
+void main() {
+  late BuildContext ctx;
+  late FakeLivenessService service;
+  late List<GateResult> gates;
+  late int gateRuns;
+  late List<bool> retryAnswers;
+  late int asked;
+
+  setUp(() {
+    service = FakeLivenessService();
+    gates = [];
+    gateRuns = 0;
+    retryAnswers = [];
+    asked = 0;
+  });
+
+  Future<void> pumpHost(WidgetTester tester) async {
+    await tester.pumpWidget(MaterialApp(home: Builder(builder: (c) {
+      ctx = c;
+      return const SizedBox();
+    })));
+  }
+
+  GateResult passed([String id = 's-1']) =>
+      GateResult.fromOutcome(LivenessOutcome(passed: true, sessionId: id));
+
+  Future<IdentityGateResult> run({String gate = IdentityBinding.passwordLogin}) => IdentityBinding.run(
+        ctx,
+        workflow: LivenessGate.operator,
+        userId: 'op1',
+        gate: gate,
+        service: service,
+        runGate: () async => gates[(gateRuns++).clamp(0, gates.length - 1)],
+        askRetry: () async {
+          asked++;
+          return retryAnswers.isEmpty ? false : retryAnswers.removeAt(0);
+        },
+      );
+
+  testWidgets('the onboarded face proceeds after one gate', (tester) async {
+    await pumpHost(tester);
+    gates = [passed()];
+    final r = await run();
+    expect(r.step, IdentityGateStep.proceed);
+    expect(r.proceed, isTrue);
+    expect(r.messageKey, isNull);
+    expect(service.identityCalls, ['s-1/op1/password_login/1']);
+    expect(asked, 0);
+  });
+
+  testWidgets('a different face gets one retry, a new session, then proceeds when it matches', (tester) async {
+    await pumpHost(tester);
+    gates = [passed('s-1'), passed('s-2')];
+    service.identityResults = [identity('NO_MATCH'), identity('MATCH')];
+    retryAnswers = [true];
+    final r = await run(gate: IdentityBinding.packetAuth);
+    expect(r.step, IdentityGateStep.proceed);
+    expect(gateRuns, 2);
+    expect(asked, 1);
+    expect(service.identityCalls, ['s-1/op1/packet_auth/1', 's-2/op1/packet_auth/2']);
+  });
+
+  testWidgets('a second rejection is not verified, with the generic text', (tester) async {
+    await pumpHost(tester);
+    gates = [passed('s-1'), passed('s-2')];
+    service.identityResults = [identity('NO_MATCH')];
+    retryAnswers = [true, true];
+    final r = await run();
+    expect(r.step, IdentityGateStep.notVerified);
+    expect(r.messageKey, 'liveness.error.identity_not_verified');
+    expect(gateRuns, 2, reason: 'one retry only');
+    expect(asked, 1);
+  });
+
+  testWidgets('Cancel on the retry question is not verified', (tester) async {
+    await pumpHost(tester);
+    gates = [passed()];
+    service.identityResults = [identity('NO_MATCH')];
+    retryAnswers = [false];
+    expect((await run()).step, IdentityGateStep.notVerified);
+    expect(gateRuns, 1);
+  });
+
+  testWidgets('no onboarded face proceeds on presence alone; a required template stops without a retry',
+      (tester) async {
+    await pumpHost(tester);
+    gates = [passed()];
+    service.identityResults = [identity('NOT_BOUND_NO_TEMPLATE')];
+    expect((await run()).step, IdentityGateStep.proceed);
+
+    gateRuns = 0;
+    service.identityResults = [identity('NOT_BOUND_UNREADABLE', accepted: false, retryable: false)];
+    service.identityCalls.clear();
+    final r = await run();
+    expect(r.step, IdentityGateStep.notVerified);
+    expect(asked, 0, reason: 'a new session cannot help');
+  });
+
+  testWidgets('a native error or a missing session id is retried once, then not verified', (tester) async {
+    await pumpHost(tester);
+    gates = [passed(''), passed('s-2')];
+    service.throwOnIdentity = StateError('channel');
+    retryAnswers = [true];
+    final r = await run();
+    expect(r.step, IdentityGateStep.notVerified);
+    expect(gateRuns, 2);
+    expect(service.identityCalls, ['s-2/op1/password_login/2'], reason: 'no call without a session id');
+  });
+
+  testWidgets('cancelled, blocked and disabled gates never call the check', (tester) async {
+    await pumpHost(tester);
+    gates = [GateResult.cancelled()];
+    expect((await run()).step, IdentityGateStep.cancelled);
+    expect((await run()).messageKey, isNull);
+    gateRuns = 0;
+    gates = [GateResult.blocked(const LivenessOutcome(failureCode: 'PAD_FAILURE', userMessage: 'DEVICE_PROBLEM'))];
+    final blocked = await run();
+    expect(blocked.step, IdentityGateStep.blocked);
