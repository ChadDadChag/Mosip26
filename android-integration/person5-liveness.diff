diff --git a/lib/platform_android/liveness_service_impl.dart b/lib/platform_android/liveness_service_impl.dart
new file mode 100644
index 0000000..d3b4c72
--- /dev/null
+++ b/lib/platform_android/liveness_service_impl.dart
@@ -0,0 +1,118 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:permission_handler/permission_handler.dart';
+import 'package:registration_client/pigeon/liveness_pigeon.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+
+class LivenessServiceImpl implements LivenessService {
+  LivenessServiceImpl._();
+
+  static final LivenessServiceImpl instance = LivenessServiceImpl._();
+
+  static const EventChannel _events =
+      EventChannel('io.mosip.registration_client/liveness/events');
+
+  final LivenessApi _api = LivenessApi();
+  StreamSubscription<dynamic>? _subscription;
+  late final StreamController<LivenessMessage> _controller =
+      StreamController<LivenessMessage>.broadcast(
+          onListen: _connect, onCancel: _disconnect);
+
+  void _connect() {
+    _subscription ??= _events.receiveBroadcastStream().listen(
+      (dynamic event) {
+        if (event is Map) {
+          _controller.add(LivenessMessage(Map<String, Object?>.from(event)));
+        }
+      },
+      onError: (Object e) => debugPrint('Liveness event channel error: $e'),
+    );
+  }
+
+  void _disconnect() {
+    _subscription?.cancel();
+    _subscription = null;
+  }
+
+  @override
+  Stream<LivenessMessage> get messages => _controller.stream;
+
+  @override
+  Future<bool> isEnabled(String workflow) => _api.isEnabled(workflow);
+
+  @override
+  Future<LivenessPolicyInfo> policy(String workflow) => _api.policy(workflow);
+
+  @override
+  Future<CameraPermission> ensureCameraPermission() async {
+    final PermissionStatus status = await Permission.camera.request();
+    if (status.isGranted) return CameraPermission.granted;
+    if (status.isPermanentlyDenied) return CameraPermission.permanentlyDenied;
+    // permission_handler can miss "don't ask again" (seen after the permission was revoked outside the app).
+    // Right after a refused request Android shows no rationale only when it will not ask any more.
+    if (!await Permission.camera.shouldShowRequestRationale) {
+      return CameraPermission.permanentlyDenied;
+    }
+    return CameraPermission.denied;
+  }
+
+  @override
+  Future<void> openCameraSettings() async {
+    await openAppSettings();
+  }
+
+  @override
+  Future<String> cameraFor(String workflow) => _api.cameraFor(workflow);
+
+  @override
+  Future<void> reloadConfig() => _api.reloadConfig();
+
+  @override
+  Future<String> startSession(String workflow,
+      {String camera = 'front', bool useFake = false}) async {
+    // The fake engine uses no camera, so it needs no permission.
+    if (!useFake && await ensureCameraPermission() != CameraPermission.granted) {
+      final String id = 'camera-denied-${DateTime.now().millisecondsSinceEpoch}';
+      _controller.add(LivenessMessage(<String, Object?>{
+        'kind': 'complete',
+        'decision': 'FAILED',
+        'passPath': 'NONE',
+        'failureCode': 'CAMERA_UNAVAILABLE',
+        'userMessage': 'DEVICE_PROBLEM',
+        'passiveScore': double.nan,
+        'challengesIssued': const <String>[],
+        'attempts': 0,
+        'durationMs': 0,
+        'sessionId': id,
+        'modelVersion': '',
+        'bestFrameJpeg': null,
+      }));
+      return id;
+    }
+    return _api.startSession(workflow, camera, useFake);
+  }
+
+  @override
+  Future<void> retry() => _api.retry();
+
+  @override
+  Future<void> cancel() => _api.cancel();
+
+  @override
+  Future<String> modelVersion() => _api.modelVersion();
+
+  @override
+  Future<void> setConfigOverride(String key, String value) =>
+      _api.setConfigOverride(key, value);
+}
+
+LivenessService getLivenessServiceImpl() => LivenessServiceImpl.instance;
