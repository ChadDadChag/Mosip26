+package io.mosip.registration.liveness.android;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import android.content.Context;
+import android.content.res.AssetManager;
+
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.mockito.ArgumentCaptor;
+
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import io.mosip.registration.clientmanager.repository.GlobalParamRepository;
+import io.mosip.registration.clientmanager.spi.AuditManagerService;
+import io.mosip.registration.liveness.analyzer.AnalyzerConfig;
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.LivenessEngineException;
+import io.mosip.registration.liveness.api.WorkflowType;
+
+/** Config handling of the holder; no models are loaded (the analyzer is created lazily). */
+public class LivenessServiceHolderTest {
+
+    private static final String FACE = "mosip.registration.liveness.face.";
+
+    @Rule
+    public TemporaryFolder files = new TemporaryFolder();
+
+    private final Map<String, String> synced = new HashMap<>();
+    private final GlobalParamRepository globalParams = mock(GlobalParamRepository.class);
+    private LivenessServiceHolder holder;
+
+    @Before
+    public void setUp() {
+        Context context = mock(Context.class);
+        when(context.getApplicationContext()).thenReturn(context);
+        when(context.getAssets()).thenReturn(mock(AssetManager.class));
+        when(context.getFilesDir()).thenReturn(files.getRoot());
+        when(globalParams.getCachedStringGlobalParam(anyString())).thenAnswer(i -> synced.get(i.<String>getArgument(0)));
+        holder = new LivenessServiceHolder(context, globalParams, mock(AuditManagerService.class));
+    }
+
+    @Test
+    public void anOverrideChangesThePolicy() {
+        assertEquals(3, holder.policy(WorkflowType.RESIDENT).maxRetries);
+        holder.setOverride(FACE + "default.maxRetries", "1");
+        assertEquals(1, holder.policy(WorkflowType.RESIDENT).maxRetries);
+        holder.setOverride(FACE + "default.maxRetries", "");
+        assertEquals(3, holder.policy(WorkflowType.RESIDENT).maxRetries);
+    }
+
+    @Test
+    public void aSyncedValueAppliesAfterTheRefreshListenerRuns() {
+        ArgumentCaptor<Runnable> listener = ArgumentCaptor.forClass(Runnable.class);
+        verify(globalParams).addRefreshListener(listener.capture());
+        assertEquals(2, holder.policy(WorkflowType.RESIDENT).minChallenges);
+
+        synced.put(FACE + "resident.minChallenges", "1");
+        assertEquals("the policy is cached until a reload", 2, holder.policy(WorkflowType.RESIDENT).minChallenges);
+        listener.getValue().run(); // what GlobalParamRepository.refreshConfigurationCache() does after a sync
+        assertEquals(1, holder.policy(WorkflowType.RESIDENT).minChallenges);
+    }
+
+    @Test
+    public void aWorkflowCanBeDisabled() {
+        holder.setOverride(FACE + "operator.enabled", "false");
+        assertFalse(holder.policy(WorkflowType.OPERATOR).enabled);
+        assertTrue(holder.policy(WorkflowType.RESIDENT).enabled);
+        assertTrue(holder.policy(WorkflowType.SUPERVISOR).enabled);
+    }
+
+    @Test
+    public void theCameraComesFromTheConfig() {
+        assertEquals("front", holder.cameraFor(WorkflowType.RESIDENT));
+        synced.put(FACE + "android.operator.camera", "back");
+        assertEquals("back", holder.cameraFor(WorkflowType.OPERATOR));
+        synced.put(FACE + "android.supervisor.camera", " BACK ");
+        assertEquals("back", holder.cameraFor(WorkflowType.SUPERVISOR));
+        synced.put(FACE + "android.resident.camera", "rear");
+        assertEquals("front", holder.cameraFor(WorkflowType.RESIDENT));
+    }
+
+    @Test
+    public void theAnalyzerIsReplacedOnlyWhenItsSettingsChange() {
+        holder.reloadConfig();
+        assertEquals(0, holder.analyzerSwaps());
+        holder.setOverride(AnalyzerConfig.KEY_PREFIX + "intraOpThreads", "3"); // the default is 2
+        assertEquals(1, holder.analyzerSwaps());
+        holder.reloadConfig();
+        assertEquals(1, holder.analyzerSwaps());
+    }
+
+    @Test
+    public void androidDefaultsApplyUnlessTheConfigSetsTheKey() {
+        String threads = AnalyzerConfig.KEY_PREFIX + "intraOpThreads";
+        String accelerator = AnalyzerConfig.KEY_PREFIX + "accelerator";
+        AnalyzerConfig android = holder.analyzerSettings();
+        assertEquals(Integer.parseInt(LivenessServiceHolder.ANDROID_ANALYZER_DEFAULTS.get(threads)), android.intraOpThreads);
+        assertEquals(LivenessServiceHolder.ANDROID_ANALYZER_DEFAULTS.get(accelerator), android.accelerator.name());
+
+        synced.put(threads, "1");
+        synced.put(accelerator, "nnapi");
+        assertEquals(1, holder.analyzerSettings().intraOpThreads);
+        assertEquals(AnalyzerConfig.Accelerator.NNAPI, holder.analyzerSettings().accelerator);
+        holder.setOverride(threads, "3");
+        assertEquals(3, holder.analyzerSettings().intraOpThreads);
+        synced.put(threads, " ");
+        holder.setOverride(threads, "");
+        assertEquals("a blank value keeps the Android default", android.intraOpThreads, holder.analyzerSettings().intraOpThreads);
+    }
+
+    @Test
+    public void anInvalidAnalyzerConfigFallsBackToTheAndroidDefaults() {
+        synced.put(AnalyzerConfig.KEY_PREFIX + "accelerator", "GPU");
+        AnalyzerConfig cfg = holder.analyzerSettings();
+        assertEquals(LivenessServiceHolder.ANDROID_ANALYZER_DEFAULTS.get(AnalyzerConfig.KEY_PREFIX + "accelerator"),
+                cfg.accelerator.name());
+    }
+
+    @Test
+    public void theExposureAssistIsOnUnlessSetToFalse() {
+        assertTrue(holder.exposureAssist());
+        synced.put(LivenessServiceHolder.EXPOSURE_ASSIST_KEY, " FALSE ");
+        assertFalse(holder.exposureAssist());
+        holder.setOverride(LivenessServiceHolder.EXPOSURE_ASSIST_KEY, "true");
+        assertTrue(holder.exposureAssist());
+    }
+
+    @Test
+    public void aBundleThatDoesNotVerifyLeavesTheStoreUntouched() throws Exception {
+        File staged = files.newFolder("staging");
+        Files.write(new File(staged, "manifest.json").toPath(), "{}".getBytes(StandardCharsets.UTF_8));
+        Files.write(new File(staged, "manifest.sig").toPath(), "mosip-liveness-dev-2026-10:00".getBytes(StandardCharsets.UTF_8));
+        try {
+            holder.installModelBundle(staged);
+            fail("installed an unsigned bundle");
+        } catch (LivenessEngineException e) {
+            assertEquals(ErrorCode.MODEL_INTEGRITY_FAILED, e.code());
+        }
+        assertFalse(new File(files.getRoot(), LivenessServiceHolder.MODEL_STORE_DIR).exists());
+        assertEquals("installed [], current none (bundled)", holder.modelStoreStatus());
+        assertEquals(0, holder.analyzerSwaps());
+    }
+
+    @Test
+    public void rollbackWithNothingInstalledIsRefused() throws Exception {
+        try {
+            holder.rollbackModelBundle();
+            fail("rolled back an empty store");
+        } catch (IllegalStateException e) {
+            assertEquals("nothing installed", e.getMessage());
+        }
+    }
+
+    @Test
+    public void benchmarkBundlesAreTheBundledOneThenEachTestFolder() throws Exception {
+        File root = files.newFolder("bench-bundles");
+        assertTrue(new File(root, "pad-2026.10.3-int8").mkdir());
+        assertTrue(new File(root, "a-first").mkdir());
+        Files.write(new File(root, "notes.txt").toPath(), new byte[]{1});
+        List<AnalyzerBenchmark.Bundle> b = holder.benchmarkBundles(root);
+        assertEquals(3, b.size());
+        assertEquals("bundled", b.get(0).label);
+        assertEquals("a-first", b.get(1).label);
+        assertEquals("pad-2026.10.3-int8", b.get(2).label);
+        assertEquals(1, holder.benchmarkBundles(null).size());
+    }
+
+    @Test
+    public void theFingerprintCoversNestedSettings() {
+        Map<String, String> cfg = new HashMap<>();
+        String base = LivenessServiceHolder.fingerprint(AnalyzerConfig.fromConfig(cfg::get));
+        cfg.put(AnalyzerConfig.KEY_PREFIX + "detectorMaxWidth", "256"); // the default is 320
+        String changed = LivenessServiceHolder.fingerprint(AnalyzerConfig.fromConfig(cfg::get));
+        assertNotEquals(base, changed);
+        assertTrue(changed, changed.contains("detector={"));
+    }
+}
