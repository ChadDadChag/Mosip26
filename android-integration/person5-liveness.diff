diff --git a/pigeon/liveness.dart b/pigeon/liveness.dart
new file mode 100644
index 0000000..482fe8b
--- /dev/null
+++ b/pigeon/liveness.dart
@@ -0,0 +1,226 @@
+import 'package:pigeon/pigeon.dart';
+
+/// The parts of a workflow's liveness policy the UI needs (from the synced
+/// mosip.registration.liveness.face.* config, or the engine defaults).
+class LivenessPolicyInfo {
+  final bool enabled;
+  final int maxRetries;
+  final int minChallenges;
+  final int challengeTimeoutMs;
+
+  LivenessPolicyInfo({
+    required this.enabled,
+    required this.maxRetries,
+    required this.minChallenges,
+    required this.challengeTimeoutMs,
+  });
+}
+
+/// Face binding (F1): the captured face compared with the face that passed
+/// liveness. outcome: MATCH, NO_MATCH, NO_FACE_A, NO_FACE_B, MULTIPLE_FACES_A,
+/// MULTIPLE_FACES_B, ERROR (fail closed) or SKIPPED (binding disabled).
+/// similarity is NaN unless both images held exactly one face.
+class BindingInfo {
+  final String outcome;
+  final double similarity;
+  final double threshold;
+
+  BindingInfo({
+    required this.outcome,
+    required this.similarity,
+    required this.threshold,
+  });
+}
+
+/// F17: what an offline model install or a rollback did. outcome: INSTALLED,
+/// ROLLED_BACK, NOT_NEWER, INVALID (MODEL_INTEGRITY_FAILED),
+/// NOTHING_TO_ROLL_BACK, NOT_ALLOWED, FAILED, or CANCELLED (the file picker was
+/// closed). The versions in use before and after, when known.
+class ModelBundleActionResult {
+  final String outcome;
+  final String? fromVersion;
+  final String? toVersion;
+
+  ModelBundleActionResult({
+    required this.outcome,
+    this.fromVersion,
+    this.toVersion,
+  });
+}
+
+/// Identity binding (F15): the live face of a PASSED password-only gate
+/// compared with the user's face onboarded on this device. outcome: MATCH,
+/// NO_MATCH, NO_LIVE_FACE, NO_LIVE_FRAME, NOT_BOUND_NO_TEMPLATE,
+/// NOT_BOUND_UNREADABLE, SKIPPED (identity binding disabled) or ERROR.
+/// accepted: the flow may go on. retryable: one new liveness session may help.
+/// similarity is NaN in release builds: only the debug page shows it.
+class IdentityCheckInfo {
+  final String outcome;
+  final bool accepted;
+  final bool retryable;
+  final double similarity;
+  final double threshold;
+
+  IdentityCheckInfo({
+    required this.outcome,
+    required this.accepted,
+    required this.retryable,
+    required this.similarity,
+    required this.threshold,
+  });
+}
+
+/// Face liveness. Workflows: RESIDENT, OPERATOR, SUPERVISOR. Cameras: front, back.
+/// Session events and the result arrive on the event channel
+/// io.mosip.registration_client/liveness/events.
+@HostApi()
+abstract class LivenessApi {
+  bool isEnabled(String workflow);
+
+  LivenessPolicyInfo policy(String workflow);
+
+  /// Starts a session (cancelling any running one) and returns its id,
+  /// or "" when liveness is disabled for the workflow.
+  @async
+  String startSession(String workflow, String camera, bool useFake);
+
+  void retry();
+
+  void cancel();
+
+  /// The loaded model bundle version, or "" before the models are loaded.
+  String modelVersion();
+
+  /// front or back, from mosip.registration.liveness.face.android.<workflow>.camera
+  /// (default front).
+  String cameraFor(String workflow);
+
+  /// Re-reads the liveness config for new sessions (the native side also does
+  /// this after every global-param sync).
+  void reloadConfig();
+
+  /// Diagnostics builds (debug, profile) only, ignored otherwise: sets a config
+  /// override, or removes it when value is empty.
+  void setConfigOverride(String key, String value);
+
+  /// The persisted anonymised metrics of the real engine (counts since install
+  /// or the last reset, and the rates derived from them), one key=value per line.
+  String metrics();
+
+  /// Diagnostics builds only: clears the persisted metrics.
+  void resetMetrics();
+
+  /// Diagnostics builds only: captures 60 camera frames into memory (the person
+  /// faces the camera for about 5 s), benchmarks the analyzer (1, 2 and 4
+  /// threads x CPU, XNNPACK, NNAPI) with the bundled models and each signed
+  /// test bundle under files/bench-bundles/, discards the frames and returns
+  /// the report as text. Takes a few minutes.
+  @async
+  String runBenchmark(String camera);
+
+  /// Diagnostics builds only: installs the signed bundle staged (adb push) in
+  /// files/bundle-staging/ into the model store; new sessions use it. Returns
+  /// the installed version.
+  @async
+  String installModelBundle();
+
+  /// Diagnostics builds only: the model store's previous bundle becomes current
+  /// again. Returns that version.
+  @async
+  String rollbackModelBundle();
+
+  /// The model store's installed versions and its current one.
+  String modelStoreStatus();
+
+  /// F17: true when the offline model install is enabled
+  /// (mosip.registration.liveness.model.offlineInstall.enabled, default true)
+  /// and the logged-in user is a supervisor or an admin. The page and its entry
+  /// are shown only then; the actions check it again.
+  bool modelBundleActionsAllowed();
+
+  /// F17: the model bundle version new sessions use, or "" when unknown.
+  String activeModelVersion();
+
+  /// F17, production builds too: the system file picker for a signed bundle
+  /// zip (Storage Access Framework); the zip is copied to the cache, installed
+  /// like an online update (signature, anti-rollback) and the copy deleted.
+  /// Audited as REG-EVT-019 with trigger=offline.
+  @async
+  ModelBundleActionResult installModelBundleFromFile();
+
+  /// F17, production builds too: the previous model bundle becomes current
+  /// again (supervisors and admins). Audited with trigger=rollback.
+  @async
+  ModelBundleActionResult rollbackModelBundleFromSettings();
+
+  /// F17, diagnostics builds only: the debug page sets it while it shows the
+  /// production model page, so the page works without a logged-in supervisor
+  /// (no backend on a development phone). Release builds ignore it.
+  void setModelBundleDiagnosticOverride(bool on);
+
+  /// Diagnostics builds only: checks for an online model update now. A
+  /// non-empty [indexUrl] first sets the update URL and enabled overrides (in
+  /// these builds plain HTTP to 127.0.0.1 is allowed). Returns the outcome:
+  /// INSTALLED, UP_TO_DATE or FAILED with a reason.
+  @async
+  String checkModelUpdate(String indexUrl);
+
+  /// Face binding (F1), the hooks: before the SBI face capture, arms the
+  /// comparison of the next face capture with the best frame of [sessionId]
+  /// (the PASSED gate's session). Returns ARMED; DISABLED when
+  /// mosip.registration.liveness.face.binding.enabled is false (the capture is
+  /// stored as before and audited SKIPPED); REJECTED for an unknown or expired
+  /// session (the hook then blocks). An armed capture that does not match makes
+  /// invokeDiscoverSbi return LIVENESS_BINDING_FAILED and is not stored.
+  String armBinding(String sessionId);
+
+  /// Face binding (F1): compares [capturedImage] (JPEG, PNG or JPEG 2000) with
+  /// the held best frame of [sessionId], then drops that frame. Never logged or
+  /// stored. The debug page's binding test uses it.
+  @async
+  BindingInfo bindCapturedFace(String sessionId, Uint8List capturedImage);
+
+  /// Identity binding (F15), the password-only gates: after the gate PASSED
+  /// (not when liveness is disabled), compares the held best frame of
+  /// [sessionId] with [userId]'s faces onboarded on this device, then drops
+  /// the frame. [gate]: password_login, packet_auth or supervisor_approval.
+  /// [attempt]: 1, or 2 for the one retry. Audited (REG-EVT-020). Never
+  /// fails: an error is ERROR (rejected, retryable).
+  @async
+  IdentityCheckInfo verifyIdentity(
+      String sessionId, String userId, String gate, int attempt);
+
+  /// F15, diagnostics builds only: the held best frame of [sessionId] (a gate
+  /// PASSED on the debug page) becomes the test template, an ISO/IEC 19794-5
+  /// record holding JPEG 2000, in app-private files/f15-test-template. It
+  /// never leaves the device. Returns ENROLLED, NO_LIVE_FRAME, FAILED, or
+  /// NOT_ALLOWED in release builds.
+  @async
+  String enrollIdentityTestTemplate(String sessionId);
+
+  /// F15, diagnostics builds only: deletes the test template; true when one
+  /// was deleted.
+  bool deleteIdentityTestTemplate();
+
+  /// F15, diagnostics builds only: whether the test template exists.
+  bool hasIdentityTestTemplate();
+
+  /// F15, diagnostics builds only: while on, verifyIdentity uses the test
+  /// template instead of the user's onboarded faces (audited
+  /// templateSource=diagnostics-test). Release builds ignore it.
+  void setIdentityDiagnosticOverride(bool on);
+
+  /// Diagnostics builds only: one camera still, without liveness, as JPEG (or
+  /// JPEG 2000 when [jp2]); it stands in for the SBI capture in the binding
+  /// test. Keep it in memory only and never display it.
+  @async
+  Uint8List captureStill(String camera, bool jp2);
+
+  /// Diagnostics builds only: captures 20 camera frames into memory (the person
+  /// faces the camera), times face binding on the last two frames with one face
+  /// (preload, matcher warm-up, first and warm comparisons, one-face embedding)
+  /// with the bundled models and each signed test bundle under
+  /// files/bench-bundles/, drops the frames and returns the report as text.
+  @async
+  String runMatcherBenchmark(String camera);
+}
