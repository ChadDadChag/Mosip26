+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+import 'package:registration_client/ui/liveness/liveness_page.dart';
+
+enum GateStatus { proceed, cancelled, blocked }
+
+/// What a flow does after [LivenessGate.run]: proceed (passed, or liveness is
+/// disabled for the workflow), cancelled (the user backed out: no state
+/// change), or blocked (failed: the page already showed the recovery text).
+@immutable
+class GateResult {
+  const GateResult._(this.status, {this.disabled = false, this.outcome});
+
+  factory GateResult.proceed({LivenessOutcome? outcome, bool disabled = false}) =>
+      GateResult._(GateStatus.proceed, outcome: outcome, disabled: disabled);
+
+  factory GateResult.cancelled([LivenessOutcome? outcome]) =>
+      GateResult._(GateStatus.cancelled, outcome: outcome);
+
+  factory GateResult.blocked(LivenessOutcome? outcome) =>
+      GateResult._(GateStatus.blocked, outcome: outcome);
+
+  /// passed -> proceed; cancelled or no outcome (the page was popped some other way) -> cancelled;
+  /// disabled -> proceed (disabled); anything else -> blocked.
+  factory GateResult.fromOutcome(LivenessOutcome? outcome) {
+    if (outcome == null) return GateResult.cancelled();
+    if (outcome.disabled) return GateResult.proceed(disabled: true);
+    if (outcome.passed) return GateResult.proceed(outcome: outcome);
+    if (outcome.cancelled) return GateResult.cancelled(outcome);
+    return GateResult.blocked(outcome);
+  }
+
+  final GateStatus status;
+
+  /// Liveness is disabled for the workflow: the legacy flow continues unchanged.
+  final bool disabled;
+  final LivenessOutcome? outcome;
+
+  bool get proceed => status == GateStatus.proceed;
+  bool get cancelled => status == GateStatus.cancelled;
+  bool get blocked => status == GateStatus.blocked;
+
+  String? get sessionId => outcome?.sessionId;
+
+  /// The passed session's best frame (kept for binding it to the captured face later). Never log it.
+  Uint8List? get bestFrameJpeg => outcome?.bestFrameJpeg;
+
+  /// The canonical key of the short failure text for a blocked result (e.g. a snackbar).
+  String get failureMessageKey => outcome?.userMessage == 'DEVICE_PROBLEM'
+      ? 'liveness.error.device_problem'
+      : 'liveness.error.max_attempts_reached';
+
+  @override
+  String toString() => 'GateResult(${status.name}${disabled ? ', disabled' : ''}, $outcome)';
+}
+
+/// The one entry point the registration flows call before a face is captured or
+/// a step is authorised (docs/ui-liveness-spec.md section 6).
+class LivenessGate {
+  LivenessGate._();
+
+  static const String resident = 'RESIDENT';
+  static const String operator = 'OPERATOR';
+  static const String supervisor = 'SUPERVISOR';
+
+  /// Runs the liveness step for [workflow]: returns proceed(disabled) at once
+  /// when liveness is disabled for it; otherwise opens [LivenessPage] full screen
+  /// on the root navigator (so it also works from a dialog) with the workflow's
+  /// configured camera, and maps the outcome. Never throws: any error fails
+  /// closed as blocked.
+  ///
+  /// [useFake], [service] and [previewBuilder] are for the debug page and tests.
+  static Future<GateResult> run(
+    BuildContext context, {
+    required String workflow,
+    bool useFake = false,
+    LivenessService? service,
+    Widget Function()? previewBuilder,
+  }) async {
+    final svc = service ?? LivenessService();
+    try {
+      final navigator = Navigator.of(context, rootNavigator: true);
+      if (!await svc.isEnabled(workflow)) return GateResult.proceed(disabled: true);
+      final camera = await svc.cameraFor(workflow);
+      final outcome = await navigator.push<LivenessOutcome>(
+        MaterialPageRoute<LivenessOutcome>(
+          fullscreenDialog: true,
+          builder: (_) => LivenessPage(
+            workflow: workflow,
+            camera: camera,
+            useFake: useFake,
+            service: svc,
+            previewBuilder: previewBuilder,
+          ),
+        ),
+      );
+      return GateResult.fromOutcome(outcome);
+    } catch (e) {
+      debugPrint('Liveness gate failed closed for $workflow: ${e.runtimeType}');
+      return GateResult.blocked(const LivenessOutcome(
+          failureCode: 'ENGINE_ERROR', userMessage: 'VERIFICATION_NOT_COMPLETED'));
+    }
+  }
+}
