+import 'dart:async';
+
+import 'package:registration_client/pigeon/liveness_pigeon.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+
+/// A scripted LivenessService: the test emits the engine's maps.
+class FakeLivenessService implements LivenessService {
+  final StreamController<LivenessMessage> _messages = StreamController<LivenessMessage>.broadcast();
+  bool enabled = true;
+  CameraPermission permission = CameraPermission.granted;
+  Map<String, String> cameras = {};
+  int maxRetries = 3;
+  String sessionId = 's-1';
+  int retries = 0;
+  int cancels = 0;
+  int permissionRequests = 0;
+  int settingsOpened = 0;
+  Object? throwOnIsEnabled;
+  final List<String> started = [];
+
+  void emit(Map<String, Object?> m) => _messages.add(LivenessMessage(m));
+
+  @override
+  Stream<LivenessMessage> get messages => _messages.stream;
+
+  @override
+  Future<bool> isEnabled(String workflow) async {
+    if (throwOnIsEnabled != null) throw throwOnIsEnabled!;
+    return enabled;
+  }
+
+  @override
+  Future<LivenessPolicyInfo> policy(String workflow) async => LivenessPolicyInfo(
+      enabled: enabled, maxRetries: maxRetries, minChallenges: 2, challengeTimeoutMs: 6000);
+
+  @override
+  Future<CameraPermission> ensureCameraPermission() async {
+    permissionRequests++;
+    return permission;
+  }
+
+  @override
+  Future<void> openCameraSettings() async => settingsOpened++;
+
+  @override
+  Future<String> cameraFor(String workflow) async => cameras[workflow] ?? 'front';
+
+  @override
+  Future<void> reloadConfig() async {}
+
+  @override
+  Future<String> startSession(String workflow, {String camera = 'front', bool useFake = false}) async {
+    started.add('$workflow/$camera/$useFake');
+    return enabled ? sessionId : '';
+  }
+
+  @override
+  Future<void> retry() async => retries++;
+
+  @override
+  Future<void> cancel() async => cancels++;
+
+  @override
+  Future<String> modelVersion() async => 'test-model';
+
+  @override
+  Future<void> setConfigOverride(String key, String value) async {}
+}
