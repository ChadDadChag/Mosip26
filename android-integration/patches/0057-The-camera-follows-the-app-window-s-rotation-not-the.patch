+package io.mosip.registration.liveness.device.android;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.robolectric.Shadows.shadowOf;
+
+import android.app.Activity;
+import android.os.Looper;
+import android.util.Size;
+import android.view.Display;
+import android.view.Surface;
+
+import androidx.camera.core.CameraSelector;
+import androidx.camera.core.Preview;
+import androidx.lifecycle.LifecycleOwner;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+import org.robolectric.shadows.ShadowDisplay;
+import org.robolectric.shadows.ShadowDisplayManager;
+
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.FrameSource;
+
+/**
+ * F19: the use cases take the app window's rotation, not the physical display's (CameraX's default), at bind time and
+ * after each display change, until stop().
+ */
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 34)
+public class CameraXFrameSourceRotationTest {
+
+    @Test
+    public void bindUsesTheWindowsRotationNotTheDisplays() {
+        // The window at 270, the display at 90: neither the display's rotation nor CameraX's unset default (0) passes.
+        FakeRotation rotation = new FakeRotation(Surface.ROTATION_270, Surface.ROTATION_90);
+        CameraXFrameSource.UseCases useCases = running(rotation, true).bindForTest();
+        assertEquals(Surface.ROTATION_270, useCases.analysis.getTargetRotation());
+        assertNotNull(useCases.preview);
+        assertEquals(Surface.ROTATION_270, useCases.preview.getTargetRotation());
+        assertEquals("one watch from the bind", 1, rotation.watches);
+    }
+
+    @Test
+    public void aDisplayChangeGivesTheBoundUseCasesTheWindowsNewRotation() {
+        // As on the phone: the display at 90 under another app's fixed-rotation transform, the app portrait.
+        FakeRotation rotation = new FakeRotation(Surface.ROTATION_0, Surface.ROTATION_90);
+        CameraXFrameSource source = running(rotation, true);
+        CameraXFrameSource.UseCases useCases = source.bindForTest();
+
+        // The transform ends: the display turns to 0, the window stays at 0.
+        rotation.display = Surface.ROTATION_0;
+        rotation.onChange.run();
+        assertEquals(Surface.ROTATION_0, useCases.analysis.getTargetRotation());
+
+        // The phone is turned: window and display at 90.
+        rotation.window = Surface.ROTATION_90;
+        rotation.display = Surface.ROTATION_90;
+        rotation.onChange.run();
+        assertEquals(Surface.ROTATION_90, useCases.analysis.getTargetRotation());
+        assertEquals(Surface.ROTATION_90, useCases.preview.getTargetRotation());
+
+        // The Activity's configuration change, which may come after the display's, applies the window's rotation too.
+        rotation.window = Surface.ROTATION_270;
+        source.refreshTargetRotation();
+        assertEquals(Surface.ROTATION_270, useCases.analysis.getTargetRotation());
+        assertEquals(Surface.ROTATION_270, useCases.preview.getTargetRotation());
+    }
+
+    @Test
+    public void withoutAPreviewOnlyTheAnalysisFollows() {
+        FakeRotation rotation = new FakeRotation(Surface.ROTATION_90, Surface.ROTATION_0);
+        CameraXFrameSource.UseCases useCases = running(rotation, false).bindForTest();
+        assertEquals(null, useCases.preview);
+        assertEquals(Surface.ROTATION_90, useCases.analysis.getTargetRotation());
+        rotation.window = Surface.ROTATION_0;
+        rotation.onChange.run();
+        assertEquals(Surface.ROTATION_0, useCases.analysis.getTargetRotation());
+    }
+
+    @Test
+    public void stopUnregistersTheWatch() {
+        FakeRotation rotation = new FakeRotation(Surface.ROTATION_0, Surface.ROTATION_90);
+        CameraXFrameSource source = running(rotation, true);
+        CameraXFrameSource.UseCases useCases = source.bindForTest();
+        source.stop();
+        assertEquals(1, rotation.unwatched);
+
+        // A change already posted before the unregistration no longer touches the released use cases.
+        rotation.window = Surface.ROTATION_90;
+        rotation.onChange.run();
+        assertEquals(Surface.ROTATION_0, useCases.analysis.getTargetRotation());
+
+        source.stop();
+        assertEquals("a second stop() unregisters nothing", 1, rotation.unwatched);
+    }
+
+    @Test
+    public void aBindThatFinishesAfterStopNeverWatches() {
+        FakeRotation rotation = new FakeRotation(Surface.ROTATION_0, Surface.ROTATION_90);
+        CameraXFrameSource source = running(rotation, true);
+        source.stop(); // on another thread, while the provider was still binding
+        source.bindForTest();
+        assertEquals(0, rotation.watches);
+    }
+
+    @Test
+    public void anActivitysWindowRotationAndItsDisplayListener() {
+        Activity activity = Robolectric.buildActivity(Activity.class).setup().get();
+        // Robolectric's Activity is not a UI context (getDisplay() throws), so this reads the WindowManager's display:
+        // the fallback path. The phone reads Activity.getDisplay().
+        shadowOf(ShadowDisplay.getDefaultDisplay()).setRotation(Surface.ROTATION_90);
+        CameraXFrameSource.WindowRotation rotation = CameraXFrameSource.windowRotationOf(activity);
+        assertEquals(Surface.ROTATION_90, rotation.window());
+        assertEquals(Surface.ROTATION_90, rotation.display());
+
+        int[] changes = {0};
+        Runnable stop = rotation.watch(() -> changes[0]++);
+        ShadowDisplayManager.changeDisplay(Display.DEFAULT_DISPLAY, "+land");
+        shadowOf(Looper.getMainLooper()).idle();
+        assertTrue("a display change is reported", changes[0] > 0);
+
+        stop.run();
+        int before = changes[0];
+        ShadowDisplayManager.changeDisplay(Display.DEFAULT_DISPLAY, "+port");
+        shadowOf(Looper.getMainLooper()).idle();
+        assertEquals("nothing after the watch is stopped", before, changes[0]);
+    }
+
+    /** A source that is running, without a camera, with {@code rotation} and optionally a preview surface. */
+    private static CameraXFrameSource running(FakeRotation rotation, boolean withPreview) {
+        CameraXFrameSource source = new CameraXFrameSource(RuntimeEnvironment.getApplication(),
+                mock(LifecycleOwner.class), CameraSelector.DEFAULT_FRONT_CAMERA, new Size(640, 480), 1,
+                withPreview ? mock(Preview.SurfaceProvider.class) : null);
+        source.setWindowRotation(rotation);
+        source.attachForTest(new FrameSource.Listener() {
+            @Override
+            public void onFrame(Frame frame) {
+            }
+
+            @Override
+            public void onError(ErrorCode code, String detailForAuditOnly, boolean recoverable) {
+                throw new AssertionError(code + ": " + detailForAuditOnly);
+            }
+        });
+        return source;
+    }
+
+    /** A window and a display whose rotations the test sets, and the watch it hands out. */
+    private static final class FakeRotation implements CameraXFrameSource.WindowRotation {
+        int window;
+        int display;
+        Runnable onChange;
+        int watches;
+        int unwatched;
+
+        FakeRotation(int window, int display) {
+            this.window = window;
+            this.display = display;
+        }
+
+        @Override
+        public int window() {
+            return window;
+        }
+
+        @Override
+        public int display() {
+            return display;
+        }
+
+        @Override
+        public Runnable watch(Runnable onChange) {
+            this.onChange = onChange;
+            watches++;
+            return () -> unwatched++;
+        }
+    }
+}
