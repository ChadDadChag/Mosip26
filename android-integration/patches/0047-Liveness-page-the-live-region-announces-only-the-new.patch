+++ b/test/liveness/liveness_page_layout_test.dart
@@ -171,6 +171,36 @@ void main() {
     expect(tester.hasRunningAnimations, isFalse);
   });
 
+  // A landscape phone and a text scale of 2.0: the page scrolls, nothing overflows, the buttons stay on screen
+  // and the camera card keeps its compact size (the fixed layout is for portrait up to 1.3).
+  for (final screen in [...livenessScreens, ...livenessExtraScreens]) {
+    for (final compact in const [_Variant('landscape 640x360', 1.0), _Variant('360x640 at', 2.0)]) {
+      testWidgets('${screen.name}, compact: $compact', (tester) async {
+        final size = compact.textScale == 1.0 ? const Size(640, 360) : const Size(360, 640);
+        await showLivenessScreen(tester, screen, size, textScale: compact.textScale);
+        expect(tester.takeException(), isNull, reason: 'no overflow');
+        for (var i = 0; i < buttons.evaluate().length; i++) {
+          final r = tester.getRect(buttons.at(i));
+          expect(r.bottom, lessThanOrEqualTo(size.height));
+          expect(r.height, greaterThanOrEqualTo(LivenessStyle.buttonHeight));
+        }
+        expect(tester.getSize(find.byKey(const Key('liveness.camera'))).height,
+            moreOrLessEquals(LivenessStyle.compactCameraHeight, epsilon: 0.5));
+      });
+    }
+  }
+
+  testWidgets('during the status fade the live region holds only the new status', (tester) async {
+    final semantics = tester.ensureSemantics();
+    final service = await showLivenessScreen(tester, livenessScreens.first, const Size(360, 640));
+    service.emit(ev('CHALLENGE_PROMPT', challenge: 'BLINK', index: 1, count: 2));
+    await tester.pump();
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 50)); // mid-fade: the old status is still painted
+    expect(tester.getSemantics(find.byKey(const Key('liveness.status'))).label, 'Please blink');
+    semantics.dispose();
+  });
+
   testWidgets('the step bar: done steps full, the current one at least half', (tester) async {
     final service = await showLivenessScreen(tester, livenessScreens.first, const Size(360, 640));
     service.emit(ev('CHALLENGE_PROMPT', challenge: 'SMILE', index: 2, count: 3));
