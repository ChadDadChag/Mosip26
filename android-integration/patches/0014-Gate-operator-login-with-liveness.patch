From 4853515502c543fbc18f7d1b45e6188c951dcb96 Mon Sep 17 00:00:00 2001
From: Varun-iiitb <var3907@gmail.com>
Date: Sat, 24 Oct 2026 19:32:58 +0530
Subject: [PATCH 14/55] Gate operator login with liveness

login_page.dart _getLoginAction: after a successful password and the
centre/machine checks, before the first-sync or home branch,
LivenessGate.run(OPERATOR) (scope S1). Not proceeding logs the operator out
again (authProvider.logoutUser()), stops the syncing state and stays on the
login page; blocked also shows the localized failure text in a snackbar.
Liveness disabled for OPERATOR: the login continues as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/ui/login_page.dart | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/lib/ui/login_page.dart b/lib/ui/login_page.dart
index 9b33955..ee7574c 100644
--- a/lib/ui/login_page.dart
+++ b/lib/ui/login_page.dart
@@ -23,6 +23,8 @@ import 'package:registration_client/provider/auth_provider.dart';
 import 'package:registration_client/provider/sync_provider.dart';
 import 'package:registration_client/ui/dashboard/dashboard_tablet.dart';
 import 'package:registration_client/ui/liveness/liveness_debug_page.dart';
+import 'package:registration_client/ui/liveness/liveness_gate.dart';
+import 'package:registration_client/ui/liveness/liveness_strings.dart';
 import 'package:registration_client/ui/widgets/network_component.dart';
 import 'package:registration_client/ui/widgets/sync_alert_dialog.dart';
 import 'package:registration_client/utils/app_style.dart';
@@ -351,6 +353,22 @@ class _LoginPageState extends State<LoginPage> with WidgetsBindingObserver {
       return;
     }
 
+    // Face liveness of the operator after the password (scope S1, docs/ui-liveness-spec.md section 6).
+    // Not proceeding logs the operator out again and stays on the login page.
+    if (!mounted) return;
+    final liveness = await LivenessGate.run(context, workflow: LivenessGate.operator);
+    if (!liveness.proceed) {
+      await authProvider.logoutUser();
+      authProvider.setIsSyncing(false);
+      if (liveness.blocked) {
+        _showInSnackBar(livenessText(appLocalizations, liveness.failureMessageKey));
+      }
+      setState(() {
+        isLoggingIn = false;
+      });
+      return;
+    }
+
     log("machine active: ${authProvider.isMachineActive}");
 
     if (authProvider.isLoggedIn &&
