+    /** Diagnostics only: {@code MatcherBenchmark} on {@value #MATCHER_BENCH_FRAMES} frames held in memory. */
+    @Override
+    public void runMatcherBenchmark(@NonNull String camera, @NonNull LivenessPigeon.Result<String> result) {
+        if (!diagnostics(result)) return;
+        MainActivity activity = activityRef.get();
+        if (activity == null) {
+            result.error(new IllegalStateException("Activity not set"));
+            return;
+        }
+        captureFrames(camera, MATCHER_BENCH_FRAMES, frames -> {
+            File benchDir = activity.getExternalFilesDir(BENCH_BUNDLES);
+            String device = android.os.Build.MANUFACTURER + " " + android.os.Build.MODEL + ", Android "
+                    + android.os.Build.VERSION.RELEASE + ", " + BuildConfig.BUILD_TYPE + " build";
+            Thread t = new Thread(() -> {
+                String report;
+                try {
+                    report = holder.runMatcherBenchmark(frames, benchDir, device);
+                } catch (RuntimeException | LinkageError e) {
+                    report = "matcher benchmark failed: " + e;
+                } finally {
+                    frames.clear();
+                }
+                for (String line : report.split("\n")) Log.i(TAG, "matcher benchmark| " + line);
+                String text = report;
+                main.post(() -> {
+                    benchmarking = false;
+                    result.success(text);
+                });
+            }, "liveness-matcher-benchmark");
+            benchmarking = true;
+            t.start();
+        }, result::error);
+    }
+
+    /**
+     * Opens the camera (no preview), keeps {@code count} frames in memory, stops it and hands them to
+     * {@code onFrames} on the main thread; any problem goes to {@code onError}. Refused while a session or a benchmark
+     * runs, or without the camera permission.
+     */
+    private void captureFrames(String camera, int count, java.util.function.Consumer<List<Frame>> onFrames,
+                               java.util.function.Consumer<Throwable> onError) {
+        MainActivity activity = activityRef.get();
+        if (activity == null) {
+            onError.accept(new IllegalStateException("Activity not set"));
+            return;
+        }
+        if (session != null || benchmarking) {
+            onError.accept(new IllegalStateException("a session or a benchmark is running"));
+            return;
+        }
+        if (ContextCompat.checkSelfPermission(activity, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+            onError.accept(new IllegalStateException("camera permission not granted"));
+            return;
+        }
+        CameraSelector selector = "back".equalsIgnoreCase(camera)
+                ? CameraSelector.DEFAULT_BACK_CAMERA : CameraSelector.DEFAULT_FRONT_CAMERA;
+        CameraXFrameSource src = new CameraXFrameSource(activity, activity, selector, ANALYSIS_RESOLUTION, 1, null);
+        src.setExposureAssist(holder.exposureAssist());
+        List<Frame> frames = new ArrayList<>();
+        boolean[] done = {false};
+        benchmarking = true;
+        Runnable finish = () -> { // main thread
+            if (done[0]) return;
+            done[0] = true;
+            src.stop();
+            benchmarking = false;
+            if (frames.size() < count) {
+                int captured = frames.size();
+                frames.clear();
+                onError.accept(new IllegalStateException("captured only " + captured + " frames"));
+                return;
+            }
+            onFrames.accept(frames);
+        };
+        src.start(new FrameSource.Listener() {
+            @Override
+            public void onFrame(Frame frame) {
+                main.post(() -> {
+                    if (done[0]) return;
+                    frames.add(frame);
+                    if (frames.size() >= count) finish.run();
+                });
+            }
+
+            @Override
+            public void onError(ErrorCode code, String detail, boolean recoverable) {
+                Log.w(TAG, "still capture: " + code + " " + detail);
+                if (!recoverable) main.post(finish);
+            }
+        });
+        main.postDelayed(finish, BENCHMARK_CAPTURE_TIMEOUT_MS);
+    }
+
     private static boolean diagnostics(LivenessPigeon.Result<String> result) {
         if (BuildConfig.LIVENESS_DIAGNOSTICS) return true;
         result.error(new IllegalStateException("diagnostics builds only"));
