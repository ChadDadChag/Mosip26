+    /**
+     * Diagnostics only: one camera still (the {@value #STILL_FRAME}th frame, once exposure has settled), without
+     * liveness, as JPEG or JPEG 2000. In memory only; never logged.
+     */
+    @Override
+    public void captureStill(@NonNull String camera, @NonNull Boolean jp2, @NonNull LivenessPigeon.Result<byte[]> result) {
+        if (!BuildConfig.LIVENESS_DIAGNOSTICS) {
+            result.error(new IllegalStateException("diagnostics builds only"));
+            return;
+        }
+        captureFrames(camera, STILL_FRAME, frames -> holder.bindingWorker().execute(() -> {
+            Frame still = frames.get(frames.size() - 1);
+            frames.clear();
+            try {
+                byte[] bytes = jp2 ? BindingImages.jp2(still) : BestFrameEncoder.jpeg(still, BestFrameEncoder.QUALITY);
+                Log.i(TAG, "binding test: camera still captured (" + (jp2 ? "JPEG 2000" : "JPEG") + ", "
+                        + still.width() + "x" + still.height() + ")");
+                main.post(() -> result.success(bytes));
+            } catch (RuntimeException | LinkageError e) {
+                main.post(() -> result.error(new IllegalStateException("the still could not be encoded: " + e)));
+            }
+        }), result::error);
+    }
