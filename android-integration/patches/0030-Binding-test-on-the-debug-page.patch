+package io.mosip.registration.liveness.android;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+
+import io.mosip.registration.liveness.analyzer.AnalyzerConfig;
+import io.mosip.registration.liveness.analyzer.integrity.ClasspathBundleSource;
+import io.mosip.registration.liveness.api.Frame;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertThrows;
+import static org.junit.Assert.assertTrue;
+
+public class MatcherBenchmarkTest {
+
+    @Test
+    public void reportsTheTimingsAndTheOutcomeOnly() throws Exception {
+        FaceBinding.Rgb portrait = FaceBindingTest.png("/golden/portrait_frontal.png");
+        FaceBinding.Rgb mirrored = FaceBindingTest.mirror(portrait);
+        Frame a = new Frame(portrait.rgb, portrait.width, portrait.height, 0, 0, "test");
+        Frame b = new Frame(mirrored.rgb, mirrored.width, mirrored.height, 1, 1, "test");
+        byte[] grey = new byte[portrait.rgb.length];
+        Arrays.fill(grey, (byte) 128);
+        Frame none = new Frame(grey, portrait.width, portrait.height, 2, 2, "test"); // a camera still starting
+        java.util.List<AnalyzerBenchmark.Bundle> bundled =
+                Collections.singletonList(new AnalyzerBenchmark.Bundle("bundled", new ClasspathBundleSource()));
+        String report = MatcherBenchmark.run(Arrays.asList(none, a, none, b, none), bundled,
+                AnalyzerConfig.defaults(), "JVM test");
+        assertTrue(report, report.contains("bundled (pad-2026.10.5): two one-face frames MATCH"));
+        String noFaces = MatcherBenchmark.run(Arrays.asList(none, a, none), bundled, AnalyzerConfig.defaults(), "x");
+        assertTrue(noFaces, noFaces.contains("fewer than 2 frames with exactly one face"));
+        assertTrue(report, report.contains("preload (verify 5 files, 4 per-frame sessions)"));
+        assertTrue(report, report.contains("warmUpMatcher"));
+        assertTrue(report, report.contains("one face embed p50"));
+        assertFalse("no similarity in the report", report.contains("similarity"));
+        assertThrows(IllegalArgumentException.class, () -> MatcherBenchmark.run(Collections.singletonList(a),
+                Collections.emptyList(), AnalyzerConfig.defaults(), "x"));
+    }
+
+    @Test
+    public void medianOfEvenAndOddCounts() {
+        assertEquals(2.0, MatcherBenchmark.median(new double[] {3, 1, 2}), 0);
+        assertEquals(2.5, MatcherBenchmark.median(new double[] {4, 1, 2, 3}), 0);
+    }
+}
