+  /// Binding test, step 1: a real Resident face gate; its best frame stays held natively (5 minutes at most).
+  Future<void> _bindingGate() async {
+    setState(() {
+      _bindingBusy = true;
+      _bindingSession = null;
+      _bindingResult = null;
+    });
+    final gate = await LivenessGate.run(context,
+        workflow: LivenessGate.resident,
+        previewBuilder: _placeholder ? _placeholderPreview : null);
+    if (!mounted) return;
+    setState(() {
+      _bindingBusy = false;
+      _bindingSession = gate.proceed && !gate.disabled ? gate.sessionId : null;
+      _bindingResult = _bindingSession == null
+          ? 'gate ${gate.status.name}${gate.disabled ? ' (liveness disabled)' : ''}: no session to bind'
+          : 'Gate passed. Point the camera at the capture subject, then tap step 2.';
+      _addLog('binding test: $_bindingResult');
+    });
+    _toast(_bindingResult!);
+  }
+
+  /// Binding test, step 2: one camera still (standing in for the SBI capture) compared with the gate's best frame.
+  /// The still is held in this method only and never displayed.
+  Future<void> _bindingCapture() async {
+    final session = _bindingSession;
+    if (session == null) return;
+    setState(() {
+      _bindingBusy = true;
+      _bindingResult = 'Capturing the still (about 2 s), hold the camera steady…';
+    });
+    _toast(_bindingResult!);
+    String text;
+    try {
+      Uint8List? still = await _api.captureStill(_camera, _bindingJp2);
+      final info = await _api.bindCapturedFace(session, still);
+      still = null;
+      text = '${info.outcome}: similarity ${info.similarity.isNaN ? 'n/a' : info.similarity.toStringAsFixed(3)}'
+          ', threshold ${info.threshold.toStringAsFixed(2)} (${_bindingJp2 ? 'JPEG 2000' : 'JPEG'} still)';
+    } on PlatformException catch (e) {
+      text = 'binding test failed: ${e.message}';
+    }
+    if (!mounted) return;
+    setState(() {
+      _bindingBusy = false;
+      _bindingSession = null; // the native side dropped the best frame
+      _bindingResult = 'Result: $text. For the next case, start again with step 1.';
+      _addLog('binding test: $text');
+    });
+    _toast(_bindingResult!);
+  }
+
+  void _toast(String text) {
+    ScaffoldMessenger.maybeOf(context)
+      ?..hideCurrentSnackBar()
+      ..showSnackBar(SnackBar(content: Text(text), duration: const Duration(seconds: 6)));
+  }
