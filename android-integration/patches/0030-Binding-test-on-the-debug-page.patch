@@ -0,0 +1,140 @@
+package io.mosip.registration.liveness.android;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+
+import io.mosip.registration.liveness.analyzer.AnalyzerConfig;
+import io.mosip.registration.liveness.analyzer.OnnxFaceAnalyzerFactory;
+import io.mosip.registration.liveness.analyzer.integrity.TrustedKeys;
+import io.mosip.registration.liveness.analyzer.match.FaceMatcher;
+import io.mosip.registration.liveness.analyzer.match.MatchResult;
+import io.mosip.registration.liveness.api.Frame;
+
+/**
+ * On-device timing of face binding (F1; debug and profile builds only). For each bundle (the bundled one, then each
+ * signed test bundle, for example one with the int8 SFace):
+ * <ul>
+ *   <li>a fresh factory's {@code preload()}: verify the five files, build the four per-frame sessions;</li>
+ *   <li>the first comparison without a warm-up (it builds the MATCHER session), then warm comparisons and one-face
+ *       embeddings ({@value #RUNS} each, after 3 untimed);</li>
+ *   <li>on a second fresh factory: {@code warmUpMatcher()} (the MATCHER session alone), then the first comparison.</li>
+ * </ul>
+ * The frames are live camera frames the caller keeps in memory and drops afterwards; the last two that each hold
+ * exactly one face are compared (the same two for every bundle). The report holds timings and the outcome only: no
+ * similarity, image or feature.
+ */
+public final class MatcherBenchmark {
+
+    public static final int RUNS = 10;
+
+    private MatcherBenchmark() { }
+
+    public static String run(List<Frame> frames, List<AnalyzerBenchmark.Bundle> bundles, AnalyzerConfig config,
+                             String device) {
+        if (frames == null || frames.size() < 2) throw new IllegalArgumentException("need at least 2 frames");
+        if (bundles == null || bundles.isEmpty()) throw new IllegalArgumentException("no bundle");
+        StringBuilder sb = new StringBuilder();
+        sb.append("Face binding (F1) timings, ").append(device).append(", ").append(frames.size())
+                .append(" frames; times in ms\n");
+        Frame[] pair;
+        try {
+            pair = pick(frames, bundles.get(0), config);
+        } catch (Exception | LinkageError e) {
+            return sb.append("frame selection failed: ").append(e).append('\n').toString();
+        }
+        if (pair == null) {
+            return sb.append("fewer than 2 frames with exactly one face: keep the face in view and run again\n")
+                    .toString();
+        }
+        Frame a = pair[0], b = pair[1];
+        for (AnalyzerBenchmark.Bundle bundle : bundles) {
+            try {
+                sb.append(one(bundle, a, b, config));
+            } catch (Exception | LinkageError e) {
+                sb.append(bundle.label).append(": failed: ").append(e).append('\n');
+            }
+        }
+        return sb.toString();
+    }
+
+    /**
+     * The last two frames that each hold exactly one face (the first frames can be dark while the camera starts),
+     * found with a separate factory on the first bundle; null when there are fewer than two.
+     */
+    static Frame[] pick(List<Frame> frames, AnalyzerBenchmark.Bundle bundle, AnalyzerConfig config) throws Exception {
+        Frame later = null;
+        try (OnnxFaceAnalyzerFactory f = new OnnxFaceAnalyzerFactory(bundle.source, null, TrustedKeys.builtIn(), config);
+             FaceMatcher m = f.createMatcher()) {
+            for (int i = frames.size() - 1; i >= 0; i--) {
+                Frame fr = frames.get(i);
+                if (m.featureOfSingleFace(fr.rgb(), fr.width(), fr.height()) == null) continue;
+                if (later == null) {
+                    later = fr;
+                } else {
+                    return new Frame[] {fr, later};
+                }
+            }
+        }
+        return null;
+    }
+
+    private static String one(AnalyzerBenchmark.Bundle bundle, Frame a, Frame b, AnalyzerConfig config) throws Exception {
+        String version;
+        double preloadMs, coldMs, compareMs, embedP50, warmUpMs, afterWarmUpMs;
+        MatchResult.Outcome outcome;
+        long t0 = System.nanoTime();
+        try (OnnxFaceAnalyzerFactory f = new OnnxFaceAnalyzerFactory(bundle.source, null, TrustedKeys.builtIn(), config)) {
+            f.preload();
+            preloadMs = ms(t0);
+            version = f.modelVersion();
+            try (FaceMatcher m = f.createMatcher()) {
+                long c0 = System.nanoTime();
+                outcome = m.compare(a, b).outcome;
+                coldMs = ms(c0);
+                for (int i = 0; i < 3; i++) m.compare(a, b);
+                long w0 = System.nanoTime();
+                for (int i = 0; i < RUNS; i++) m.compare(a, b);
+                compareMs = ms(w0) / RUNS;
+                double[] embed = new double[RUNS];
+                for (int i = 0; i < RUNS; i++) {
+                    long e0 = System.nanoTime();
+                    m.featureOfSingleFace(a.rgb(), a.width(), a.height());
+                    embed[i] = ms(e0);
+                }
+                embedP50 = median(embed);
+            }
+        }
+        try (OnnxFaceAnalyzerFactory f = new OnnxFaceAnalyzerFactory(bundle.source, null, TrustedKeys.builtIn(), config)) {
+            f.preload();
+            long u0 = System.nanoTime();
+            f.warmUpMatcher();
+            warmUpMs = ms(u0);
+            try (FaceMatcher m = f.createMatcher()) {
+                long c0 = System.nanoTime();
+                m.compare(a, b);
+                afterWarmUpMs = ms(c0);
+            }
+        }
+        List<String> lines = new ArrayList<>();
+        lines.add(String.format(Locale.ROOT, "%s (%s): two one-face frames %s", bundle.label, version, outcome));
+        lines.add(String.format(Locale.ROOT, "  preload (verify 5 files, 4 per-frame sessions) %.0f", preloadMs));
+        lines.add(String.format(Locale.ROOT, "  first comparison without warm-up (builds the MATCHER session) %.0f", coldMs));
+        lines.add(String.format(Locale.ROOT, "  warmUpMatcher %.0f, then first comparison %.0f", warmUpMs, afterWarmUpMs));
+        lines.add(String.format(Locale.ROOT, "  comparison warm %.1f (mean of %d); one face embed p50 %.1f", compareMs, RUNS,
+                embedP50));
+        return String.join("\n", lines) + "\n";
+    }
+
+    private static double ms(long since) {
+        return (System.nanoTime() - since) / 1e6;
+    }
+
+    static double median(double[] v) {
+        double[] s = v.clone();
+        Arrays.sort(s);
+        int n = s.length;
+        return n % 2 == 1 ? s[n / 2] : (s[n / 2 - 1] + s[n / 2]) / 2;
+    }
+}
