+    }
+    if (!mounted) return;
+    setState(() {
+      _bindingBusy = false;
+      _matcherReport = report;
+      _addLog('matcher benchmark finished');
+    });
+    _toast('Matcher benchmark finished: the report is in the Face binding card');
+  }
