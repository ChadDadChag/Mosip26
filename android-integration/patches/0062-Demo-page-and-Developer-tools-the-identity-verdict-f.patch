+  /// The models load in the background, at start and again after an install or a rollback, and their version reads
+  /// '' until then. A bundle that fails verification never loads, and nothing else tells this page: the version is
+  /// read again every 2 s, and after 30 s the page says the models did not load.
+  void _watchModels() {
+    _modelPoll?.cancel();
+    _modelPoll = null;
+    if (_modelVersion.isNotEmpty) return;
+    var polls = 0;
+    _modelPoll = Timer.periodic(_modelPollEvery, (timer) async {
+      polls++;
+      final last = polls >= _modelPolls;
+      if (last) timer.cancel();
+      String version = '';
+      try {
+        version = await _service.modelVersion();
+      } on PlatformException catch (e) {
+        debugPrint('liveness demo: model version failed: ${e.message}');
+      }
+      if (!mounted || _modelPoll != timer) return;
+      if (version.isNotEmpty) timer.cancel();
+      setState(() {
+        _modelVersion = version;
+        _modelsNotLoaded = version.isEmpty && last;
+      });
+    });
+  }
