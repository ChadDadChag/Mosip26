new file mode 100644
index 0000000..d8e92ed
--- /dev/null
+++ b/test/liveness/liveness_page_layout_test.dart
@@ -0,0 +1,127 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:registration_client/ui/liveness/liveness_page.dart';
+import 'package:registration_client/ui/liveness/liveness_strings.dart';
+import 'package:registration_client/ui/liveness/liveness_style.dart';
+
+import 'fake_liveness_service.dart';
+import 'liveness_screens.dart';
+import 'liveness_test_fonts.dart';
+
+class _Variant {
+  const _Variant(this.lang, this.textScale);
+
+  final String lang;
+  final double textScale;
+
+  @override
+  String toString() => textScale == 1.0 ? lang : '$lang ${textScale}x';
+}
+
+/// docs/ui-liveness-spec.md §9 on phones: every state fits 360x640 and 412x915
+/// (logical) without scrolling, the buttons are always on screen, a failed attempt
+/// shows one attempts line, and the state badge sits on the oval's top centre;
+/// also in Arabic (right to left) and at 1.3x text, where only the tips may scroll.
+void main() {
+  setUpAll(loadLivenessTestFonts);
+
+  const sizes = [Size(360, 640), Size(412, 915)];
+  const variants = [_Variant('en', 1.0), _Variant('ar', 1.0), _Variant('en', 1.3)];
+  final status = find.byKey(const Key('liveness.status'));
+  final tips = find.byKey(const Key('liveness.tips'));
+  final buttons = find.byWidgetPredicate((w) => w is ElevatedButton || w is OutlinedButton);
+
+  for (final screen in [...livenessScreens, ...livenessExtraScreens]) {
+    for (final size in sizes) {
+      for (final v in variants) {
+        testWidgets('${screen.name} at ${size.width.toInt()}x${size.height.toInt()}, $v', (tester) async {
+          await showLivenessScreen(tester, screen, size, lang: v.lang, textScale: v.textScale);
+          expect(tester.takeException(), isNull, reason: 'no overflow');
+          final l = AppLocalizations.of(tester.element(find.byType(LivenessPage)))!;
+          final hasTips = tips.evaluate().isNotEmpty;
+
+          // Nothing scrolls but the tips; the buttons are on screen, 48 high.
+          expect(find.byType(Scrollable), hasTips ? findsOneWidget : findsNothing);
+          if (hasTips) expect(find.descendant(of: tips, matching: find.byType(Scrollable)), findsOneWidget);
+          for (var i = 0; i < buttons.evaluate().length; i++) {
+            final r = tester.getRect(buttons.at(i));
+            expect(r.top, greaterThanOrEqualTo(0));
+            expect(r.bottom, lessThanOrEqualTo(size.height));
+            expect(r.height, greaterThanOrEqualTo(LivenessStyle.buttonHeight));
+          }
+
+          // The camera card keeps 3:4 and a useful size; the badge is on the oval's top centre, inside the card.
+          final camera = tester.getRect(find.byKey(const Key('liveness.camera')));
+          final badge = tester.getRect(find.byKey(const Key('liveness.badge')));
+          expect(camera.width / camera.height, moreOrLessEquals(3 / 4, epsilon: 0.01));
+          expect(camera.height, greaterThanOrEqualTo(size.height * (hasTips ? 0.15 : 0.30)),
+              reason: 'camera card ${camera.size}');
+          expect(badge.center.dx, moreOrLessEquals(camera.center.dx, epsilon: 0.5));
+          expect(badge.center.dy, moreOrLessEquals(camera.top + camera.height * 0.14, epsilon: 0.5));
+          expect(badge.top, greaterThanOrEqualTo(camera.top));
+          expect(badge.size, const Size(LivenessStyle.badge, LivenessStyle.badge));
+
+          // English at 1x: the status takes at most 2 lines.
+          final statusText = find.descendant(of: status, matching: find.byType(Text));
+          if (v.lang == 'en' && v.textScale == 1.0) {
+            expect(tester.getSize(statusText).height, lessThanOrEqualTo(2 * 20 * 1.25 + 0.5));
+          }
+
+          // After a failed attempt: the attempts left, never "Attempt a of m" as well.
+          if (screen.events.any((e) => e['type'] == 'ATTEMPT_FAILED')) {
+            expect(find.text(livenessText(l, 'liveness.retry.attempts_left', n: 3)), findsOneWidget);
+            expect(find.text(livenessText(l, 'liveness.progress.attempt', a: 1, m: 4)), findsNothing);
+          }
+
+          // Right to left: the status icon right of its text, the step label right of the bar,
+          // the first button (Retry or Close) right of the second.
+          if (v.lang == 'ar') {
+            final icon = find.descendant(of: status, matching: find.byType(Icon));
+            expect(tester.getCenter(icon).dx, greaterThan(tester.getCenter(statusText).dx));
+            final steps = screen.events.where((e) => (e['challengeCount'] as int? ?? 0) > 0);
+            if (steps.isNotEmpty) {
+              final step = find.text(livenessText(l, 'liveness.progress.step',
+                  i: steps.last['challengeIndex'] as int, n: steps.last['challengeCount'] as int));
+              expect(tester.getCenter(step).dx, greaterThan(tester.getCenter(find.byType(LivenessStepBar)).dx));
+            }
+            if (buttons.evaluate().length > 1) {
+              expect(tester.getCenter(buttons.at(0)).dx, greaterThan(tester.getCenter(buttons.at(1)).dx));
+            }
+          }
+        });
+      }
+    }
+  }
+
+  testWidgets('the status cross-fades in 200 ms; the progress row does not animate', (tester) async {
+    final service = await showLivenessScreen(tester, livenessScreens.first, const Size(360, 640));
+    service.emit(ev('CHALLENGE_PROMPT', challenge: 'BLINK', index: 1, count: 2));
+    await tester.pump(); // delivers the event
+    await tester.pump(); // draws it: the fade starts
+    await tester.pump(const Duration(milliseconds: 100));
+    expect(find.text('Checking face liveness…'), findsOneWidget, reason: 'fading out');
+    expect(find.text('Please blink'), findsOneWidget);
+    await tester.pump(const Duration(milliseconds: 150));
+    await tester.pump(); // the finished fade removes the old status
+    expect(find.text('Checking face liveness…'), findsNothing);
+    expect(tester.hasRunningAnimations, isFalse);
+  });
+
+  testWidgets('the step bar: done steps full, the current one at least half', (tester) async {
+    final service = await showLivenessScreen(tester, livenessScreens.first, const Size(360, 640));
+    service.emit(ev('CHALLENGE_PROMPT', challenge: 'SMILE', index: 2, count: 3));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 300));
+    List<double> fills() => tester
+        .widgetList<FractionallySizedBox>(
+            find.descendant(of: find.byType(LivenessStepBar), matching: find.byType(FractionallySizedBox)))
+        .map((b) => b.widthFactor!)
+        .toList();
+    expect(fills(), [1.0, 0.5, 0.0]);
+    service.emit(ev('CHALLENGE_PROGRESS', challenge: 'SMILE', index: 2, count: 3, progress: 0.8));
+    await tester.pump();
+    await tester.pump();
+    expect(fills(), [1.0, 0.8, 0.0]);
+  });
+}
