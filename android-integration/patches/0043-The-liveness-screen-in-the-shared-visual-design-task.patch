+import 'dart:io';
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import 'liveness_screens.dart';
+import 'liveness_test_fonts.dart';
+
+/// The documentation screenshots (docs/images/android): every state from the fake
+/// engine's events, with the placeholder instead of a camera, so no face or
+/// personal data can appear. 360x740 logical at 1.5x (540x1110 px), as before.
+///
+///   LIVENESS_SCREENSHOTS=<dir> flutter test test/liveness/liveness_screenshots_test.dart
+///
+/// Skipped without LIVENESS_SCREENSHOTS.
+void main() {
+  final out = Platform.environment['LIVENESS_SCREENSHOTS'];
+  const root = Key('screenshot');
+
+  setUpAll(() async {
+    if (out != null && !await loadLivenessTestFonts()) fail('Roboto not found in the Flutter SDK');
+  });
+
+  for (final screen in livenessScreens) {
+    testWidgets(screen.name, (tester) async {
+      debugDisableShadows = false; // flutter_test draws shadows as solid lines; back on below
+      await showLivenessScreen(tester, screen, const Size(360, 740), devicePixelRatio: 1.5, rootKey: root);
+      if (screen.scrollTips) {
+        final tips = find.descendant(of: find.byKey(const Key('liveness.tips')), matching: find.byType(Scrollable));
+        final position = tester.state<ScrollableState>(tips).position;
+        position.jumpTo(position.maxScrollExtent);
+        await tester.pump();
+      }
+      expect(tester.takeException(), isNull);
+      await tester.runAsync(() async {
+        final boundary = tester.renderObject<RenderRepaintBoundary>(find.byKey(root));
+        final image = await boundary.toImage(pixelRatio: 1.5);
+        final png = await image.toByteData(format: ui.ImageByteFormat.png);
+        File('$out/${screen.name}.png').writeAsBytesSync(png!.buffer.asUint8List());
+      });
+      debugDisableShadows = true;
+    }, skip: out == null);
+  }
+}
