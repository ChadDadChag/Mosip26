@@ -0,0 +1,129 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+import 'package:registration_client/ui/liveness/liveness_page.dart';
+import 'package:registration_client/ui/liveness/liveness_style.dart';
+
+import 'fake_liveness_service.dart';
+
+/// Shows [screen] as the app does: pushed over another page (the app bar's back
+/// arrow), in the app's primary colour, after the fake engine's events and the
+/// status fade.
+Future<FakeLivenessService> showLivenessScreen(WidgetTester tester, LivenessScreen screen, Size size,
+    {String lang = 'en', double? textScale, double devicePixelRatio = 3, Key? rootKey}) async {
+  tester.view.physicalSize = size * devicePixelRatio;
+  tester.view.devicePixelRatio = devicePixelRatio;
+  addTearDown(tester.view.reset);
+  final service = FakeLivenessService()..permission = screen.permission;
+  final fake = screen.permission == CameraPermission.granted;
+  final page = LivenessPage(
+    workflow: screen.workflow,
+    service: service,
+    useFake: fake,
+    showDebugInfo: false,
+    previewBuilder: fake ? null : () => const LivenessPlaceholderPreview(),
+  );
+  await tester.pumpWidget(RepaintBoundary(
+    key: rootKey,
+    child: MaterialApp(
+      debugShowCheckedModeBanner: false,
+      locale: Locale(lang),
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      theme: ThemeData(colorScheme: const ColorScheme.light(primary: LivenessStyle.primary)),
+      builder: (context, child) => MediaQuery(
+        data: MediaQuery.of(context).copyWith(textScaleFactor: textScale ?? screen.textScale),
+        child: child!,
+      ),
+      onGenerateRoute: (_) => MaterialPageRoute<void>(builder: (_) => const SizedBox()),
+      onGenerateInitialRoutes: (_) => [
+        MaterialPageRoute<void>(builder: (_) => const SizedBox()),
+        MaterialPageRoute<void>(builder: (_) => page),
+      ],
+    ),
+  ));
+  await tester.pump();
+  await tester.pump(const Duration(milliseconds: 400)); // the start-up calls
+  for (final m in screen.events) {
+    service.emit(m);
+    await tester.pump();
+    await tester.pump();
+  }
+  await tester.pump(LivenessStyle.statusFade + const Duration(milliseconds: 50));
+  return service;
+}
+
+/// One state of the liveness screen, reached by the fake engine's events.
+class LivenessScreen {
+  const LivenessScreen(this.name, this.events,
+      {this.workflow = 'RESIDENT',
+      this.permission = CameraPermission.granted,
+      this.textScale = 1.0,
+      this.scrollTips = false});
+
+  /// The screenshot's file name in docs/images/android, without .png.
+  final String name;
+  final List<Map<String, Object?>> events;
+  final String workflow;
+  final CameraPermission permission;
+  final double textScale;
+
+  /// Scroll the tips to their end (the 1.3x screenshot).
+  final bool scrollTips;
+}
+
+final Map<String, Object?> _notVerified =
+    ev('ATTEMPT_FAILED', error: 'CHALLENGE_TIMEOUT', userMessage: 'LIVENESS_NOT_VERIFIED', retriesLeft: 3);
+
+Map<String, Object?> _maxAttempts(int attempt) => ev('FAILED_FINAL',
+    attempt: attempt, error: 'MAX_RETRIES_EXCEEDED', userMessage: 'MAX_ATTEMPTS_REACHED', recoverable: false);
+
+final Map<String, Object?> _failedComplete =
+    complete('FAILED', failureCode: 'MAX_RETRIES_EXCEEDED', userMessage: 'MAX_ATTEMPTS_REACHED');
+
+/// The states of docs/images/android/README.md, in its order.
+final List<LivenessScreen> livenessScreens = [
+  LivenessScreen('01-checking', [ev('STARTED'), ev('CHECKING_PASSIVE')]),
+  LivenessScreen('02-challenge-blink', [ev('CHALLENGE_PROMPT', challenge: 'BLINK', index: 2, count: 2)]),
+  LivenessScreen('03-challenge-smile', [ev('CHALLENGE_PROMPT', challenge: 'SMILE', index: 1, count: 2)]),
+  LivenessScreen('04-challenge-turn-left', [ev('CHALLENGE_PROMPT', challenge: 'TURN_LEFT', index: 1, count: 2)]),
+  LivenessScreen('05-challenge-progress', [
+    ev('CHALLENGE_PROMPT', challenge: 'TURN_LEFT', index: 1, count: 2),
+    ev('CHALLENGE_PROGRESS', challenge: 'TURN_LEFT', index: 1, count: 2, progress: 0.7),
+  ]),
+  LivenessScreen('06-action-detected', [
+    ev('CHALLENGE_PROMPT', challenge: 'BLINK', index: 1, count: 2),
+    ev('ACTION_DETECTED', challenge: 'BLINK', index: 1, count: 2),
+  ]),
+  LivenessScreen('07-hold-still', [ev('HOLD_STILL')]),
+  LivenessScreen('08-passed', [ev('PASSED')]),
+  LivenessScreen('09-attempt-failed-tips', [_notVerified]),
+  LivenessScreen('10-attempt-failed-tips-buttons', [_notVerified], textScale: 1.3, scrollTips: true),
+  LivenessScreen('11-pad-generic', [
+    ev('ATTEMPT_FAILED', error: 'PAD_FAILURE', userMessage: 'VERIFICATION_NOT_COMPLETED', retriesLeft: 3),
+  ]),
+  LivenessScreen('12-guidance-no-face', [ev('CHECKING_PASSIVE'), ev('GUIDANCE', guidance: 'NO_FACE')]),
+  LivenessScreen(
+      '13-guidance-multiple-faces', [ev('CHECKING_PASSIVE'), ev('GUIDANCE', guidance: 'MULTIPLE_FACES')]),
+  LivenessScreen(
+      '14-guidance-improve-lighting', [ev('CHECKING_PASSIVE'), ev('GUIDANCE', guidance: 'IMPROVE_LIGHTING')]),
+  LivenessScreen('15-device-error-recoverable', [
+    ev('DEVICE_ERROR', error: 'DEVICE_DISCONNECTED', userMessage: 'DEVICE_PROBLEM', retriesLeft: 3),
+  ]),
+  LivenessScreen('16-device-failure-final', [
+    ev('FAILED_FINAL', error: 'DEVICE_FAILURE', userMessage: 'DEVICE_PROBLEM', recoverable: false),
+    complete('FAILED', failureCode: 'DEVICE_FAILURE', userMessage: 'DEVICE_PROBLEM'),
+  ]),
+  LivenessScreen('17-max-attempts-resident', [_maxAttempts(4), _failedComplete]),
+  LivenessScreen('18-max-attempts-operator', [_maxAttempts(4), _failedComplete], workflow: 'OPERATOR'),
+  LivenessScreen('19-max-attempts-supervisor', [_maxAttempts(4), _failedComplete], workflow: 'SUPERVISOR'),
+  LivenessScreen('20-operator-cooldown-refusal', [_maxAttempts(1), _failedComplete], workflow: 'OPERATOR'),
+];
+
+/// States the screenshots leave out, for the layout tests.
+final List<LivenessScreen> livenessExtraScreens = [
+  LivenessScreen('starting', [ev('STARTED')]),
+  LivenessScreen('hold-still-look-at-camera', [ev('HOLD_STILL'), ev('GUIDANCE', guidance: 'LOOK_AT_CAMERA')]),
+  const LivenessScreen('camera-refused-permanently', [], permission: CameraPermission.permanentlyDenied),
+];
