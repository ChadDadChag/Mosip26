+import 'package:flutter/material.dart';
+
+/// The liveness screen's design tokens (docs/ui-liveness-spec.md §9, "Visual
+/// design"). The Desktop client's liveness.css uses the same values.
+class LivenessStyle {
+  LivenessStyle._();
+
+  // State colours. Contrast ratios are against white unless noted.
+  /// Checking and guidance, done steps, primary buttons: the app bar's blue (8.9:1).
+  static const Color primary = Color(0xFF1C43A1);
+  /// Challenges. The badge glyph on it is [onChallenge] (6.3:1); white would be 2.6:1.
+  static const Color challenge = Color(0xFFE8890C);
+  static const Color onChallenge = Color(0xFF1F1F1F);
+  /// Passed and action detected (5.1:1).
+  static const Color success = Color(0xFF2E7D32);
+  /// Failure, PAD and device errors (5.0:1).
+  static const Color failure = Color(0xFFD32F2F);
+  /// Starting (6.2:1).
+  static const Color neutral = Color(0xFF616161);
+
+  static const Color background = Color(0xFFFFFFFF);
+  static const Color textPrimary = Color(0xFF212121); // 16:1
+  static const Color textSecondary = Color(0xFF616161); // grey-700, 6.2:1 (5.7:1 on the tips card)
+  static const Color warningIcon = Color(0xFFB26A00); // 4.2:1
+  static const Color track = Color(0xFFE0E0E0);
+  static const Color tipsBackground = Color(0xFFF5F5F5);
+  static const Color scrim = Color(0x66000000); // 40 % outside the oval
+
+  // Layout.
+  static const double maxContentWidth = 560;
+  static const double gutter = 16;
+  static const double cameraRadius = 16;
+  /// The camera card's height as a share of the screen's; it shrinks when space runs out (the tips).
+  static const double cameraShare = 0.45;
+  /// The tips card's most, as a share of the content area; beyond it the tips scroll.
+  static const double tipsMaxShare = 0.40;
+  static const double ovalStroke = 4;
+  static const double badge = 28;
+  static const double badgeIcon = 18;
+  static const double statusRadius = 12;
+  static const double statusMinHeight = 80;
+  static const double segmentHeight = 6;
+  static const double segmentGap = 4;
+  static const double buttonHeight = 48;
+  static const double buttonRadius = 12;
+  static const double buttonGap = 12;
+
+  // Type (the platform family, Roboto on Android).
+  /// 20 sp, stepping down to [statusMinSize] where 20 would need a third line.
+  static const TextStyle status =
+      TextStyle(fontSize: 20, fontWeight: FontWeight.w600, height: 1.25, color: textPrimary);
+  static const double statusMinSize = 16;
+  static const TextStyle body = TextStyle(fontSize: 15, fontWeight: FontWeight.w400, color: textSecondary);
+  static const TextStyle tips = TextStyle(fontSize: 14, fontWeight: FontWeight.w400, color: textPrimary);
+  static const TextStyle caption = TextStyle(fontSize: 13, fontWeight: FontWeight.w400, color: textSecondary);
+  static const TextStyle button = TextStyle(fontSize: 15, fontWeight: FontWeight.w600);
+
+  // Motion: a cross-fade when the status changes, nothing else.
+  static const Duration statusFade = Duration(milliseconds: 200);
+}
