@@ -0,0 +1,32 @@
+import 'dart:io';
+
+import 'package:flutter/services.dart';
+
+/// Loads Roboto (the Flutter SDK's copy) and the Material icons, so layout tests
+/// and screenshots measure real text instead of the 1-em-per-glyph test font.
+/// Returns false when the SDK's fonts cannot be found; the test font stays then.
+Future<bool> loadLivenessTestFonts() async {
+  final icons = FontLoader('MaterialIcons')..addFont(rootBundle.load('fonts/MaterialIcons-Regular.otf'));
+  await icons.load();
+  final dir = _materialFonts();
+  if (dir == null) return false;
+  final roboto = FontLoader('Roboto');
+  for (final weight in ['regular', 'medium', 'bold']) {
+    final bytes = File('${dir.path}/roboto-$weight.ttf').readAsBytesSync();
+    roboto.addFont(Future.value(bytes.buffer.asByteData(bytes.offsetInBytes, bytes.lengthInBytes)));
+  }
+  await roboto.load();
+  return true;
+}
+
+/// flutter_tester runs from <sdk>/bin/cache/artifacts/engine/<platform>/; the fonts
+/// are in <sdk>/bin/cache/artifacts/material_fonts.
+Directory? _materialFonts() {
+  var dir = File(Platform.resolvedExecutable).parent;
+  for (var i = 0; i < 5; i++) {
+    final fonts = Directory('${dir.path}/material_fonts');
+    if (File('${fonts.path}/roboto-regular.ttf').existsSync()) return fonts;
+    dir = dir.parent;
+  }
+  return null;
+}
