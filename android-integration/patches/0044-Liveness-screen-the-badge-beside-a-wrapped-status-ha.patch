+/// The laid-out lines of a paragraph, top to bottom, in global coordinates: the
+/// extent of their visible characters (a line's trailing space at a wrap is left out).
+List<Rect> textLines(WidgetTester tester, Finder richText) {
+  final p = tester.renderObject<RenderParagraph>(richText);
+  final boxes = [
+    for (final word in RegExp(r'\S+').allMatches(p.text.toPlainText()))
+      ...p.getBoxesForSelection(TextSelection(baseOffset: word.start, extentOffset: word.end)),
+  ]..sort((a, b) => a.top.compareTo(b.top));
+  final lines = <Rect>[];
+  for (final box in boxes) {
+    final r = box.toRect();
+    if (lines.isNotEmpty && r.center.dy < lines.last.bottom) {
+      lines.last = lines.last.expandToInclude(r);
+    } else {
+      lines.add(r);
+    }
+  }
+  final origin = p.localToGlobal(Offset.zero);
+  return lines.map((r) => r.shift(origin)).toList();
+}
