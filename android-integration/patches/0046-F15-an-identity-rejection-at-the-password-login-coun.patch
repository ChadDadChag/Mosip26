+    /** The operator's password login: the gate whose rejections count as failed logins. */
+    public static final String PASSWORD_LOGIN = "password_login";
+
+    /**
+     * Whether a check counts as a failed login: a rejection on the first attempt of the password login. It counts
+     * once per login, also when the retry is then cancelled or rejected again, so a person who has the password
+     * cannot probe faces without the login lockout seeing it (as on Desktop, where a rejection is a failed login).
+     */
+    public static boolean countsAsFailedLogin(String gate, int attempt, boolean accepted) {
+        return PASSWORD_LOGIN.equals(gate) && attempt == 1 && !accepted;
+    }
