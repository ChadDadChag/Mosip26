+            LivenessPigeon.IdentityCheckInfo info;
+            try {
+                IdentityBinding.Result r = holder.verifyIdentity(sessionId, userId, gate, attempt.intValue());
+                Log.i(TAG, "identity binding " + r + " for session " + sessionId + " (" + gate + ", attempt " + attempt + ")");
+                info = new LivenessPigeon.IdentityCheckInfo.Builder()
+                        .setOutcome(r.outcome).setAccepted(r.accepted).setRetryable(r.retryable)
+                        .setSimilarity(BuildConfig.LIVENESS_DIAGNOSTICS ? r.similarity : Double.NaN)
+                        .setThreshold(r.threshold).build();
+            } catch (Throwable t) {
+                // An Error (out of memory on a bad template) must refuse the gate, not leave it waiting.
+                Log.e(TAG, "identity binding failed: " + t.getClass().getSimpleName());
+                info = new LivenessPigeon.IdentityCheckInfo.Builder()
+                        .setOutcome("ERROR").setAccepted(false).setRetryable(false)
+                        .setSimilarity(Double.NaN).setThreshold(Double.NaN).build();
+            }
+            if (IdentityBinding.countsAsFailedLogin(gate, attempt.intValue(), info.getAccepted())) {
+                try {
+                    loginService.recordFailedLoginAttempt(userId);
+                } catch (RuntimeException e) {
+                    Log.e(TAG, "failed login not recorded: " + e.getClass().getSimpleName());
+                }
+            }
+            final LivenessPigeon.IdentityCheckInfo answer = info;
+            main.post(() -> result.success(answer));
         });
     }
 
