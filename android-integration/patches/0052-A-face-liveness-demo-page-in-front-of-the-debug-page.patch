+                  const SizedBox(width: 6),
+                  Flexible(
+                    child: Text(
+                      // A version is shown only once its signed bundle has been verified and loaded.
+                      _modelVersion.isEmpty ? 'Models loading…' : 'Models $_modelVersion · signed',
+                      style: _Demo.chip,
+                    ),
+                  ),
+                ],
+              ),
+            ),
+          ],
+        )),
+      );
+
+  Widget _section(String? title, String? caption, List<Widget> children) => _width(Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          const SizedBox(height: 28),
+          if (title != null) ...[
+            Text(title, style: _Demo.title),
+            if (caption != null) ...[
+              const SizedBox(height: 4),
