+
+  /// The last real check: a sentence and its numbers, never an image.
+  Widget _resultPanel() {
+    final run = _lastRun;
+    final result = _lastResult;
+    Widget content;
+    if (run == null) {
+      content = const _ResultRow(
+        icon: Icons.play_circle_outline,
+        tone: LivenessStyle.neutral,
+        sentence: 'No check yet',
+        message: 'Tap a check above. Its result shows here.',
+      );
+    } else if (_running || result == null) {
+      content = _ResultRow(
+        icon: Icons.hourglass_top,
+        tone: LivenessStyle.primary,
+        sentence: 'Checking…',
+        message: run.title,
+      );
+    } else {
+      final outcome = result.outcome;
+      final en = lookupAppLocalizations(const Locale('en'));
+      final seconds = outcome == null ? null : (outcome.durationMs / 1000).toStringAsFixed(1);
+      final attempts = outcome == null ? 0 : outcome.attempts;
+      final detail = seconds == null
+          ? run.title
+          : '${run.title} · $seconds s · $attempts ${attempts == 1 ? 'attempt' : 'attempts'}';
+      if (result.disabled) {
+        content = _ResultRow(
+          icon: Icons.toggle_off_outlined,
+          tone: LivenessStyle.neutral,
+          sentence: 'Liveness is off for this step',
+          message: 'The policy turns the face check off here; the step goes ahead without it.',
+          detail: run.title,
+        );
+      } else if (result.proceed) {
+        final n = _actions[outcome?.sessionId ?? ''];
+        content = _ResultRow(
+          icon: Icons.check_circle,
+          tone: LivenessStyle.success,
+          sentence: outcome?.passPath == 'PASSIVE_ONLY'
+              ? 'Passed – no action needed'
+              : n == null
+                  ? 'Passed after actions'
+                  : 'Passed after $n ${n == 1 ? 'action' : 'actions'}',
+          message: livenessText(en, 'liveness.status.passed'),
+          detail: detail,
+        );
+      } else if (result.cancelled) {
+        content = _ResultRow(
+          icon: Icons.remove_circle_outline,
+          tone: LivenessStyle.neutral,
+          sentence: 'Cancelled',
+          message: 'The check was closed before it finished.',
+          detail: detail,
+        );
+      } else {
+        final code = outcome?.userMessage;
+        content = _ResultRow(
+          icon: Icons.cancel,
+          tone: LivenessStyle.failure,
+          sentence: 'Not verified',
+          message: livenessText(
+              en,
+              code == null || code == 'NONE'
+                  ? 'liveness.error.verification_not_completed'
+                  : 'liveness.error.${code.toLowerCase()}'),
+          detail: detail,
+        );
+      }
+    }
+    return _DemoCard(key: const Key('demo.result'), child: content);
+  }
