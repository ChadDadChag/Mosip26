+        ],
+      ));
+
+  Widget _runCard(_Run run) => _DemoCard(
+        key: Key('demo.run.${run.workflow}'),
+        onTap: _busy ? null : () => _runCheck(run),
+        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 18),
+        child: Row(
+          children: [
+            _IconBadge(run.icon),
+            const SizedBox(width: 16),
+            Expanded(
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Text(run.title, style: _Demo.cardTitle),
+                  const SizedBox(height: 2),
+                  Text(run.line, style: _Demo.secondary),
