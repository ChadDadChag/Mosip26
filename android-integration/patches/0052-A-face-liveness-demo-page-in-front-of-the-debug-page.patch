+import 'package:flutter/foundation.dart' show visibleForTesting;
+import 'package:registration_client/platform_spi/liveness_service.dart';
+
+/// Debug and profile builds: the config overrides this app process has set. The native side keeps them in memory
+/// for as long as the process lives and cannot list them, so the demo page reads them here after the debug page
+/// (which sets them through [set] too) or itself changed one.
+class LivenessDevOverrides {
+  LivenessDevOverrides._();
+
+  static final Map<String, String> _values = {};
+
+  /// The value set for [key], or null when none is set.
+  static String? valueOf(String key) => _values[key];
+
+  /// Sets [key] on the native side (an empty [value] removes it), then records it. A failed call records nothing.
+  static Future<void> set(LivenessService service, String key, String value) async {
+    await service.setConfigOverride(key, value);
+    if (value.isEmpty) {
+      _values.remove(key);
+    } else {
+      _values[key] = value;
+    }
+  }
+
+  @visibleForTesting
+  static void clear() => _values.clear();
+}
