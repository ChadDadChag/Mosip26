+/// Debug and profile builds only (never release): the face liveness demo the sign-in page opens. It runs the real
+/// engine through [LivenessGate.run] as the registration flows do, the F15 identity test, the model page, the
+/// persisted metrics and the fake engine's scripted screens; [LivenessDebugPage] stays below as "Developer tools".
+/// English only and always left to right: the language picker changes the app (and so the face check), not this
+/// page. It never shows an image from a session.
+class LivenessDemoPage extends StatefulWidget {
+  const LivenessDemoPage({super.key, this.service, this.api, this.previewBuilder});
+
+  /// Tests: a scripted engine and diagnostics channel; null uses the app's.
+  final LivenessService? service;
+  final LivenessApi? api;
+
+  /// Tests: stands in for the camera preview of the real checks.
+  final Widget Function()? previewBuilder;
+
+  @override
+  State<LivenessDemoPage> createState() => _LivenessDemoPageState();
+}
+
+class _LivenessDemoPageState extends State<LivenessDemoPage> {
+  // The debug page's keys and values.
+  static const String _fakeScenarioKey = 'mosip.registration.liveness.fake.scenario';
+  static const String _passiveThresholdKey = 'mosip.registration.liveness.face.default.passiveThreshold';
+  static const String _forcedThreshold = '0.9999';
+  // LivenessServiceHolder.cameraFor reads <prefix><workflow>.camera.
+  static const String _cameraKeyPrefix = 'mosip.registration.liveness.face.android.';
+  static const String _identityTestUser = 'f15-test-user';
+  static const List<String> _workflows = [LivenessGate.resident, LivenessGate.operator, LivenessGate.supervisor];
+  // The debug page's list: the app's languages, by their own names.
+  static const Map<String, String> _uiLanguages = {
+    'eng': 'English',
+    'ara': 'العربية',
+    'fra': 'Français',
+    'hin': 'हिंदी',
+    'kan': 'ಕನ್ನಡ',
+    'tam': 'தமிழ்',
+  };
+  static const List<_Run> _runs = [
+    _Run('Resident face capture', 'Before a resident\'s photo is taken', Icons.face_outlined, LivenessGate.resident),
+    _Run('Operator sign-in', 'After the operator\'s password', Icons.login, LivenessGate.operator),
+    _Run('Supervisor approval', 'Before packets are approved', Icons.verified_user_outlined, LivenessGate.supervisor),
+  ];
+  // The fake engine's scenarios (FakeScenario), in plain words.
+  static const List<List<String>> _scenarios = [
+    ['PASS_PASSIVE', 'Passed with no action'],
+    ['PASS_ACTIVE', 'Passed after actions'],
+    ['FAIL_CHALLENGE_THEN_PASS_ON_RETRY', 'Wrong action, passed on retry'],
+    ['CHALLENGE_TIMEOUT', 'Action too slow, passed on retry'],
+    ['NO_FACE_THEN_PASS', 'No face at first, then passed'],
+    ['MULTIPLE_FACES', 'Two people in view'],
+    ['POOR_LIGHTING_HINTS', 'Poor lighting hints'],
+    ['PAD_ATTACK', 'Photo attack refused'],
+    ['MAX_RETRIES_EXCEEDED', 'Too many attempts'],
+    ['DEVICE_DISCONNECT', 'Camera disconnected, then passed'],
+    ['DEVICE_FAILURE', 'Camera keeps failing'],
+    ['ENGINE_ERROR', 'Engine error'],
+    ['RANDOM', 'A random scenario'],
+  ];
+
+  late final LivenessService _service = widget.service ?? LivenessService();
+  late final LivenessApi _api = widget.api ?? LivenessApi();
+  StreamSubscription<LivenessMessage>? _subscription;
+  // The passing attempt's challenge count of each session, from its result message.
+  final Map<String, int> _actions = {};
+
+  bool _busy = false;
+  bool _running = false;
+  _Run? _lastRun;
+  GateResult? _lastResult;
+  String _modelVersion = '';
+  String _camera = 'front';
+  bool _forceActions = false;
+  bool _identityTemplate = false;
+  String? _identityLine;
+  String? _identityDetail;
+  Map<String, String> _metrics = const {};
+  bool _metricsLoaded = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _subscription = _service.messages.listen((m) {
+      final session = m.sessionId;
+      if (m.isComplete && session != null) _actions[session] = m.challengesIssued.length;
+    });
+    _refreshAll();
+  }
+
+  @override
+  void dispose() {
+    _subscription?.cancel();
+    super.dispose();
+  }
+
+  /// The shown state: the models, the overrides (also after the debug page changed them), the test face, the metrics.
+  Future<void> _refreshAll() async {
+    String version = _modelVersion;
+    String camera = _camera;
+    bool template = _identityTemplate;
+    try {
+      version = await _service.modelVersion();
+      camera = await _service.cameraFor(LivenessGate.resident);
+    } on PlatformException catch (e) {
+      debugPrint('liveness demo: engine state failed: ${e.message}');
+    }
+    try {
+      template = await _api.hasIdentityTestTemplate();
+    } on PlatformException catch (e) {
+      debugPrint('liveness demo: test face status failed: ${e.message}');
+    }
+    if (!mounted) return;
+    setState(() {
+      _modelVersion = version;
+      _camera = camera;
+      _forceActions = LivenessDevOverrides.valueOf(_passiveThresholdKey) == _forcedThreshold;
+      _identityTemplate = template;
+    });
+    await _refreshMetrics();
+  }
+
+  Future<void> _refreshMetrics() async {
+    try {
+      final text = await _api.metrics();
+      final values = <String, String>{};
+      for (final line in text.split('\n')) {
+        final eq = line.indexOf('=');
+        if (eq > 0) values[line.substring(0, eq).trim()] = line.substring(eq + 1).trim();
+      }
+      if (mounted) {
+        setState(() {
+          _metrics = values;
+          _metricsLoaded = true;
+        });
+      }
+    } on PlatformException catch (e) {
+      debugPrint('liveness demo: metrics failed: ${e.message}');
+    }
+  }
+
+  Future<void> _resetMetrics() async {
+    final ok = await showDialog<bool>(
+      context: context,
+      builder: (dialogContext) => Directionality(
+        textDirection: TextDirection.ltr,
+        child: AlertDialog(
+          title: const Text('Reset the diagnostics?'),
+          content: const Text('All counts and times on this phone start again from zero.'),
+          actions: [
+            TextButton(onPressed: () => Navigator.pop(dialogContext, false), child: const Text('Cancel')),
+            TextButton(
+                key: const Key('demo.metrics.resetConfirm'),
+                onPressed: () => Navigator.pop(dialogContext, true),
+                child: const Text('Reset')),
+          ],
+        ),
+      ),
+    );
+    if (ok != true) return;
+    try {
+      await _api.resetMetrics();
+    } on PlatformException catch (e) {
+      debugPrint('liveness demo: metrics reset failed: ${e.message}');
+    }
+    await _refreshMetrics();
+  }
+
+  Future<void> _setOverride(String key, String value) async {
+    try {
+      await LivenessDevOverrides.set(_service, key, value);
+    } on PlatformException catch (e) {
+      debugPrint('liveness demo: override $key failed: ${e.message}');
+    }
+  }
+
+  Future<void> _setForceActions(bool on) async {
+    setState(() => _forceActions = on);
+    await _setOverride(_passiveThresholdKey, on ? _forcedThreshold : '');
+  }
+
+  Future<void> _setCamera(String camera) async {
+    setState(() => _camera = camera);
+    for (final w in _workflows) {
+      await _setOverride('$_cameraKeyPrefix${w.toLowerCase()}.camera', camera);
+    }
+  }
+
+  /// One real check, exactly as the registration flow's hook calls it.
+  Future<void> _runCheck(_Run run) async {
+    setState(() {
+      _busy = true;
+      _running = true;
+      _lastRun = run;
+      _lastResult = null;
+    });
+    final result = await LivenessGate.run(context,
+        workflow: run.workflow, service: _service, previewBuilder: widget.previewBuilder);
+    if (!mounted) return;
+    setState(() {
+      _busy = false;
+      _running = false;
+      _lastResult = result;
+    });
+    // The native side merges the session's metrics in the background.
+    Future<void>.delayed(const Duration(milliseconds: 500), _refreshMetrics);
+  }
+
+  /// One scripted session of the fake engine on the face check screen, with the placeholder instead of a camera.
+  Future<void> _runSimulated(String scenario) async {
+    setState(() => _busy = true);
+    await _setOverride(_fakeScenarioKey, scenario);
+    if (!mounted) return;
+    await Navigator.push<LivenessOutcome>(
+      context,
+      MaterialPageRoute(
+        builder: (_) => LivenessPage(
+          workflow: LivenessGate.resident,
+          camera: _camera,
+          useFake: true,
+          service: _service,
+          previewBuilder: () => const LivenessPlaceholderPreview(),
+          showDebugInfo: false,
+        ),
+      ),
+    );
+    if (mounted) setState(() => _busy = false);
+  }
+
+  /// F15, enroll: a real Operator gate; its best frame becomes the test face (app-private). It is never shown.
+  Future<void> _identityEnroll() async {
+    setState(() {
+      _busy = true;
+      _identityLine = null;
+      _identityDetail = null;
+    });
+    final gate = await LivenessGate.run(context,
+        workflow: LivenessGate.operator, service: _service, previewBuilder: widget.previewBuilder);
+    String line;
+    if (gate.disabled) {
+      line = 'Liveness is off for operators – nothing enrolled';
+    } else if (!gate.proceed || gate.sessionId == null) {
+      line = 'Face check not passed – nothing enrolled';
+    } else {
+      try {
+        final outcome = await _api.enrollIdentityTestTemplate(gate.sessionId!);
+        line = outcome == 'ENROLLED'
+            ? 'Your face is enrolled as the test user'
+            : outcome == 'NO_LIVE_FRAME'
+                ? 'No face kept from the check – nothing enrolled'
+                : 'Enrolment failed – try again';
+      } on PlatformException catch (e) {
+        line = 'Enrolment failed: ${e.message}';
+      }
+    }
+    await _identityDone(line, null);
+  }
+
+  /// F15, check: a new Operator gate, then the production identity check against the test face.
+  Future<void> _identityCheck() async {
+    setState(() {
+      _busy = true;
+      _identityLine = null;
+      _identityDetail = null;
+    });
+    final gate = await LivenessGate.run(context,
+        workflow: LivenessGate.operator, service: _service, previewBuilder: widget.previewBuilder);
+    String line;
+    String? detail;
+    if (gate.disabled) {
+      line = 'Liveness is off for operators – nothing compared';
+    } else if (!gate.proceed || gate.sessionId == null) {
+      line = 'Face check not passed – nothing compared';
+    } else {
+      try {
+        await _api.setIdentityDiagnosticOverride(true);
+        final info = await _service.verifyIdentity(gate.sessionId!, _identityTestUser, 'diagnostics', 1);
+        line = _identityText(info);
+        if (!info.similarity.isNaN && info.outcome != 'MATCH') {
+          detail = 'Similarity ${info.similarity.toStringAsFixed(2)}, needed ${info.threshold.toStringAsFixed(2)}';
+        }
+      } on PlatformException catch (e) {
+        line = 'Identity check failed: ${e.message}';
+      } finally {
+        await _api.setIdentityDiagnosticOverride(false);
+      }
+    }
+    await _identityDone(line, detail);
+  }
+
+  Future<void> _identityDelete() async {
+    setState(() => _busy = true);
+    String line;
+    try {
+      line = await _api.deleteIdentityTestTemplate() ? 'Test face deleted' : 'No test face enrolled';
+    } on PlatformException catch (e) {
+      line = 'Delete failed: ${e.message}';
+    }
+    await _identityDone(line, null);
+  }
+
+  Future<void> _identityDone(String line, String? detail) async {
+    bool template = _identityTemplate;
+    try {
+      template = await _api.hasIdentityTestTemplate();
+    } on PlatformException catch (e) {
+      debugPrint('liveness demo: test face status failed: ${e.message}');
+    }
+    if (!mounted) return;
+    setState(() {
+      _busy = false;
+      _identityTemplate = template;
+      _identityLine = line;
+      _identityDetail = detail;
+    });
+  }
+
+  static String _identityText(IdentityCheckInfo info) {
+    switch (info.outcome) {
+      case 'MATCH':
+        return info.similarity.isNaN
+            ? 'Same person'
+            : 'Same person (similarity ${info.similarity.toStringAsFixed(2)})';
+      case 'NO_MATCH':
+        return 'Different person – refused';
+      case 'NOT_BOUND_NO_TEMPLATE':
+        return 'No test face enrolled';
+      case 'NOT_BOUND_UNREADABLE':
+        return 'The test face cannot be read – enroll again';
+      case 'NO_LIVE_FACE':
+        return 'No face found in the check – try again';
+      case 'NO_LIVE_FRAME':
+        return 'No face kept from the check – try again';
+      case 'SKIPPED':
+        return 'The identity check is turned off';
+      default:
+        return 'The comparison failed – try again';
+    }
+  }
+
+  /// F17: the production model page, with the diagnostics-only stand-in for the supervisor role while it is open.
+  Future<void> _openModelPage() async {
+    setState(() => _busy = true);
+    try {
+      await _api.setModelBundleDiagnosticOverride(true);
+      if (!mounted) return;
+      await Navigator.push(context, MaterialPageRoute(builder: (_) => const ModelBundlePage()));
+    } on PlatformException catch (e) {
+      debugPrint('liveness demo: model page failed: ${e.message}');
+    } finally {
+      try {
+        await _api.setModelBundleDiagnosticOverride(false);
+      } on PlatformException catch (e) {
+        debugPrint('liveness demo: model page override off failed: ${e.message}');
+      }
+      if (mounted) setState(() => _busy = false);
+      // A new analyzer loads in the background; its version shows once loaded.
+      await _refreshAll();
+    }
+  }
+
+  Future<void> _openDeveloperTools() async {
+    await Navigator.push(context, MaterialPageRoute(builder: (_) => const LivenessDebugPage()));
+    await _refreshAll();
+  }
+
