+/// The diagnostics calls the demo page makes, scripted; any other call fails the test.
+class FakeDemoApi implements LivenessApi {
+  String metricsText = 'sessions=38\npassedPassive=28\npassedActive=4\nfailedFinal=4\ncancelled=2\nretries=16\n'
+      'deviceErrors=0\navgProcessingMs=41.250\navgChallengeCompletionMs=1850.000\nretryRate=0.421\n'
+      'failureRate=0.105\npassiveShare=0.875\n';
+  bool template = false;
+  String enrollResult = 'ENROLLED';
+  final List<String> calls = [];
+
+  @override
+  Future<String> metrics() async => metricsText;
+
+  @override
+  Future<void> resetMetrics() async => calls.add('resetMetrics');
+
+  @override
+  Future<bool> hasIdentityTestTemplate() async => template;
+
+  @override
+  Future<String> enrollIdentityTestTemplate(String sessionId) async {
+    calls.add('enroll $sessionId');
+    if (enrollResult == 'ENROLLED') template = true;
+    return enrollResult;
+  }
+
+  @override
+  Future<bool> deleteIdentityTestTemplate() async {
+    calls.add('delete');
+    final had = template;
+    template = false;
+    return had;
+  }
+
+  @override
+  Future<void> setIdentityDiagnosticOverride(bool on) async => calls.add('identityOverride $on');
+
+  @override
+  Future<void> setModelBundleDiagnosticOverride(bool on) async => calls.add('modelOverride $on');
+
+  @override
+  dynamic noSuchMethod(Invocation invocation) => throw UnimplementedError('${invocation.memberName}');
+}
+
+void main() {
+  late FakeLivenessService service;
+  late FakeDemoApi api;
+
+  setUpAll(() async {
+    if (!await loadLivenessTestFonts()) fail('the test fonts were not found');
+  });
+
+  setUp(() {
+    service = FakeLivenessService()..version = 'pad-2026.10.5';
+    api = FakeDemoApi();
+    LivenessDevOverrides.clear();
+  });
+
+  Future<void> pumpDemo(WidgetTester tester, {Size size = const Size(412, 915), double textScale = 1.0}) async {
+    tester.view.physicalSize = size * 3;
+    tester.view.devicePixelRatio = 3;
+    addTearDown(tester.view.reset);
+    await tester.pumpWidget(ChangeNotifierProvider<GlobalProvider>(
+      create: (_) => GlobalProvider(),
+      child: MaterialApp(
+        localizationsDelegates: AppLocalizations.localizationsDelegates,
+        supportedLocales: AppLocalizations.supportedLocales,
+        theme: ThemeData(colorScheme: const ColorScheme.light(primary: LivenessStyle.primary)),
+        builder: (context, child) => MediaQuery(
+          data: MediaQuery.of(context).copyWith(textScaleFactor: textScale),
+          child: child!,
+        ),
+        home: LivenessDemoPage(
+            service: service, api: api, previewBuilder: () => const ColoredBox(color: Colors.grey)),
+      ),
+    ));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 100));
+  }
+
+  ScrollPosition listPosition(WidgetTester tester) => tester
+      .state<ScrollableState>(
+          find.descendant(of: find.byKey(const Key('demo.list')), matching: find.byType(Scrollable)).first)
+      .position;
+
+  /// The list builds lazily: scrolls from the top until [finder] is built, then fully into view.
+  Future<void> reveal(WidgetTester tester, Finder finder) async {
+    listPosition(tester).jumpTo(0);
+    await tester.pump();
+    await tester.scrollUntilVisible(finder, 200,
+        scrollable: find.descendant(of: find.byKey(const Key('demo.list')), matching: find.byType(Scrollable)).first);
+    await tester.ensureVisible(finder);
+    await tester.pump();
+  }
+
+  Future<void> tapKey(WidgetTester tester, String key) async {
+    await reveal(tester, find.byKey(Key(key)));
+    await tester.tap(find.byKey(Key(key)));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 400));
+  }
+
+  Future<void> send(WidgetTester tester, Map<String, Object?> m) async {
+    service.emit(m);
+    await tester.pump();
+    await tester.pump();
+  }
+
+  Future<void> passSession(WidgetTester tester, {List<String> challenges = const ['BLINK', 'SMILE']}) async {
+    await send(tester, ev('STARTED'));
+    await send(tester, ev('PASSED'));
+    final done = complete('PASSED');
+    done['challengesIssued'] = challenges;
+    done['passPath'] = challenges.isEmpty ? 'PASSIVE_ONLY' : 'ACTIVE_CHALLENGE';
+    done['bestFrameJpeg'] = Uint8List.fromList([0xFF, 0xD8, 1]);
+    await send(tester, done);
+    await tester.pump(const Duration(milliseconds: 1100));
+    await tester.pump(const Duration(milliseconds: 400));
+  }
+
+  Future<void> failSession(WidgetTester tester) async {
+    await send(tester, ev('FAILED_FINAL',
+        attempt: 4, error: 'MAX_RETRIES_EXCEEDED', userMessage: 'MAX_ATTEMPTS_REACHED', recoverable: false));
+    await send(tester, complete('FAILED', failureCode: 'MAX_RETRIES_EXCEEDED', userMessage: 'MAX_ATTEMPTS_REACHED'));
+    await tester.tap(find.text('Close'));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 400));
+  }
+
+  /// Scrolls the whole page in steps; nothing may overflow at any step.
+  Future<void> scrollThrough(WidgetTester tester, String reason) async {
+    final position = listPosition(tester);
+    for (var y = 0.0;; y += 200) {
+      position.jumpTo(math.min(y, position.maxScrollExtent));
+      await tester.pump();
+      expect(tester.takeException(), isNull, reason: '$reason at $y');
+      if (y >= position.maxScrollExtent) break;
+    }
+    position.jumpTo(0);
+    await tester.pump();
+  }
