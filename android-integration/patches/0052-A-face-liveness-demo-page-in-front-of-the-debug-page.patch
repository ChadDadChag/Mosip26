+          (tester) async {
+        await pumpDemo(tester, size: size, textScale: scale);
+        await scrollThrough(tester, 'start');
+        expect(find.text('Models pad-2026.10.5 · signed'), findsOneWidget);
+        await reveal(tester, find.text('38'));
+
+        // The longest result: not verified, with the engine's message.
+        await tapKey(tester, 'demo.run.OPERATOR');
