@@ -380,6 +381,12 @@ class _OperatorBiometricCaptureScanBlockViewState
         ElevatedButton.icon(
           onPressed: () async {
             if (biometricAttributeData.exceptions.contains(false)) {
+              // Face liveness of the operator before the onboarding face capture (docs/ui-liveness-spec.md
+              // section 6). Not proceeding means no capture.
+              if (biometricAttributeData.title == "Face") {
+                final liveness = await LivenessGate.run(context, workflow: LivenessGate.operator);
