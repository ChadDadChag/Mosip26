+    @Override
+    public void runBenchmark(@NonNull String camera, @NonNull LivenessPigeon.Result<String> result) {
+        if (!diagnostics(result)) return;
+        MainActivity activity = activityRef.get();
+        if (activity == null) {
+            result.error(new IllegalStateException("Activity not set"));
+            return;
+        }
+        if (session != null || benchmarking) {
+            result.error(new IllegalStateException("a session or a benchmark is running"));
+            return;
+        }
+        if (ContextCompat.checkSelfPermission(activity, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+            result.error(new IllegalStateException("camera permission not granted"));
+            return;
+        }
+        benchmarking = true;
+        CameraSelector selector = "back".equalsIgnoreCase(camera)
+                ? CameraSelector.DEFAULT_BACK_CAMERA : CameraSelector.DEFAULT_FRONT_CAMERA;
+        PreviewView preview = holder.preview();
+        CameraXFrameSource src = new CameraXFrameSource(activity, activity, selector, ANALYSIS_RESOLUTION, 1,
+                preview == null ? null : preview.getSurfaceProvider());
+        src.setExposureAssist(holder.exposureAssist());
+        List<Frame> frames = new ArrayList<>();
+        boolean[] done = {false};
+        Runnable finishCapture = () -> { // main thread
+            if (done[0]) return;
+            done[0] = true;
+            src.stop();
+            if (frames.size() < BENCHMARK_FRAMES) {
+                int captured = frames.size();
+                frames.clear();
+                benchmarking = false;
+                result.error(new IllegalStateException("captured only " + captured + " frames"));
+                return;
+            }
+            File benchDir = activity.getExternalFilesDir(BENCH_BUNDLES);
+            String device = android.os.Build.MANUFACTURER + " " + android.os.Build.MODEL + ", Android "
+                    + android.os.Build.VERSION.RELEASE + " (API " + android.os.Build.VERSION.SDK_INT + "), "
+                    + BuildConfig.BUILD_TYPE + " build, " + frames.get(0).width() + "x" + frames.get(0).height();
+            List<AnalyzerBenchmark.Bundle> bundles = holder.benchmarkBundles(benchDir);
+            Thread t = new Thread(() -> {
+                String report;
+                try {
+                    List<AnalyzerBenchmark.Result> r = AnalyzerBenchmark.run(frames, bundles,
+                            AnalyzerBenchmark.defaultSettings(), step -> Log.i(TAG, "benchmark: " + step));
+                    report = AnalyzerBenchmark.report(r, frames.size(), device);
+                } catch (RuntimeException | LinkageError e) {
+                    report = "benchmark failed: " + e;
+                } finally {
+                    frames.clear(); // the frames are dropped here, whatever happened
+                }
+                for (String line : report.split("\n")) Log.i(TAG, "benchmark| " + line);
+                String text = report;
+                main.post(() -> {
+                    benchmarking = false;
+                    result.success(text);
+                });
+            }, "liveness-benchmark");
+            t.start();
+        };
+        src.start(new FrameSource.Listener() {
+            @Override
+            public void onFrame(Frame frame) {
+                main.post(() -> {
+                    if (done[0]) return;
+                    frames.add(frame);
+                    if (frames.size() >= BENCHMARK_FRAMES) finishCapture.run();
+                });
+            }
+
+            @Override
+            public void onError(ErrorCode code, String detail, boolean recoverable) {
+                Log.w(TAG, "benchmark capture: " + code + " " + detail);
+                if (!recoverable) main.post(finishCapture);
+            }
+        });
+        main.postDelayed(finishCapture, BENCHMARK_CAPTURE_TIMEOUT_MS);
+        Log.i(TAG, "benchmark: capturing " + BENCHMARK_FRAMES + " frames into memory");
+    }
