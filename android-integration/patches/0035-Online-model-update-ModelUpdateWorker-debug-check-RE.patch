@@ -0,0 +1,41 @@
+package io.mosip.registration.liveness.android;
+
+import android.content.Context;
+import android.util.Log;
+
+import androidx.annotation.NonNull;
+import androidx.work.Worker;
+import androidx.work.WorkerParameters;
+
+/**
+ * The periodic online model update ({@link ModelUpdates}): checks the index and installs a newer verified bundle.
+ * A failed check leaves the store unchanged and waits for the next period, so the job always ends as success.
+ */
+public final class ModelUpdateWorker extends Worker {
+
+    private static final String TAG = "LivenessModelUpdate";
+
+    public ModelUpdateWorker(@NonNull Context context, @NonNull WorkerParameters params) {
+        super(context, params);
+    }
+
+    @NonNull
+    @Override
+    public Result doWork() {
+        LivenessServiceHolder holder = LivenessServiceHolder.current();
+        try {
+            if (holder != null) {
+                holder.checkModelUpdate("scheduled");
+            } else {
+                String url = getInputData().getString(ModelUpdates.INPUT_URL);
+                if (url != null) {
+                    ModelUpdates.checkWithoutEngine(getApplicationContext(), url,
+                            getInputData().getBoolean(ModelUpdates.INPUT_INSECURE_LOCALHOST, false));
+                }
+            }
+        } catch (IllegalStateException e) {
+            Log.i(TAG, "model update skipped: " + e.getMessage()); // disabled meanwhile
+        }
+        return Result.success();
+    }
+}
