+package io.mosip.registration.liveness.android;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.verifyNoMoreInteractions;
+
+import android.content.Context;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+import java.io.IOException;
+import java.net.URL;
+import java.util.HashMap;
+import java.util.Map;
+
+import io.mosip.registration.clientmanager.constant.AuditEvent;
+import io.mosip.registration.clientmanager.constant.Components;
+import io.mosip.registration.clientmanager.spi.AuditManagerService;
+import io.mosip.registration.liveness.analyzer.integrity.BundleSource;
+import io.mosip.registration.liveness.analyzer.integrity.ModelStore;
+import io.mosip.registration.liveness.analyzer.integrity.ModelUpdater;
+import io.mosip.registration.liveness.analyzer.integrity.TrustedKeys;
+
+/** The online update's settings, scheduling without WorkManager, and the outcomes kept while the engine is down. */
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 34)
+public class ModelUpdatesTest {
+
+    @Rule
+    public TemporaryFolder tmp = new TemporaryFolder();
+
+    private final Context context = ApplicationProvider.getApplicationContext();
+
+    @Test
+    public void updatesAreOffByDefaultAndCheckDaily() {
+        Map<String, String> c = new HashMap<>();
+        ModelUpdates.Settings s = ModelUpdates.Settings.from(c::get);
+        assertFalse(s.enabled);
+        assertNull(s.url);
+        assertEquals(24, s.intervalHours);
+        assertFalse(s.active());
+
+        c.put(ModelUpdates.ENABLED_KEY, " TRUE ");
+        c.put(ModelUpdates.URL_KEY, " https://models.example.org/liveness/latest.json ");
+        c.put(ModelUpdates.INTERVAL_KEY, "6");
+        s = ModelUpdates.Settings.from(c::get);
+        assertTrue(s.active());
+        assertEquals("https://models.example.org/liveness/latest.json", s.url);
+        assertEquals(6, s.intervalHours);
+
+        c.put(ModelUpdates.INTERVAL_KEY, "0");
+        assertEquals(1, ModelUpdates.Settings.from(c::get).intervalHours);
+        c.put(ModelUpdates.INTERVAL_KEY, "daily");
+        assertEquals(24, ModelUpdates.Settings.from(c::get).intervalHours);
+        c.put(ModelUpdates.URL_KEY, "  ");
+        assertFalse(ModelUpdates.Settings.from(c::get).active());
+    }
+
+    @Test
+    public void schedulingWithoutWorkManagerIsHarmless() {
+        ModelUpdates.schedule(context, new ModelUpdates.Settings(true, "https://example.org/latest.json", 24), false);
+        ModelUpdates.schedule(context, new ModelUpdates.Settings(false, null, 24), false);
+    }
+
+    @Test
+    public void outcomesKeptWithoutTheEngineAreAuditedOnceWithCodesOnly() throws Exception {
+        ModelUpdater.UpdateResult failed = refusedCheck();
+        assertEquals(ModelUpdater.Reason.INSECURE_TRANSPORT, failed.reason());
+        for (int ms = 0; ms < 25; ms++) ModelUpdates.keep(context, failed, ms);
+
+        AuditManagerService audit = mock(AuditManagerService.class);
+        ModelUpdates.auditKept(context, new AndroidAuditSink(audit, Runnable::run));
+        for (int ms = 5; ms < 25; ms++) { // the newest 20
+            verify(audit).audit(AuditEvent.LIVENESS_MODEL_UPDATE, Components.HOME,
+                    "outcome=FAILED;reason=INSECURE_TRANSPORT;durationMs=" + ms + ";trigger=scheduled-offline");
+        }
+        ModelUpdates.auditKept(context, new AndroidAuditSink(audit, Runnable::run));
+        verifyNoMoreInteractions(audit);
+    }
+
+    @Test
+    public void anInvalidUrlFromTheJobIsIgnored() {
+        ModelUpdates.checkWithoutEngine(context, "not a url", false);
+    }
+
+    /** A check refused before any connection (plain HTTP, not allowed). */
+    private ModelUpdater.UpdateResult refusedCheck() throws Exception {
+        BundleSource unreadable = new BundleSource() {
+            @Override
+            public byte[] read(String name) throws IOException {
+                throw new IOException("not used");
+            }
+
+            @Override
+            public String describe() {
+                return "none";
+            }
+        };
+        return ModelUpdates.updater(false).check(new URL("http://example.invalid/latest.json"),
+                new ModelStore(tmp.newFolder()), unreadable, TrustedKeys.builtIn());
+    }
+}
