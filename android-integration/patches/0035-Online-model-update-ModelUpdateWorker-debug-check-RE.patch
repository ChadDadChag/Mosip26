@@ -0,0 +1,205 @@
+package io.mosip.registration.liveness.android;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.SystemClock;
+import android.util.Log;
+
+import androidx.work.Constraints;
+import androidx.work.Data;
+import androidx.work.ExistingPeriodicWorkPolicy;
+import androidx.work.NetworkType;
+import androidx.work.PeriodicWorkRequest;
+import androidx.work.WorkManager;
+
+import java.net.MalformedURLException;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+import io.mosip.registration.liveness.analyzer.integrity.ModelUpdater;
+import io.mosip.registration.liveness.analyzer.integrity.TrustedKeys;
+import io.mosip.registration.liveness.api.ConfigProvider;
+
+/**
+ * Online model updates on Android, with the engine's {@link ModelUpdater}.
+ *
+ * <ul>
+ *   <li>Config: {@value #ENABLED_KEY} (default false: no update server exists yet), {@value #URL_KEY} (the index,
+ *       {@code latest.json}, over HTTPS) and {@value #INTERVAL_KEY} (default 24, at least 1).</li>
+ *   <li>{@link #schedule}: one unique periodic WorkManager job, {@value #WORK_NAME}, which needs a network
+ *       connection. It exists while updates are enabled with a URL, and is cancelled otherwise. It is replaced only
+ *       when the URL or the interval change.</li>
+ *   <li>{@link ModelUpdateWorker} checks through the running engine ({@link LivenessServiceHolder#checkModelUpdate}),
+ *       which reloads the analyzer after an install and writes REG-EVT-019.</li>
+ *   <li>When WorkManager started the process and the engine is not running, the worker checks with the same store,
+ *       assets and keys. It keeps the outcome for the engine to audit when it starts; the next preload uses an
+ *       installed bundle.</li>
+ * </ul>
+ * Plain HTTP to 127.0.0.1 and localhost is allowed only in diagnostics builds (debug and profile), as their network
+ * security config allows; release builds use HTTPS only.
+ */
+public final class ModelUpdates {
+
+    private static final String TAG = "LivenessModelUpdate";
+    public static final String KEY_PREFIX = "mosip.registration.liveness.model.update.";
+    public static final String ENABLED_KEY = KEY_PREFIX + "enabled";
+    public static final String URL_KEY = KEY_PREFIX + "url";
+    public static final String INTERVAL_KEY = KEY_PREFIX + "intervalHours";
+    static final int DEFAULT_INTERVAL_HOURS = 24;
+    static final String WORK_NAME = "liveness-model-update";
+    static final String INPUT_URL = "url";
+    static final String INPUT_INSECURE_LOCALHOST = "allowInsecureLocalhost";
+    static final String PREFS = "liveness-model-update";
+    private static final String SCHEDULED = "scheduled";
+    private static final String PENDING = "pending";
+    private static final int MAX_PENDING = 20;
+
+    private ModelUpdates() { }
+
+    /** The update settings in the config. */
+    static final class Settings {
+        final boolean enabled;
+        final String url;
+        final int intervalHours;
+
+        Settings(boolean enabled, String url, int intervalHours) {
+            this.enabled = enabled;
+            this.url = url;
+            this.intervalHours = intervalHours;
+        }
+
+        static Settings from(ConfigProvider config) {
+            String enabled = trim(config.get(ENABLED_KEY));
+            String url = trim(config.get(URL_KEY));
+            int hours = DEFAULT_INTERVAL_HOURS;
+            String h = trim(config.get(INTERVAL_KEY));
+            if (h != null) {
+                try {
+                    hours = Math.max(1, Integer.parseInt(h));
+                } catch (NumberFormatException e) {
+                    Log.w(TAG, INTERVAL_KEY + " is not a number; using " + DEFAULT_INTERVAL_HOURS);
+                }
+            }
+            return new Settings("true".equalsIgnoreCase(enabled), url, hours);
+        }
+
+        /** Enabled, with a URL. */
+        boolean active() {
+            return enabled && url != null;
+        }
+
+        private static String trim(String s) {
+            if (s == null) return null;
+            s = s.trim();
+            return s.isEmpty() ? null : s;
+        }
+    }
+
+    static ModelUpdater updater(boolean allowInsecureLocalhost) {
+        return ModelUpdater.builder().allowInsecureLocalhost(allowInsecureLocalhost).build();
+    }
+
+    /** Schedules, replaces or cancels the periodic job for these settings. */
+    static void schedule(Context context, Settings s, boolean allowInsecureLocalhost) {
+        SharedPreferences prefs = prefs(context);
+        if (prefs == null) return; // no app storage (unit tests)
+        try {
+            WorkManager work = WorkManager.getInstance(context);
+            if (!s.active()) {
+                work.cancelUniqueWork(WORK_NAME);
+                prefs.edit().remove(SCHEDULED).apply();
+                return;
+            }
+            String fingerprint = s.url + "|" + s.intervalHours + "|" + allowInsecureLocalhost;
+            boolean same = fingerprint.equals(prefs.getString(SCHEDULED, null));
+            PeriodicWorkRequest request = new PeriodicWorkRequest.Builder(ModelUpdateWorker.class,
+                    s.intervalHours, TimeUnit.HOURS)
+                    .setConstraints(new Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build())
+                    .setInputData(new Data.Builder()
+                            .putString(INPUT_URL, s.url)
+                            .putBoolean(INPUT_INSECURE_LOCALHOST, allowInsecureLocalhost)
+                            .build())
+                    .build();
+            work.enqueueUniquePeriodicWork(WORK_NAME,
+                    same ? ExistingPeriodicWorkPolicy.KEEP : ExistingPeriodicWorkPolicy.REPLACE, request);
+            prefs.edit().putString(SCHEDULED, fingerprint).apply();
+            if (!same) Log.i(TAG, "model update scheduled every " + s.intervalHours + " h");
+        } catch (RuntimeException e) {
+            Log.w(TAG, "model update not scheduled: " + e); // e.g. WorkManager not initialised
+        }
+    }
+
+    /**
+     * The worker's check while the engine is not running. The outcome goes to the engine if it started meanwhile,
+     * else it is kept for its audit at the next start.
+     */
+    static void checkWithoutEngine(Context context, String url, boolean allowInsecureLocalhost) {
+        URL index;
+        try {
+            index = new URL(url);
+        } catch (MalformedURLException e) {
+            Log.w(TAG, "model update: the index URL is invalid");
+            return;
+        }
+        long start = SystemClock.elapsedRealtime();
+        ModelUpdater.UpdateResult r = updater(allowInsecureLocalhost).check(index,
+                LivenessServiceHolder.sharedStore(context), new AssetBundleSource(context), TrustedKeys.builtIn());
+        long ms = SystemClock.elapsedRealtime() - start;
+        LivenessServiceHolder holder = LivenessServiceHolder.current();
+        if (holder != null) {
+            holder.onModelUpdate(r, ms, "scheduled");
+        } else {
+            Log.i(TAG, "model update (engine not running): " + r + " in " + ms + " ms");
+            keep(context, r, ms);
+        }
+    }
+
+    /** Keeps an outcome for the engine's audit (at most {@value #MAX_PENDING}, the newest). */
+    static synchronized void keep(Context context, ModelUpdater.UpdateResult r, long ms) {
+        SharedPreferences prefs = prefs(context);
+        if (prefs == null) return;
+        List<String> lines = split(prefs.getString(PENDING, ""));
+        lines.add(r.status() + "|" + nullable(r.version()) + "|" + nullable(r.reason() == null ? null : r.reason().name())
+                + "|" + ms);
+        while (lines.size() > MAX_PENDING) lines.remove(0);
+        prefs.edit().putString(PENDING, String.join("\n", lines)).apply();
+    }
+
+    /** Audits the kept outcomes once (trigger "scheduled-offline") and forgets them. */
+    static synchronized void auditKept(Context context, AndroidAuditSink audit) {
+        SharedPreferences prefs = prefs(context);
+        if (prefs == null) return;
+        List<String> lines = split(prefs.getString(PENDING, ""));
+        if (lines.isEmpty()) return;
+        prefs.edit().remove(PENDING).apply();
+        for (String line : lines) {
+            String[] f = line.split("\\|", -1);
+            if (f.length != 4) continue;
+            long ms;
+            try {
+                ms = Long.parseLong(f[3]);
+            } catch (NumberFormatException e) {
+                continue;
+            }
+            audit.modelUpdate(f[0], f[1].isEmpty() ? null : f[1], f[2].isEmpty() ? null : f[2], ms, "scheduled-offline");
+        }
+    }
+
+    private static List<String> split(String s) {
+        List<String> out = new ArrayList<>();
+        for (String line : s.split("\n")) {
+            if (!line.isEmpty()) out.add(line);
+        }
+        return out;
+    }
+
+    private static String nullable(String s) {
+        return s == null ? "" : s;
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+}
