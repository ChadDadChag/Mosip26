-            Expanded(
-              child: Text('decision: ${r.decision}\n'
-                  'passPath: ${r.passPath}\n'
-                  'failureCode: ${r.failureCode}\n'
-                  'userMessage: ${r.userMessage}\n'
-                  'passiveScore: ${r.passiveScore.toStringAsFixed(4)}\n'
-                  'challenges: ${r.challengesIssued.join(', ')}\n'
