         padding: const EdgeInsets.all(8),
-        child: Row(
-          crossAxisAlignment: CrossAxisAlignment.start,
-          children: [
-            Expanded(
-              child: Text('LivenessPage returned\n'
-                  'passed: ${o.passed}  cancelled: ${o.cancelled}  disabled: ${o.disabled}\n'
-                  'passPath: ${o.passPath}\n'
-                  'failureCode: ${o.failureCode}\n'
-                  'userMessage: ${o.userMessage}\n'
-                  'attempts: ${o.attempts}, ${o.durationMs} ms\n'
-                  'model: ${o.modelVersion}\n'
-                  'session: ${o.sessionId}'),
-            ),
-            if (jpeg != null)
-              Image.memory(jpeg, width: 96, height: 128, fit: BoxFit.cover),
-          ],
-        ),
+        child: Text('LivenessPage returned\n'
+            'passed: ${o.passed}  cancelled: ${o.cancelled}  disabled: ${o.disabled}\n'
+            'passPath: ${o.passPath}\n'
