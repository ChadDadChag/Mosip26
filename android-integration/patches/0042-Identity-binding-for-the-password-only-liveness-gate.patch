+import io.mosip.biometrics.util.face.FaceQualityBlock;
+import io.mosip.registration.clientmanager.dao.UserBiometricDao;
+import io.mosip.registration.clientmanager.entity.UserBiometric;
+import io.mosip.registration.liveness.android.BindingImages;
+import io.mosip.registration.liveness.android.FaceBinding;
+import io.mosip.registration.liveness.android.IdentityBinding;
+import io.mosip.registration.liveness.api.Frame;
+
+/**
+ * Identity binding (F15) on Android: where the onboarded faces come from, and the debug page's test template.
+ *
+ * <p>Operator onboarding stores each face as a bare ISO/IEC 19794-5 record (the SBI's bioValue, no extraction) in
+ * {@code user_biometric.bio_template}. Each is decoded as F1 decodes an SBI face: the record's image ({@link FaceBDIR})
+ * with {@link BindingImages#decode} (JPEG 2000 or JPEG). In memory only.
+ */
+final class IdentityTemplates {
+
+    /** The debug page's test template, in app-private storage: it never leaves the device. */
+    static final String TEST_TEMPLATE = "f15-test-template";
+
+    private IdentityTemplates() { }
+
+    /** The user's Face rows that are not deleted, each decoded on the worker thread. */
+    static IdentityBinding.TemplateSource fromRoom(UserBiometricDao rows) {
+        return userId -> {
+            List<FaceBinding.Decoder> out = new ArrayList<>();
+            if (userId == null || rows == null) return out;
+            List<UserBiometric> found = rows.findByUsrId(userId);
+            if (found == null) return out;
+            for (UserBiometric row : found) {
+                if (row == null || !"face".equalsIgnoreCase(row.getBioTypeCode())
+                        || Boolean.TRUE.equals(row.getIsDeleted())) continue;
+                final byte[] iso = row.getBioTemplate();
+                out.add(() -> decodeIso(iso));
+            }
+            return out;
+        };
+    }
+
+    /** Debug and profile builds: the test template as the only onboarded face (none when it does not exist). */
+    static IdentityBinding.TemplateSource fromTestTemplate(File file) {
+        return userId -> {
+            if (!file.isFile()) return Collections.emptyList();
+            final byte[] iso = Files.readAllBytes(file.toPath());
+            return Collections.<FaceBinding.Decoder>singletonList(() -> decodeIso(iso));
+        };
+    }
+
+    /** The image of an ISO/IEC 19794-5 face record as RGB888. */
+    static FaceBinding.Rgb decodeIso(byte[] iso) throws Exception {
+        if (iso == null || iso.length == 0) throw new IOException("no record");
+        FaceBDIR record = new FaceBDIR(new DataInputStream(new ByteArrayInputStream(iso)));
+        return BindingImages.decode(record.getRepresentation().getRepresentationData().getImageData().getImage());
+    }
+
+    /**
+     * Debug and profile builds: a live best frame as an ISO/IEC 19794-5:2011 record holding a JPEG 2000 image, with
+     * the values MOSIP's {@code FaceEncoder.convertFaceImageToISO} uses for registration (that method needs AWT, so the
+     * record is written with the lower-level encoder here).
+     */
+    static byte[] encodeIso(Frame frame) throws IOException {
+        byte[] jp2 = BindingImages.jp2(frame);
+        return FaceEncoder.convertFaceImageToISO19794_5_2011(1178682112L, 808660992L, 0, 0, new Date(), 1, 0, 255, 0,
+                0, 0, 0, 0, new int[] {0, 0, 0}, new int[] {0, 0, 0}, 1, 5, 0, 0,
+                new FaceQualityBlock[] {new FaceQualityBlock(40, 1, 1)}, jp2, frame.width(), frame.height(), 2, 0, 0,
+                0, 1, null, null);
+    }
+
+    /** Debug and profile builds: writes the test template (replacing any earlier one). */
+    static void writeTestTemplate(File file, byte[] iso) throws IOException {
+        File tmp = new File(file.getParentFile(), file.getName() + ".tmp");
+        try (FileOutputStream out = new FileOutputStream(tmp)) {
+            out.write(iso);
+        }
+        if (!tmp.renameTo(file)) {
+            tmp.delete();
+            throw new IOException("the test template could not be written");
+        }
+    }
+}
