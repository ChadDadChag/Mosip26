@@ -0,0 +1,183 @@
+package io.mosip.registration.liveness.android;
+
+import org.junit.AfterClass;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import io.mosip.registration.liveness.analyzer.OnnxFaceAnalyzerFactory;
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.LivenessEngineException;
+import io.mosip.registration.liveness.api.WorkflowType;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/**
+ * Identity binding (F15) on the real matcher (the bundled signed models, desktop ONNX Runtime) with the public-domain
+ * golden images: the held best frame against onboarded faces, the outcomes, retryability, the audit, and that the
+ * frame is used once.
+ */
+public class IdentityBindingTest {
+
+    private static OnnxFaceAnalyzerFactory factory;
+    private static FaceBinding.Rgb portrait, mirrored, crewFace, crew, blank;
+
+    private final long[] now = {1_000};
+    private final List<String> audits = new ArrayList<>();
+    private final Map<String, String> config = new HashMap<>();
+    private FaceBinding.MatcherSource matchers = () -> factory.createMatcher();
+    private final FaceBinding binding = new FaceBinding(() -> factory.createMatcher(), () -> true, () -> 0.45,
+            (wf, id, r) -> { }, () -> now[0]);
+    private final IdentityBinding identity = new IdentityBinding(binding, () -> matchers.open(), config::get,
+            () -> 0.40, (wf, id, d) -> audits.add(wf + "/" + id + "/" + d));
+
+    @BeforeClass
+    public static void load() throws Exception {
+        factory = new OnnxFaceAnalyzerFactory();
+        factory.preload();
+        portrait = FaceBindingTest.png("/golden/portrait_frontal.png");
+        mirrored = FaceBindingTest.mirror(portrait);
+        crew = FaceBindingTest.png("/golden/crew_multi.png");
+        crewFace = FaceBindingTest.crop(crew, 160, 90, 150, 200);
+        byte[] grey = new byte[portrait.rgb.length];
+        java.util.Arrays.fill(grey, (byte) 128);
+        blank = new FaceBinding.Rgb(grey, portrait.width, portrait.height);
+    }
+
+    @AfterClass
+    public static void close() {
+        factory.close();
+    }
+
+    /** Onboarded faces; a null entry does not decode. */
+    private static IdentityBinding.TemplateSource onboarded(FaceBinding.Rgb... faces) {
+        return userId -> {
+            List<FaceBinding.Decoder> out = new ArrayList<>();
+            for (FaceBinding.Rgb f : faces) {
+                out.add(() -> {
+                    if (f == null) throw new IOException("not an ISO 19794-5 record");
+                    return f;
+                });
+            }
+            return out;
+        };
+    }
+
+    private void hold(String session, FaceBinding.Rgb face) {
+        binding.hold(session, WorkflowType.OPERATOR, new Frame(face.rgb, face.width, face.height, 0, 0, "test"));
+    }
+
+    @Test
+    public void theOnboardedFaceMatchesAndTheFrameIsUsedOnce() {
+        hold("s1", portrait);
+        IdentityBinding.Result r = identity.verify("s1", "op1", "password_login", 1, onboarded(mirrored), null);
+        assertEquals("MATCH", r.outcome);
+        assertTrue(r.accepted);
+        assertFalse(r.retryable);
+        assertTrue("similarity " + r.similarity, r.similarity > 0.9);
+        assertEquals(0.40, r.threshold, 0);
+        assertFalse("the best frame is dropped", binding.holding());
+        String audit = audits.get(0);
+        assertTrue(audit, audit.startsWith("OPERATOR/s1/{outcome=MATCH, similarity=0.9"));
+        assertTrue(audit, audit.contains("threshold=0.40, gate=password_login, attempt=1, userId=op1, templates=1, "
+                + "unreadable=0, accepted=true}"));
+
+        IdentityBinding.Result again = identity.verify("s1", "op1", "password_login", 2, onboarded(mirrored), null);
+        assertEquals("NO_LIVE_FRAME", again.outcome);
+        assertFalse(again.accepted);
+        assertTrue(again.retryable);
+    }
+
+    @Test
+    public void anotherPersonIsRejectedAndMayRetry() {
+        hold("s1", portrait);
+        IdentityBinding.Result r = identity.verify("s1", "op1", "packet_auth", 1, onboarded(crewFace), null);
+        assertEquals("NO_MATCH", r.outcome);
+        assertFalse(r.accepted);
+        assertTrue(r.retryable);
+        assertTrue("similarity " + r.similarity, r.similarity < 0.363);
+    }
+
+    @Test
+    public void theBestOfSeveralTemplatesDecidesAndUnreadableOnesAreCounted() {
+        hold("s1", portrait);
+        IdentityBinding.Result r = identity.verify("s1", "sup1", "supervisor_approval", 1,
+                onboarded(crewFace, null, blank, crew, mirrored), null);
+        assertEquals("MATCH", r.outcome);
+        assertTrue(audits.get(0), audits.get(0).contains("templates=5, unreadable=3"));
+    }
+
+    @Test
+    public void withoutAReadableTemplateTheUserGetsInOnPresenceUnlessTemplatesAreRequired() {
+        hold("s1", portrait);
+        IdentityBinding.Result none = identity.verify("s1", "op1", "password_login", 1, onboarded(), null);
+        assertEquals("NOT_BOUND_NO_TEMPLATE", none.outcome);
+        assertTrue(none.accepted);
+        assertFalse(none.retryable);
+        assertTrue(audits.get(0), audits.get(0).contains("requireTemplate=false"));
+
+        hold("s2", portrait);
+        IdentityBinding.Result unreadable = identity.verify("s2", "op1", "password_login", 1, onboarded(blank, crew, null),
+                null);
+        assertEquals("NOT_BOUND_UNREADABLE", unreadable.outcome);
+        assertTrue(unreadable.accepted);
+
+        config.put(IdentityBinding.REQUIRE_TEMPLATE_KEY, "true");
+        hold("s3", portrait);
+        IdentityBinding.Result required = identity.verify("s3", "op1", "password_login", 1, onboarded(), null);
+        assertFalse(required.accepted);
+        assertFalse("a new session cannot help", required.retryable);
+        assertTrue(audits.get(2), audits.get(2).contains("requireTemplate=true"));
+    }
+
+    @Test
+    public void everyOtherFailureFailsClosed() {
+        hold("s1", portrait);
+        assertEquals("another session", "NO_LIVE_FRAME",
+                identity.verify("s2", "op1", "password_login", 1, onboarded(mirrored), null).outcome);
+
+        hold("s1", portrait);
+        now[0] += FaceBinding.TTL_MS;
+        assertEquals("expired", "NO_LIVE_FRAME",
+                identity.verify("s1", "op1", "password_login", 1, onboarded(mirrored), null).outcome);
+
+        hold("s1", portrait);
+        IdentityBinding.Result broken = identity.verify("s1", "op1", "password_login", 1,
+                userId -> { throw new IllegalStateException("database closed"); }, null);
+        assertEquals("ERROR", broken.outcome);
+        assertTrue(broken.retryable);
+
+        matchers = () -> { throw new LivenessEngineException(ErrorCode.ENGINE_ERROR, "closed"); };
+        hold("s1", portrait);
+        assertEquals("ERROR", identity.verify("s1", "op1", "password_login", 1, onboarded(mirrored), null).outcome);
+        matchers = () -> factory.createMatcher();
+
+        hold("s1", blank);
+        IdentityBinding.Result noFace = identity.verify("s1", "op1", "password_login", 1, onboarded(mirrored), null);
+        assertEquals("NO_LIVE_FACE", noFace.outcome);
+        assertFalse(noFace.accepted);
+        assertTrue(noFace.retryable);
+    }
+
+    @Test
+    public void switchedOffIsAuditedAsSkipped() {
+        config.put(IdentityBinding.ENABLED_KEY, "false");
+        hold("s1", portrait);
+        IdentityBinding.Result r = identity.verify("s1", "op1", "password_login", 1, onboarded(crewFace),
+                java.util.Collections.singletonMap("templateSource", "diagnostics-test"));
+        assertEquals("SKIPPED", r.outcome);
+        assertTrue(r.accepted);
+        assertTrue(audits.get(0), audits.get(0).contains("templateSource=diagnostics-test"));
+        assertTrue(IdentityBinding.enabled(null));
+        assertTrue(IdentityBinding.enabled("true"));
+        assertFalse(IdentityBinding.enabled(" FALSE "));
+    }
+}
