+    @Override
+    public void enrollIdentityTestTemplate(@NonNull String sessionId, @NonNull LivenessPigeon.Result<String> result) {
+        if (!BuildConfig.LIVENESS_DIAGNOSTICS) {
+            result.success("NOT_ALLOWED");
+            return;
+        }
+        holder.bindingWorker().execute(() -> {
+            String outcome;
+            FaceBinding.Held held = holder.binding().take(sessionId);
+            if (held == null) {
+                outcome = "NO_LIVE_FRAME";
+            } else {
+                try {
+                    IdentityTemplates.writeTestTemplate(identityTestTemplate(), IdentityTemplates.encodeIso(held.bestFrame));
+                    outcome = "ENROLLED";
+                } catch (IOException | RuntimeException | LinkageError e) {
+                    outcome = "FAILED";
+                }
+            }
+            Log.i(TAG, "identity test template: " + outcome);
+            final String done = outcome;
+            main.post(() -> result.success(done));
+        });
+    }
+
+    @NonNull
+    @Override
+    public Boolean deleteIdentityTestTemplate() {
+        if (!BuildConfig.LIVENESS_DIAGNOSTICS) return false;
+        boolean deleted = identityTestTemplate().delete();
+        Log.i(TAG, "identity test template deleted: " + deleted);
+        return deleted;
+    }
+
+    @NonNull
+    @Override
+    public Boolean hasIdentityTestTemplate() {
+        return BuildConfig.LIVENESS_DIAGNOSTICS && identityTestTemplate().isFile();
+    }
