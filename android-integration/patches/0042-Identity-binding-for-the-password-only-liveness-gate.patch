--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/IdentityBinding.java
@@ -0,0 +1,186 @@
+package io.mosip.registration.liveness.android;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.function.DoubleSupplier;
+import java.util.function.Function;
+
+import io.mosip.registration.liveness.analyzer.match.FaceMatcher;
+import io.mosip.registration.liveness.analyzer.match.IdentityResult;
+import io.mosip.registration.liveness.api.Frame;
+import io.mosip.registration.liveness.api.WorkflowType;
+
+/**
+ * Identity binding (F15) on Android: after a liveness gate that no face capture follows (the operator's password
+ * login, the operator's packet authentication, the supervisor's approval), the live face must be that user's face
+ * onboarded on this device.
+ *
+ * <p>F1 binds the live face to an SBI capture; these gates have none, so liveness alone proves only that some live
+ * person is there. {@link #verify} takes the PASSED session's held best frame ({@link FaceBinding#take}) and compares it
+ * with the user's onboarded faces ({@link TemplateSource}: the Room {@code user_biometric} Face rows, a bare ISO/IEC
+ * 19794-5 record each), with {@code FaceMatcher.identify}: the same detection and alignment as F1, the best of several
+ * templates, and its own threshold ({@value #THRESHOLD_KEY}, provisional 0.40).
+ *
+ * <p>F15 is a second factor after the password: a false match lets in someone who has the password AND a similar face.
+ * <ul>
+ *   <li>MATCH: accepted.</li>
+ *   <li>NO_MATCH, NO_LIVE_FACE, NO_LIVE_FRAME (nothing held for the session), ERROR: rejected and retryable (one new
+ *       liveness session, then the gate is blocked).</li>
+ *   <li>NOT_BOUND_NO_TEMPLATE, NOT_BOUND_UNREADABLE (no onboarded face on this device, or none decodes to one face):
+ *       accepted on presence alone, unless {@value #REQUIRE_TEMPLATE_KEY} is true (then rejected, not retryable).</li>
+ *   <li>{@value #ENABLED_KEY} false: SKIPPED, accepted.</li>
+ * </ul>
+ * Every decision is audited (REG-EVT-020): codes, the similarity (2 decimals), the threshold, the gate, the attempt,
+ * the user id and template counts. The Room rows have no creation time, so there is no template age. Images and
+ * templates stay in memory.
+ */
+public final class IdentityBinding {
+
+    public static final String ENABLED_KEY = "mosip.registration.liveness.face.binding.identity.enabled";
+    public static final String REQUIRE_TEMPLATE_KEY = "mosip.registration.liveness.face.binding.identity.requireTemplate";
+    public static final String THRESHOLD_KEY = "mosip.registration.liveness.face.binding.identity.threshold";
+
+    /** The user's onboarded faces, each decoded on the worker thread. An empty list: none on this device. */
+    public interface TemplateSource {
+        List<FaceBinding.Decoder> load(String userId) throws Exception;
+    }
+
+    public interface Audit {
+        void identity(WorkflowType workflow, String sessionId, Map<String, String> details);
+    }
+
+    /** The decision. similarity is NaN unless a template was compared; only the debug page shows it. */
+    public static final class Result {
+        public final String outcome;
+        public final double similarity;
+        public final double threshold;
+        public final boolean accepted;
+        public final boolean retryable;
+
+        Result(String outcome, double similarity, double threshold, boolean accepted, boolean retryable) {
+            this.outcome = outcome;
+            this.similarity = similarity;
+            this.threshold = threshold;
+            this.accepted = accepted;
+            this.retryable = retryable;
+        }
+
+        @Override
+        public String toString() {
+            return outcome + (accepted ? " (accepted)" : retryable ? " (rejected, retryable)" : " (rejected)");
+        }
+    }
+
+    private final FaceBinding binding;
+    private final FaceBinding.MatcherSource matchers;
+    private final Function<String, String> config;
+    private final DoubleSupplier threshold;
+    private final Audit audit;
+
+    public IdentityBinding(FaceBinding binding, FaceBinding.MatcherSource matchers, Function<String, String> config,
+                           DoubleSupplier threshold, Audit audit) {
+        if (binding == null || matchers == null || config == null || threshold == null || audit == null) {
+            throw new IllegalArgumentException("null argument");
+        }
+        this.binding = binding;
+        this.matchers = matchers;
+        this.config = config;
+        this.threshold = threshold;
+        this.audit = audit;
+    }
+
+    /**
+     * The check after a PASSED gate: consumes the held best frame of {@code sessionId}. Blocking (loading, decoding
+     * and matching take a few hundred ms): call it on a worker thread. Never throws.
+     *
+     * @param gate    password_login, packet_auth or supervisor_approval (audited)
+     * @param attempt 1 for the gate's first liveness session, 2 for the retry (audited)
+     * @param extra   audit details of the caller (the debug page's templateSource=diagnostics-test), or null
+     */
+    public Result verify(String sessionId, String userId, String gate, int attempt, TemplateSource templates,
+                         Map<String, String> extra) {
+        Map<String, String> d = new LinkedHashMap<>();
+        d.put("gate", gate == null ? "NA" : gate);
+        d.put("attempt", Integer.toString(attempt));
+        d.put("userId", userId == null ? "NA" : userId);
+        if (extra != null) d.putAll(extra);
+        double t = threshold.getAsDouble();
+        if (!enabled(config.apply(ENABLED_KEY))) {
+            return finish(null, sessionId, new Result("SKIPPED", Double.NaN, t, true, false), d);
+        }
+        FaceBinding.Held held = binding.take(sessionId);
+        if (held == null) {
+            return finish(null, sessionId, new Result("NO_LIVE_FRAME", Double.NaN, t, false, true), d);
+        }
+        String outcome;
+        double similarity = Double.NaN;
+        int unreadable = 0;
+        List<Frame> faces = new ArrayList<>();
+        try {
+            List<FaceBinding.Decoder> stored = templates == null ? null : templates.load(userId);
+            if (stored != null) {
+                for (FaceBinding.Decoder decoder : stored) faces.add(decode(decoder));
+            }
+            if (faces.isEmpty()) {
+                // No onboarded face: as FaceMatcher.identify decides, without loading the matcher.
+                outcome = IdentityResult.Outcome.NOT_BOUND_NO_TEMPLATE.name();
+            } else {
+                try (FaceMatcher m = matchers.open()) {
+                    IdentityResult r = m.identify(held.bestFrame, faces);
+                    outcome = r.outcome.name();
+                    similarity = r.similarity;
+                    t = r.threshold;
+                    unreadable = r.unreadable;
+                }
+            }
+        } catch (Exception | LinkageError e) {
+            return finish(held.workflow, sessionId, new Result("ERROR", Double.NaN, t, false, true), d);
+        }
+        d.put("templates", Integer.toString(faces.size()));
+        d.put("unreadable", Integer.toString(unreadable));
+        boolean accepted;
+        boolean retryable;
+        if (IdentityResult.Outcome.MATCH.name().equals(outcome)) {
+            accepted = true;
+            retryable = false;
+        } else if (outcome.startsWith("NOT_BOUND")) {
+            boolean required = "true".equalsIgnoreCase(String.valueOf(config.apply(REQUIRE_TEMPLATE_KEY)).trim());
+            d.put("requireTemplate", Boolean.toString(required));
+            accepted = !required;
+            retryable = false;
+        } else {
+            accepted = false;
+            retryable = true;
+        }
+        return finish(held.workflow, sessionId, new Result(outcome, similarity, t, accepted, retryable), d);
+    }
+
+    /** {@value #ENABLED_KEY}: anything but "false" (or no value) keeps it on. */
+    static boolean enabled(String value) {
+        return value == null || !"false".equalsIgnoreCase(value.trim());
+    }
+
+    /** One template as RGB888, or null when it does not decode (counted as unreadable). */
+    private static Frame decode(FaceBinding.Decoder decoder) {
+        try {
+            FaceBinding.Rgb rgb = decoder.decode();
+            return rgb == null || rgb.rgb == null ? null : new Frame(rgb.rgb, rgb.width, rgb.height, 0, 0, "template");
+        } catch (Exception | LinkageError e) {
+            return null;
+        }
+    }
+
+    private Result finish(WorkflowType workflow, String sessionId, Result r, Map<String, String> d) {
+        Map<String, String> details = new LinkedHashMap<>();
+        details.put("outcome", r.outcome);
+        details.put("similarity", Double.isNaN(r.similarity) ? "NaN" : String.format(Locale.ROOT, "%.2f", r.similarity));
+        details.put("threshold", String.format(Locale.ROOT, "%.2f", r.threshold));
+        details.putAll(d);
+        details.put("accepted", Boolean.toString(r.accepted));
+        audit.identity(workflow, sessionId, details);
+        return r;
+    }
+}
