diff --git a/test/liveness/identity_binding_test.dart b/test/liveness/identity_binding_test.dart
new file mode 100644
index 0000000..6eb3b53
--- /dev/null
+++ b/test/liveness/identity_binding_test.dart
@@ -0,0 +1,164 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:registration_client/ui/liveness/identity_binding.dart';
+import 'package:registration_client/ui/liveness/liveness_gate.dart';
+import 'package:registration_client/ui/liveness/liveness_page.dart';
+
+import 'fake_liveness_service.dart';
+
+/// Identity binding (F15) in the password-only steps (operator login, packet
+/// authentication, supervisor approval all call IdentityBinding.run), with the
+/// gate, the native check and the retry dialog mocked.
+void main() {
+  late BuildContext ctx;
+  late FakeLivenessService service;
+  late List<GateResult> gates;
+  late int gateRuns;
+  late List<bool> retryAnswers;
+  late int asked;
+
+  setUp(() {
+    service = FakeLivenessService();
+    gates = [];
+    gateRuns = 0;
+    retryAnswers = [];
+    asked = 0;
+  });
+
+  Future<void> pumpHost(WidgetTester tester) async {
+    await tester.pumpWidget(MaterialApp(home: Builder(builder: (c) {
+      ctx = c;
+      return const SizedBox();
+    })));
+  }
+
+  GateResult passed([String id = 's-1']) =>
+      GateResult.fromOutcome(LivenessOutcome(passed: true, sessionId: id));
+
+  Future<IdentityGateResult> run({String gate = IdentityBinding.passwordLogin}) => IdentityBinding.run(
+        ctx,
+        workflow: LivenessGate.operator,
+        userId: 'op1',
+        gate: gate,
+        service: service,
+        runGate: () async => gates[(gateRuns++).clamp(0, gates.length - 1)],
+        askRetry: () async {
+          asked++;
+          return retryAnswers.isEmpty ? false : retryAnswers.removeAt(0);
+        },
+      );
+
+  testWidgets('the onboarded face proceeds after one gate', (tester) async {
+    await pumpHost(tester);
+    gates = [passed()];
+    final r = await run();
+    expect(r.step, IdentityGateStep.proceed);
+    expect(r.proceed, isTrue);
+    expect(r.messageKey, isNull);
+    expect(service.identityCalls, ['s-1/op1/password_login/1']);
+    expect(asked, 0);
+  });
+
+  testWidgets('a different face gets one retry, a new session, then proceeds when it matches', (tester) async {
+    await pumpHost(tester);
+    gates = [passed('s-1'), passed('s-2')];
+    service.identityResults = [identity('NO_MATCH'), identity('MATCH')];
+    retryAnswers = [true];
+    final r = await run(gate: IdentityBinding.packetAuth);
+    expect(r.step, IdentityGateStep.proceed);
+    expect(gateRuns, 2);
+    expect(asked, 1);
+    expect(service.identityCalls, ['s-1/op1/packet_auth/1', 's-2/op1/packet_auth/2']);
+  });
+
+  testWidgets('a second rejection is not verified, with the generic text', (tester) async {
+    await pumpHost(tester);
+    gates = [passed('s-1'), passed('s-2')];
+    service.identityResults = [identity('NO_MATCH')];
+    retryAnswers = [true, true];
+    final r = await run();
+    expect(r.step, IdentityGateStep.notVerified);
+    expect(r.messageKey, 'liveness.error.identity_not_verified');
+    expect(gateRuns, 2, reason: 'one retry only');
+    expect(asked, 1);
+  });
+
+  testWidgets('Cancel on the retry question is not verified', (tester) async {
+    await pumpHost(tester);
+    gates = [passed()];
+    service.identityResults = [identity('NO_MATCH')];
+    retryAnswers = [false];
+    expect((await run()).step, IdentityGateStep.notVerified);
+    expect(gateRuns, 1);
+  });
+
+  testWidgets('no onboarded face proceeds on presence alone; a required template stops without a retry',
+      (tester) async {
+    await pumpHost(tester);
+    gates = [passed()];
+    service.identityResults = [identity('NOT_BOUND_NO_TEMPLATE')];
+    expect((await run()).step, IdentityGateStep.proceed);
+
+    gateRuns = 0;
+    service.identityResults = [identity('NOT_BOUND_UNREADABLE', accepted: false, retryable: false)];
+    service.identityCalls.clear();
+    final r = await run();
+    expect(r.step, IdentityGateStep.notVerified);
+    expect(asked, 0, reason: 'a new session cannot help');
+  });
+
+  testWidgets('a native error or a missing session id is retried once, then not verified', (tester) async {
+    await pumpHost(tester);
+    gates = [passed(''), passed('s-2')];
+    service.throwOnIdentity = StateError('channel');
+    retryAnswers = [true];
+    final r = await run();
+    expect(r.step, IdentityGateStep.notVerified);
+    expect(gateRuns, 2);
+    expect(service.identityCalls, ['s-2/op1/password_login/2'], reason: 'no call without a session id');
+  });
+
+  testWidgets('cancelled, blocked and disabled gates never call the check', (tester) async {
+    await pumpHost(tester);
+    gates = [GateResult.cancelled()];
+    expect((await run()).step, IdentityGateStep.cancelled);
+    expect((await run()).messageKey, isNull);
+    gateRuns = 0;
+    gates = [GateResult.blocked(const LivenessOutcome(failureCode: 'PAD_FAILURE', userMessage: 'DEVICE_PROBLEM'))];
+    final blocked = await run();
+    expect(blocked.step, IdentityGateStep.blocked);
+    expect(blocked.messageKey, 'liveness.error.device_problem');
+    gateRuns = 0;
+    gates = [GateResult.proceed(disabled: true)];
+    expect((await run()).step, IdentityGateStep.proceed, reason: 'liveness disabled: the legacy flow');
+    expect(service.identityCalls, isEmpty);
+  });
+
+  testWidgets('the retry question shows the generic text with Retry and Cancel, never a score', (tester) async {
+    await tester.pumpWidget(MaterialApp(
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      home: Builder(builder: (c) {
+        ctx = c;
+        return const SizedBox();
+      }),
+    ));
+    gates = [passed('s-1'), passed('s-2')];
+    service.identityResults = [identity('NO_MATCH'), identity('MATCH')];
+    final Future<IdentityGateResult> result = IdentityBinding.run(ctx,
+        workflow: LivenessGate.supervisor,
+        userId: 'sup1',
+        gate: IdentityBinding.supervisorApproval,
+        service: service,
+        runGate: () async => gates[(gateRuns++).clamp(0, gates.length - 1)]);
+    await tester.pumpAndSettle();
+    expect(find.text('Face verification could not be completed for this user. Please try again.'), findsOneWidget);
+    expect(find.byKey(const Key('identityCancel')), findsOneWidget);
+    expect(find.textContaining('0.'), findsNothing);
+    await tester.tap(find.byKey(const Key('identityRetry')));
+    await tester.pumpAndSettle();
+    expect((await result).step, IdentityGateStep.proceed);
+    expect(service.identityCalls, ['s-1/sup1/supervisor_approval/1', 's-2/sup1/supervisor_approval/2']);
+  });
+}
