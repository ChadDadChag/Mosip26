+/// NOT_BOUND_UNREADABLE, SKIPPED (identity binding disabled) or ERROR.
+/// accepted: the flow may go on. retryable: one new liveness session may help.
+/// similarity is NaN in release builds: only the debug page shows it.
+class IdentityCheckInfo {
+  final String outcome;
+  final bool accepted;
+  final bool retryable;
+  final double similarity;
