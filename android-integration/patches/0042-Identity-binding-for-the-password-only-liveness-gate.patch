diff --git a/lib/ui/liveness/identity_binding.dart b/lib/ui/liveness/identity_binding.dart
new file mode 100644
index 0000000..626d122
--- /dev/null
+++ b/lib/ui/liveness/identity_binding.dart
@@ -0,0 +1,147 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:registration_client/pigeon/liveness_pigeon.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+import 'package:registration_client/ui/liveness/liveness_gate.dart';
+import 'package:registration_client/ui/liveness/liveness_strings.dart';
+
+/// How a password-only step with identity binding (F15) ended.
+enum IdentityGateStep {
+  /// Liveness passed and the live face is the user's onboarded face; or the
+  /// user has none on this device and templates are not required; or liveness
+  /// is disabled for the workflow. The step goes on.
+  proceed,
+
+  /// The person backed out of the liveness page: nothing happened.
+  cancelled,
+
+  /// Liveness failed: the page already showed the recovery text.
+  blocked,
+
+  /// Liveness passed, but the live face was not verified as the user's, after
+  /// the one retry. The step is refused; show [IdentityBinding.messageKey].
+  notVerified,
+}
+
+/// What [IdentityBinding.run] returns: the step, and the last liveness gate's result.
+@immutable
+class IdentityGateResult {
+  const IdentityGateResult(this.step, [this.gate]);
+
+  final IdentityGateStep step;
+  final GateResult? gate;
+
+  bool get proceed => step == IdentityGateStep.proceed;
+  bool get cancelled => step == IdentityGateStep.cancelled;
+
+  /// The canonical key of the short text to show when the step does not go on:
+  /// none when cancelled, the gate's failure text when blocked, and
+  /// [IdentityBinding.messageKey] when not verified.
+  String? get messageKey {
+    switch (step) {
+      case IdentityGateStep.blocked:
+        return gate?.failureMessageKey ?? 'liveness.error.max_attempts_reached';
+      case IdentityGateStep.notVerified:
+        return IdentityBinding.messageKey;
+      default:
+        return null;
+    }
+  }
+
+  @override
+  String toString() => 'IdentityGateResult(${step.name}, $gate)';
+}
+
+/// Identity binding (F15, docs/ui-liveness-spec.md section 6) for the steps
+/// that no face capture follows: the operator's password login, the
+/// operator's packet authentication and the supervisor's approval.
+///
+/// [run] runs the liveness gate, then compares the gate's best frame with the
+/// user's face onboarded on this device (natively, verifyIdentity). A rejection
+/// that a new session can fix shows [messageKey] with Retry and Cancel; Retry
+/// runs one new liveness session. A second rejection, Cancel, or a rejection a
+/// retry cannot fix is [IdentityGateStep.notVerified]. No score is ever shown.
+class IdentityBinding {
+  IdentityBinding._();
+
+  /// The generic text of a face that was not verified as the user's.
+  static const String messageKey = 'liveness.error.identity_not_verified';
+
+  static const String passwordLogin = 'password_login';
+  static const String packetAuth = 'packet_auth';
+  static const String supervisorApproval = 'supervisor_approval';
+
+  /// Liveness sessions per step: the first, and one retry after a rejection.
+  static const int attempts = 2;
+
+  static Future<IdentityGateResult> run(
+    BuildContext context, {
+    required String workflow,
+    required String userId,
+    required String gate,
+    LivenessService? service,
+    Future<GateResult> Function()? runGate,
+    Future<bool> Function()? askRetry,
+  }) async {
+    final LivenessService svc = service ?? LivenessService();
+    for (int attempt = 1; attempt <= attempts; attempt++) {
+      final GateResult liveness = await (runGate ??
+          () => LivenessGate.run(context, workflow: workflow, service: service))();
+      IdentityGateResult end(IdentityGateStep step) => IdentityGateResult(step, liveness);
+      if (liveness.cancelled) return end(IdentityGateStep.cancelled);
+      if (!liveness.proceed) return end(IdentityGateStep.blocked);
+      if (liveness.disabled) return end(IdentityGateStep.proceed); // liveness off: the legacy flow
+      final IdentityCheckInfo? check = await _verify(svc, liveness.sessionId, userId, gate, attempt);
+      if (check != null && check.accepted) return end(IdentityGateStep.proceed);
+      final bool retryable = check == null || check.retryable; // an error may pass on a new session
+      if (!retryable || attempt == attempts || !context.mounted) return end(IdentityGateStep.notVerified);
+      if (!await (askRetry ?? () => _askRetry(context))()) return end(IdentityGateStep.notVerified);
+    }
+    return const IdentityGateResult(IdentityGateStep.notVerified);
+  }
+
+  /// The native check; null (an error, fail closed) when it could not run.
+  static Future<IdentityCheckInfo?> _verify(
+      LivenessService service, String? sessionId, String userId, String gate, int attempt) async {
+    if (sessionId == null || sessionId.isEmpty) return null;
+    try {
+      return await service.verifyIdentity(sessionId, userId, gate, attempt);
+    } catch (e) {
+      debugPrint('Identity binding could not run: ${e.runtimeType}');
+      return null;
+    }
+  }
+
+  static Future<bool> _askRetry(BuildContext context) async {
+    final AppLocalizations? l = AppLocalizations.of(context);
+    String text(String key) => l == null ? key : livenessText(l, key);
+    final bool? retry = await showDialog<bool>(
+      context: context,
+      barrierDismissible: false,
+      builder: (dialog) => AlertDialog(
+        content: Text(text(messageKey)),
+        actions: [
+          TextButton(
+            key: const Key('identityCancel'),
+            onPressed: () => Navigator.of(dialog).pop(false),
+            child: Text(text('liveness.button.cancel')),
+          ),
+          TextButton(
+            key: const Key('identityRetry'),
+            onPressed: () => Navigator.of(dialog).pop(true),
+            child: Text(text('liveness.button.retry')),
+          ),
+        ],
+      ),
+    );
+    return retry ?? false;
+  }
+}
