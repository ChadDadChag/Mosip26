+  /// "Test face enrolled · today 13:16" (or its date), or "No test face enrolled".
+  String _enrolledText() {
+    final at = _identityEnrolledAt;
+    if (at == null) return 'No test face enrolled';
+    // File.lastModified is 0 when the time cannot be read.
+    if (at <= 0) return 'Test face enrolled';
+    final t = DateTime.fromMillisecondsSinceEpoch(at);
+    final now = DateTime.now();
+    String two(int v) => v.toString().padLeft(2, '0');
+    final day = t.year == now.year && t.month == now.month && t.day == now.day
+        ? 'today'
+        : '${t.day} ${_months[t.month - 1]}${t.year == now.year ? '' : ' ${t.year}'}';
+    return 'Test face enrolled · $day ${two(t.hour)}:${two(t.minute)}';
+  }
+
+  /// "Similarity 0.82 · needed 0.40" when faces were compared (the number reaches Dart in diagnostics builds only).
+  static String? _similarityText(IdentityCheckInfo info) {
+    if (info.similarity.isNaN) return null;
+    final similarity = 'Similarity ${info.similarity.toStringAsFixed(2)}';
+    return info.threshold.isNaN ? similarity : '$similarity · needed ${info.threshold.toStringAsFixed(2)}';
+  }
