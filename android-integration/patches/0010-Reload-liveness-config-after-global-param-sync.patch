+
+    @Test
+    public void theCameraComesFromTheConfig() {
+        assertEquals("front", holder.cameraFor(WorkflowType.RESIDENT));
+        synced.put(FACE + "android.operator.camera", "back");
+        assertEquals("back", holder.cameraFor(WorkflowType.OPERATOR));
+        synced.put(FACE + "android.supervisor.camera", " BACK ");
+        assertEquals("back", holder.cameraFor(WorkflowType.SUPERVISOR));
+        synced.put(FACE + "android.resident.camera", "rear");
+        assertEquals("front", holder.cameraFor(WorkflowType.RESIDENT));
+    }
+
+    @Test
+    public void theAnalyzerIsReplacedOnlyWhenItsSettingsChange() {
+        holder.reloadConfig();
+        assertEquals(0, holder.analyzerSwaps());
+        holder.setOverride(AnalyzerConfig.KEY_PREFIX + "intraOpThreads", "3"); // the default is 2
+        assertEquals(1, holder.analyzerSwaps());
+        holder.reloadConfig();
+        assertEquals(1, holder.analyzerSwaps());
+    }
+
+    @Test
+    public void theFingerprintCoversNestedSettings() {
+        Map<String, String> cfg = new HashMap<>();
+        String base = LivenessServiceHolder.fingerprint(AnalyzerConfig.fromConfig(cfg::get));
+        cfg.put(AnalyzerConfig.KEY_PREFIX + "detectorMaxWidth", "256"); // the default is 320
+        String changed = LivenessServiceHolder.fingerprint(AnalyzerConfig.fromConfig(cfg::get));
+        assertNotEquals(base, changed);
+        assertTrue(changed, changed.contains("detector={"));
+    }
+}
diff --git a/android/liveness/src/test/java/io/mosip/registration/liveness/android/SwappableAnalyzerFactoryTest.java b/android/liveness/src/test/java/io/mosip/registration/liveness/android/SwappableAnalyzerFactoryTest.java
new file mode 100644
index 0000000..84fe5c4
--- /dev/null
+++ b/android/liveness/src/test/java/io/mosip/registration/liveness/android/SwappableAnalyzerFactoryTest.java
@@ -0,0 +1,65 @@
+package io.mosip.registration.liveness.android;
+
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.fail;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import org.junit.Test;
+
+import io.mosip.registration.liveness.analyzer.OnnxFaceAnalyzerFactory;
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.FaceAnalyzer;
+import io.mosip.registration.liveness.api.LivenessEngineException;
+
+public class SwappableAnalyzerFactoryTest {
+
+    private final OnnxFaceAnalyzerFactory first = mock(OnnxFaceAnalyzerFactory.class);
+    private final OnnxFaceAnalyzerFactory second = mock(OnnxFaceAnalyzerFactory.class);
+    private final FaceAnalyzer firstAnalyzer = mock(FaceAnalyzer.class);
+    private final FaceAnalyzer secondAnalyzer = mock(FaceAnalyzer.class);
+
+    @Test
+    public void anUnusedFactoryClosesAtOnce() {
+        SwappableAnalyzerFactory f = new SwappableAnalyzerFactory(first);
+        f.swap(second);
+        verify(first).close();
+        assertSame(second, f.current());
+    }
+
+    @Test
+    public void aRunningSessionKeepsItsAnalyzerUntilItCloses() throws Exception {
+        when(first.create()).thenReturn(firstAnalyzer);
+        when(second.create()).thenReturn(secondAnalyzer);
+        SwappableAnalyzerFactory f = new SwappableAnalyzerFactory(first);
+        FaceAnalyzer running = f.create();
+
+        f.swap(second);
+        verify(first, never()).close();
+        FaceAnalyzer next = f.create();
+        assertSame(secondAnalyzer, ((SwappableAnalyzerFactory.Counted) next).inner());
+
+        running.close();
+        running.close(); // closing twice releases once
+        verify(firstAnalyzer).close();
+        verify(first, times(1)).close();
+        verify(second, never()).close();
+    }
+
+    @Test
+    public void aFailedCreateReleasesItsClaim() throws Exception {
+        when(first.create()).thenThrow(new LivenessEngineException(ErrorCode.MODEL_INTEGRITY_FAILED, "bad bundle"));
+        SwappableAnalyzerFactory f = new SwappableAnalyzerFactory(first);
+        try {
+            f.create();
+            fail("expected LivenessEngineException");
+        } catch (LivenessEngineException expected) {
+            // the claim on the factory is released
+        }
+        f.swap(second);
+        verify(first).close();
+    }
+}
