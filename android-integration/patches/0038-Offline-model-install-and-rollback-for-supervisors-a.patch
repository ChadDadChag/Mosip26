+    @Override
+    public void installModelBundleFromFile(@NonNull LivenessPigeon.Result<LivenessPigeon.ModelBundleActionResult> result) {
+        if (!holder.modelBundleActionsAllowed()) {
+            holder.background().execute(() -> {
+                LivenessServiceHolder.ModelBundleResult r = holder.installOfflineBundle(null); // NOT_ALLOWED, audited
+                main.post(() -> result.success(toPigeon(r)));
+            });
+            return;
+        }
+        MainActivity activity = activityRef == null ? null : activityRef.get();
+        if (activity == null) {
+            result.success(outcome("FAILED"));
+            return;
+        }
+        if (pendingModelBundlePick != null) pendingModelBundlePick.success(outcome("CANCELLED")); // a second tap wins
+        pendingModelBundlePick = result;
+        Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        pick.addCategory(Intent.CATEGORY_OPENABLE);
+        pick.setType("*/*");
+        pick.putExtra(Intent.EXTRA_MIME_TYPES,
+                new String[] {"application/zip", "application/x-zip-compressed", "application/octet-stream"});
+        try {
+            activity.startActivityForResult(pick, PICK_MODEL_BUNDLE);
+        } catch (ActivityNotFoundException e) {
+            pendingModelBundlePick = null;
+            result.success(outcome("FAILED"));
+        }
+    }
+
+    /**
+     * From {@code MainActivity.onActivityResult} for {@link #PICK_MODEL_BUNDLE}, whatever the result code: copies the
+     * picked document to the cache (at most 64 MiB + 1 byte, so a larger file is refused by the install), installs it
+     * on the background thread and deletes the copy. A closed picker is CANCELLED, with nothing to audit.
+     */
+    public void onModelBundlePicked(int resultCode, Intent data) {
+        LivenessPigeon.Result<LivenessPigeon.ModelBundleActionResult> result = pendingModelBundlePick;
+        pendingModelBundlePick = null;
+        if (result == null) return;
+        Uri uri = resultCode == Activity.RESULT_OK && data != null ? data.getData() : null;
+        if (uri == null) {
+            result.success(outcome("CANCELLED"));
+            return;
+        }
+        ContentResolver resolver = holder.context().getContentResolver();
+        holder.background().execute(() -> {
+            File copy = new File(holder.context().getCacheDir(), "model-bundle-" + UUID.randomUUID() + ".zip");
+            try {
+                copyAtMost(resolver, uri, copy, MAX_PICKED_BYTES);
+            } catch (IOException | RuntimeException e) {
+                Log.w(TAG, "picked model bundle not readable: " + e.getClass().getSimpleName());
+                if (copy.exists() && !copy.delete()) Log.w(TAG, "could not delete a partial model bundle copy");
+            }
+            LivenessServiceHolder.ModelBundleResult r;
+            try {
+                r = holder.installOfflineBundle(copy); // a missing copy is a STORAGE failure, audited
+            } finally {
+                if (copy.exists() && !copy.delete()) Log.w(TAG, "could not delete the model bundle copy");
+            }
+            main.post(() -> result.success(toPigeon(r)));
+        });
+    }
+
+    @Override
+    public void rollbackModelBundleFromSettings(
+            @NonNull LivenessPigeon.Result<LivenessPigeon.ModelBundleActionResult> result) {
+        holder.background().execute(() -> {
+            LivenessServiceHolder.ModelBundleResult r = holder.rollbackOfflineBundle();
+            main.post(() -> result.success(toPigeon(r)));
+        });
+    }
+
+    private static void copyAtMost(ContentResolver resolver, Uri uri, File to, long max) throws IOException {
+        try (InputStream in = resolver.openInputStream(uri); OutputStream out = new FileOutputStream(to)) {
+            if (in == null) throw new IOException("no stream");
+            byte[] buf = new byte[64 * 1024];
+            long total = 0;
+            int n;
+            while (total < max && (n = in.read(buf, 0, (int) Math.min(buf.length, max - total))) > 0) {
+                out.write(buf, 0, n);
+                total += n;
+            }
+        }
+    }
+
+    private static LivenessPigeon.ModelBundleActionResult toPigeon(LivenessServiceHolder.ModelBundleResult r) {
+        return new LivenessPigeon.ModelBundleActionResult.Builder().setOutcome(r.outcome.name())
+                .setFromVersion(r.fromVersion).setToVersion(r.toVersion).build();
+    }
+
+    private static LivenessPigeon.ModelBundleActionResult outcome(String outcome) {
+        return new LivenessPigeon.ModelBundleActionResult.Builder().setOutcome(outcome).build();
+    }
