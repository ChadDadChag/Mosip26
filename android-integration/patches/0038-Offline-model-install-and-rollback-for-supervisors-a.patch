+    }
+
+    /** {@value #OFFLINE_INSTALL_KEY}: true unless the synced config (or an override) says false. */
+    public boolean offlineInstallEnabled() {
+        String v = config.get(OFFLINE_INSTALL_KEY);
+        return v == null || !"false".equalsIgnoreCase(v.trim());
+    }
+
+    /** The production page and its entry are shown only when this is true; the actions check it again. */
+    public boolean modelBundleActionsAllowed() {
+        return offlineInstallEnabled() && modelBundleUser.maySupervise();
+    }
+
+    /** The model bundle version new sessions use (store or bundled), or null when unreadable. */
+    public String activeModelVersion() {
+        return ModelUpdater.activeVersion(modelStore(), bundledModels);
