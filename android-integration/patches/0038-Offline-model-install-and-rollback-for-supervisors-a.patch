+    // ---- F17: offline model install and rollback from the production page (supervisors and admins) ----
+
+    /** Offline model install from removable media: on unless the synced config says false. */
+    public static final String OFFLINE_INSTALL_KEY = "mosip.registration.liveness.model.offlineInstall.enabled";
+
+    /** Who is logged in, as the app knows it (SessionManager). Until the app sets one, nobody may act. */
+    public interface ModelBundleUser {
+        /** A logged-in supervisor or admin. */
+        boolean maySupervise();
+
+        /** The user id for the audit, or null. */
+        String id();
+    }
+
+    private static final ModelBundleUser NOBODY = new ModelBundleUser() {
+        @Override public boolean maySupervise() {
+            return false;
+        }
+
+        @Override public String id() {
+            return null;
+        }
+    };
+
+    private volatile ModelBundleUser modelBundleUser = NOBODY;
+
+    /** What an offline install or a rollback did; the UI maps it to a generic text, never to paths or exceptions. */
+    public enum ModelBundleOutcome { INSTALLED, ROLLED_BACK, NOT_NEWER, INVALID, NOTHING_TO_ROLL_BACK, NOT_ALLOWED, FAILED }
+
+    /** The outcome and the versions in use before and after (null when unknown). */
+    public static final class ModelBundleResult {
+        public final ModelBundleOutcome outcome;
+        public final String fromVersion, toVersion;
+
+        ModelBundleResult(ModelBundleOutcome outcome, String fromVersion, String toVersion) {
+            this.outcome = outcome;
+            this.fromVersion = fromVersion;
+            this.toVersion = toVersion;
+        }
+    }
+
+    /** The app's view of the logged-in user (null: nobody, fail closed). */
