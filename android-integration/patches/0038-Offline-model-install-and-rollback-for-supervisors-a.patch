+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:registration_client/platform_spi/model_bundle_service.dart';
+import 'package:registration_client/ui/liveness/model_bundle_page.dart';
+
+/// F17: a scripted model bundle service.
+class FakeModelBundleService implements ModelBundleService {
+  bool allowed = true;
+  String version = 'pad-2026.10.5';
+  ModelBundleResult installResult =
+      const ModelBundleResult('INSTALLED', fromVersion: 'pad-2026.10.5', toVersion: 'pad-2026.10.6');
+  ModelBundleResult rollbackResult =
+      const ModelBundleResult('ROLLED_BACK', fromVersion: 'pad-2026.10.6', toVersion: 'pad-2026.10.5');
+  int installs = 0, rollbacks = 0;
+
+  @override
+  Future<bool> actionsAllowed() async => allowed;
+
+  @override
+  Future<String> activeVersion() async => version;
+
+  @override
+  Future<ModelBundleResult> installFromFile() async {
+    installs++;
+    if (installResult.succeeded) version = installResult.toVersion!;
+    return installResult;
+  }
+
+  @override
+  Future<ModelBundleResult> rollback() async {
+    rollbacks++;
+    if (rollbackResult.succeeded) version = rollbackResult.toVersion!;
+    return rollbackResult;
+  }
+}
+
+Widget app(Widget home, {Locale locale = const Locale('en')}) => MaterialApp(
+      locale: locale,
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      home: home,
+    );
+
+/// Renders the home page's operational-task entry the way the task list does:
+/// its title when there is one.
+class TaskProbe extends StatelessWidget {
+  const TaskProbe({super.key, required this.allowed});
+
+  final bool allowed;
+
+  @override
+  Widget build(BuildContext context) {
+    final task = modelBundleTask(AppLocalizations.of(context)!, allowed);
+    return Scaffold(
+        body: task == null
+            ? const SizedBox.shrink()
+            : InkWell(
+                onTap: () => task['onTap'](context),
+                child: Column(children: [
+                  task['icon'] as Widget,
+                  Text(task['title'] as String),
+                ])));
+  }
+}
+
+void main() {
+  testWidgets('the entry is shown to supervisors and admins and hidden otherwise', (tester) async {
+    await tester.pumpWidget(app(const TaskProbe(allowed: true)));
+    expect(find.text('Face liveness models'), findsOneWidget);
+
+    await tester.pumpWidget(app(const TaskProbe(allowed: false)));
+    await tester.pumpAndSettle();
+    expect(find.text('Face liveness models'), findsNothing);
+  });
+
+  testWidgets('installing shows the new version and a generic text', (tester) async {
+    final service = FakeModelBundleService();
+    await tester.pumpWidget(app(ModelBundlePage(service: service)));
+    await tester.pumpAndSettle();
+    expect(find.text('Models in use: pad-2026.10.5'), findsOneWidget);
+
+    await tester.tap(find.byKey(const Key('installModelBundle')));
+    await tester.pumpAndSettle();
+
+    expect(service.installs, 1);
+    expect(find.text('Model bundle pad-2026.10.6 installed. New liveness checks use it.'), findsOneWidget);
+    expect(find.text('Models in use: pad-2026.10.6'), findsOneWidget);
+  });
+
+  testWidgets('every refusal is a generic text and a closed picker shows nothing', (tester) async {
+    final service = FakeModelBundleService();
+    await tester.pumpWidget(app(ModelBundlePage(service: service)));
+    final expected = {
+      'INVALID': 'This file is not a valid signed model bundle. Nothing was changed.',
+      'NOT_NEWER': 'This model bundle is not newer than the models in use. Nothing was changed.',
+      'NOT_ALLOWED': 'Only a supervisor or an administrator can change the face liveness models.',
+      'FAILED': 'The model bundle could not be installed. Nothing was changed. Please try again.',
+    };
+    for (final e in expected.entries) {
+      service.installResult = ModelBundleResult(e.key);
+      await tester.tap(find.byKey(const Key('installModelBundle')));
+      await tester.pumpAndSettle();
+      expect(find.text(e.value), findsOneWidget, reason: e.key);
+    }
+    service.installResult = const ModelBundleResult('CANCELLED');
+    await tester.tap(find.byKey(const Key('installModelBundle')));
+    await tester.pumpAndSettle();
+    expect(find.byKey(const Key('modelBundleMessage')), findsNothing);
+    expect(find.text('Models in use: pad-2026.10.5'), findsOneWidget);
+  });
+
+  testWidgets('a rollback needs a confirmation', (tester) async {
+    final service = FakeModelBundleService()..version = 'pad-2026.10.6';
+    await tester.pumpWidget(app(ModelBundlePage(service: service)));
+    await tester.pumpAndSettle();
+
+    await tester.tap(find.byKey(const Key('rollbackModelBundle')));
+    await tester.pumpAndSettle();
+    await tester.tap(find.byKey(const Key('modelBundleRollbackCancel')));
+    await tester.pumpAndSettle();
+    expect(service.rollbacks, 0);
+
+    await tester.tap(find.byKey(const Key('rollbackModelBundle')));
+    await tester.pumpAndSettle();
+    await tester.tap(find.byKey(const Key('modelBundleRollbackConfirm')));
+    await tester.pumpAndSettle();
+    expect(service.rollbacks, 1);
+    expect(find.text('Models rolled back to pad-2026.10.5. New liveness checks use them.'), findsOneWidget);
+
+    service.rollbackResult = const ModelBundleResult('INVALID');
+    await tester.tap(find.byKey(const Key('rollbackModelBundle')));
+    await tester.pumpAndSettle();
+    await tester.tap(find.byKey(const Key('modelBundleRollbackConfirm')));
+    await tester.pumpAndSettle();
+    expect(find.text('The models could not be rolled back. Nothing was changed.'), findsOneWidget);
+  });
+
+  testWidgets('the texts are translated, with the version filled in', (tester) async {
+    final service = FakeModelBundleService();
+    await tester.pumpWidget(app(ModelBundlePage(service: service), locale: const Locale('fr')));
+    await tester.pumpAndSettle();
+    await tester.tap(find.byKey(const Key('installModelBundle')));
+    await tester.pumpAndSettle();
+    expect(find.text("Lot de modèles pad-2026.10.6 installé. Les nouvelles vérifications de vivacité l'utilisent."),
+        findsOneWidget);
+  });
+
+  test('every language has the 15 model bundle keys, with the English placeholders', () {
+    Map<String, dynamic> arb(String lang) =>
+        jsonDecode(File('assets/l10n/app_$lang.arb').readAsStringSync()) as Map<String, dynamic>;
+    final en = arb('en');
+    final keys = en.keys.where((k) => k.startsWith('liveness_model_')).toList();
+    expect(keys, hasLength(15));
+    final placeholder = RegExp(r'\{(\w+)\}');
+    for (final lang in ['ar', 'fr', 'hi', 'kn', 'ta']) {
+      final a = arb(lang);
+      for (final k in keys) {
+        expect(a[k], isA<String>(), reason: '$lang $k');
+        expect(placeholder.allMatches(a[k] as String).map((m) => m.group(1)).toList(),
+            placeholder.allMatches(en[k] as String).map((m) => m.group(1)).toList(),
+            reason: '$lang $k');
+        expect(a[k], isNot(en[k]), reason: '$lang $k is translated');
+      }
+      expect(a['@@x-liveness-model-translation'], 'machine-translated; needs native-speaker review');
+    }
+  });
+}
