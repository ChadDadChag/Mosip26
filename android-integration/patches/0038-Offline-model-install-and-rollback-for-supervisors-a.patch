--- /dev/null
+++ b/android/liveness/src/test/java/io/mosip/registration/liveness/android/LivenessOfflineModelInstallTest.java
@@ -0,0 +1,255 @@
+package io.mosip.registration.liveness.android;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.ArgumentMatchers.argThat;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.timeout;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import android.content.Context;
+import android.content.res.AssetManager;
+
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.security.MessageDigest;
+import java.security.Signature;
+import java.security.spec.ECGenParameterSpec;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+import io.mosip.registration.clientmanager.constant.AuditEvent;
+import io.mosip.registration.clientmanager.constant.Components;
+import io.mosip.registration.clientmanager.repository.GlobalParamRepository;
+import io.mosip.registration.clientmanager.spi.AuditManagerService;
+import io.mosip.registration.liveness.analyzer.integrity.DirectoryBundleSource;
+import io.mosip.registration.liveness.analyzer.integrity.TrustedKeys;
+import io.mosip.registration.liveness.analyzer.runtime.ModelRole;
+import io.mosip.registration.liveness.android.LivenessServiceHolder.ModelBundleOutcome;
+import io.mosip.registration.liveness.android.LivenessServiceHolder.ModelBundleResult;
+
+/**
+ * F17: the production offline model install and rollback, end to end with the real models re-signed with a throwaway
+ * key (no development key in tests): install and reload, refusals that leave the store unchanged, rollback, the role
+ * gate and the config switch, and the REG-EVT-019 audit (codes, versions and the user id only).
+ */
+public class LivenessOfflineModelInstallTest {
+
+    private static final String KEY_ID = "android-test-key";
+    private static final String BUNDLED = "pad-2026.10.5";
+    private static final String NEWER = "pad-2026.10.6";
+    private static final File ASSET_MODELS = new File("src/main/assets/liveness/models");
+
+    @Rule
+    public TemporaryFolder files = new TemporaryFolder();
+
+    private final Map<String, String> synced = new HashMap<>();
+    private final GlobalParamRepository globalParams = mock(GlobalParamRepository.class);
+    private final AuditManagerService auditManager = mock(AuditManagerService.class);
+    private KeyPair kp;
+    private LivenessServiceHolder holder;
+    private boolean supervisor = true;
+
+    @Before
+    public void setUp() throws Exception {
+        Context context = mock(Context.class);
+        when(context.getApplicationContext()).thenReturn(context);
+        when(context.getAssets()).thenReturn(mock(AssetManager.class));
+        when(context.getFilesDir()).thenReturn(files.newFolder("files"));
+        when(globalParams.getCachedStringGlobalParam(anyString())).thenAnswer(i -> synced.get(i.<String>getArgument(0)));
+        KeyPairGenerator g = KeyPairGenerator.getInstance("EC");
+        g.initialize(new ECGenParameterSpec("secp256r1"));
+        kp = g.generateKeyPair();
+        File bundled = files.newFolder("bundled");
+        for (Map.Entry<String, byte[]> e : bundle(BUNDLED).entrySet()) {
+            Files.write(new File(bundled, e.getKey()).toPath(), e.getValue());
+        }
+        holder = new LivenessServiceHolder(context, globalParams, auditManager, false, new DirectoryBundleSource(bundled),
+                new TrustedKeys(Collections.singletonMap(KEY_ID, kp.getPublic())));
+        holder.setModelBundleUser(new LivenessServiceHolder.ModelBundleUser() {
+            @Override public boolean maySupervise() {
+                return supervisor;
+            }
+
+            @Override public String id() {
+                return "sup-17";
+            }
+        });
+    }
+
+    /** manifest.json, manifest.sig and the real models, as bundle {@code version} signed with the throwaway key. */
+    private Map<String, byte[]> bundle(String version) throws Exception {
+        StringBuilder list = new StringBuilder();
+        Map<String, byte[]> models = new LinkedHashMap<>();
+        for (ModelRole role : ModelRole.values()) {
+            byte[] b = Files.readAllBytes(new File(ASSET_MODELS, role.fileName()).toPath());
+            models.put(role.fileName(), b);
+            list.append(list.length() == 0 ? "" : ",\n").append("    {\"role\": \"").append(role.name())
+                    .append("\", \"name\": \"").append(role.fileName()).append("\", \"size\": ").append(b.length)
+                    .append(", \"sha256\": \"").append(hex(MessageDigest.getInstance("SHA-256").digest(b))).append("\"}");
+        }
+        byte[] manifest = ("{\n  \"schema\": 1,\n  \"bundleVersion\": \"" + version + "\",\n  \"keyId\": \"" + KEY_ID
+                + "\",\n  \"createdUtc\": \"2026-10-27T00:00:00Z\",\n  \"params\": { \"pitchBiasDeg\": -9.5 },\n"
+                + "  \"files\": [\n" + list + "\n  ]\n}\n").getBytes(StandardCharsets.UTF_8);
+        Signature s = Signature.getInstance("SHA256withECDSA");
+        s.initSign(kp.getPrivate());
+        s.update(manifest);
+        Map<String, byte[]> out = new LinkedHashMap<>();
+        out.put("manifest.json", manifest);
+        out.put("manifest.sig", (KEY_ID + ":" + hex(s.sign()) + "\n").getBytes(StandardCharsets.US_ASCII));
+        out.putAll(models);
+        return out;
+    }
+
+    /** A zip of these entries, in order (manifest.json first, as ModelBundleTool pack writes it). */
+    private File zip(String name, Map<String, byte[]> entries) throws IOException {
+        File f = files.newFile(name);
+        try (ZipOutputStream z = new ZipOutputStream(new FileOutputStream(f))) {
+            for (Map.Entry<String, byte[]> e : entries.entrySet()) {
+                z.putNextEntry(new ZipEntry(e.getKey()));
+                z.write(e.getValue());
+                z.closeEntry();
+            }
+        }
+        return f;
+    }
+
+    private static String hex(byte[] b) {
+        StringBuilder sb = new StringBuilder();
+        for (byte x : b) sb.append(String.format("%02x", x & 0xff));
+        return sb.toString();
+    }
+
+    private void verifyAudit(String... parts) {
+        verifyAudits(1, parts);
+    }
+
+    /** Exactly {@code count} REG-EVT-019 records contain every part, and none of them a path. */
+    private void verifyAudits(int count, String... parts) {
+        verify(auditManager, timeout(5000).times(count)).audit(eq(AuditEvent.LIVENESS_MODEL_UPDATE), eq(Components.HOME),
+                argThat(text -> {
+                    for (String p : parts) if (!text.contains(p)) return false;
+                    return !text.contains(files.getRoot().getName()); // no path in the audit
+                }));
+    }
+
+    @Test
+    public void aSupervisorInstallsAValidZipAndTheModelsReload() throws Exception {
+        assertTrue(holder.modelBundleActionsAllowed());
+        assertEquals(BUNDLED, holder.activeModelVersion());
+        File zip = zip("newer.zip", bundle(NEWER));
+
+        ModelBundleResult r = holder.installOfflineBundle(zip);
+
+        assertEquals(ModelBundleOutcome.INSTALLED, r.outcome);
+        assertEquals(BUNDLED, r.fromVersion);
+        assertEquals(NEWER, r.toVersion);
+        assertEquals(NEWER, holder.activeModelVersion());
+        assertEquals("installed [" + BUNDLED + ", " + NEWER + "], current " + NEWER, holder.modelStoreStatus());
+        assertEquals(1, holder.analyzerSwaps());
+        verifyAudit("outcome=INSTALLED", "fromVersion=" + BUNDLED, "toVersion=" + NEWER, "trigger=offline",
+                "userId=sup-17");
+        assertTrue("the picked copy is the caller's to delete", zip.exists());
+    }
+
+    @Test
+    public void aTamperedByteIsRejectedAndTheStoreIsUnchanged() throws Exception {
+        Map<String, byte[]> entries = bundle(NEWER);
+        byte[] model = entries.get(ModelRole.DETECTOR.fileName()).clone();
+        model[model.length / 2] ^= 1;
+        entries.put(ModelRole.DETECTOR.fileName(), model);
+
+        ModelBundleResult r = holder.installOfflineBundle(zip("tampered.zip", entries));
+
+        assertEquals(ModelBundleOutcome.INVALID, r.outcome);
+        assertEquals("installed [], current none (bundled)", holder.modelStoreStatus());
+        assertEquals(0, holder.analyzerSwaps());
+        verifyAudit("outcome=FAILED", "errorCode=MODEL_INTEGRITY_FAILED", "reason=BUNDLE_INVALID", "trigger=offline");
+    }
+
+    @Test
+    public void theSameOrAnOlderVersionIsRefused() throws Exception {
+        assertEquals(ModelBundleOutcome.NOT_NEWER, holder.installOfflineBundle(zip("same.zip", bundle(BUNDLED))).outcome);
+        assertEquals(ModelBundleOutcome.NOT_NEWER,
+                holder.installOfflineBundle(zip("older.zip", bundle("pad-2026.09.1"))).outcome);
+        assertEquals("installed [], current none (bundled)", holder.modelStoreStatus());
+        verifyAudits(2, "outcome=UP_TO_DATE", "reason=NOT_NEWER", "trigger=offline");
+    }
+
+    @Test
+    public void aZipSlipEntryIsRejectedAndNothingIsWrittenOutside() throws Exception {
+        Map<String, byte[]> entries = new LinkedHashMap<>();
+        entries.put("manifest.json", bundle(NEWER).get("manifest.json"));
+        entries.put("../evil.onnx", new byte[] {6});
+
+        ModelBundleResult r = holder.installOfflineBundle(zip("slip.zip", entries));
+
+        assertEquals(ModelBundleOutcome.INVALID, r.outcome);
+        assertFalse(new File(files.getRoot(), "evil.onnx").exists());
+        assertFalse(new File(new File(files.getRoot(), "files"), "evil.onnx").exists());
+        verifyAudit("reason=ZIP_ENTRY_REFUSED", "errorCode=MODEL_INTEGRITY_FAILED");
+    }
+
+    @Test
+    public void aRollbackReturnsToTheBundledModels() throws Exception {
+        assertEquals(ModelBundleOutcome.NOTHING_TO_ROLL_BACK, holder.rollbackOfflineBundle().outcome);
+        assertEquals(ModelBundleOutcome.INSTALLED, holder.installOfflineBundle(zip("newer.zip", bundle(NEWER))).outcome);
+
+        ModelBundleResult r = holder.rollbackOfflineBundle();
+
+        assertEquals(ModelBundleOutcome.ROLLED_BACK, r.outcome);
+        assertEquals(NEWER, r.fromVersion);
+        assertEquals(BUNDLED, r.toVersion);
+        assertEquals(BUNDLED, holder.activeModelVersion());
+        assertEquals(2, holder.analyzerSwaps());
+        verifyAudit("outcome=ROLLED_BACK", "trigger=rollback", "fromVersion=" + NEWER, "toVersion=" + BUNDLED,
+                "userId=sup-17");
+        assertEquals(ModelBundleOutcome.NOTHING_TO_ROLL_BACK, holder.rollbackOfflineBundle().outcome);
+    }
+
+    @Test
+    public void onlySupervisorsAndAdminsMayActAndNobodyBeforeTheAppSaysWho() throws Exception {
+        supervisor = false;
+        assertFalse(holder.modelBundleActionsAllowed());
+        File zip = zip("newer.zip", bundle(NEWER));
+        assertEquals(ModelBundleOutcome.NOT_ALLOWED, holder.installOfflineBundle(zip).outcome);
+        assertEquals(ModelBundleOutcome.NOT_ALLOWED, holder.rollbackOfflineBundle().outcome);
+        verifyAudit("outcome=REFUSED", "reason=NOT_ALLOWED", "trigger=offline", "userId=sup-17");
+        verifyAudit("outcome=REFUSED", "reason=NOT_ALLOWED", "trigger=rollback", "userId=sup-17");
+        assertEquals("installed [], current none (bundled)", holder.modelStoreStatus());
+
+        holder.setModelBundleUser(null); // the app has not said who is logged in: fail closed
+        assertFalse(holder.modelBundleActionsAllowed());
+        assertEquals(ModelBundleOutcome.NOT_ALLOWED, holder.installOfflineBundle(zip).outcome);
+    }
+
+    @Test
+    public void theConfigSwitchHidesAndRefusesIt() throws Exception {
+        assertTrue(holder.offlineInstallEnabled()); // on by default
+        synced.put(LivenessServiceHolder.OFFLINE_INSTALL_KEY, "false");
+        assertFalse(holder.offlineInstallEnabled());
+        assertFalse(holder.modelBundleActionsAllowed());
+        assertEquals(ModelBundleOutcome.NOT_ALLOWED,
+                holder.installOfflineBundle(zip("newer.zip", bundle(NEWER))).outcome);
+        assertEquals("installed [], current none (bundled)", holder.modelStoreStatus());
+    }
+}
