+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'package:flutter/services.dart';
+import 'package:registration_client/pigeon/liveness_pigeon.dart';
+import 'package:registration_client/platform_spi/model_bundle_service.dart';
+
+class ModelBundleServiceImpl implements ModelBundleService {
+  ModelBundleServiceImpl._();
+
+  static final ModelBundleServiceImpl instance = ModelBundleServiceImpl._();
+
+  final LivenessApi _api = LivenessApi();
+
+  @override
+  Future<bool> actionsAllowed() async {
+    try {
+      return await _api.modelBundleActionsAllowed();
+    } on PlatformException {
+      return false; // fail closed: no entry
+    }
+  }
+
+  @override
+  Future<String> activeVersion() async {
+    try {
+      return await _api.activeModelVersion();
+    } on PlatformException {
+      return '';
+    }
+  }
+
+  @override
+  Future<ModelBundleResult> installFromFile() =>
+      _run(_api.installModelBundleFromFile);
+
+  @override
+  Future<ModelBundleResult> rollback() =>
+      _run(_api.rollbackModelBundleFromSettings);
+
+  Future<ModelBundleResult> _run(
+      Future<ModelBundleActionResult> Function() call) async {
+    try {
+      final r = await call();
+      return ModelBundleResult(r.outcome,
+          fromVersion: r.fromVersion, toVersion: r.toVersion);
+    } on PlatformException {
+      return const ModelBundleResult('FAILED');
+    }
+  }
+}
+
+ModelBundleService getModelBundleServiceImpl() => ModelBundleServiceImpl.instance;
diff --git a/lib/platform_spi/model_bundle_service.dart b/lib/platform_spi/model_bundle_service.dart
new file mode 100644
index 0000000..f41772b
--- /dev/null
+++ b/lib/platform_spi/model_bundle_service.dart
@@ -0,0 +1,42 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'package:registration_client/platform_android/model_bundle_service_impl.dart';
+
+/// F17: the result of an offline model install or rollback. [outcome] is one
+/// of INSTALLED, ROLLED_BACK, NOT_NEWER, INVALID, NOTHING_TO_ROLL_BACK,
+/// NOT_ALLOWED, FAILED or CANCELLED (the picker was closed). The UI shows a
+/// generic text for it, never a path or an exception message.
+class ModelBundleResult {
+  const ModelBundleResult(this.outcome, {this.fromVersion, this.toVersion});
+
+  final String outcome;
+  final String? fromVersion;
+  final String? toVersion;
+
+  bool get succeeded => outcome == 'INSTALLED' || outcome == 'ROLLED_BACK';
+}
+
+/// F17: offline face liveness model install and rollback, for supervisors and
+/// admins. The native side checks the role and the config key again before it
+/// acts.
+abstract class ModelBundleService {
+  /// True for a logged-in supervisor or admin while
+  /// mosip.registration.liveness.model.offlineInstall.enabled is not false.
+  Future<bool> actionsAllowed();
+
+  /// The model bundle version new sessions use, or '' when unknown.
+  Future<String> activeVersion();
+
+  /// Opens the system file picker for a signed bundle zip, then installs it.
+  Future<ModelBundleResult> installFromFile();
+
+  /// The previous model bundle becomes current again.
+  Future<ModelBundleResult> rollback();
+
+  factory ModelBundleService() => getModelBundleServiceImpl();
+}
diff --git a/lib/ui/liveness/model_bundle_page.dart b/lib/ui/liveness/model_bundle_page.dart
new file mode 100644
index 0000000..4085fad
--- /dev/null
+++ b/lib/ui/liveness/model_bundle_page.dart
@@ -0,0 +1,171 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'package:flutter/material.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:registration_client/platform_spi/model_bundle_service.dart';
+
+/// F17: the operational-task entry for the face liveness models, or null when
+/// the user may not change them (not a supervisor or admin, or the feature is
+/// off). The home page asks [ModelBundleService.actionsAllowed] once.
+Map<String, dynamic>? modelBundleTask(AppLocalizations l, bool allowed,
+    {ModelBundleService? service}) {
+  if (!allowed) return null;
+  return {
+    "icon": const Icon(Icons.system_update_alt, size: 36),
+    "title": l.liveness_model_title,
+    "onTap": (BuildContext context) {
+      Navigator.push(
+          context,
+          MaterialPageRoute(
+              builder: (context) => ModelBundlePage(service: service)));
+    },
+    "subtitle": l.liveness_model_install,
+  };
+}
+
+/// The generic text for a result, or null for a closed picker. A failed
+/// rollback has its own text: no file was involved.
+String? modelBundleText(AppLocalizations l, ModelBundleResult r,
+    {required bool rollback}) {
+  switch (r.outcome) {
+    case 'INSTALLED':
+      return l.liveness_model_installed(r.toVersion ?? '');
+    case 'ROLLED_BACK':
+      return l.liveness_model_rolled_back(r.toVersion ?? '');
+    case 'NOT_NEWER':
+      return l.liveness_model_not_newer;
+    case 'NOTHING_TO_ROLL_BACK':
+      return l.liveness_model_nothing_to_roll_back;
+    case 'NOT_ALLOWED':
+      return l.liveness_model_not_allowed;
+    case 'CANCELLED':
+      return null;
+    case 'INVALID':
+      return rollback ? l.liveness_model_rollback_failed : l.liveness_model_invalid;
+    default:
+      return rollback ? l.liveness_model_rollback_failed : l.liveness_model_failed;
+  }
+}
+
+/// F17: the version in use, install a signed bundle zip from removable media
+/// (the system file picker), and roll back after a confirmation.
+class ModelBundlePage extends StatefulWidget {
+  const ModelBundlePage({super.key, this.service});
+
+  final ModelBundleService? service;
+
+  @override
+  State<ModelBundlePage> createState() => _ModelBundlePageState();
+}
+
+class _ModelBundlePageState extends State<ModelBundlePage> {
+  late final ModelBundleService _service =
+      widget.service ?? ModelBundleService();
+  String _version = '';
+  bool _busy = false;
+  String? _message;
+  bool _succeeded = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _refresh();
+  }
+
+  Future<void> _refresh() async {
+    final v = await _service.activeVersion();
+    if (mounted) setState(() => _version = v);
+  }
+
+  Future<void> _rollback() async {
+    final l = AppLocalizations.of(context)!;
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        content: Text(l.liveness_model_confirm_rollback),
+        actions: [
+          TextButton(
+              key: const Key('modelBundleRollbackCancel'),
+              onPressed: () => Navigator.pop(context, false),
+              child: Text(l.liveness_button_cancel)),
+          TextButton(
+              key: const Key('modelBundleRollbackConfirm'),
+              onPressed: () => Navigator.pop(context, true),
+              child: Text(l.liveness_model_rollback)),
+        ],
+      ),
+    );
+    if (confirmed == true) await _act(_service.rollback, rollback: true);
+  }
+
+  Future<void> _act(Future<ModelBundleResult> Function() action,
+      {required bool rollback}) async {
+    setState(() {
+      _busy = true;
+      _message = null;
+    });
+    final r = await action();
+    if (!mounted) return;
+    final l = AppLocalizations.of(context)!;
+    setState(() {
+      _busy = false;
+      _message = modelBundleText(l, r, rollback: rollback);
+      _succeeded = r.succeeded;
+    });
+    await _refresh();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = AppLocalizations.of(context)!;
+    return Scaffold(
+      appBar: AppBar(title: Text(l.liveness_model_title)),
+      body: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Text(l.liveness_model_current(_version),
+                key: const Key('modelBundleVersion')),
+            const SizedBox(height: 16),
+            ElevatedButton(
+              key: const Key('installModelBundle'),
+              onPressed: _busy
+                  ? null
+                  : () => _act(_service.installFromFile, rollback: false),
+              child: Text(l.liveness_model_install),
+            ),
+            const SizedBox(height: 8),
+            OutlinedButton(
+              key: const Key('rollbackModelBundle'),
+              onPressed: _busy ? null : _rollback,
+              child: Text(l.liveness_model_rollback),
+            ),
+            const SizedBox(height: 16),
+            if (_busy)
+              Row(children: [
+                const SizedBox(
+                    width: 20,
+                    height: 20,
+                    child: CircularProgressIndicator(strokeWidth: 2)),
+                const SizedBox(width: 12),
+                Expanded(child: Text(l.liveness_model_working)),
+              ]),
+            if (_message != null)
+              Text(_message!,
+                  key: const Key('modelBundleMessage'),
+                  style: TextStyle(
+                      color: _succeeded
+                          ? Colors.green.shade800
+                          : Theme.of(context).colorScheme.error)),
+          ],
+        ),
