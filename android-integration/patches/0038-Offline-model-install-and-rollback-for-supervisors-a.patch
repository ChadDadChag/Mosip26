+    /**
+     * Installs a signed bundle zip from removable media ({@link ModelUpdater#installZip}: the online update's zip and
+     * verification, unpacked into a temporary directory that is deleted afterwards) and reloads; a running session
+     * keeps its models. Writes REG-EVT-019 with trigger=offline (codes, versions and the user id only). Blocking: call
+     * it on {@link #background()}.
+     */
+    public synchronized ModelBundleResult installOfflineBundle(File zip) {
+        long start = SystemClock.elapsedRealtime();
+        String from = activeModelVersion();
+        if (!modelBundleActionsAllowed()) {
+            return bundleAudit("offline", from, null, "REFUSED", "NOT_ALLOWED", null, start, ModelBundleOutcome.NOT_ALLOWED);
+        }
+        if (zip == null) {
+            return bundleAudit("offline", from, from, "FAILED", "STORAGE", null, start, ModelBundleOutcome.FAILED);
+        }
+        ModelUpdater.UpdateResult r = ModelUpdater.builder().build().installZip(zip, modelStore(), bundledModels, trustedKeys);
+        switch (r.status()) {
+            case INSTALLED:
+                Log.i(TAG, "model store: installed " + r.version() + " from removable media");
+                reloadModels();
+                return bundleAudit("offline", from, r.version(), "INSTALLED", null, null, start, ModelBundleOutcome.INSTALLED);
+            case UP_TO_DATE:
+                return bundleAudit("offline", from, from, "UP_TO_DATE", "NOT_NEWER", null, start, ModelBundleOutcome.NOT_NEWER);
+            default:
+                boolean storage = r.reason() == ModelUpdater.Reason.STORAGE;
+                return bundleAudit("offline", from, from, "FAILED", r.reason().name(),
+                        storage ? null : ErrorCode.MODEL_INTEGRITY_FAILED.name(), start,
+                        storage ? ModelBundleOutcome.FAILED : ModelBundleOutcome.INVALID);
+        }
+    }
+
+    /**
+     * Operator action from the production page: the store's previous bundle becomes current again
+     * ({@link ModelStore#rollback}, verified again), then a reload. Writes REG-EVT-019 with trigger=rollback.
+     */
+    public synchronized ModelBundleResult rollbackOfflineBundle() {
+        long start = SystemClock.elapsedRealtime();
+        String from = activeModelVersion();
+        if (!modelBundleActionsAllowed()) {
+            return bundleAudit("rollback", from, null, "REFUSED", "NOT_ALLOWED", null, start, ModelBundleOutcome.NOT_ALLOWED);
+        }
+        try {
+            String v = modelStore().rollback(trustedKeys);
+            Log.i(TAG, "model store: rolled back to " + v);
+            reloadModels();
+            return bundleAudit("rollback", from, activeModelVersion(), "ROLLED_BACK", null, null, start,
+                    ModelBundleOutcome.ROLLED_BACK);
+        } catch (IllegalStateException nothingEarlier) {
+            return bundleAudit("rollback", from, from, "REFUSED", "NOTHING_TO_ROLL_BACK", null, start,
+                    ModelBundleOutcome.NOTHING_TO_ROLL_BACK);
+        } catch (LivenessEngineException e) {
+            return bundleAudit("rollback", from, from, "FAILED", "BUNDLE_INVALID", e.code().name(), start,
+                    ModelBundleOutcome.INVALID);
+        } catch (IOException | RuntimeException e) {
+            Log.w(TAG, "model rollback failed: " + e.getClass().getSimpleName());
+            return bundleAudit("rollback", from, from, "FAILED", "STORAGE", null, start, ModelBundleOutcome.FAILED);
+        }
+    }
+
+    private ModelBundleResult bundleAudit(String trigger, String from, String to, String outcome, String reason,
+                                          String errorCode, long start, ModelBundleOutcome result) {
+        String user;
+        try {
+            user = modelBundleUser.id();
+        } catch (RuntimeException e) {
+            user = null;
+        }
+        audit.modelBundle(outcome, errorCode, reason, from, to, SystemClock.elapsedRealtime() - start, trigger, user);
+        return new ModelBundleResult(result, from, to);
+    }
+
     /**
      * Online model update ({@link ModelUpdates}): checks the configured index and installs a newer verified bundle
      * into the store, then reloads as {@link #installModelBundle} does. Writes REG-EVT-019 with the outcome; the
@@ -336,7 +482,7 @@ public final class LivenessServiceHolder {
         }
         long start = SystemClock.elapsedRealtime();
         ModelUpdater.UpdateResult r = ModelUpdates.updater(diagnostics).check(index, modelStore(),
-                new AssetBundleSource(context), TrustedKeys.builtIn());
+                bundledModels, trustedKeys);
         onModelUpdate(r, SystemClock.elapsedRealtime() - start, trigger);
         return r;
     }
diff --git a/android/liveness/src/test/java/io/mosip/registration/liveness/android/LivenessOfflineModelInstallTest.java b/android/liveness/src/test/java/io/mosip/registration/liveness/android/LivenessOfflineModelInstallTest.java
