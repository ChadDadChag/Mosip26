diff --git a/test/liveness/model_bundle_test.dart b/test/liveness/model_bundle_test.dart
new file mode 100644
index 0000000..c7fcc59
--- /dev/null
+++ b/test/liveness/model_bundle_test.dart
@@ -0,0 +1,178 @@
+/*
