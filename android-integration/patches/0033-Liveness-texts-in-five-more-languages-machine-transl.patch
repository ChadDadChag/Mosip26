+
+import 'fake_liveness_service.dart';
+
+/// LivenessPage in Arabic (right to left), in Hindi, and in every language of the client.
+void main() {
+  late FakeLivenessService service;
+
+  setUp(() => service = FakeLivenessService());
+
+  Future<void> open(WidgetTester tester, String lang) async {
+    await tester.binding.setSurfaceSize(const Size(411, 891)); // a phone in portrait
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    await tester.pumpWidget(MaterialApp(
+      locale: Locale(lang),
+      localizationsDelegates: AppLocalizations.localizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      home: LivenessPage(
+        workflow: 'RESIDENT',
+        service: service,
+        previewBuilder: () => const ColoredBox(color: Colors.grey),
+      ),
+    ));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 400)); // the start-up calls
+  }
+
+  Future<void> send(WidgetTester tester, Map<String, Object?> m) async {
+    service.emit(m);
+    await tester.pump();
+    await tester.pump();
+  }
+
+  Finder stateIcon(IconData icon, double size) =>
+      find.byWidgetPredicate((w) => w is Icon && w.icon == icon && w.size == size);
+
+  void expectNotMirrored(WidgetTester tester, IconData icon) {
+    final icons = find.byIcon(icon);
+    expect(icons, findsNWidgets(2), reason: 'the oval badge and the status banner');
+    for (final e in icons.evaluate()) {
+      expect(Directionality.of(e), TextDirection.ltr);
+    }
+    // Icon paints a mirrored glyph through a Transform (matchTextDirection in a right-to-left context).
+    expect(find.descendant(of: icons, matching: find.byType(Transform)), findsNothing);
+  }
+
+  testWidgets('Arabic: right to left, and the turn arrows keep the user\'s physical direction', (tester) async {
+    await open(tester, 'ar');
+    expect(find.text('التحقق من حيوية الوجه'), findsOneWidget);
+    await send(tester, ev('STARTED'));
+    expect(find.text('المحاولة 1 من 4'), findsOneWidget);
+
+    await send(tester, ev('CHALLENGE_PROMPT', challenge: 'TURN_LEFT', index: 1, count: 2));
+    final prompt = find.text('يرجى إدارة رأسك إلى اليسار');
+    expect(prompt, findsOneWidget);
+    expect(Directionality.of(tester.element(prompt)), TextDirection.rtl);
+    expectNotMirrored(tester, Icons.arrow_back);
+    // Right to left: the banner icon sits right of its text, the step text right of the progress bar.
+    expect(tester.getCenter(stateIcon(Icons.arrow_back, 32)).dx, greaterThan(tester.getCenter(prompt).dx));
+    expect(tester.getCenter(find.text('الخطوة 1 من 2')).dx,
+        greaterThan(tester.getCenter(find.byType(LinearProgressIndicator)).dx));
+
+    await send(tester, ev('CHALLENGE_PROMPT', challenge: 'TURN_RIGHT', index: 2, count: 2));
+    expect(find.text('يرجى إدارة رأسك إلى اليمين'), findsOneWidget);
+    expectNotMirrored(tester, Icons.arrow_forward);
+
+    await send(tester, ev('ATTEMPT_FAILED',
+        error: 'CHALLENGE_TIMEOUT', userMessage: 'LIVENESS_NOT_VERIFIED', retriesLeft: 2));
+    expect(find.text('تعذّر التحقق من حيوية الوجه. يرجى المحاولة مرة أخرى.'), findsOneWidget);
+    expect(find.text('المحاولات المتبقية: 2'), findsOneWidget);
+    expect(find.text('نصائح:'), findsOneWidget);
+    // The tips start at the right edge; Retry (first) is right of Cancel.
+    final tip = find.textContaining('انظر مباشرة إلى الكاميرا.');
+    await tester.ensureVisible(tip);
+    await tester.pump();
+    expect(tester.getTopRight(tip).dx, greaterThan(411 - 16 - 1));
+    expect(tester.getCenter(find.text('إعادة المحاولة')).dx, greaterThan(tester.getCenter(find.text('إلغاء')).dx));
+  });
