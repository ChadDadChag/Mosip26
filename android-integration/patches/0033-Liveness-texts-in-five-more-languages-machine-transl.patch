diff --git a/test/liveness/liveness_l10n_test.dart b/test/liveness/liveness_l10n_test.dart
new file mode 100644
index 0000000..3dc21e8
--- /dev/null
+++ b/test/liveness/liveness_l10n_test.dart
@@ -0,0 +1,63 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter/widgets.dart';
+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:registration_client/ui/liveness/liveness_strings.dart';
+
+/// The liveness strings in every ARB: all 44 keys, the English placeholders, and the
+/// machine-translation note in each translated file.
+void main() {
+  const languages = ['ar', 'fr', 'hi', 'kn', 'ta'];
+  final placeholder = RegExp(r'\{(\w+)\}');
+
+  Map<String, dynamic> arb(String lang) =>
+      jsonDecode(File('assets/l10n/app_$lang.arb').readAsStringSync()) as Map<String, dynamic>;
+
+  final en = arb('en');
+  final keys = en.keys.where((k) => k.startsWith('liveness_')).toList();
+
+  List<String> placeholders(String text) =>
+      placeholder.allMatches(text).map((m) => m.group(1)!).toList()..sort();
+
+  test('English has the 44 liveness keys', () {
+    expect(keys, hasLength(44));
+  });
+
+  for (final lang in languages) {
+    test('$lang: all 44 liveness keys, with the English placeholders', () {
+      final a = arb(lang);
+      final missing = keys.where((k) => !a.containsKey(k)).toList();
+      expect(missing, isEmpty, reason: 'untranslated liveness keys in app_$lang.arb');
+      for (final k in keys) {
+        final value = a[k] as String;
+        expect(value.trim(), isNotEmpty, reason: '$lang $k');
+        expect(placeholders(value), placeholders(en[k] as String), reason: '$lang $k');
+      }
+      expect(a.keys.where((k) => k.startsWith('liveness_')), hasLength(44), reason: 'no extra keys');
+    });
+
+    test('$lang: marked as machine-translated', () {
+      expect(arb(lang)['@@x-liveness-translation'], 'machine-translated; needs native-speaker review');
+    });
+  }
+
+  test('every locale resolves every spec key, with placeholders filled', () async {
+    final specKeys = keys.map((k) {
+      final parts = k.split('_');
+      return 'liveness.${parts[1]}.${parts.sublist(2).join('_')}';
+    }).toList();
+    for (final lang in ['en', ...languages]) {
+      final l = await AppLocalizations.delegate.load(Locale(lang));
+      for (final key in specKeys) {
+        final text = livenessText(l, key, i: 1, n: 2, a: 3, m: 4);
+        expect(text, isNot(key), reason: '$lang $key has no mapping');
+        expect(text, isNot(contains('{')), reason: '$lang $key: unfilled placeholder');
+      }
+      expect(livenessText(l, 'liveness.progress.step', i: 1, n: 2), allOf(contains('1'), contains('2')));
+      expect(livenessText(l, 'liveness.progress.attempt', a: 3, m: 4), allOf(contains('3'), contains('4')));
+      expect(livenessText(l, 'liveness.retry.attempts_left', n: 2), contains('2'));
+    }
+  });
+}
