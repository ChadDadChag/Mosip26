diff --git a/lib/utils/app_fonts.dart b/lib/utils/app_fonts.dart
new file mode 100644
index 0000000..ea50fd4
--- /dev/null
+++ b/lib/utils/app_fonts.dart
@@ -0,0 +1,77 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'package:flutter/material.dart';
+
+/// The app's typeface: Noto Sans for Latin, with the Noto families of the app's other scripts as fallbacks, so the
+/// six app languages share one design (pubspec.yaml bundles them; licence in assets/fonts/OFL.txt).
+class AppFonts {
+  AppFonts._();
+
+  static const String family = 'NotoSans';
+  static const List<String> fallback = [
+    'NotoSansArabic',
+    'NotoSansDevanagari',
+    'NotoSansKannada',
+    'NotoSansTamil',
+  ];
+  static const String licenceAsset = 'assets/fonts/OFL.txt';
+}
+
+/// The app's type scale, in the theme (ThemeData.extensions). Sizes and weights only: the family comes from the
+/// theme. MOSIP's own text keeps its explicit sizes and its TextTheme slots (titleLarge 24, bodyLarge 18, and the
+/// slots its screens use); new screens take their text styles from here.
+@immutable
+class AppTypeScale extends ThemeExtension<AppTypeScale> {
+  const AppTypeScale({
+    required this.headline,
+    required this.title,
+    required this.body,
+    required this.label,
+    required this.caption,
+  });
+
+  static const AppTypeScale standard = AppTypeScale(
+    headline: TextStyle(fontSize: 28, fontWeight: FontWeight.w600, height: 1.2),
+    title: TextStyle(fontSize: 20, fontWeight: FontWeight.w600),
+    body: TextStyle(fontSize: 16, fontWeight: FontWeight.w400),
+    label: TextStyle(fontSize: 14, fontWeight: FontWeight.w500),
+    caption: TextStyle(fontSize: 13, fontWeight: FontWeight.w400),
+  );
+
+  /// The theme's scale, or [standard] where the theme has none (e.g. a test's plain ThemeData).
+  static AppTypeScale of(BuildContext context) => Theme.of(context).extension<AppTypeScale>() ?? standard;
+
+  final TextStyle headline;
+  final TextStyle title;
+  final TextStyle body;
+  final TextStyle label;
+  final TextStyle caption;
+
+  @override
+  AppTypeScale copyWith(
+          {TextStyle? headline, TextStyle? title, TextStyle? body, TextStyle? label, TextStyle? caption}) =>
+      AppTypeScale(
+        headline: headline ?? this.headline,
+        title: title ?? this.title,
+        body: body ?? this.body,
+        label: label ?? this.label,
+        caption: caption ?? this.caption,
+      );
+
+  @override
+  AppTypeScale lerp(ThemeExtension<AppTypeScale>? other, double t) {
+    if (other is! AppTypeScale) return this;
+    return AppTypeScale(
+      headline: TextStyle.lerp(headline, other.headline, t)!,
+      title: TextStyle.lerp(title, other.title, t)!,
+      body: TextStyle.lerp(body, other.body, t)!,
+      label: TextStyle.lerp(label, other.label, t)!,
+      caption: TextStyle.lerp(caption, other.caption, t)!,
+    );
+  }
+}
