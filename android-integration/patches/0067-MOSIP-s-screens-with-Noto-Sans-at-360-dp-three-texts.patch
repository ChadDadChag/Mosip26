+  const locales = [Locale('en'), Locale('fr'), Locale('hi')];
+  const scales = [1.0, 1.3];
+
+  /// The layout problems of [screen] at 360x740 dp: overflows and other errors reported while it is built, and
+  /// texts cut off. [prepare] sets the state before the first frame; [shown] is a text the screen must show.
+  Future<List<String>> check(WidgetTester tester, Widget Function() screen,
+      {required Locale locale,
+      required double scale,
+      void Function(GlobalProvider global, AuthProvider auth)? prepare,
+      Future<void> Function(WidgetTester tester, AppLocalizations l)? act,
+      String Function(AppLocalizations l)? shown,
+      List<String> Function(AppLocalizations l)? knownCuts}) async {
+    final problems = <String>[];
+    final original = FlutterError.onError;
+    FlutterError.onError = (details) => problems.add(details.exceptionAsString().split('\n').first);
+    try {
+      tester.view.physicalSize = const Size(360, 740) * 3;
+      tester.view.devicePixelRatio = 3;
+      final global = _QuietGlobalProvider();
+      final auth = _QuietAuthProvider();
+      prepare?.call(global, auth);
+      await tester.pumpWidget(_app(screen(), locale, scale, global, auth));
+      await tester.pump();
+      await tester.pump(const Duration(milliseconds: 500));
+      final l = await AppLocalizations.delegate.load(locale);
+      if (act != null) {
+        await act(tester, l);
+        await tester.pump();
+        await tester.pump(const Duration(milliseconds: 500));
+      }
+      if (shown != null) {
+        final text = shown(l);
+        if (find.textContaining(text, skipOffstage: false).evaluate().isEmpty) problems.add('not shown: "$text"');
+      }
+      final known = knownCuts?.call(l) ?? const <String>[];
+      problems.addAll(_cutOff(tester).where((t) => !known.contains(t)).map((t) => 'text cut off: "$t"'));
+    } finally {
+      FlutterError.onError = original;
+      await tester.pumpWidget(const SizedBox());
+      tester.view.reset();
+    }
+    return problems.map((p) => '${locale.languageCode} x$scale: $p').toList();
+  }
+
+  Future<void> everywhere(WidgetTester tester, Widget Function() screen,
+      {void Function(GlobalProvider global, AuthProvider auth)? prepare,
+      Future<void> Function(WidgetTester tester, AppLocalizations l)? act,
+      String Function(AppLocalizations l)? shown,
+      List<String> Function(AppLocalizations l)? knownCuts}) async {
+    final problems = <String>[];
+    for (final locale in locales) {
+      for (final scale in scales) {
+        problems.addAll(await check(tester, screen,
+            locale: locale, scale: scale, prepare: prepare, act: act, shown: shown, knownCuts: knownCuts));
+      }
+    }
+    expect(problems, isEmpty);
+  }
+
+  /// Taps a bottom navigation item of the home page by its label.
+  Future<void> Function(WidgetTester, AppLocalizations) tab(String Function(AppLocalizations l) label) =>
+      (tester, l) => tester.tap(find.text(label(l)));
+
+  testWidgets('the checks find an overflow and a cut-off text', (tester) async {
+    // The detectors themselves: a row wider than the screen, and a long text held to one line.
+    final problems = await check(
+        tester,
+        () => const Scaffold(
+              body: Column(children: [
+                Row(children: [SizedBox(width: 400, height: 10)]),
+                Text('a text far too long to stay on one line at this width, so it is cut', maxLines: 1,
+                    overflow: TextOverflow.ellipsis),
+              ]),
+            ),
+        locale: const Locale('en'),
+        scale: 1.0);
+    expect(problems, contains(startsWith('en x1.0: A RenderFlex overflowed')));
+    expect(problems, contains(startsWith('en x1.0: text cut off: "a text far too long')));
+  });
