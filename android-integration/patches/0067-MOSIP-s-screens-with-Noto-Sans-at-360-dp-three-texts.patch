+/// Texts cut off: over their line limit (maxLines, with an ellipsis or a clip), or wider than their box when they may
+/// not wrap. Each paragraph's text is laid out again with its own settings (RenderParagraph does not expose it).
+List<String> _cutOff(WidgetTester tester) {
+  final out = <String>[];
+  void visit(RenderObject o) {
+    if (o is RenderParagraph && o.hasSize) {
+      final painter = TextPainter(
+        text: o.text,
+        textAlign: o.textAlign,
+        textDirection: o.textDirection,
+        maxLines: o.maxLines,
+        ellipsis: o.overflow == TextOverflow.ellipsis ? '…' : null,
+        textScaleFactor: o.textScaleFactor,
+        locale: o.locale,
+        strutStyle: o.strutStyle,
+        textWidthBasis: o.textWidthBasis,
+        textHeightBehavior: o.textHeightBehavior,
+      )..layout(maxWidth: o.softWrap ? o.constraints.maxWidth : double.infinity);
+      if (painter.didExceedMaxLines || (!o.softWrap && painter.width > o.size.width + 0.5)) {
+        final text = o.text.toPlainText().replaceAll('\n', ' ');
+        out.add(text.length > 40 ? '${text.substring(0, 40)}…' : text);
+      }
+      painter.dispose();
+    }
+    o.visitChildren(visit);
+  }
+
+  visit(tester.binding.renderView);
+  return out;
+}
