+plugins {
+    id 'com.android.library'
+}
+
+// Face liveness for the registration client: the MOSIP liveness engine (libs/, synced from the
+// Mosip26 repository by android-integration/scripts/sync-engine.ps1), its signed model bundle
+// (src/main/assets/liveness/models/), the CameraX frame source and the Android adapters.
+android {
+    namespace 'io.mosip.registration.liveness.android'
+    lintOptions {
+        abortOnError false
+        ignoreWarnings true
+    }
+    compileSdk rootProject.ext.compileSdkVersion
+
+    defaultConfig {
+        minSdk rootProject.ext.minSdkVersion
+        targetSdk rootProject.ext.targetSdkVersion
+        consumerProguardFiles "consumer-rules.pro"
+    }
+
+    testOptions {
+        unitTests {
+            returnDefaultValues = true
+        }
+    }
+
+    packagingOptions {
+        // Each engine jar has its own git.properties (build info); merge them as the app does.
+        resources.merges.add("git.properties")
+        // The analyzer jar also carries the models as Java resources (desktop use). Android reads them
+        // from the assets; the app excludes liveness/models/** too, so they ship once.
+        resources.excludes.add("liveness/models/**")
+    }
+
+    compileOptions {
+        sourceCompatibility JavaVersion.VERSION_21
+        targetCompatibility JavaVersion.VERSION_21
+    }
+    buildToolsVersion rootProject.ext.buildToolsVersion
+}
+
+dependencies {
+    api fileTree(dir: 'libs', include: ['liveness-*.jar'])
+    implementation "com.microsoft.onnxruntime:onnxruntime-android:1.31.0"
+
+    api "androidx.camera:camera-core:1.3.4"
+    implementation "androidx.camera:camera-camera2:1.3.4"
+    implementation "androidx.camera:camera-lifecycle:1.3.4"
+    api "androidx.camera:camera-view:1.3.4"
+    implementation "androidx.core:core:1.12.0"
+
+    implementation project(':clientmanager')
+
+    testImplementation "junit:junit:${rootProject.ext.junitVersion}"
+    testImplementation "org.mockito:mockito-core:${rootProject.ext.mockitoCoreVersion}"
+}
