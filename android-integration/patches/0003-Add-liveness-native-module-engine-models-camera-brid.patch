+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+
+import javax.inject.Inject;
+import javax.inject.Singleton;
+
+import io.flutter.embedding.engine.FlutterEngine;
+import io.flutter.plugin.common.BinaryMessenger;
+import io.flutter.plugin.common.EventChannel;
+import io.mosip.registration.liveness.android.BestFrameEncoder;
+import io.mosip.registration.liveness.android.LivenessMaps;
+import io.mosip.registration.liveness.android.LivenessServiceHolder;
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.LivenessEvent;
+import io.mosip.registration.liveness.api.LivenessListener;
+import io.mosip.registration.liveness.api.LivenessPolicy;
+import io.mosip.registration.liveness.api.LivenessResult;
+import io.mosip.registration.liveness.api.LivenessSession;
+import io.mosip.registration.liveness.api.WorkflowType;
+import io.mosip.registration.liveness.device.android.CameraXFrameSource;
+import io.mosip.registration_client.BuildConfig;
+import io.mosip.registration_client.MainActivity;
+import io.mosip.registration_client.model.LivenessPigeon;
+
+/**
+ * Face liveness for Dart: the Pigeon {@code LivenessApi} plus the event channel
+ * {@value #EVENT_CHANNEL}, which carries each session's events and its result (see {@link LivenessMaps}).
+ *
+ * <p>One session at a time: starting a session cancels the running one (whose remaining callbacks are dropped),
+ * and the Activity pausing cancels it. Session state is touched on the main thread only. The best frame is
+ * sent to Dart as a JPEG on PASSED and is never logged.</p>
+ */
+@Singleton
+public class LivenessApi implements LivenessPigeon.LivenessApi {
+
+    private static final String TAG = "LivenessApi";
+    public static final String EVENT_CHANNEL = "io.mosip.registration_client/liveness/events";
+    public static final String PREVIEW_VIEW_TYPE = "io.mosip.registration_client/liveness_preview";
+    private static final Size ANALYSIS_RESOLUTION = new Size(640, 480);
+
+    private final LivenessServiceHolder holder;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private WeakReference<MainActivity> activityRef = new WeakReference<>(null);
+
+    // Main thread only.
+    private EventChannel.EventSink events;
+    private LivenessSession session;
+    private CameraXFrameSource source;
+    private int generation;
+
+    @Inject
+    public LivenessApi(LivenessServiceHolder holder) {
+        this.holder = holder;
+    }
+
+    public void setCallbackActivity(MainActivity activity) {
+        this.activityRef = new WeakReference<>(activity);
+    }
+
+    /** Registers the Pigeon API, the event channel and the camera preview view factory. */
+    public void setup(@NonNull FlutterEngine flutterEngine) {
+        BinaryMessenger messenger = flutterEngine.getDartExecutor().getBinaryMessenger();
+        LivenessPigeon.LivenessApi.setup(messenger, this);
+        new EventChannel(messenger, EVENT_CHANNEL).setStreamHandler(new EventChannel.StreamHandler() {
+            @Override
+            public void onListen(Object arguments, EventChannel.EventSink sink) {
+                events = sink;
+            }
+
+            @Override
+            public void onCancel(Object arguments) {
+                events = null;
+            }
+        });
+        flutterEngine.getPlatformViewsController().getRegistry()
+                .registerViewFactory(PREVIEW_VIEW_TYPE, new LivenessPreviewFactory(holder));
+    }
+
+    /** Loads the models in the background so the first session does not wait for them. */
+    public void preload() {
+        holder.preload();
+    }
+
+    public void onActivityPause() {
+        if (session != null) {
+            Log.i(TAG, "activity paused: cancelling the liveness session");
+            session.cancel();
+        }
+    }
+
+    @NonNull
+    @Override
+    public Boolean isEnabled(@NonNull String workflow) {
+        return holder.policy(workflow(workflow)).enabled;
+    }
+
+    @NonNull
+    @Override
+    public LivenessPigeon.LivenessPolicyInfo policy(@NonNull String workflow) {
+        LivenessPolicy p = holder.policy(workflow(workflow));
+        return new LivenessPigeon.LivenessPolicyInfo.Builder()
+                .setEnabled(p.enabled)
+                .setMaxRetries((long) p.maxRetries)
+                .setMinChallenges((long) p.minChallenges)
+                .setChallengeTimeoutMs(p.challengeTimeoutMs)
+                .build();
+    }
+
+    @Override
+    public void startSession(@NonNull String workflow, @NonNull String camera, @NonNull Boolean useFake,
+                             @NonNull LivenessPigeon.Result<String> result) {
+        int gen = ++generation; // callbacks of the session being replaced are dropped from here on
+        stopCurrent();
+        MainActivity activity = activityRef.get();
+        if (activity == null) {
+            result.error(new IllegalStateException("Activity not set"));
+            return;
+        }
+        WorkflowType wf;
+        try {
+            wf = workflow(workflow);
+        } catch (IllegalArgumentException e) {
+            result.error(e);
+            return;
+        }
+        if (ContextCompat.checkSelfPermission(activity, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+            // Dart asks for the permission first; this covers a refusal or a revoked permission.
+            String id = UUID.randomUUID().toString();
+            Log.w(TAG, "camera permission not granted: session " + id + " failed");
+            result.success(id);
+            send(gen, LivenessMaps.failed(ErrorCode.CAMERA_UNAVAILABLE, id, holder.modelVersion()));
+            return;
+        }
+        LivenessSession s;
+        try {
+            s = holder.service(useFake).newSession(wf);
+        } catch (RuntimeException e) {
+            result.error(e);
+            return;
+        }
+        if (s == null) {
+            result.success(""); // liveness disabled for this workflow: the caller keeps its legacy flow
+            return;
+        }
+        PreviewView preview = holder.preview();
+        CameraSelector selector = "back".equalsIgnoreCase(camera)
+                ? CameraSelector.DEFAULT_BACK_CAMERA : CameraSelector.DEFAULT_FRONT_CAMERA;
+        CameraXFrameSource src = new CameraXFrameSource(activity, activity, selector, ANALYSIS_RESOLUTION, 1,
+                preview == null ? null : preview.getSurfaceProvider());
+        src.setDebugTiming(BuildConfig.DEBUG);
+        session = s;
+        source = src;
+        holder.analyzerTimes().reset();
+        Log.i(TAG, "session " + s.sessionId() + " started: " + wf + ", " + (useFake ? "fake" : "real") + " engine, "
+                + ("back".equalsIgnoreCase(camera) ? "back" : "front") + " camera, preview " + (preview != null));
+        s.start(src, new LivenessListener() {
+            @Override
+            public void onEvent(LivenessEvent event) {
+                Map<String, Object> m = LivenessMaps.event(event);
+                if (BuildConfig.DEBUG) Log.d(TAG, "event " + event.type + describe(event));
+                send(gen, m);
+            }
+
+            @Override
+            public void onComplete(LivenessResult r) {
+                complete(gen, r, src);
+            }
+        });
+        result.success(s.sessionId());
+    }
+
+    @Override
+    public void retry() {
+        if (session != null) session.retry();
+    }
+
+    @Override
+    public void cancel() {
+        if (session != null) session.cancel();
+    }
+
+    @NonNull
+    @Override
+    public String modelVersion() {
+        return holder.modelVersion();
+    }
+
+    @Override
+    public void setConfigOverride(@NonNull String key, @NonNull String value) {
+        if (!BuildConfig.DEBUG) {
+            Log.w(TAG, "config overrides are for debug builds only; ignored " + key);
+            return;
+        }
+        holder.setOverride(key, value);
+        Log.i(TAG, "config overrides now " + holder.overrides());
+    }
+
+    private void complete(int gen, LivenessResult r, CameraXFrameSource src) {
+        src.stop(); // the session stops it too; stop() is idempotent
+        if (BuildConfig.DEBUG) {
+            Log.i(TAG, "complete " + LivenessMaps.describe(r));
+            Log.i(TAG, "analyzer " + holder.analyzerTimes().summary());
+        } else {
+            Log.i(TAG, "complete " + r.decision + " " + r.failureCode + " in " + r.durationMs + " ms");
+        }
+        holder.background().execute(() -> {
+            byte[] jpeg = null;
+            if (r.passed() && r.bestFrame != null) {
+                try {
+                    jpeg = BestFrameEncoder.jpeg(r.bestFrame, BestFrameEncoder.QUALITY);
+                } catch (RuntimeException e) {
+                    Log.e(TAG, "best frame could not be encoded", e);
+                }
+            }
+            Map<String, Object> m = LivenessMaps.result(r, jpeg);
+            main.post(() -> {
+                if (gen != generation) return;
+                session = null;
+                source = null;
+                deliver(m);
+            });
+        });
+    }
+
+    private void send(int gen, Map<String, Object> m) {
+        main.post(() -> {
+            if (gen == generation) deliver(m);
+        });
+    }
+
+    private void deliver(Map<String, Object> m) {
+        if (events != null) events.success(m);
+    }
+
+    private void stopCurrent() {
+        LivenessSession s = session;
+        CameraXFrameSource src = source;
+        session = null;
+        source = null;
+        if (s != null) s.cancel();
+        if (src != null) src.stop();
+    }
+
+    private static WorkflowType workflow(String workflow) {
+        return WorkflowType.valueOf(workflow.trim().toUpperCase(Locale.ROOT));
+    }
+
+    private static String describe(LivenessEvent e) {
+        StringBuilder sb = new StringBuilder();
+        if (e.guidance != null) sb.append(' ').append(e.guidance);
+        if (e.challenge != null) sb.append(' ').append(e.challenge).append(' ').append(e.challengeIndex).append('/').append(e.challengeCount);
+        if (e.type == LivenessEvent.Type.CHALLENGE_PROGRESS) sb.append(String.format(Locale.ROOT, " %.2f", e.progress));
+        if (e.error != null) sb.append(' ').append(e.error).append(" retriesLeft=").append(e.retriesLeft);
+        return sb.toString();
+    }
+}
