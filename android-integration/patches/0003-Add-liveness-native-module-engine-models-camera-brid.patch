+package io.mosip.registration.liveness.android;
+
+import android.content.Context;
+import android.content.res.AssetManager;
+
+import java.io.FileNotFoundException;
+import java.io.IOException;
+import java.io.InputStream;
+
+import io.mosip.registration.liveness.analyzer.integrity.BundleSource;
+
+/**
+ * Reads the bundled, signed model bundle from the APK assets ({@code assets/liveness/models/}).
+ * The bundle is verified by the engine ({@code VerifiedBundle}) after reading; this class only reads,
+ * with the same per-file size cap as the other bundle sources.
+ */
+public final class AssetBundleSource implements BundleSource {
+
+    public static final String DEFAULT_PREFIX = "liveness/models/";
+
+    private final AssetManager assets;
+    private final String prefix;
+
+    public AssetBundleSource(Context context) {
+        this(context.getAssets(), DEFAULT_PREFIX);
+    }
+
+    public AssetBundleSource(AssetManager assets, String prefix) {
+        if (assets == null || prefix == null) throw new IllegalArgumentException("null argument");
+        this.assets = assets;
+        this.prefix = prefix;
+    }
+
+    @Override
+    public byte[] read(String name) throws IOException {
+        InputStream in;
+        try {
+            in = assets.open(prefix + name, AssetManager.ACCESS_STREAMING);
+        } catch (FileNotFoundException e) {
+            throw new FileNotFoundException("missing " + describe() + name);
+        }
+        if (in == null) throw new FileNotFoundException("missing " + describe() + name);
+        return Reader.readCapped(in, name, MAX_FILE_BYTES);
+    }
+
+    @Override
+    public String describe() {
+        return "assets:" + prefix;
+    }
+}
