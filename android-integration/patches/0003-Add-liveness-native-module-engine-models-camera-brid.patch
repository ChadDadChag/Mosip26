--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/LivenessMaps.java
@@ -0,0 +1,93 @@
+package io.mosip.registration.liveness.android;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+import io.mosip.registration.liveness.api.ChallengeType;
+import io.mosip.registration.liveness.api.ErrorCode;
+import io.mosip.registration.liveness.api.LivenessEvent;
+import io.mosip.registration.liveness.api.LivenessResult;
+
+/**
+ * The maps sent to Dart on the liveness event channel. Enums travel as their names, absent values as null.
+ *
+ * <pre>
+ * event:    {kind:"event", type, guidance, challenge, challengeIndex, challengeCount, timeoutMs, progress,
+ *            error, userMessage, attemptNumber, retriesLeft, recoverable}
+ * complete: {kind:"complete", decision, passPath, failureCode, userMessage, passiveScore, challengesIssued:[...],
+ *            attempts, durationMs, sessionId, modelVersion, bestFrameJpeg}
+ * </pre>
+ *
+ * <p>{@code bestFrameJpeg} is set only on PASSED. {@link #describe(LivenessResult)} is the log form of a result:
+ * it never contains the image.</p>
+ */
+public final class LivenessMaps {
+
+    public static final String KIND = "kind";
+    public static final String KIND_EVENT = "event";
+    public static final String KIND_COMPLETE = "complete";
+    public static final String BEST_FRAME_JPEG = "bestFrameJpeg";
+
+    private LivenessMaps() { }
+
+    public static Map<String, Object> event(LivenessEvent e) {
+        Map<String, Object> m = new HashMap<>();
+        m.put(KIND, KIND_EVENT);
+        m.put("type", name(e.type));
+        m.put("guidance", name(e.guidance));
+        m.put("challenge", name(e.challenge));
+        m.put("challengeIndex", e.challengeIndex);
+        m.put("challengeCount", e.challengeCount);
+        m.put("timeoutMs", e.timeoutMs);
+        m.put("progress", (double) e.progress);
+        m.put("error", name(e.error));
+        m.put("userMessage", e.error == null ? null : e.error.userMessage().name());
+        m.put("attemptNumber", e.attemptNumber);
+        m.put("retriesLeft", e.retriesLeft);
+        m.put("recoverable", e.recoverable);
+        return m;
+    }
+
+    /** @param bestFrameJpeg the encoded best frame; ignored unless the result PASSED */
+    public static Map<String, Object> result(LivenessResult r, byte[] bestFrameJpeg) {
+        Map<String, Object> m = new HashMap<>();
+        m.put(KIND, KIND_COMPLETE);
+        m.put("decision", name(r.decision));
+        m.put("passPath", name(r.passPath));
+        m.put("failureCode", name(r.failureCode));
+        m.put("userMessage", r.failureCode == null ? ErrorCode.UserMessage.NONE.name() : r.failureCode.userMessage().name());
+        m.put("passiveScore", (double) r.passiveScore);
+        List<String> challenges = new ArrayList<>();
+        for (ChallengeType c : r.challengesIssued == null ? Collections.<ChallengeType>emptyList() : r.challengesIssued) {
+            challenges.add(c.name());
+        }
+        m.put("challengesIssued", challenges);
+        m.put("attempts", r.attempts);
+        m.put("durationMs", r.durationMs);
+        m.put("sessionId", r.sessionId);
+        m.put("modelVersion", r.modelVersion);
+        m.put(BEST_FRAME_JPEG, r.decision == LivenessResult.Decision.PASSED ? bestFrameJpeg : null);
+        return m;
+    }
+
+    /** A completed session that never reached the engine, e.g. the camera permission was refused. */
+    public static Map<String, Object> failed(ErrorCode code, String sessionId, String modelVersion) {
+        return result(new LivenessResult(LivenessResult.Decision.FAILED, LivenessResult.PassPath.NONE, code, null,
+                Float.NaN, Collections.<ChallengeType>emptyList(), 0, 0L, sessionId, modelVersion), null);
+    }
+
+    /** One log line for a result, without the best frame. */
+    public static String describe(LivenessResult r) {
+        return String.format(Locale.ROOT, "decision=%s path=%s failure=%s score=%.4f challenges=%s attempts=%d durationMs=%d model=%s session=%s",
+                r.decision, r.passPath, r.failureCode, r.passiveScore, r.challengesIssued, r.attempts, r.durationMs,
+                r.modelVersion, r.sessionId);
+    }
+
+    private static String name(Enum<?> e) {
+        return e == null ? null : e.name();
+    }
+}
