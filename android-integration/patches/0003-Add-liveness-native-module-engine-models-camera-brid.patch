index 0000000..a1868f9
--- /dev/null
+++ b/android/liveness/src/main/java/io/mosip/registration/liveness/android/AndroidAuditSink.java
@@ -0,0 +1,125 @@
+package io.mosip.registration.liveness.android;
+
+import android.util.Log;
+
+import java.util.Map;
+import java.util.concurrent.Executor;
+import java.util.concurrent.Executors;
+
+import io.mosip.registration.clientmanager.constant.AuditEvent;
+import io.mosip.registration.clientmanager.constant.Components;
+import io.mosip.registration.clientmanager.spi.AuditManagerService;
+import io.mosip.registration.liveness.api.AuditSink;
+import io.mosip.registration.liveness.api.WorkflowType;
+
+/**
+ * Writes the engine's audit records to the client's audit table through {@link AuditManagerService}.
+ *
+ * <p>Each {@link AuditSink.Event} has its own {@link AuditEvent} (REG-EVT-009..017). The workflow picks the
+ * module: RESIDENT is the registration, OPERATOR the operator's login and onboarding, SUPERVISOR the approval
+ * of packets in the packet list; records without a workflow (model loading at app start) go to HOME.
+ * The session id and the engine's details are appended to the event description as {@code key=value;...},
+ * cut to {@link #MAX_DESCRIPTION} characters (the server's audit description column).</p>
+ *
+ * <p>The engine only passes codes, scores, versions, timings and ids, never images. Records are written on a
+ * background thread; a failure is logged and never reaches the engine.</p>
+ */
+public final class AndroidAuditSink implements AuditSink {
+
+    private static final String TAG = "LivenessAudit";
+
+    /** log_desc in MOSIP's audit table is varchar(2048). */
+    public static final int MAX_DESCRIPTION = 2048;
+    static final String ELLIPSIS = "...";
+
+    private final AuditManagerService auditManager;
+    private final Executor executor;
+
+    public AndroidAuditSink(AuditManagerService auditManager) {
+        this(auditManager, Executors.newSingleThreadExecutor(r -> {
+            Thread t = new Thread(r, "liveness-audit");
+            t.setDaemon(true);
+            return t;
+        }));
+    }
+
+    AndroidAuditSink(AuditManagerService auditManager, Executor executor) {
+        if (auditManager == null || executor == null) throw new IllegalArgumentException("null argument");
+        this.auditManager = auditManager;
+        this.executor = executor;
+    }
+
+    @Override
+    public void record(Event event, WorkflowType workflow, String sessionId, Map<String, String> details) {
+        try {
+            AuditEvent auditEvent = auditEvent(event);
+            Components component = component(workflow);
+            String text = details(auditEvent, sessionId, details);
+            executor.execute(() -> write(auditEvent, component, text));
+        } catch (RuntimeException e) {
+            Log.w(TAG, "could not record " + event, e);
+        }
+    }
+
+    private void write(AuditEvent auditEvent, Components component, String text) {
+        try {
+            auditManager.audit(auditEvent, component, text);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "could not write " + auditEvent.getName(), e);
+        }
+    }
+
+    static AuditEvent auditEvent(Event event) {
+        switch (event) {
+            case LIVENESS_STARTED: return AuditEvent.LIVENESS_STARTED;
+            case LIVENESS_PASSED: return AuditEvent.LIVENESS_PASSED;
+            case LIVENESS_ATTEMPT_FAILED: return AuditEvent.LIVENESS_ATTEMPT_FAILED;
+            case LIVENESS_FAILED_FINAL: return AuditEvent.LIVENESS_FAILED_FINAL;
+            case PAD_ATTACK_SUSPECTED: return AuditEvent.LIVENESS_PAD_ATTACK_SUSPECTED;
+            case DEVICE_ERROR: return AuditEvent.LIVENESS_DEVICE_ERROR;
+            case MODEL_LOADED: return AuditEvent.LIVENESS_MODEL_LOADED;
+            case MODEL_INTEGRITY_FAILED: return AuditEvent.LIVENESS_MODEL_INTEGRITY_FAILED;
+            case CONFIG_LOADED: return AuditEvent.LIVENESS_CONFIG_LOADED;
+            default: throw new IllegalArgumentException("unknown event " + event);
+        }
+    }
+
+    static Components component(WorkflowType workflow) {
+        if (workflow == null) return Components.HOME;
+        switch (workflow) {
+            case RESIDENT: return Components.REGISTRATION;
+            case OPERATOR: return Components.LOGIN;
+            case SUPERVISOR: return Components.REG_PACKET_LIST;
+            default: return Components.HOME;
+        }
+    }
+
+    /**
+     * {@code sessionId=...;key=value;...}, cut so that the stored description ("event description: details")
+     * stays within {@link #MAX_DESCRIPTION}. ';' and '=' inside values become ',' and ':' so the text stays parseable.
+     */
+    static String details(AuditEvent auditEvent, String sessionId, Map<String, String> details) {
+        StringBuilder sb = new StringBuilder();
+        if (sessionId != null) append(sb, "sessionId", sessionId);
+        if (details != null) {
+            for (Map.Entry<String, String> e : details.entrySet()) append(sb, e.getKey(), e.getValue());
+        }
+        // AuditManagerServiceImpl stores "<description>: <details>".
+        int max = MAX_DESCRIPTION - auditEvent.getDescription().length() - 2;
+        if (sb.length() > max) {
+            sb.setLength(Math.max(0, max - ELLIPSIS.length()));
+            sb.append(ELLIPSIS);
+        }
+        return sb.toString();
+    }
+
+    private static void append(StringBuilder sb, String key, String value) {
+        if (sb.length() > 0) sb.append(';');
+        sb.append(clean(key)).append('=').append(clean(value));
+    }
+
+    private static String clean(String s) {
+        if (s == null) return "";
+        return s.replace(';', ',').replace('=', ':').replace('\n', ' ').replace('\r', ' ');
+    }
+}
