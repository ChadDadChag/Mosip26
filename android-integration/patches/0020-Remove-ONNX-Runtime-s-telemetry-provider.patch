From 368641e8e1c2ed9ada3ba6d1c14ea75800ffc584 Mon Sep 17 00:00:00 2001
From: Varun-iiitb <var3907@gmail.com>
Date: Sat, 24 Oct 2026 21:53:41 +0530
Subject: [PATCH 20/61] Remove ONNX Runtime's telemetry provider

The onnxruntime-android 1.31.0 AAR registers ai.onnxruntime.TelemetryInitializer,
a ContentProvider that starts a telemetry HTTP client at app start (device
class, locale, time zone and an id; INTERNET and ACCESS_NETWORK_STATE are
declared for it). Found in the P5-5 airplane-mode check: every app start
logged "ORTTelemetry: Unable to initialize telemetry" (UnsatisfiedLinkError,
the 1.31.0 native library lacks the JNI symbol), so nothing was sent, but a
later ORT version could start sending.

The liveness module's manifest removes the provider (tools:node="remove");
the merged profile manifest no longer contains it, the app starts without
the ORTTelemetry warning and the bundle still verifies and loads (ONNX
sessions built). Inference does not use the provider. The app's own
INTERNET permission (MOSIP sync) is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 android/liveness/src/main/AndroidManifest.xml | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/android/liveness/src/main/AndroidManifest.xml b/android/liveness/src/main/AndroidManifest.xml
index 624c31a..b1e4144 100644
--- a/android/liveness/src/main/AndroidManifest.xml
+++ b/android/liveness/src/main/AndroidManifest.xml
@@ -1,3 +1,16 @@
 <?xml version="1.0" encoding="utf-8"?>
 <!-- The CAMERA permission is declared by the app, which asks for it before a liveness session. -->
-<manifest />
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:tools="http://schemas.android.com/tools">
+
+    <application>
+        <!-- The ONNX Runtime AAR (1.31.0) registers this provider to start a telemetry HTTP client at app start
+             (device class, locale, time zone, an id). In 1.31.0 it fails to initialise (missing JNI symbol), but the
+             liveness engine must work offline and send nothing, so it is removed rather than left to a future
+             version. Inference does not use it. -->
+        <provider
+            android:name="ai.onnxruntime.TelemetryInitializer"
+            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
+            tools:node="remove" />
+    </application>
+</manifest>
