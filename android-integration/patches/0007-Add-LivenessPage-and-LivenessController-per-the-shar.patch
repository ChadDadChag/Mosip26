new file mode 100644
index 0000000..7910dc3
--- /dev/null
+++ b/lib/ui/liveness/liveness_controller.dart
@@ -0,0 +1,480 @@
+/*
+ * Copyright (c) Modular Open Source Identity Platform
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+*/
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+import 'package:registration_client/platform_spi/liveness_service.dart';
+
+/// Creates the controller's timers; tests pass a manual one.
+typedef LivenessTimerFactory = Timer Function(
+    Duration duration, void Function() callback);
+
+enum LivenessPhase {
+  starting,
+  checking,
+  challenge,
+  actionDetected,
+  holdStill,
+  attemptFailed,
+  passed,
+  failedFinal,
+  deviceError,
+  cancelled,
+}
+
+/// The face-oval colour. Always shown together with [LivenessIcon].
+enum LivenessOvalTone { neutral, checking, challenge, success, error }
+
+enum LivenessIcon {
+  camera,
+  scanning,
+  blink,
+  smile,
+  turnLeft,
+  turnRight,
+  lookUp,
+  lookDown,
+  check,
+  cross,
+  cameraOff,
+}
+
+const Object _unset = Object();
+
+/// What the liveness screen shows, as canonical message keys
+/// (docs/ui-liveness-spec.md §3, §4). Never a score or model detail.
+@immutable
+class LivenessViewState {
+  const LivenessViewState({
+    required this.phase,
+    this.statusKey,
+    this.hintKey,
+    this.hintIsGuidance = false,
+    this.challengeKey,
+    this.stepIndex = 0,
+    this.stepCount = 0,
+    this.progressVisible = false,
+    this.progress,
+    this.attempt = 0,
+    this.maxAttempts = 0,
+    this.retriesLeft = 0,
+    this.ovalTone = LivenessOvalTone.neutral,
+    this.icon = LivenessIcon.camera,
+    this.showRetry = false,
+    this.showCancel = true,
+    this.showClose = false,
+    this.tips = false,
+    this.messageKey,
+    this.recoveryKey,
+  });
+
+  final LivenessPhase phase;
+
+  /// The big status line: a status, challenge, feedback or error key.
+  final String? statusKey;
+
+  /// The hint line. `liveness.retry.attempts_left` takes [retriesLeft].
+  final String? hintKey;
+
+  /// The hint is positioning guidance (shown with a warning icon).
+  final bool hintIsGuidance;
+
+  /// `liveness.challenge.<name>` during a challenge.
+  final String? challengeKey;
+
+  /// "Step i of n" (1-based); 0 = not shown.
+  final int stepIndex;
+  final int stepCount;
+
+  /// The progress bar is shown; [progress] null = indeterminate.
+  final bool progressVisible;
+  final double? progress;
+
+  /// "Attempt a of m"; 0 = not shown.
+  final int attempt;
+  final int maxAttempts;
+  final int retriesLeft;
+
+  final LivenessOvalTone ovalTone;
+  final LivenessIcon icon;
+
+  final bool showRetry;
+  final bool showCancel;
+  final bool showClose;
+
+  /// Show the tips list (LIVENESS_NOT_VERIFIED only).
+  final bool tips;
+
+  /// The failure message key (attempt failed, device error, final failure).
+  final String? messageKey;
+
+  /// `liveness.recovery.<workflow>` on a final failure.
+  final String? recoveryKey;
+
+  bool get isFinal =>
+      phase == LivenessPhase.passed ||
+      phase == LivenessPhase.failedFinal ||
+      phase == LivenessPhase.cancelled;
+
+  LivenessViewState copyWith({
+    LivenessPhase? phase,
+    Object? statusKey = _unset,
+    Object? hintKey = _unset,
+    bool? hintIsGuidance,
+    Object? challengeKey = _unset,
+    int? stepIndex,
+    int? stepCount,
+    bool? progressVisible,
+    Object? progress = _unset,
+    int? attempt,
+    int? maxAttempts,
+    int? retriesLeft,
+    LivenessOvalTone? ovalTone,
+    LivenessIcon? icon,
+    bool? showRetry,
+    bool? showCancel,
+    bool? showClose,
+    bool? tips,
+    Object? messageKey = _unset,
+    Object? recoveryKey = _unset,
+  }) {
+    return LivenessViewState(
+      phase: phase ?? this.phase,
+      statusKey: identical(statusKey, _unset) ? this.statusKey : statusKey as String?,
+      hintKey: identical(hintKey, _unset) ? this.hintKey : hintKey as String?,
+      hintIsGuidance: hintIsGuidance ?? this.hintIsGuidance,
+      challengeKey:
+          identical(challengeKey, _unset) ? this.challengeKey : challengeKey as String?,
+      stepIndex: stepIndex ?? this.stepIndex,
+      stepCount: stepCount ?? this.stepCount,
+      progressVisible: progressVisible ?? this.progressVisible,
+      progress: identical(progress, _unset) ? this.progress : progress as double?,
+      attempt: attempt ?? this.attempt,
+      maxAttempts: maxAttempts ?? this.maxAttempts,
+      retriesLeft: retriesLeft ?? this.retriesLeft,
+      ovalTone: ovalTone ?? this.ovalTone,
+      icon: icon ?? this.icon,
+      showRetry: showRetry ?? this.showRetry,
+      showCancel: showCancel ?? this.showCancel,
+      showClose: showClose ?? this.showClose,
+      tips: tips ?? this.tips,
+      messageKey: identical(messageKey, _unset) ? this.messageKey : messageKey as String?,
+      recoveryKey: identical(recoveryKey, _unset) ? this.recoveryKey : recoveryKey as String?,
+    );
+  }
+
+  @override
+  String toString() => 'LivenessViewState($phase, status=$statusKey, hint=$hintKey, '
+      'step=$stepIndex/$stepCount, progress=${progressVisible ? progress : '-'}, '
+      'attempt=$attempt/$maxAttempts, tone=$ovalTone, icon=$icon, '
+      'retry=$showRetry cancel=$showCancel close=$showClose tips=$tips, '
+      'message=$messageKey recovery=$recoveryKey)';
+}
+
+/// Turns liveness events and the result into [LivenessViewState]s, following
+/// docs/ui-liveness-spec.md §3 and §4. Holds no widgets.
+///
+/// Guidance hints: a new hint is shown at once unless another one was shown
+/// less than [hintDebounce] ago; then it waits for the rest of that time (the
+/// latest one wins). CHECKING_PASSIVE, CHALLENGE_PROMPT, CHALLENGE_PROGRESS,
+/// PASSED and failures clear the hint and drop a waiting one.
+class LivenessController extends ChangeNotifier {
+  LivenessController({
+    required String workflow,
+    int maxRetries = 0,
+    LivenessTimerFactory? timerFactory,
+  })  : _workflow = workflow.toLowerCase(),
+        _timer = timerFactory ?? ((d, cb) => Timer(d, cb)),
+        _state = LivenessViewState(
+          phase: LivenessPhase.starting,
+          statusKey: 'liveness.status.starting',
+          maxAttempts: maxRetries + 1,
+        );
+
+  static const Duration hintDebounce = Duration(milliseconds: 500);
+
+  final String _workflow;
+  final LivenessTimerFactory _timer;
+  LivenessViewState _state;
+  LivenessMessage? _result;
+  Timer? _hintLock;
+  String? _pendingHint;
+  bool _disposed = false;
+
+  LivenessViewState get state => _state;
+
+  /// The session's result once it completed (kind "complete").
+  LivenessMessage? get result => _result;
+
+  String get titleKey => 'liveness.title.$_workflow';
+
+  /// From `policy(workflow).maxRetries`: "Attempt a of m" uses m = maxRetries + 1.
+  set maxRetries(int value) => _set(_state.copyWith(maxAttempts: value + 1));
+
+  void handle(LivenessMessage m) {
+    if (_disposed) return;
+    if (m.isComplete) {
+      _complete(m);
+    } else if (!_state.isFinal) {
+      _event(m);
+    }
+  }
+
+  /// The camera permission was refused: the device text, the recovery text and Close.
+  void permissionDenied() => _set(_finalState('DEVICE_PROBLEM'));
+
+  /// The session could not be started at all (bridge error).
+  void startFailed() => _set(_finalState('VERIFICATION_NOT_COMPLETED'));
+
+  void _event(LivenessMessage m) {
+    final attempt = m.attemptNumber > 0 ? m.attemptNumber : _state.attempt;
+    switch (m.type) {
+      case 'STARTED':
+        _dropPendingHint();
+        _set(LivenessViewState(
+          phase: LivenessPhase.starting,
+          statusKey: 'liveness.status.starting',
+          attempt: attempt,
+          maxAttempts: _state.maxAttempts,
+          ovalTone: LivenessOvalTone.neutral,
+          icon: LivenessIcon.camera,
+        ));
+        break;
+      case 'CHECKING_PASSIVE':
+        _dropPendingHint();
+        _set(LivenessViewState(
+          phase: LivenessPhase.checking,
+          statusKey: 'liveness.status.checking',
+          progressVisible: true,
+          attempt: attempt,
+          maxAttempts: _state.maxAttempts,
+          ovalTone: LivenessOvalTone.checking,
+          icon: LivenessIcon.scanning,
+        ));
+        break;
+      case 'GUIDANCE':
+        if (_state.phase == LivenessPhase.attemptFailed) return; // the hint line shows the attempts left
+        final guidance = m.guidance;
+        if (guidance != null) _showGuidance('liveness.guidance.${guidance.toLowerCase()}');
+        break;
+      case 'CHALLENGE_PROMPT':
+        _dropPendingHint();
+        _set(_challengeState(m, attempt, progress: 0, hint: null));
+        break;
+      case 'CHALLENGE_PROGRESS':
+        _dropPendingHint();
+        _set(_challengeState(m, attempt,
+            progress: m.progress.clamp(0.0, 1.0).toDouble(),
+            hint: 'liveness.feedback.continue'));
+        break;
+      case 'ACTION_DETECTED':
+        _dropPendingHint();
+        _set(_state.copyWith(
+          phase: LivenessPhase.actionDetected,
+          statusKey: 'liveness.feedback.action_detected',
+          hintKey: null,
+          hintIsGuidance: false,
+          progressVisible: true,
+          progress: 1.0,
+          attempt: attempt,
+          ovalTone: LivenessOvalTone.success,
+          icon: LivenessIcon.check,
+        ));
+        break;
+      case 'HOLD_STILL':
+        _dropPendingHint();
+        _set(LivenessViewState(
+          phase: LivenessPhase.holdStill,
+          statusKey: 'liveness.feedback.hold_still',
+          progressVisible: true,
+          attempt: attempt,
+          maxAttempts: _state.maxAttempts,
+          ovalTone: LivenessOvalTone.checking,
+          icon: LivenessIcon.scanning,
+        ));
+        break;
+      case 'ATTEMPT_FAILED':
+        _dropPendingHint();
+        final message = _errorKey(m.userMessage);
+        _set(LivenessViewState(
+          phase: LivenessPhase.attemptFailed,
+          statusKey: message,
+          messageKey: message,
+          hintKey: 'liveness.retry.attempts_left',
+          retriesLeft: m.retriesLeft,
+          attempt: attempt,
+          maxAttempts: _state.maxAttempts,
+          ovalTone: LivenessOvalTone.error,
+          icon: LivenessIcon.cross,
+          showRetry: true,
+          tips: m.userMessage == 'LIVENESS_NOT_VERIFIED',
+        ));
+        break;
+      case 'PASSED':
+        _set(_passedState(attempt));
+        break;
+      case 'FAILED_FINAL':
+        _set(_finalState(m.userMessage, attempt: attempt));
+        break;
+      case 'DEVICE_ERROR':
+        _dropPendingHint();
+        _set(LivenessViewState(
+          phase: LivenessPhase.deviceError,
+          statusKey: 'liveness.error.device_problem',
+          messageKey: 'liveness.error.device_problem',
+          attempt: attempt,
+          maxAttempts: _state.maxAttempts,
+          retriesLeft: m.retriesLeft,
+          ovalTone: LivenessOvalTone.error,
+          icon: LivenessIcon.cameraOff,
+          showRetry: m.recoverable,
+        ));
+        break;
+      default:
+        break; // a newer engine's event: nothing to show
+    }
+  }
+
+  void _complete(LivenessMessage m) {
+    _result = m;
+    switch (m.decision) {
+      case 'PASSED':
+        if (_state.phase != LivenessPhase.passed) _set(_passedState(_state.attempt));
+        break;
+      case 'CANCELLED':
+        _dropPendingHint();
+        _set(LivenessViewState(
+          phase: LivenessPhase.cancelled,
+          attempt: _state.attempt,
+          maxAttempts: _state.maxAttempts,
+          showCancel: false,
+        ));
+        break;
+      default:
+        // Usually FAILED_FINAL came first; a refusal before any event (camera permission) did not.
+        if (_state.phase != LivenessPhase.failedFinal) _set(_finalState(m.userMessage));
+    }
+  }
+
+  LivenessViewState _challengeState(LivenessMessage m, int attempt,
+      {required double progress, required String? hint}) {
+    final challenge = m.challenge;
+    return LivenessViewState(
+      phase: LivenessPhase.challenge,
+      statusKey: challenge == null ? _state.statusKey : 'liveness.challenge.${challenge.toLowerCase()}',
+      challengeKey: challenge == null ? null : 'liveness.challenge.${challenge.toLowerCase()}',
+      hintKey: hint,
+      stepIndex: m.challengeIndex,
+      stepCount: m.challengeCount,
+      progressVisible: true,
+      progress: progress,
+      attempt: attempt,
+      maxAttempts: _state.maxAttempts,
+      ovalTone: LivenessOvalTone.challenge,
+      icon: _challengeIcon(challenge),
+    );
+  }
+
+  LivenessViewState _passedState(int attempt) {
+    _dropPendingHint();
+    return LivenessViewState(
+      phase: LivenessPhase.passed,
+      statusKey: 'liveness.status.passed',
+      progressVisible: true,
+      progress: 1.0,
+      attempt: attempt,
+      maxAttempts: _state.maxAttempts,
+      ovalTone: LivenessOvalTone.success,
+      icon: LivenessIcon.check,
+      showCancel: false,
+    );
+  }
+
+  /// FAILED_FINAL: never the "try again" texts. MAX_RETRIES_EXCEEDED, a cooldown
+  /// refusal and final engine or PAD errors get max_attempts_reached; a device
+  /// problem gets the device text. Both with the workflow's recovery text.
+  LivenessViewState _finalState(String? userMessage, {int? attempt}) {
+    _dropPendingHint();
+    final key = userMessage == 'DEVICE_PROBLEM'
+        ? 'liveness.error.device_problem'
+        : 'liveness.error.max_attempts_reached';
+    return LivenessViewState(
+      phase: LivenessPhase.failedFinal,
+      statusKey: key,
+      messageKey: key,
+      recoveryKey: 'liveness.recovery.$_workflow',
+      attempt: attempt ?? _state.attempt,
+      maxAttempts: _state.maxAttempts,
+      ovalTone: LivenessOvalTone.error,
+      icon: LivenessIcon.cross,
+      showCancel: false,
+      showClose: true,
+    );
+  }
+
+  static String _errorKey(String? userMessage) {
+    if (userMessage == null || userMessage == 'NONE') {
+      return 'liveness.error.verification_not_completed';
+    }
+    return 'liveness.error.${userMessage.toLowerCase()}';
+  }
+
+  static LivenessIcon _challengeIcon(String? challenge) {
+    switch (challenge) {
+      case 'BLINK':
+        return LivenessIcon.blink;
+      case 'SMILE':
+        return LivenessIcon.smile;
+      case 'TURN_LEFT':
+        return LivenessIcon.turnLeft;
+      case 'TURN_RIGHT':
+        return LivenessIcon.turnRight;
+      case 'LOOK_UP':
+        return LivenessIcon.lookUp;
+      case 'LOOK_DOWN':
+        return LivenessIcon.lookDown;
+      default:
+        return LivenessIcon.scanning;
+    }
+  }
+
+  void _showGuidance(String key) {
+    if (key == _state.hintKey) {
+      _pendingHint = null;
+      return;
+    }
+    if (_hintLock?.isActive ?? false) {
+      _pendingHint = key;
+      return;
+    }
+    _set(_state.copyWith(hintKey: key, hintIsGuidance: true));
+    _hintLock = _timer(hintDebounce, _hintUnlocked);
+  }
+
+  void _hintUnlocked() {
+    final pending = _pendingHint;
+    _pendingHint = null;
+    if (_disposed || pending == null || _state.isFinal) return;
+    _showGuidance(pending);
+  }
+
+  void _dropPendingHint() => _pendingHint = null;
+
+  void _set(LivenessViewState next) {
+    if (_disposed) return;
+    _state = next;
+    notifyListeners();
+  }
+
+  @override
+  void dispose() {
+    _disposed = true;
+    _hintLock?.cancel();
+    super.dispose();
+  }
+}
