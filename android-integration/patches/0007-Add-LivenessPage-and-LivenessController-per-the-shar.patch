+import 'package:flutter_gen/gen_l10n/app_localizations.dart';
+
+/// The tips under LIVENESS_NOT_VERIFIED, in the spec's order (after liveness.tips.title).
+const List<String> livenessTipKeys = [
+  'liveness.tips.look_at_camera',
+  'liveness.tips.face_visible',
+  'liveness.tips.lighting',
+  'liveness.tips.capture_area',
+  'liveness.tips.follow_prompt',
+];
+
+/// The one place that maps the spec's canonical keys (docs/ui-liveness-spec.md
+/// §5) to the generated getters. [i] / [n] / [a] / [m] fill the placeholders of
+/// the progress and retry keys. An unknown key is returned as it is, so a gap
+/// shows up in testing instead of an empty line.
+String livenessText(AppLocalizations l, String key,
+    {int i = 0, int n = 0, int a = 0, int m = 0}) {
+  switch (key) {
+    case 'liveness.title.resident':
+      return l.liveness_title_resident;
+    case 'liveness.title.operator':
+      return l.liveness_title_operator;
+    case 'liveness.title.supervisor':
+      return l.liveness_title_supervisor;
+    case 'liveness.status.starting':
+      return l.liveness_status_starting;
+    case 'liveness.status.checking':
+      return l.liveness_status_checking;
+    case 'liveness.status.passed':
+      return l.liveness_status_passed;
+    case 'liveness.status.cancelled':
+      return l.liveness_status_cancelled;
+    case 'liveness.challenge.blink':
+      return l.liveness_challenge_blink;
+    case 'liveness.challenge.smile':
+      return l.liveness_challenge_smile;
+    case 'liveness.challenge.turn_left':
+      return l.liveness_challenge_turn_left;
+    case 'liveness.challenge.turn_right':
+      return l.liveness_challenge_turn_right;
+    case 'liveness.challenge.look_up':
+      return l.liveness_challenge_look_up;
+    case 'liveness.challenge.look_down':
+      return l.liveness_challenge_look_down;
+    case 'liveness.feedback.continue':
+      return l.liveness_feedback_continue;
+    case 'liveness.feedback.action_detected':
+      return l.liveness_feedback_action_detected;
+    case 'liveness.feedback.hold_still':
+      return l.liveness_feedback_hold_still;
+    case 'liveness.guidance.no_face':
+      return l.liveness_guidance_no_face;
+    case 'liveness.guidance.multiple_faces':
+      return l.liveness_guidance_multiple_faces;
+    case 'liveness.guidance.move_closer':
+      return l.liveness_guidance_move_closer;
+    case 'liveness.guidance.move_back':
+      return l.liveness_guidance_move_back;
+    case 'liveness.guidance.center_face':
+      return l.liveness_guidance_center_face;
+    case 'liveness.guidance.improve_lighting':
+      return l.liveness_guidance_improve_lighting;
+    case 'liveness.guidance.hold_steady':
+      return l.liveness_guidance_hold_steady;
+    case 'liveness.guidance.look_at_camera':
+      return l.liveness_guidance_look_at_camera;
+    case 'liveness.error.liveness_not_verified':
+      return l.liveness_error_liveness_not_verified;
+    case 'liveness.error.verification_not_completed':
+      return l.liveness_error_verification_not_completed;
+    case 'liveness.error.max_attempts_reached':
+      return l.liveness_error_max_attempts_reached;
+    case 'liveness.error.device_problem':
+      return l.liveness_error_device_problem;
+    case 'liveness.tips.title':
+      return l.liveness_tips_title;
+    case 'liveness.tips.look_at_camera':
+      return l.liveness_tips_look_at_camera;
+    case 'liveness.tips.face_visible':
+      return l.liveness_tips_face_visible;
+    case 'liveness.tips.lighting':
+      return l.liveness_tips_lighting;
+    case 'liveness.tips.capture_area':
+      return l.liveness_tips_capture_area;
+    case 'liveness.tips.follow_prompt':
+      return l.liveness_tips_follow_prompt;
+    case 'liveness.retry.attempts_left':
+      return l.liveness_retry_attempts_left(n);
+    case 'liveness.progress.step':
+      return l.liveness_progress_step(i, n);
+    case 'liveness.progress.attempt':
