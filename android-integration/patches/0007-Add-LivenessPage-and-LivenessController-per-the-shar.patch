+
+/// What [LivenessPage] returns with `Navigator.pop`.
+@immutable
+class LivenessOutcome {
+  const LivenessOutcome({
+    this.passed = false,
+    this.cancelled = false,
+    this.disabled = false,
+    this.passPath,
+    this.failureCode,
+    this.userMessage,
+    this.bestFrameJpeg,
+    this.sessionId,
+    this.attempts = 0,
+    this.durationMs = 0,
+    this.modelVersion,
+  });
+
+  factory LivenessOutcome.fromResult(LivenessMessage r) => LivenessOutcome(
+        passed: r.decision == 'PASSED',
+        cancelled: r.decision == 'CANCELLED',
+        passPath: r.passPath,
+        failureCode: r.failureCode,
+        userMessage: r.userMessage,
+        bestFrameJpeg: r.bestFrameJpeg,
+        sessionId: r.sessionId,
+        attempts: r.attempts,
+        durationMs: r.durationMs,
+        modelVersion: r.modelVersion,
+      );
+
+  /// Liveness is disabled for the workflow: the caller keeps its legacy flow.
+  static const LivenessOutcome disabledOutcome = LivenessOutcome(disabled: true);
+  static const LivenessOutcome cancelledOutcome = LivenessOutcome(cancelled: true);
+
+  final bool passed;
+  final bool cancelled;
+  final bool disabled;
+  final String? passPath;
+  final String? failureCode;
+  final String? userMessage;
+
+  /// JPEG of the best frame, on passed only. Keep it in memory.
+  final Uint8List? bestFrameJpeg;
+  final String? sessionId;
+  final int attempts;
+  final int durationMs;
+  final String? modelVersion;
+
+  @override
+  String toString() => 'LivenessOutcome(passed=$passed cancelled=$cancelled disabled=$disabled '
+      'passPath=$passPath failure=$failureCode message=$userMessage attempts=$attempts '
+      '${durationMs}ms bestFrame=${bestFrameJpeg == null ? '-' : '${bestFrameJpeg!.length} bytes'})';
+}
+
+/// The face liveness step (docs/ui-liveness-spec.md): checks that liveness is
+/// enabled for [workflow], asks for the camera, starts a session and renders its
+/// events. Pops a [LivenessOutcome]: passed (about 1 s after the success state),
+/// failed (after Close), cancelled (Cancel or back) or disabled.
+class LivenessPage extends StatefulWidget {
+  const LivenessPage({
+    super.key,
+    required this.workflow,
+    this.camera = 'front',
+    this.useFake = false,
+    this.previewBuilder,
+    this.service,
+    this.showDebugInfo = true,
+  });
+
+  static const String previewViewType = 'io.mosip.registration_client/liveness_preview';
+  static const Duration passedDelay = Duration(seconds: 1);
+
+  /// RESIDENT, OPERATOR or SUPERVISOR.
+  final String workflow;
+
+  /// front or back.
+  final String camera;
+
+  /// The scripted fake engine (debug and tests).
+  final bool useFake;
+
+  /// Replaces the camera preview (tests, privacy-safe screenshots).
+  final Widget Function()? previewBuilder;
+
+  /// Defaults to the platform's [LivenessService].
+  final LivenessService? service;
+
+  /// Debug builds only: a small chip with the model version (off for documentation screenshots).
+  final bool showDebugInfo;
+
+  @override
+  State<LivenessPage> createState() => _LivenessPageState();
+}
+
+class _LivenessPageState extends State<LivenessPage> {
+  late final LivenessService _service = widget.service ?? LivenessService();
+  late final LivenessController _controller = LivenessController(workflow: widget.workflow);
+  final Completer<void> _previewReady = Completer<void>();
+  StreamSubscription<LivenessMessage>? _subscription;
+  Timer? _passedTimer;
+  String? _sessionId;
+  bool _sessionRunning = false;
+  bool _popped = false;
+  String _debugModel = '';
+
+  @override
+  void initState() {
+    super.initState();
+    _controller.addListener(_onStateChanged);
+    _subscription = _service.messages.listen(_onMessage);
+    if (widget.previewBuilder != null) _previewReady.complete();
+    _begin();
+  }
+
+  @override
+  void dispose() {
+    _passedTimer?.cancel();
+    _subscription?.cancel();
+    if (_sessionRunning) _service.cancel(); // leaving the screen releases the camera
+    _controller.removeListener(_onStateChanged);
+    _controller.dispose();
+    super.dispose();
+  }
+
+  Future<void> _begin() async {
+    try {
+      if (!await _service.isEnabled(widget.workflow)) {
+        _pop(LivenessOutcome.disabledOutcome);
+        return;
+      }
+      if (!await _service.ensureCameraPermission()) {
+        _controller.permissionDenied();
+        return;
+      }
+      final policy = await _service.policy(widget.workflow);
+      _controller.maxRetries = policy.maxRetries;
+      if (kDebugMode && widget.showDebugInfo) _debugModel = await _service.modelVersion();
+      // Let the platform view exist first, so the session binds its preview.
+      await _previewReady.future.timeout(const Duration(seconds: 2), onTimeout: () {});
+      if (!mounted || _popped) return;
+      _sessionRunning = true;
+      final id = await _service.startSession(widget.workflow,
+          camera: widget.camera, useFake: widget.useFake);
+      if (id.isEmpty) {
+        _sessionRunning = false;
+        _pop(LivenessOutcome.disabledOutcome);
+        return;
+      }
+      _sessionId = id;
+    } on PlatformException catch (e) {
+      debugPrint('Liveness could not start: ${e.code}');
+      _sessionRunning = false;
+      _controller.startFailed();
+    }
+  }
+
+  void _onMessage(LivenessMessage m) {
+    if (_popped) return;
+    if (m.isComplete && _sessionId != null && m.sessionId != _sessionId) return; // an older session
+    _controller.handle(m);
+    if (!m.isComplete) return;
+    _sessionRunning = false;
+    switch (m.decision) {
+      case 'CANCELLED':
+        _pop(LivenessOutcome.fromResult(m));
+        break;
+      case 'PASSED':
+        _passedTimer = Timer(LivenessPage.passedDelay, () => _pop(LivenessOutcome.fromResult(m)));
+        break;
+      default:
+        break; // the final screen waits for Close
+    }
+  }
+
+  void _onStateChanged() {
+    if (mounted) setState(() {});
+  }
+
+  void _retry() => _service.retry();
+
+  void _cancel() {
+    if (_sessionRunning) _service.cancel();
+    _sessionRunning = false;
+    _pop(LivenessOutcome.cancelledOutcome);
+  }
+
+  void _close() {
+    final result = _controller.result;
+    if (result != null) {
+      _pop(LivenessOutcome.fromResult(result));
+    } else {
+      // Refused before a session existed: the camera permission, or the bridge failed.
+      final camera = _controller.state.messageKey == 'liveness.error.device_problem';
+      _pop(LivenessOutcome(
+        failureCode: camera ? 'CAMERA_UNAVAILABLE' : 'ENGINE_ERROR',
+        userMessage: camera ? 'DEVICE_PROBLEM' : 'VERIFICATION_NOT_COMPLETED',
+      ));
+    }
+  }
+
+  void _onBack() {
+    final state = _controller.state;
+    final result = _controller.result;
+    if (state.phase == LivenessPhase.passed && result != null) {
+      _passedTimer?.cancel();
+      _pop(LivenessOutcome.fromResult(result));
+    } else if (state.phase == LivenessPhase.failedFinal) {
+      _close();
+    } else {
+      _cancel();
+    }
+  }
+
+  void _pop(LivenessOutcome outcome) {
+    if (_popped || !mounted) return;
+    _popped = true;
+    Navigator.of(context).pop(outcome);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l = AppLocalizations.of(context)!;
+    final s = _controller.state;
+    final tone = _toneColor(s.ovalTone);
+    return WillPopScope(
+      onWillPop: () async {
+        _onBack();
+        return false;
+      },
+      child: Scaffold(
+        appBar: AppBar(
+          title: Text(livenessText(l, _controller.titleKey)),
+          actions: [
+            if (kDebugMode && _debugModel.isNotEmpty)
+              Padding(
+                padding: const EdgeInsets.only(right: 8),
+                child: Center(
+                  child: Chip(
+                    visualDensity: VisualDensity.compact,
+                    label: Text('debug $_debugModel', style: const TextStyle(fontSize: 11)),
+                  ),
+                ),
+              ),
+          ],
+        ),
+        body: SafeArea(
+          child: LayoutBuilder(builder: (context, constraints) {
+            final previewWidth = math.min(constraints.maxWidth * 0.72, 420.0);
+            return SingleChildScrollView(
+              padding: const EdgeInsets.fromLTRB(16, 12, 16, 24),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  Center(
+                    child: SizedBox(
+                      width: previewWidth,
+                      child: AspectRatio(aspectRatio: 3 / 4, child: _preview(s, tone)),
+                    ),
+                  ),
+                  const SizedBox(height: 16),
+                  _statusBanner(l, s, tone),
+                  _hintLine(l, s),
+                  if (s.progressVisible) _progressRow(l, s, tone),
+                  if (s.attempt > 0 && s.maxAttempts > 0 && s.phase != LivenessPhase.cancelled)
+                    Padding(
+                      padding: const EdgeInsets.only(top: 8),
+                      child: Text(
+                        livenessText(l, 'liveness.progress.attempt', a: s.attempt, m: s.maxAttempts),
+                        style: const TextStyle(fontSize: 16),
+                      ),
+                    ),
+                  if (s.tips) _tips(l),
+                  if (s.recoveryKey != null)
+                    Padding(
+                      padding: const EdgeInsets.only(top: 12),
+                      child: Text(livenessText(l, s.recoveryKey!), style: const TextStyle(fontSize: 18)),
+                    ),
+                  const SizedBox(height: 20),
+                  _buttons(l, s),
+                ],
+              ),
+            );
+          }),
+        ),
+      ),
+    );
+  }
+
+  Widget _preview(LivenessViewState s, Color tone) {
+    final preview = widget.previewBuilder?.call() ??
+        AndroidView(
+          viewType: LivenessPage.previewViewType,
+          creationParamsCodec: const StandardMessageCodec(),
+          onPlatformViewCreated: (_) {
+            if (!_previewReady.isCompleted) _previewReady.complete();
+          },
+        );
+    return ClipRRect(
+      borderRadius: BorderRadius.circular(12),
+      child: LayoutBuilder(builder: (context, c) {
+        final oval = _OvalPainter.ovalRect(Size(c.maxWidth, c.maxHeight));
+        return Stack(
+          fit: StackFit.expand,
+          children: [
+            preview,
+            IgnorePointer(child: CustomPaint(painter: _OvalPainter(tone))),
+            Positioned(
+              left: oval.center.dx - 22,
+              top: math.max(4, oval.top - 22),
+              child: ExcludeSemantics(
+                child: Container(
+                  width: 44,
+                  height: 44,
+                  decoration: BoxDecoration(
+                    color: tone,
+                    shape: BoxShape.circle,
+                    border: Border.all(color: Colors.white, width: 2),
+                  ),
+                  child: Icon(_iconData(s.icon), color: Colors.white, size: 26),
+                ),
+              ),
+            ),
+          ],
+        );
+      }),
+    );
+  }
+
+  Widget _statusBanner(AppLocalizations l, LivenessViewState s, Color tone) {
+    final key = s.statusKey;
+    return Semantics(
+      liveRegion: true,
+      child: Container(
+        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 14),
+        decoration: BoxDecoration(
+          color: tone.withOpacity(0.12),
+          borderRadius: BorderRadius.circular(8),
+          border: Border.all(color: tone, width: 2),
+        ),
+        child: Row(
+          children: [
+            ExcludeSemantics(child: Icon(_iconData(s.icon), color: tone, size: 32)),
+            const SizedBox(width: 12),
+            Expanded(
+              child: Text(
+                key == null ? '' : livenessText(l, key),
+                style: const TextStyle(fontSize: 26, fontWeight: FontWeight.bold),
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _hintLine(AppLocalizations l, LivenessViewState s) {
+    final key = s.hintKey;
+    if (key == null) return const SizedBox(height: 8);
+    return Padding(
+      padding: const EdgeInsets.only(top: 10),
+      child: Semantics(
+        liveRegion: true,
+        child: Row(
+          children: [
+            if (s.hintIsGuidance)
+              Padding(
+                padding: const EdgeInsets.only(right: 8),
+                child: Icon(Icons.warning_amber_rounded, color: Colors.amber.shade900),
+              ),
+            Expanded(
+              child: Text(livenessText(l, key, n: s.retriesLeft),
+                  style: const TextStyle(fontSize: 18)),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _progressRow(AppLocalizations l, LivenessViewState s, Color tone) {
+    return Padding(
+      padding: const EdgeInsets.only(top: 12),
+      child: Row(
+        children: [
+          if (s.stepCount > 0)
+            Padding(
+              padding: const EdgeInsets.only(right: 12),
+              child: Text(
+                livenessText(l, 'liveness.progress.step', i: s.stepIndex, n: s.stepCount),
+                style: const TextStyle(fontSize: 16),
+              ),
+            ),
+          Expanded(
+            child: ExcludeSemantics(
+              child: LinearProgressIndicator(
+                value: s.progress,
+                minHeight: 8,
+                color: tone,
+                backgroundColor: tone.withOpacity(0.2),
+              ),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+
+  Widget _tips(AppLocalizations l) {
+    return Padding(
+      padding: const EdgeInsets.only(top: 12),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(livenessText(l, 'liveness.tips.title'),
+              style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
+          for (final key in livenessTipKeys)
+            Padding(
+              padding: const EdgeInsets.only(top: 4),
+              child: Text('•  ${livenessText(l, key)}', style: const TextStyle(fontSize: 16)),
+            ),
+        ],
+      ),
+    );
+  }
+
+  Widget _buttons(AppLocalizations l, LivenessViewState s) {
+    const size = Size(120, 48);
+    return Wrap(
+      alignment: WrapAlignment.center,
+      spacing: 12,
+      runSpacing: 8,
+      children: [
+        if (s.showRetry)
+          ElevatedButton(
+            style: ElevatedButton.styleFrom(minimumSize: size),
+            onPressed: _retry,
+            child: Text(livenessText(l, 'liveness.button.retry')),
+          ),
+        if (s.showCancel)
+          OutlinedButton(
+            style: OutlinedButton.styleFrom(minimumSize: size),
+            onPressed: _cancel,
+            child: Text(livenessText(l, 'liveness.button.cancel')),
+          ),
+        if (s.showClose)
+          ElevatedButton(
+            style: ElevatedButton.styleFrom(minimumSize: size),
+            onPressed: _close,
+            child: Text(livenessText(l, 'liveness.button.close')),
+          ),
+      ],
+    );
+  }
+
+  static Color _toneColor(LivenessOvalTone tone) {
+    switch (tone) {
+      case LivenessOvalTone.neutral:
+        return Colors.grey.shade600;
+      case LivenessOvalTone.checking:
+        return Colors.blue.shade600;
+      case LivenessOvalTone.challenge:
+        return Colors.amber.shade800;
+      case LivenessOvalTone.success:
+        return Colors.green.shade600;
+      case LivenessOvalTone.error:
+        return Colors.red.shade600;
+    }
+  }
+
+  static IconData _iconData(LivenessIcon icon) {
+    switch (icon) {
+      case LivenessIcon.camera:
+        return Icons.photo_camera_outlined;
+      case LivenessIcon.scanning:
+        return Icons.center_focus_weak;
+      case LivenessIcon.blink:
+        return Icons.visibility_outlined;
+      case LivenessIcon.smile:
+        return Icons.sentiment_satisfied_alt;
+      case LivenessIcon.turnLeft:
+        return Icons.arrow_back; // the preview is mirrored: the user's left is on screen left
+      case LivenessIcon.turnRight:
+        return Icons.arrow_forward;
+      case LivenessIcon.lookUp:
+        return Icons.arrow_upward;
+      case LivenessIcon.lookDown:
+        return Icons.arrow_downward;
+      case LivenessIcon.check:
+        return Icons.check_circle;
+      case LivenessIcon.cross:
+        return Icons.cancel;
+      case LivenessIcon.cameraOff:
+        return Icons.no_photography_outlined;
+    }
+  }
+}
+
+/// The face-oval guide: the outside dimmed lightly, the outline in the state colour.
+class _OvalPainter extends CustomPainter {
+  _OvalPainter(this.color);
+
+  final Color color;
+
+  static Rect ovalRect(Size size) => Rect.fromCenter(
+        center: Offset(size.width / 2, size.height * 0.47),
+        width: size.width * 0.66,
+        height: size.height * 0.66,
+      );
+
+  @override
+  void paint(Canvas canvas, Size size) {
+    final oval = ovalRect(size);
+    final dim = Path()
+      ..fillType = PathFillType.evenOdd
+      ..addRect(Offset.zero & size)
+      ..addOval(oval);
+    canvas.drawPath(dim, Paint()..color = Colors.black.withOpacity(0.30));
+    canvas.drawOval(
+      oval,
+      Paint()
+        ..style = PaintingStyle.stroke
+        ..strokeWidth = 4
+        ..color = color,
+    );
+  }
+
+  @override
+  bool shouldRepaint(_OvalPainter old) => old.color != color;
+}
